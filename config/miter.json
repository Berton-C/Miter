{
  "schema": "miter-assistant-config-v1",
  "human_editable": true,
  "idle_base_seconds": 0.05,
  "idle_cap_seconds": 0.4,
  "max_input_batch": 8,
  "max_input_bytes": 1048576,
  "external_effects": "none",
  "network_access": "explicit-model-grant-only",
  "runtime_root": "explicit-required",
  "mattermost": {
    "schema": "miter-mattermost-surface-v1",
    "human_editable": true,
    "enabled": true,
    "origin": "http://127.0.0.1:8065",
    "origin_policy": "loopback-only",
    "team_slug": "clarityclaw",
    "bot_username": "miter",
    "authorized_humans": ["berton_c", "haley"],
    "required_group_members": ["berton_c", "haley", "miter"],
    "scope": {
      "audience": "berton-haley-shared-local",
      "project": "miter-evaluation-v1"
    },
    "credential_reference": {
      "source": "macos-keychain",
      "account": "bcb",
      "service": "ai.bgi.miter.mattermost"
    },
    "inbound": {
      "new_events_only": true,
      "history_backfill": false,
      "bot_posts_are_contact": false,
      "max_event_bytes": 32768,
      "poll_seconds": 2
    },
    "outbound": {
      "enabled": false,
      "certificate": "VoiceRNA-required",
      "destination": "resolved-exact-group-only",
      "unknown_outcome": "hold-and-reconcile-never-blind-resend"
    },
    "operator_notes": [
      "Stable IDs remain in the private runtime and are revalidated before cognition.",
      "Outbound requires VoiceRNA plus a separately active evaluation grant."
    ]
  },
  "memory": {
    "schema": "miter-semantic-memory-config-v1",
    "human_editable": true,
    "enabled": true,
    "chroma": {
      "origin": "http://127.0.0.1:8001",
      "origin_policy": "loopback-only",
      "tenant": "default_tenant",
      "database": "default_database",
      "collection": "miter-cleanroom-continuity-v1",
      "distance": "cosine"
    },
    "embedding": {
      "endpoint": "http://127.0.0.1:1234/v1/embeddings",
      "endpoint_policy": "loopback-only",
      "model": "text-embedding-nomic-embed-text-v1.5",
      "dimension": 768
    },
    "query": {"max_results": 4, "max_body_characters": 8000},
    "projection": {
      "source": "native-continuity-capsules-only",
      "authority": "rebuildable-projection-never-continuity-authority",
      "include": ["exact-human-contact", "certified-delivered-expression"]
    },
    "operator_notes": [
      "Native continuity is authoritative; Chroma is a rebuildable scoped index.",
      "Distance and result order never select or certify movement."
    ]
  },
  "models": {
    "schema": "miter-model-resource-registry-v1",
    "human_editable": true,
    "selection": {
      "mode": "human-operator-direction",
      "operator_preference": "openrouter-glm53",
      "preference_standing": "human-preferred-default-not-cognitive-authority",
      "authorized_directions": [
        "openrouter-glm53",
        "qwen-local",
        "nemotron-local"
      ],
      "direction_scopes": ["next-model-calls", "bounded-duration", "until-replaced"],
      "soul_choice": "not-yet-embodied-must-be-native-relational-comparison-among-authorized-resources",
      "selected_model_output_authority": "none",
      "fallback_policy": "explicit-native-comparison-only",
      "silent_model_substitution": false
    },
    "resources": [
      {
        "id": "openrouter-glm53",
        "kind": "remote",
        "enabled": true,
        "adapter": "openrouter-chat-completions",
        "model": "z-ai/glm-5.3",
        "endpoint": "https://openrouter.ai/api/v1/chat/completions",
        "roles": ["semantic-reading", "language-rendering"],
        "reasoning_effort": "high",
        "limits": {
          "max_output_tokens": 2048,
          "deadline_seconds": 120,
          "capture_bytes": 262144
        },
        "provider": {
          "zdr": true,
          "data_collection": "deny",
          "require_parameters": true,
          "allow_fallbacks": true
        },
        "credential_reference": {
          "source": "macos-keychain",
          "account": "bcb",
          "service": "ai.bgi.miter.openrouter"
        }
      },
      {
        "id": "qwen-local",
        "kind": "local",
        "enabled": true,
        "adapter": "lm-studio",
        "model": "qwen/qwen3.8-27b",
        "endpoint": "http://127.0.0.1:1234/v1/chat/completions",
        "roles": ["semantic-reading", "language-rendering"],
        "limits": {
          "max_output_tokens": 2048,
          "deadline_seconds": 300,
          "capture_bytes": 262144
        },
        "credential_reference": null
      },
      {
        "id": "nemotron-local",
        "kind": "local",
        "enabled": true,
        "adapter": "lm-studio",
        "model": "nemotron-3.5-30b-a3b-antislop-ftpo-i1",
        "endpoint": "http://127.0.0.1:1234/v1/chat/completions",
        "roles": ["semantic-reading", "language-rendering"],
        "limits": {
          "max_output_tokens": 2048,
          "deadline_seconds": 300,
          "capture_bytes": 262144
        },
        "credential_reference": null
      }
    ],
    "operator_notes": [
      "Store secrets outside this file; credential_reference is only a lookup location.",
      "Human direction selects a live resource, never meaning, movement, memory admission, or effects; Soul-directed resource choice remains unimplemented until it is embodied as native relational comparison.",
      "Every remote call additionally requires a current runtime-local grant."
    ]
  },
  "initial_model_grants": {
    "schema": "miter-model-grants-v1",
    "standing": "inactive-no-live-model-authority",
    "grants": []
  },
  "initial_evaluation_grants": {
    "schema": "miter-evaluation-grants-v1",
    "standing": "inactive-awaiting-participant-disclosure",
    "authority": "AMA-1.2-ratified-by-berton",
    "grants": [],
    "bounds": {
      "first_segment_hours": 72,
      "maximum_hours": 168,
      "admitted_events": 1000,
      "outbound_posts": 500,
      "outbound_per_hour": 60,
      "remote_calls": 50
    },
    "required_affirmations": {
      "berton_c": "affirmed-by-ratification",
      "haley": "required-before-payload-cognition-memory-model-or-egress"
    },
    "haley_disclosure": {
      "exact_text": "I understand that Miter is an alpha; this shared conversation enters durable shared-project memory; local models may process it; authorized bounded material may be sent to OpenRouter GLM 5.3; credentials, unrelated private memory, and stable IDs will not be sent; either participant may panic or revoke future operation; corrections are additive; and comprehensive private-payload erasure is not yet complete. I affirm participation in AMA-1.2.",
      "required_author": "haley",
      "required_surface": "exact-berton-haley-miter-group"
    },
    "authority_separation": "grant-bounds-reach-not-meaning-or-movement"
  },
  "operator_notes": [
    "This is the only human-edited repository configuration file.",
    "It contains names and Keychain references, never secrets or private stable IDs.",
    "Installation materializes validated private runtime views from these settings.",
    "The evaluation grant installs inactive and can activate only after both participant disclosures and complete preflight."
  ]
}
