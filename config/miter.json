{
  "schema": "miter-assistant-config-v1",
  "human_editable": true,
  "deployment": {
    "schema": "miter-installation-v1",
    "human_editable": true,
    "runtime_user": "claritymiter",
    "install_root": "/Users/claritymiter/Miter",
    "service_mode": "isolated-docker-compose",
    "docker_project": "miter",
    "credential_imports": [
      {
        "relative_path": "secrets/mattermost-token",
        "source": "macos-keychain",
        "account": "bcb",
        "service": "ai.bgi.miter.mattermost"
      },
      {
        "relative_path": "secrets/openrouter-api-key",
        "source": "macos-keychain",
        "account": "bcb",
        "service": "ai.bgi.miter.openrouter"
      }
    ],
    "petta": {
      "commit": "ae66fa8e41dcd5539d614706bd4e5cfb34f9608d",
      "archive_url": "https://github.com/trueagi-io/PeTTa/archive/ae66fa8e41dcd5539d614706bd4e5cfb34f9608d.tar.gz",
      "archive_sha256": "de1e2474b902895f5373fc833ed45341f16e0d283ae957ccb323df42200ce397"
    },
    "images": {
      "chroma": "docker.io/chromadb/chroma:1.5.9@sha256:1e0b73a187a28757c572acba508c46f48c9e8b0acaf5c20e6d95cdedce1acdf6",
      "mattermost": "mattermost/mattermost-team-edition:11.7.7@sha256:3ecc659553b14335e382a3d4b673afe84f4368ea1ed4cccdb44805add8dedbd7",
      "postgres": "postgres:16-alpine@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777",
      "workshop": "python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0"
    },
    "operator_notes": [
      "The installer is finite packaging machinery and exits before Miter runs.",
      "All Miter-owned application, dependency, runtime, service, backup, and operator paths are derived beneath install_root.",
      "Application and PeTTa bytes are root-owned read-only inputs; writable continuity remains private to the dedicated runtime identity.",
      "Existing service ports or private data are never replaced implicitly.",
      "Credential imports name optional migration sources; secret bytes never enter this file."
    ]
  },
  "idle_base_seconds": 0.05,
  "idle_cap_seconds": 2.0,
  "max_input_batch": 8,
  "max_input_bytes": 1048576,
  "supervision": {
    "startup_grace_seconds": 30,
    "waiting_lease_seconds": 10,
    "processing_lease_seconds": 90,
    "model_lease_margin_seconds": 30,
    "termination_grace_seconds": 5,
    "poll_seconds": 1
  },
  "external_effects": "none",
  "network_access": "dedicated-user-open-growth-environment",
  "runtime_root": "explicit-required",
  "growth_environment": {
    "schema": "miter-open-growth-environment-v1",
    "human_editable": true,
    "enabled": true,
    "expected_runtime_user": "claritymiter",
    "workspace_relative": "workspace",
    "informational_network": "open-http-https",
    "terminal": "typed-direct-argv-broker",
    "credential_access": "named-reference-only",
    "reversible_writes": "versioned-owned-workspace",
    "workshop": {
      "runner": "docker-isolated-v1",
      "image": "python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0",
      "platform": "linux/arm64",
      "network": "none",
      "root_filesystem": "read-only",
      "memory_megabytes": 128,
      "cpus": 0.5,
      "pids_limit": 32,
      "operator_notes": [
        "Candidate trials and invocations receive only a read-only candidate mount and an extension-specific state mount.",
        "No network, host credential, runtime-state, or unrelated workspace mount enters the candidate container.",
        "The image is exact-digest pinned and the operator-owned Docker broker remains non-cognitive."
      ]
    },
    "human_authority_boundaries": [
      "bind-other-principal",
      "cross-user-private-material",
      "use-named-credential",
      "spend-or-transfer-value",
      "external-publication-or-message",
      "difficult-to-reverse-external-commitment"
    ],
    "operator_notes": [
      "Surface availability is not cognitive authority; the Soul forms every tool movement.",
      "No per-command or per-site microgrant is required inside this durable class.",
      "The environment remains held unless the running process is the dedicated claritymiter user.",
      "Terminal operations are exact direct argument vectors with a sanitized environment, bounded lifetime and output, and an owned-workspace working directory.",
      "Workspace writes use exact prior-content identity, immutable rollback lineage, and durable completion observations."
    ]
  },
  "mattermost": {
    "schema": "miter-mattermost-surface-v1",
    "human_editable": true,
    "enabled": true,
    "origin": "http://127.0.0.1:8065",
    "origin_policy": "loopback-only",
    "team_slug": "clarityclaw",
    "bot_username": "miter",
    "authorized_humans": ["berton_c", "haley"],
    "required_group_members": ["berton_c", "haley", "miter"],
    "scope": {
      "audience": "berton-haley-shared-local",
      "project": "miter-evaluation-v1"
    },
    "credential_reference": {
      "source": "private-runtime-file",
      "relative_path": "secrets/mattermost-token"
    },
    "inbound": {
      "new_events_only": true,
      "history_backfill": false,
      "bot_posts_are_contact": false,
      "max_event_bytes": 32768,
      "poll_seconds": 2
    },
    "outbound": {
      "enabled": false,
      "certificate": "VoiceRNA-required",
      "destination": "resolved-exact-group-only",
      "unknown_outcome": "hold-and-reconcile-never-blind-resend"
    },
    "operator_notes": [
      "Stable IDs remain in the private runtime and are revalidated before cognition.",
      "Outbound requires VoiceRNA plus a separately active evaluation grant."
    ]
  },
  "memory": {
    "schema": "miter-semantic-memory-config-v1",
    "human_editable": true,
    "enabled": true,
    "chroma": {
      "origin": "http://127.0.0.1:8001",
      "origin_policy": "loopback-only",
      "tenant": "default_tenant",
      "database": "default_database",
      "collection": "miter-cleanroom-continuity-v1",
      "distance": "cosine"
    },
    "embedding": {
      "endpoint": "http://127.0.0.1:1234/v1/embeddings",
      "endpoint_policy": "loopback-only",
      "model": "text-embedding-nomic-embed-text-v1.5",
      "dimension": 768
    },
    "query": {"max_results": 4, "max_body_characters": 8000},
    "projection": {
      "source": "native-continuity-capsules-only",
      "authority": "rebuildable-projection-never-continuity-authority",
      "include": ["exact-human-contact", "certified-delivered-expression"]
    },
    "operator_notes": [
      "Native continuity is authoritative; Chroma is a rebuildable scoped index.",
      "Distance and result order never select or certify movement."
    ]
  },
  "vad": {
    "schema": "miter-vad-language-cue-config-v1",
    "human_editable": true,
    "enabled": true,
    "asset": {
      "version": "NRC-VAD-2.1",
      "sha256": "42c718817fc91d5c133581b24b0bb31d2b14a0b16edb19bc6ce6ab70343e5a45",
      "source": "private-runtime-file",
      "relative_path": "private-assets/NRC-VAD-Lexicon-v2.1.txt",
      "redistribution": "prohibited-no-lexicon-rows-in-public-repository"
    },
    "limits": {
      "maximum_text_characters": 32768,
      "maximum_clauses": 32,
      "maximum_tokens": 4096,
      "maximum_ngram_tokens": 3
    },
    "matching": "longest-exact-only",
    "operator_notes": [
      "VAD measures lexical associations and within-contact language trajectory only.",
      "No VAD value diagnoses a person, infers hidden inner state, authorizes action, selects movement, or classifies SNS/PNS.",
      "The licensed asset remains a private runtime input and is never copied into source, checkpoints, Chroma, model prompts, or public evidence."
    ]
  },
  "models": {
    "schema": "miter-model-resource-registry-v1",
    "human_editable": true,
    "selection": {
      "mode": "human-operator-direction",
      "operator_preference": "openrouter-glm53",
      "preference_standing": "human-preferred-default-not-cognitive-authority",
      "authorized_directions": [
        "openrouter-glm53",
        "qwen-local",
        "nemotron-local"
      ],
      "remote_context_standing": "authorized-conversation-continuity-project-and-personal-context",
      "remote_exclusions": [
        "passwords-and-credentials",
        "authentication-material",
        "content-whose-disclosure-creates-a-concrete-security-risk"
      ],
      "direction_scopes": ["next-model-calls", "bounded-duration", "until-replaced"],
      "soul_choice": "general-relational-resource-comparison-remains-open",
      "selected_model_output_authority": "none",
      "fallback_policy": "explicit-native-comparison-only",
      "silent_model_substitution": false
    },
    "resources": [
      {
        "id": "openrouter-glm53",
        "kind": "remote",
        "enabled": true,
        "adapter": "openrouter-chat-completions",
        "model": "z-ai/glm-5.3",
        "endpoint": "https://openrouter.ai/api/v1/chat/completions",
        "roles": ["semantic-reading", "language-rendering"],
        "reasoning_effort": "high",
        "limits": {
          "max_output_tokens": 2048,
          "deadline_seconds": 120,
          "capture_bytes": 262144
        },
        "provider": {
          "zdr": true,
          "data_collection": "deny",
          "require_parameters": true,
          "allow_fallbacks": true
        },
        "credential_reference": {
          "source": "private-runtime-file",
          "relative_path": "secrets/openrouter-api-key"
        }
      },
      {
        "id": "qwen-local",
        "kind": "local",
        "enabled": true,
        "adapter": "lm-studio",
        "model": "qwen/qwen3.8-27b",
        "endpoint": "http://127.0.0.1:1234/v1/chat/completions",
        "roles": ["semantic-reading", "language-rendering"],
        "limits": {
          "max_output_tokens": 2048,
          "deadline_seconds": 300,
          "capture_bytes": 262144
        },
        "credential_reference": null
      },
      {
        "id": "nemotron-local",
        "kind": "local",
        "enabled": true,
        "adapter": "lm-studio",
        "model": "nemotron-3.5-30b-a3b-antislop-ftpo-i1",
        "endpoint": "http://127.0.0.1:1234/v1/chat/completions",
        "roles": ["semantic-reading", "language-rendering"],
        "limits": {
          "max_output_tokens": 2048,
          "deadline_seconds": 300,
          "capture_bytes": 262144
        },
        "credential_reference": null
      }
    ],
    "operator_notes": [
      "Store secrets outside this file; credential_reference is only a lookup location.",
      "Human direction selects a preferred live resource, never meaning, movement, memory admission, or effects.",
      "OpenRouter GLM 5.3 is the installed default and may receive ordinary conversation, continuity, project, and personal context needed for Miter's work; passwords, credentials, authentication material, and concrete security-risk content are excluded.",
      "Qwen and Nemotron remain explicit human-selectable resources; continuity never silently changes the selected model.",
      "Every remote call additionally requires a current runtime-local grant."
    ]
  },
  "initial_model_grants": {
    "schema": "miter-model-grants-v1",
    "standing": "inactive-no-live-model-authority",
    "grants": []
  },
  "initial_evaluation_grants": {
    "schema": "miter-evaluation-grants-v1",
    "standing": "inactive-awaiting-authorized-activation",
    "authority": "AMA-1.2-ratified-by-berton",
    "grants": [],
    "bounds": {
      "first_segment_hours": 72,
      "maximum_hours": 168,
      "admitted_events": 1000,
      "outbound_posts": 500,
      "outbound_per_hour": 60,
      "remote_calls": 50
    },
    "required_affirmations": {
      "berton_c": "affirmed-by-ratification-and-current-system-administrator-attestation",
      "haley": "consent-attested-by-berton-current-system-administrator"
    },
    "administrator_attestation": {
      "attestor": "berton_c",
      "attested_participant": "haley",
      "standing": "ratified-participant-consent-attestation",
      "activation_authority": "system-administrator-and-evaluation-owner",
      "scope": "AMA-1.2-only"
    },
    "haley_disclosure": {
      "exact_text": "I understand that Miter is an alpha; this shared conversation enters durable shared-project memory; OpenRouter GLM 5.3 is the default and may process ordinary conversation, continuity, project, and personal context needed for Miter's work; passwords, credentials, authentication material, and content whose disclosure creates a concrete security risk will not be sent; local models remain available by explicit direction; either participant may panic or revoke future operation; corrections are additive; and comprehensive private-payload erasure is not yet complete. I affirm participation in AMA-1.2.",
      "required_author": "haley",
      "required_surface": "exact-berton-haley-miter-group",
      "standing": "recommended-direct-confirmation-not-activation-precondition"
    },
    "authority_separation": "grant-bounds-reach-not-meaning-or-movement"
  },
  "operator_notes": [
    "This is the only human-edited repository configuration file.",
    "It contains names and private credential references, never secrets or private stable IDs.",
    "Installation materializes validated private runtime views from these settings.",
    "The evaluation grant installs inactive and can activate only through the ratified administrator attestation or Haley's direct disclosure, plus complete preflight."
  ]
}
