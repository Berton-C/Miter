{
  "schema": "miter-semantic-memory-config-v1",
  "human_editable": true,
  "enabled": true,
  "chroma": {
    "origin": "http://127.0.0.1:8001",
    "origin_policy": "loopback-only",
    "tenant": "default_tenant",
    "database": "default_database",
    "collection": "miter-cleanroom-continuity-v1",
    "distance": "cosine"
  },
  "embedding": {
    "endpoint": "http://127.0.0.1:1234/v1/embeddings",
    "endpoint_policy": "loopback-only",
    "model": "text-embedding-nomic-embed-text-v1.5",
    "dimension": 768
  },
  "query": {
    "max_results": 4,
    "max_body_characters": 8000
  },
  "projection": {
    "source": "native-continuity-capsules-only",
    "authority": "rebuildable-projection-never-continuity-authority",
    "include": ["exact-human-contact", "certified-delivered-expression"]
  },
  "operator_notes": [
    "This file contains no credential or private stable identifier.",
    "The native continuity capsule is authoritative; Chroma may be deleted and rebuilt.",
    "Every query is exact-scope filtered and every returned capsule hash is verified locally.",
    "Distances and result order are diagnostics only and never select or certify a movement."
  ]
}
