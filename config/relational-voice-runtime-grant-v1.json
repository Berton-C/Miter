{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miter.local/schema/relational-voice-runtime-grant-v1.json",
  "title": "Miter relational voice runtime grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "root",
    "request_id",
    "scope",
    "purpose",
    "model_alias",
    "endpoint",
    "max_calls",
    "external_human_emission",
    "issued_at_epoch",
    "expires_at_epoch"
  ],
  "properties": {
    "schema": {"const": "miter-relational-voice-runtime-grant-v1"},
    "root": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "scope": {"type": "array", "minItems": 5, "maxItems": 5},
    "purpose": {"const": "bounded-relational-expression-rendering"},
    "model_alias": {"const": "qwen-local"},
    "endpoint": {"const": "http://127.0.0.1:1234/v1/chat/completions"},
    "max_calls": {"const": 1},
    "external_human_emission": {"const": false},
    "issued_at_epoch": {"type": "number"},
    "expires_at_epoch": {"type": "number"}
  }
}
