      "enabled": true,
      "adapter": "lm-studio",
      "model": "text-embedding-nomic-embed-text-v1.5",
      "discovery_endpoint": "http://127.0.0.1:1234/api/v0/models",
      "inference_endpoint": "http://127.0.0.1:1234/v1/embeddings",
      "roles": ["embedding"],
      "credential_reference": null
