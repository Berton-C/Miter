{
  "schema": "miter-model-resource-registry-v1",
  "human_editable": true,
  "selection": {
    "mode": "human-direction-or-native-relational",
    "operator_preference": "openrouter-glm53",
    "preference_standing": "human-preferred-default-not-cognitive-authority",
    "authorized_directions": ["openrouter-glm53", "qwen-local", "nemotron-local", "soul-choice"],
    "direction_scopes": ["one-call", "conversation", "undertaking", "until-time"],
    "direction_authority_source": "active-surface-grant-and-authenticated-human-contact",
    "soul_choice": "native-relational-comparison-among-currently-authorized-resources",
    "selected_model_output_authority": "none",
    "fallback_policy": "explicit-native-comparison-only",
