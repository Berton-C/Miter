    {
      "id": "qwen-local",
      "kind": "local",
      "enabled": true,
      "adapter": "lm-studio",
      "model": "qwen/qwen3.8-27b",
      "discovery_endpoint": "http://127.0.0.1:1234/api/v0/models",
      "inference_endpoint": "http://127.0.0.1:1234/v1/chat/completions",
      "roles": ["semantic-reading", "voice-rendering", "extension-implementation"],
      "credential_reference": null
    },
    {
      "id": "nemotron-local",
      "kind": "local",
      "enabled": true,
      "adapter": "lm-studio",
      "model": "nemotron-3.5-30b-a3b-antislop-ftpo-i1",
      "discovery_endpoint": "http://127.0.0.1:1234/api/v0/models",
      "inference_endpoint": "http://127.0.0.1:1234/v1/chat/completions",
      "roles": ["semantic-reading", "voice-rendering", "extension-implementation"],
