{
  "schema": "miter-model-resource-registry-v1",
  "human_editable": true,
  "selection": {
    "mode": "human-direction-or-native-relational",
    "operator_preference": "openrouter-glm53",
    "preference_standing": "human-preferred-default-not-cognitive-authority",
