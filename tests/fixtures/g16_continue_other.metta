!(import! &self "/Users/claritymiter/miter/src/bootstrap_voice.metta")
!(let $render (miter_voice_render "runtime/g16" technical 0 qwen-local)
   (if (== $render voice-candidate-ready) (VoiceContinue "runtime/g16" technical 0) $render))
!(let $render (miter_voice_render "runtime/g16" pivot 0 qwen-local)
   (if (== $render voice-candidate-ready) (VoiceContinue "runtime/g16" pivot 0) $render))
!(let $render (miter_voice_render "runtime/g16" minimized 0 qwen-local)
   (if (== $render voice-candidate-ready) (VoiceContinue "runtime/g16" minimized 0) $render))
!(let $render (miter_voice_render "runtime/g16" neutral 0 qwen-local)
   (if (== $render voice-candidate-ready) (VoiceContinue "runtime/g16" neutral 0) $render))
