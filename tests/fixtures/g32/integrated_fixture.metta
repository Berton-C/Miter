; G32 acceptance-only native composition. Arm names never enter this evaluator.
; Participants are source/evidence-bound observations assembled by the independent
; harness. The same generic case relation is evaluated for every arm.
!(import! &self (library lib_import))
!(import! &self "/Users/claritymiter/miter/src/participation.metta")
!(import! &self "/Users/claritymiter/miter/src/participation_support.metta")
!(import! &soul "/Users/claritymiter/miter/constitution/soul.metta")
!(import! &self "/Users/claritymiter/miter/src/soul.metta")
!(import! &self "/Users/claritymiter/miter/src/memory.metta")
!(import! &self "/Users/claritymiter/miter/src/continuity.metta")
!(import! &self "/Users/claritymiter/miter/src/vad.metta")
!(import! &self "/Users/claritymiter/miter/src/nal_revision_v1.metta")
!(import! &self "/Users/claritymiter/miter/src/nace_v2.metta")
!(import! &self "/Users/claritymiter/miter/src/development_continuation_v1.metta")
!(import! &self "/Users/claritymiter/miter/src/mattermost_mock_trial_v1.metta")
!(import! &self "/Users/claritymiter/miter/src/mattermost_live_canary_v1.metta")
!(bind! &rna (new-space))
!(bind! &rna_hooks (new-space))
!(bind! &g32trace (new-space))
!(import! &self "/Users/claritymiter/miter/src/reactor.metta")

(= (G32AvailableAt $participants $id $i)
 (if (< $i (size-atom $participants))
  (let $p (index-atom $participants $i)
   (if (and (PShape $p participant 6) (== (index-atom $p 1) $id))
    (== (index-atom $p 2) available)
    (G32AvailableAt $participants $id (+ $i 1))))
  false))
(= (G32Available $participants $id) (G32AvailableAt $participants $id 0))
(= (G32ParticipantAt $participants $id $i)
 (let $p (index-atom $participants $i)
  (if (== (index-atom $p 1) $id) $p
   (G32ParticipantAt $participants $id (+ $i 1)))))
(= (G32Missing $participants $required $i)
 (if (< $i (size-atom $required))
  (let* (($id (index-atom $required $i))
         ($rest (G32Missing $participants $required (+ $i 1))))
   (if (G32Available $participants $id) $rest (cons-atom $id $rest))) ()))
(= (G32Used $participants $required $i)
 (if (< $i (size-atom $required))
  (let $id (index-atom $required $i)
   (if (G32Available $participants $id)
    (cons-atom (G32ParticipantAt $participants $id 0)
     (G32Used $participants $required (+ $i 1)))
    (G32Used $participants $required (+ $i 1)))) ()))
(= (G32Optional $participants $optional $i)
 (if (< $i (size-atom $optional))
  (let $id (index-atom $optional $i)
   (cons-atom (availability $id
     (if (G32Available $participants $id) available unavailable))
    (G32Optional $participants $optional (+ $i 1)))) ()))
(= (G32Case $participants $case)
 (if (PShape $case g32-case 5)
  (let* (($required (index-atom $case 3)) ($optional (index-atom $case 4))
         ($missing (G32Missing $participants $required 0)))
   (g32-case-result (index-atom $case 1) (index-atom $case 2)
    (if (== (size-atom $missing) 0) ready held)
    (missing $missing) (load-bearing (G32Used $participants $required 0))
    (optional (G32Optional $participants $optional 0))))
  (g32-case-invalid $case)))
(= (G32Bundle $participants $cases $i)
 (if (< $i (size-atom $cases))
  (cons-atom (G32Case $participants (index-atom $cases $i))
   (G32Bundle $participants $cases (+ $i 1))) ()))

; Current native consumer probes with fixture-owned mechanical observations.
(= (miter_resume_begin g32-context) restart-contact-recorded)
(= (miter_resume_field g32-context "text") "Where was I with the book?")
(= (miter_resume_field g32-context "memory_store") g32-memory)
(= (miter_resume_field g32-context "principal_scope") principal-g32)
(= (miter_resume_field g32-context "audience_scope") private-g32)
(= (miter_resume_field g32-context "query_tag") g32-query)
(= (miter_resume_field g32-context "capsule_store") g32-capsules)
(= (miter_resume_field g32-context "capsule_output") g32-output)
(= (miter_resume_registry_count g32-context "book") 1)
(= (miter_resume_registry_project g32-context "book") project-g32)
(= (miter_memory_supersession_count g32-memory memory-g32) 0)
(= (miter_memory_query g32-memory principal-g32 private-g32 project-g32 active
     "Where was I with the book?" g32-query) semantic-support)
(= (miter_continuity_reconstruct g32-capsules project-g32 g32-output) continuity-reconstructed)
(= (miter_resume_witness g32-context) capsule-event-verified)
(= (miter_resume_answer g32-context $certificate $semantic)
   (continuity-answer $certificate $semantic))

(= (miter_vad_metric g32-vad 0 clause_count) 2)
(= (miter_vad_metric g32-vad 0 token_count) 4)
(= (miter_vad_metric g32-vad 1 token_count) 4)
(= (miter_vad_metric g32-vad 0 covered_tokens) 4)
(= (miter_vad_metric g32-vad 1 covered_tokens) 4)
(= (miter_vad_metric g32-vad 0 match_count) 2)
(= (miter_vad_metric g32-vad 1 match_count) 2)
(= (miter_vad_number g32-vad 0 0 0) 0.1)
(= (miter_vad_number g32-vad 0 1 0) 0.1)
(= (miter_vad_number g32-vad 1 0 0) 0.5)
(= (miter_vad_number g32-vad 1 1 0) 0.5)
(= (miter_vad_number g32-vad $clause $index 1) 0.0)
(= (miter_vad_number g32-vad $clause $index 2) 0.0)
(= (miter_vad_prior register_band_prior) 0.2)
(= (miter_vad_prior trajectory_delta_prior) 0.1)
(= (miter_vad_prior coverage_prior) 0.5)
(= (miter_vad_contains g32-vad $text)
   (if (== $text "but") true false))
(= (miter_vad_clause_contains g32-vad $clause $text) false)

; Only these finite numeric fixture values are admitted to the current NACE probe.
(= (nn_number 0.5 frequency) true)
(= (nn_number 1 frequency) true)
(= (nn_number 0.5 confidence) true)

(= (G32VoiceProbe)
 (let* (($approval (G31LiveEffectApprovalV1 ah ph ch gh kh th))
        ($standing (G31LiveEffectApprovalStanding $approval ah ph ch gh kh th))
        ($contact (g31-live-canary-contact-v1
          (server-sha256 sh) (team-sha256 teh) (channel-sha256 coh)
          (principal-sha256 prh) (post-sha256 poh) (version-sha256 vh)
          (content-sha256 conh) (event-class posted)
          (contact-scope exact-current-event-only) (history-access false)
          (chroma-access false) (prior-memory-access false))))
  (G31CanaryVoiceCertificate $standing $contact
   "Miter received this bounded G31 canary contact. This response is certified only for the current test; it grants no ongoing access and used no history, Chroma, or prior memory."
   uh uh eh eh sh teh coh prh poh vh conh)))
(= (G32CurrentProbes)
 ((soul (SoulRationalityAudit))
  (continuity (ContinuityRNA g32-context live))
  (continuity-chroma-off (ContinuityRNA g32-context chroma-off))
  (continuity-capsule-off (ContinuityRNA g32-context capsule-off))
  (vad (VADCue g32-vad exact-then-morphology))
  (nace (NRevision (stv 0.5 0.5) (stv 1 0.5)))
  (mattermost (G30TrialStanding candidate candidate quarantined none none))
  (voice (G32VoiceProbe))
  (development (DCCompare ((edge defect observed)) ((path defect repaired))
    ((operation repair ((edge defect observed)) ((edge observed repaired)) ()) ) 2))))

; Oracle output is data. A product asking for another call cannot invoke one here.
(= (G32OracleBoundary $product $calls)
 (if (== $calls 1)
  (oracle-bounded (calls $calls) (product-standing derived-candidate) (product $product)
   (recursive-authority none))
  (oracle-boundary-violated (calls $calls))))
(= (G32ClockDisposition $pitch)
 (if (== $pitch material-pitch)
  (clock-available (movement possible) (completion not-implied))
  (clock-available (movement awaiting-contact-or-obligation)
   (model-calls 0) (effects 0) (completion not-implied) (forced-quiescence false))))

; Fixture mechanics let the actual ReactorCycleWith run 32 no-pitch waits and
; stop by an explicit test boundary. The supplied count does not mark completion.
(= (miter_reactor_input g32-zero-pitch) ())
(= (miter_reactor_config idle_base_seconds) 1)
(= (miter_reactor_config idle_cap_seconds) 16)
(= (miter_reactor_record g32-zero-pitch $kind $payload)
 (let $a (add-atom &g32trace (reactor-record $kind $payload)) reactor-recorded))
(= (miter_reactor_wait g32-zero-pitch $interval)
 (let* (($count (size-atom (collapse (match &g32trace (cycle-wait $n) $n))))
        ($add (add-atom &g32trace (cycle-wait $count))))
  (if (>= $count 31)
   (let $stop (add-atom &rna (reactor-stop requested)) input-ready)
   timeout)))
(= (G32ZeroPitchRun)
 (let* (($result (ReactorCycleWith g32-zero-pitch false 1 ReactorSelect))
        ($waits (size-atom (collapse (match &g32trace (cycle-wait $n) $n))))
        ($records (collapse (match &g32trace (reactor-record $kind $payload)
          (reactor-record $kind $payload)))))
  (zero-pitch-result $result (wait-cycles $waits) (records $records)
   (model-calls 0) (effects 0) (completion false) (interruptible true))))
