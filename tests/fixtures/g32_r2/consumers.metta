; G32 R2 current-consumer probes. Mechanical observations are fixture-owned;
; every returned semantic product below is made by the current imported consumer.
!(import! &self (library lib_import))
!(import! &self "/Users/claritymiter/miter/src/participation.metta")
!(import! &self "/Users/claritymiter/miter/src/participation_support.metta")
!(import! &soul "/Users/claritymiter/miter/constitution/soul.metta")
!(import! &self "/Users/claritymiter/miter/src/soul.metta")
!(import! &self "/Users/claritymiter/miter/src/memory.metta")
!(import! &self "/Users/claritymiter/miter/src/continuity.metta")
!(import! &self "/Users/claritymiter/miter/src/vad.metta")
!(import! &self "/Users/claritymiter/miter/src/nal_revision_v1.metta")
!(import! &self "/Users/claritymiter/miter/src/nace_v2.metta")
!(import! &self "/Users/claritymiter/miter/src/mattermost_mock_trial_v1.metta")
!(import! &self "/Users/claritymiter/miter/src/mattermost_live_canary_v1.metta")
!(bind! &rna (new-space))
!(bind! &rna_hooks (new-space))
!(bind! &g32r2trace (new-space))
!(import! &self "/Users/claritymiter/miter/src/reactor.metta")

; Exact-continuity mechanical observations.
(= (miter_resume_begin g32r2-context) restart-contact-recorded)
(= (miter_resume_field g32r2-context "text") "Where was I with the book?")
(= (miter_resume_field g32r2-context "memory_store") g32r2-memory)
(= (miter_resume_field g32r2-context "principal_scope") principal-g32r2)
(= (miter_resume_field g32r2-context "audience_scope") private-g32r2)
(= (miter_resume_field g32r2-context "query_tag") g32r2-query)
(= (miter_resume_field g32r2-context "capsule_store") g32r2-capsules)
(= (miter_resume_field g32r2-context "capsule_output") g32r2-output)
(= (miter_resume_registry_count g32r2-context "book") 1)
(= (miter_resume_registry_project g32r2-context "book") project-g32r2)
(= (miter_memory_supersession_count g32r2-memory memory-g32r2) 0)
(= (miter_memory_query g32r2-memory principal-g32r2 private-g32r2 project-g32r2 active
     "Where was I with the book?" g32r2-query) semantic-support)
(= (miter_continuity_reconstruct g32r2-capsules project-g32r2 g32r2-output) continuity-reconstructed)
(= (miter_resume_witness g32r2-context) capsule-event-verified)
(= (miter_resume_answer g32r2-context $certificate $semantic)
   (continuity-answer $certificate $semantic))

; Qualified language-cue observations. g32r2-vad-off has no lexical coverage.
(= (miter_vad_metric g32r2-vad 0 clause_count) 2)
(= (miter_vad_metric g32r2-vad 0 token_count) 4)
(= (miter_vad_metric g32r2-vad 1 token_count) 4)
(= (miter_vad_metric g32r2-vad 0 covered_tokens) 4)
(= (miter_vad_metric g32r2-vad 1 covered_tokens) 4)
(= (miter_vad_metric g32r2-vad 0 match_count) 2)
(= (miter_vad_metric g32r2-vad 1 match_count) 2)
(= (miter_vad_number g32r2-vad 0 0 0) 0.1)
(= (miter_vad_number g32r2-vad 0 1 0) 0.1)
(= (miter_vad_number g32r2-vad 1 0 0) 0.5)
(= (miter_vad_number g32r2-vad 1 1 0) 0.5)
(= (miter_vad_number g32r2-vad $clause $index 1) 0.0)
(= (miter_vad_number g32r2-vad $clause $index 2) 0.0)
(= (miter_vad_metric g32r2-vad-off 0 clause_count) 1)
(= (miter_vad_metric g32r2-vad-off 0 token_count) 4)
(= (miter_vad_metric g32r2-vad-off 0 covered_tokens) 0)
(= (miter_vad_metric g32r2-vad-off 0 match_count) 0)
(= (miter_vad_prior register_band_prior) 0.2)
(= (miter_vad_prior trajectory_delta_prior) 0.1)
(= (miter_vad_prior coverage_prior) 0.5)
(= (miter_vad_contains $id $text) false)
(= (miter_vad_clause_contains $id $clause $text) false)

; Finite numeric fixture values admitted to the current NAL revision consumer.
(= (nn_number 0 frequency) true)
(= (nn_number 0 confidence) true)
(= (nn_number 0.5 frequency) true)
(= (nn_number 0.5 confidence) true)
(= (nn_number 1 frequency) true)

(= (G32R2Voice $effectHash $expectedEffectHash)
 (let* (($approval (G31LiveEffectApprovalV1 ah ph ch gh kh th))
        ($standing (G31LiveEffectApprovalStanding $approval ah ph ch gh kh th))
        ($contact (g31-live-canary-contact-v1
          (server-sha256 sh) (team-sha256 teh) (channel-sha256 coh)
          (principal-sha256 prh) (post-sha256 poh) (version-sha256 vh)
          (content-sha256 conh) (event-class posted)
          (contact-scope exact-current-event-only) (history-access false)
          (chroma-access false) (prior-memory-access false))))
  (G31CanaryVoiceCertificate $standing $contact
   "Miter received this bounded G31 canary contact. This response is certified only for the current test; it grants no ongoing access and used no history, Chroma, or prior memory."
   uh uh $effectHash $expectedEffectHash sh teh coh prh poh vh conh)))

; Actual zero-pitch recurring consumer; explicit test stop after 32 waits.
(= (miter_reactor_input g32r2-zero-pitch) ())
(= (miter_reactor_config idle_base_seconds) 1)
(= (miter_reactor_config idle_cap_seconds) 16)
(= (miter_reactor_record g32r2-zero-pitch $kind $payload)
 (let $a (add-atom &g32r2trace (reactor-record $kind $payload)) reactor-recorded))
(= (miter_reactor_wait g32r2-zero-pitch $interval)
 (let* (($count (size-atom (collapse (match &g32r2trace (cycle-wait $n) $n))))
        ($add (add-atom &g32r2trace (cycle-wait $count))))
  (if (>= $count 31)
   (let $stop (add-atom &rna (reactor-stop requested)) input-ready)
   timeout)))
(= (G32R2ZeroPitch)
 (let* (($result (ReactorCycleWith g32r2-zero-pitch false 1 ReactorSelect))
        ($waits (size-atom (collapse (match &g32r2trace (cycle-wait $n) $n))))
        ($records (collapse (match &g32r2trace (reactor-record $kind $payload)
          (reactor-record $kind $payload)))))
  (zero-pitch-product $result (wait-cycles $waits) (records $records)
   (model-calls 0) (effects 0) (completion false) (interruptible true))))

; These wrappers expose products without assigning a pass standing.
(= (G32R2CoreProducts)
 ((soul (SoulRationalityAudit))
  (continuity (ContinuityRNA g32r2-context live))
  (chroma-severed (ContinuityRNA g32r2-context chroma-off))
  (capsule-severed (ContinuityRNA g32r2-context capsule-off))
  (vad (VADCue g32r2-vad exact-then-morphology))
  (vad-severed (VADCue g32r2-vad-off lexicon_off))
  (nace (NRevision (stv 0.5 0.5) (stv 1 0.5)))
  (consequence-severed (NRevision (stv 0.5 0.5) (stv 0 0)))
  (workshop (G30TrialStanding candidate candidate quarantined none none))
  (workshop-severed (G30TrialStanding candidate candidate quarantined prohibited none))
  (voice (G32R2Voice effect-hash effect-hash))
  (voice-severed (G32R2Voice effect-hash different-effect-hash))))
