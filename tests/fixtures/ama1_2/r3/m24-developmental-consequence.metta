!(import! &self "/Users/claritymiter/miter/src/bootstrap_assistant_v2.metta")
!(import! &self "/Users/claritymiter/miter/tests/fixtures/ama1_2/r3/authority-runtime-data.metta")

!(let* (($contact (R3ProbeRuntimeContact))
        ($grounded (CP2Encounter $contact ()))
        ($encounter (index-atom $grounded 2))
        ($joint (index-atom $grounded 1))
        ($cut (index-atom $encounter 1))
        ($movement (index-atom $encounter 5))
        ($basis (M24ProbeBasisForMovement $movement))
        ($consequence (R3ProbeConsequence (index-atom $movement 2)))
        ($next-cut (CPNextCutV2 $cut $consequence))
        ($prior (CP2M24DevelopmentalOrganization (index-atom $joint 3)))
        ($transition (M24DevelopmentalTransition $prior $basis $consequence
          (CPContactScope $contact) $next-cut))
        ($evolved (index-atom $transition 2))
        ($carrier (index-atom $evolved 1))
        ($lifecycle (M24DevelopmentalLifecycle $evolved)))
  (m24-consequence-case canonical
    (index-atom $movement 1)
    (M24ProbeBasisValid $basis)
    (M24DevelopmentalTransitionValid $transition)
    (M24DevelopmentalOrganizationValid $evolved)
    (M24LifecycleProbeStanding $lifecycle)
    (M24RetrospectiveAffordanceValid
      (index-atom (index-atom $evolved 8) 2))
    (M24BranchTransactionValid (index-atom $evolved 12))
    (size-atom (index-atom $carrier 6))
    (size-atom (index-atom $carrier 9))
    (size-atom (index-atom $carrier 10))
    (size-atom (index-atom $carrier 11))))

!(let* (($contact (R3ProbeRuntimeContact))
        ($grounded (CP2Encounter $contact ()))
        ($encounter (index-atom $grounded 2))
        ($joint (index-atom $grounded 1))
        ($cut (index-atom $encounter 1))
        ($movement (index-atom $encounter 5))
        ($basis (M24ProbeBasisForMovement $movement))
        ($wrong (R3ProbeConsequence wrong-movement))
        ($next-cut (CPNextCutV2 $cut $wrong))
        ($prior (CP2M24DevelopmentalOrganization (index-atom $joint 3)))
        ($transition (M24DevelopmentalTransition $prior $basis $wrong
          (CPContactScope $contact) $next-cut)))
  (m24-consequence-case movement-link-severed
    (M24DevelopmentalTransitionValid $transition)
    (CPShape $transition m24-developmental-transition-v1 8)))

!(let* (($contact (R3RuntimeContact))
        ($grounded (CP2Encounter $contact ()))
        ($movement (index-atom (index-atom $grounded 2) 5))
        ($basis (M24ProbeBasisForMovement $movement)))
  (m24-consequence-case non-inquiry
    (index-atom $movement 1) (M24ProbeBasisValid $basis)))
