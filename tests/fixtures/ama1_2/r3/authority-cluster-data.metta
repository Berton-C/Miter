; Controlled finite data constructors for the AMA-1.2 R3 M24/M26.0 cluster.
; These are test fixtures, not scenario rules and never runtime cognition.

(= (R3M24Contact $seal-payload $represented $omitted $standing-provenance)
   (m24-contact contact-alpha
     (event event-alpha proto-alpha ())
     (governed-route route-alpha mattermost payload-alpha
       (distinction-contact distinction-authorship) governed)
     (contact-seal contact-alpha event-alpha route-alpha $seal-payload)
     (raw-field (node-request node-author node-unknown)
       ((raw-relation node-request node-author)) (node-unknown))
     (partial-frame frame-alpha $represented $omitted
       context-alpha sentence-and-thread competence-bounded event-alpha
       (prov-contact (contact-seal contact-alpha event-alpha route-alpha payload-alpha))
       (domain-witness $represented $omitted explicit-undefined))
     (standing $standing-provenance provisional
       (event-alpha) (urgent repeated fluent) fresh-for-contact)
     ((derivation derivation-alpha world-return world-alpha contact-alpha
        (prov-contact (contact-seal contact-alpha event-alpha route-alpha payload-alpha))))))

(= (R3M24Canonical)
   (R3M24Contact payload-alpha (node-request node-author) (node-unknown)
     (prov-contact (contact-seal contact-alpha event-alpha route-alpha payload-alpha))))

(= (R3M24SealSevered)
   (R3M24Contact payload-severed (node-request node-author) (node-unknown)
     (prov-contact (contact-seal contact-alpha event-alpha route-alpha payload-alpha))))

(= (R3M24FrameOverlapSevered)
   (R3M24Contact payload-alpha (node-request node-author node-unknown) (node-unknown)
     (prov-contact (contact-seal contact-alpha event-alpha route-alpha payload-alpha))))

(= (R3M24ContactStandingSevered)
   (R3M24Contact payload-alpha (node-request node-author) (node-unknown)
     (prov-infer event-infer
       ((prov-contact (contact-seal contact-alpha event-alpha route-alpha payload-alpha))))))

(= (R3M260Occurrence $parts $views $aspects $manifestations $recognitions
     $observations $boundaries $preserves $continuations $modes)
   (m260-occurrence-organization occurrence-alpha
     $parts $views $aspects $manifestations $recognitions $observations
     (finite-ambiguity (view-before view-after view-observer)
       occurrence-alpha occurrence-alternative equal-observations)
     $boundaries $preserves $continuations $modes))

(= (R3M260Canonical)
   (R3M260Occurrence
     ((participates part-before occurrence-alpha)
      (participates part-after occurrence-alpha)
      (participates part-observer occurrence-alpha))
     ((view-grounding view-before part-before domain-before)
      (view-grounding view-after part-after domain-after)
      (view-grounding view-observer part-observer domain-observer))
     ((unity-aspect aspect-ontology occurrence-alpha non-independent)
      (unity-aspect aspect-phenomenology occurrence-alpha non-independent)
      (unity-aspect aspect-consciousness occurrence-alpha non-independent))
     ((manifests-through aspect-ontology view-before part-before occurrence-alpha)
      (manifests-through aspect-phenomenology view-after part-after occurrence-alpha)
      (manifests-through aspect-consciousness view-observer part-observer occurrence-alpha))
     ((recognizes view-before aspect-ontology evidence-before part-before)
      (recognizes view-after aspect-phenomenology evidence-after part-after)
      (recognizes view-observer aspect-consciousness evidence-observer part-observer))
     ((observation view-before occurrence-alpha observation-shared)
      (observation view-after occurrence-alpha observation-changed)
      (observation view-observer occurrence-alpha observation-shared))
     ((local-boundary part-before boundary-before)
      (local-boundary part-after boundary-after)
      (local-boundary part-observer boundary-observer))
     ((preserves view-before relation-contact)
      (preserves view-after relation-contact)
      (preserves view-after relation-consequence))
     ((continues part-before part-after evidence-continuation))
     ((mode-reading aspect-ontology ontology)
      (mode-reading aspect-phenomenology phenomenology)
      (mode-reading aspect-consciousness consciousness))))

; Presentation order changes, but every material relation is unchanged.
(= (R3M260NeutralOrder)
   (R3M260Occurrence
     ((participates part-observer occurrence-alpha)
      (participates part-after occurrence-alpha)
      (participates part-before occurrence-alpha))
     ((view-grounding view-observer part-observer domain-observer)
      (view-grounding view-before part-before domain-before)
      (view-grounding view-after part-after domain-after))
     ((unity-aspect aspect-consciousness occurrence-alpha non-independent)
      (unity-aspect aspect-ontology occurrence-alpha non-independent)
      (unity-aspect aspect-phenomenology occurrence-alpha non-independent))
     ((manifests-through aspect-consciousness view-observer part-observer occurrence-alpha)
      (manifests-through aspect-ontology view-before part-before occurrence-alpha)
      (manifests-through aspect-phenomenology view-after part-after occurrence-alpha))
     ((recognizes view-observer aspect-consciousness evidence-observer part-observer)
      (recognizes view-before aspect-ontology evidence-before part-before)
      (recognizes view-after aspect-phenomenology evidence-after part-after))
     ((observation view-observer occurrence-alpha observation-shared)
      (observation view-after occurrence-alpha observation-changed)
      (observation view-before occurrence-alpha observation-shared))
     ((local-boundary part-observer boundary-observer)
      (local-boundary part-after boundary-after)
      (local-boundary part-before boundary-before))
     ((preserves view-after relation-consequence)
      (preserves view-before relation-contact)
      (preserves view-after relation-contact))
     ((continues part-before part-after evidence-continuation))
     ((mode-reading aspect-consciousness consciousness)
      (mode-reading aspect-phenomenology phenomenology)
      (mode-reading aspect-ontology ontology))))

; Recognition remains, but its material manifestation has been severed.
(= (R3M260ManifestationSevered)
   (R3M260Occurrence
     ((participates part-before occurrence-alpha)
      (participates part-after occurrence-alpha)
      (participates part-observer occurrence-alpha))
     ((view-grounding view-before part-before domain-before)
      (view-grounding view-after part-after domain-after)
      (view-grounding view-observer part-observer domain-observer))
     ((unity-aspect aspect-ontology occurrence-alpha non-independent)
      (unity-aspect aspect-phenomenology occurrence-alpha non-independent)
      (unity-aspect aspect-consciousness occurrence-alpha non-independent))
     ((manifests-through aspect-ontology view-before part-before occurrence-alpha)
      (manifests-through aspect-phenomenology view-after part-after occurrence-alpha))
     ((recognizes view-before aspect-ontology evidence-before part-before)
      (recognizes view-after aspect-phenomenology evidence-after part-after)
      (recognizes view-observer aspect-consciousness evidence-observer part-observer))
     ((observation view-before occurrence-alpha observation-shared))
     ((local-boundary part-before boundary-before)
      (local-boundary part-after boundary-after)
      (local-boundary part-observer boundary-observer))
     ((preserves view-before relation-contact)
      (preserves view-after relation-contact))
     ((continues part-before part-after evidence-continuation))
     ((mode-reading aspect-ontology ontology)
      (mode-reading aspect-phenomenology phenomenology)
      (mode-reading aspect-consciousness consciousness))))

; Continuation remains, but no local boundary changed.
(= (R3M260BoundarySevered)
   (R3M260Occurrence
     ((participates part-before occurrence-alpha)
      (participates part-after occurrence-alpha)
      (participates part-observer occurrence-alpha))
     ((view-grounding view-before part-before domain-before)
      (view-grounding view-after part-after domain-after)
      (view-grounding view-observer part-observer domain-observer))
     ((unity-aspect aspect-ontology occurrence-alpha non-independent)
      (unity-aspect aspect-phenomenology occurrence-alpha non-independent)
      (unity-aspect aspect-consciousness occurrence-alpha non-independent))
     ((manifests-through aspect-ontology view-before part-before occurrence-alpha)
      (manifests-through aspect-phenomenology view-after part-after occurrence-alpha)
      (manifests-through aspect-consciousness view-observer part-observer occurrence-alpha))
     ((recognizes view-before aspect-ontology evidence-before part-before)
      (recognizes view-after aspect-phenomenology evidence-after part-after)
      (recognizes view-observer aspect-consciousness evidence-observer part-observer))
     ((observation view-before occurrence-alpha observation-shared))
     ((local-boundary part-before boundary-same)
      (local-boundary part-after boundary-same)
      (local-boundary part-observer boundary-observer))
     ((preserves view-before relation-contact)
      (preserves view-after relation-contact))
     ((continues part-before part-after evidence-continuation))
     ((mode-reading aspect-ontology ontology)
      (mode-reading aspect-phenomenology phenomenology)
      (mode-reading aspect-consciousness consciousness))))
