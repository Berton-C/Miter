;; ===== SECTION 3: NAL Inheritance Links =====
;; Inductive generalizations: cells inherit from valence superclass

(= (vad-inherits (VADCell mid high high)) (ValenceSuperclass mid))
(= (vad-inherits (VADCell mid high low)) (ValenceSuperclass mid))
(= (vad-inherits (VADCell mid high mid)) (ValenceSuperclass mid))
(= (vad-inherits (VADCell mid low high)) (ValenceSuperclass mid))
(= (vad-inherits (VADCell mid low low)) (ValenceSuperclass mid))
(= (vad-inherits (VADCell mid low mid)) (ValenceSuperclass mid))
(= (vad-inherits (VADCell mid mid high)) (ValenceSuperclass mid))
(= (vad-inherits (VADCell mid mid low)) (ValenceSuperclass mid))
(= (vad-inherits (VADCell mid mid mid)) (ValenceSuperclass mid))
(= (vad-inherits (VADCell neg high high)) (ValenceSuperclass neg))
(= (vad-inherits (VADCell neg high low)) (ValenceSuperclass neg))
(= (vad-inherits (VADCell neg high mid)) (ValenceSuperclass neg))
(= (vad-inherits (VADCell neg low high)) (ValenceSuperclass neg))
(= (vad-inherits (VADCell neg low low)) (ValenceSuperclass neg))
(= (vad-inherits (VADCell neg low mid)) (ValenceSuperclass neg))
(= (vad-inherits (VADCell neg mid high)) (ValenceSuperclass neg))
(= (vad-inherits (VADCell neg mid low)) (ValenceSuperclass neg))
(= (vad-inherits (VADCell neg mid mid)) (ValenceSuperclass neg))
(= (vad-inherits (VADCell pos high high)) (ValenceSuperclass pos))
(= (vad-inherits (VADCell pos high low)) (ValenceSuperclass pos))
(= (vad-inherits (VADCell pos high mid)) (ValenceSuperclass pos))
(= (vad-inherits (VADCell pos low high)) (ValenceSuperclass pos))
(= (vad-inherits (VADCell pos low low)) (ValenceSuperclass pos))
(= (vad-inherits (VADCell pos low mid)) (ValenceSuperclass pos))
(= (vad-inherits (VADCell pos mid high)) (ValenceSuperclass pos))
(= (vad-inherits (VADCell pos mid low)) (ValenceSuperclass pos))
(= (vad-inherits (VADCell pos mid mid)) (ValenceSuperclass pos))

;; ===== SECTION 4: Abductive Tone Inference =====
;; Given observed words, abduce most likely VAD cell

(= (abduce-tone-from-word actuate) (Tone intense))
(= (abduce-tone-from-word fiercely) (Tone intense))
(= (abduce-tone-from-word forcefully) (Tone intense))
