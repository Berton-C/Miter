;; lib_vad.metta — Expanded VAD Routing Library
;; Generated from NRC VAD Lexicon v2.1 (54801 words)
;; All 27 VAD cells mapped via induction + abduction
;; Valence: neg/mid/pos  Arousal: low/mid/high  Dominance: low/mid/high

;; ===== SECTION 1: VAD Route Rules (27 cells) =====

;; Cell (mid,high,high) — 2585 words — forceful-neutral
(= (vad-route (ValenceLevel mid) (ArousalLevel high) (DominanceLevel high))
   (VADState (Tone intense) (Strategy channel-energy) (Label forceful-neutral)))

;; Cell (mid,high,low) — 492 words — chaotic-neutral
(= (vad-route (ValenceLevel mid) (ArousalLevel high) (DominanceLevel low))
   (VADState (Tone scattered) (Strategy ground-and-focus) (Label chaotic-neutral)))

;; Cell (mid,high,mid) — 814 words — excited-neutral
(= (vad-route (ValenceLevel mid) (ArousalLevel high) (DominanceLevel mid))
   (VADState (Tone animated) (Strategy ride-momentum) (Label excited-neutral)))

;; Cell (mid,low,high) — 1368 words — steady-resolve
(= (vad-route (ValenceLevel mid) (ArousalLevel low) (DominanceLevel high))
   (VADState (Tone unwavering) (Strategy affirm-stability) (Label steady-resolve)))

;; Cell (mid,low,low) — 2307 words — inert-neutral
(= (vad-route (ValenceLevel mid) (ArousalLevel low) (DominanceLevel low))
   (VADState (Tone still) (Strategy slow-activation) (Label inert-neutral)))

;; Cell (mid,low,mid) — 1628 words — quiet-mundane
(= (vad-route (ValenceLevel mid) (ArousalLevel low) (DominanceLevel mid))
   (VADState (Tone placid) (Strategy paced-engagement) (Label quiet-mundane)))

;; Cell (mid,mid,high) — 1364 words — authoritative-neutral
(= (vad-route (ValenceLevel mid) (ArousalLevel mid) (DominanceLevel high))
   (VADState (Tone measured) (Strategy structured-guidance) (Label authoritative-neutral)))

;; Cell (mid,mid,low) — 761 words — passive-neutral
(= (vad-route (ValenceLevel mid) (ArousalLevel mid) (DominanceLevel low))
   (VADState (Tone subdued) (Strategy gentle-uplift) (Label passive-neutral)))

;; Cell (mid,mid,mid) — 1439 words — flat-neutral
(= (vad-route (ValenceLevel mid) (ArousalLevel mid) (DominanceLevel mid))
   (VADState (Tone neutral) (Strategy calibrated-mirroring) (Label flat-neutral)))

;; Cell (neg,high,high) — 3463 words — aggressive-dominance
(= (vad-route (ValenceLevel neg) (ArousalLevel high) (DominanceLevel high))
   (VADState (Tone confrontational) (Strategy assert-boundaries) (Label aggressive-dominance)))

