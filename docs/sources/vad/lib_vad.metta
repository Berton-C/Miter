;; Cell (neg,high,mid) — 1529 words — agitated-distress
(= (vad-route (ValenceLevel neg) (ArousalLevel high) (DominanceLevel mid))
   (VADState (Tone alarmed) (Strategy empathic-attunement) (Label agitated-distress)))

