; SC07: expressive constructions are reusable data, never defect/action rules.
; Source-grounded intention, independently read meaning and joint participation
; determine which compositions are possible. No list-order semantic winner.
(= (VAll $xs $ys) (DSubset $xs $ys 0))
(= (VSame $xs $ys) (and (VAll $xs $ys) (VAll $ys $xs)))
(= (VWanted $i) (RClaimSet (index-atom $i 4)))
(= (VMissing $wanted $covered)
 (collapse (let $w (superpose $wanted) (if (PHas $w $covered 0) (empty) $w))))
(= (VName $i $entity)
 (let $names (RModelNames $i)
  (let $rows (collapse (let $n (superpose $names)
   (if (== (index-atom $n 3) $entity) (index-atom $n 1) (empty))))
   (if (== (size-atom $rows) 1) (index-atom $rows 0) unresolved-name))))
(= (VVerb $role)
 (if (== $role choice) choose (if (== $role inspection) inspect (if (== $role recovery) restore unresolved-role))))
(= (VJoinVerbs $claims $n)
 (if (< $n (size-atom $claims))
  (let* (($verb (VVerb (index-atom (index-atom $claims $n) 3))) ($tail (VJoinVerbs $claims (+ $n 1))))
   (if (== (size-atom $tail) 0) ($verb) (cons-atom $verb (cons-atom and $tail)))) ()))
(= (VSlot $i $claims $slot)
 (let $first (index-atom $claims 0)
  (if (== $slot artifact) ((VName $i (index-atom $i 3)))
   (if (PShape $first retain 5)
    (if (== $slot person) ((VName $i (index-atom $first 2)))
     (if (== $slot verbs) (VJoinVerbs $claims 0)
      (if (== $slot verb) (if (== (size-atom $claims) 1) (VJoinVerbs $claims 0) (unresolved-group)) (unresolved-slot))))
    (unresolved-slot)))))
(= (VWords $i $claims $tokens $n)
 (if (< $n (size-atom $tokens))
  (let* (($t (index-atom $tokens $n)) ($tail (VWords $i $claims $tokens (+ $n 1))))
   (if (== (index-atom $t 0) literal) (cons-atom (index-atom $t 1) $tail)
    (union-atom (VSlot $i $claims (index-atom $t 1)) $tail))) ()))
(= (VTokenValid $t)
 (if (PShape $t literal 2) (vc_word (index-atom $t 1))
  (if (PShape $t slot 2) (PHas (index-atom $t 1) (artifact person verb verbs) 0) false)))
(= (VTokensValid $tokens $n)
 (if (< $n (size-atom $tokens))
  (and (VTokenValid (index-atom $tokens $n)) (VTokensValid $tokens (+ $n 1))) true))
(= (VConstructionValid $c)
 (if (PShape $c construction 4)
  (if (is-expr (index-atom $c 3))
   (and (PHas (index-atom $c 2) (reported-request retain completion) 0)
    (and (> (size-atom (index-atom $c 3)) 0)
     (and (<= (size-atom (index-atom $c 3)) 24) (VTokensValid (index-atom $c 3) 0)))) false) false))
(= (VConstructionsValid $cs $n $seen)
 (if (< $n (size-atom $cs))
  (let $c (index-atom $cs $n)
   (if (VConstructionValid $c)
    (and (not (PHas (index-atom $c 1) $seen 0))
     (VConstructionsValid $cs (+ $n 1) (cons-atom (index-atom $c 1) $seen))) false)) true))
(= (VModuleValid $id $m)
 (if (PShape $m voice-realization 7)
  (if (and (== (index-atom $m 1) miter-voice-realization-v2) (== (index-atom $m 2) $id))
   (if true
    (if (== (index-atom $m 6) ())
     (let $cs (index-atom $m 4)
      (if (is-expr $cs)
       (if (and (> (size-atom $cs) 0) (<= (size-atom $cs) 8))
        (if (VConstructionsValid $cs 0 ()) module-valid invalid-construction) invalid-constructions) invalid-constructions))
     forbidden-effect) forbidden-write) wrong-schema-or-id) malformed-schema))
(= (VQuarantine $id $m $binding)
 (let $valid (VModuleValid $id $m)
  (if (== $valid module-valid)
   (if (== $binding model-candidate-bound)
    (let $old (collapse (match &trial (trial-voice-realization $id $previous) $previous))
     (if (== (size-atom $old) 0)
      (let $write (add-atom &trial (trial-voice-realization $id $m)) candidate-quarantined) duplicate-trial-id))
    unproven-candidate-lineage) $valid)))
; Every nonempty subset of same-actor/artifact retentions is a potential
; grammatical binding, not a preselected behavioral response.
(= (VSubsets $xs $n)
 (if (< $n (size-atom $xs))
  (let* (($tail (VSubsets $xs (+ $n 1))) ($with (cons-atom (index-atom $xs $n) $tail)))
   (superpose ($tail $with))) ()))
(= (VGroup $claims $first $n)
 (if (< $n (size-atom $claims))
  (let $c (index-atom $claims $n)
   (and (== (index-atom $c 0) retain)
    (and (== (index-atom $c 1) (index-atom $first 1))
     (and (== (index-atom $c 2) (index-atom $first 2)) (VGroup $claims $first (+ $n 1)))))) true))
(= (VBindings $wanted $category)
 (if (== $category retain)
  (let $claims (VSubsets $wanted 0)
   (if (> (size-atom $claims) 0)
    (if (VGroup $claims (index-atom $claims 0) 0) $claims (empty)) (empty)))
  (let $claim (superpose $wanted)
   (if (== (index-atom $claim 0) $category) ($claim) (empty)))))
(= (VReadMatches $readings $claims)
 (and (== (size-atom (RUnresolved $readings)) 0)
  (VSame (RClaimSet (RMeaningUses $readings)) $claims)))
(= (VFragment $i $construction $claims)
 (let* (($words (VWords $i $claims (index-atom $construction 3) 0))
        ($text (vc_sentence $words)) ($readings (RReadAll $i ($text) 0)))
  (if (VReadMatches $readings $claims)
   (expression-fragment (index-atom $construction 1) $claims $text (readings $readings))
   (unqualified-fragment (index-atom $construction 1) $claims $text (readings $readings)))))
(= (VFragments $i $constructions)
 (collapse (let $c (superpose $constructions)
  (let $claims (VBindings (VWanted $i) (index-atom $c 2)) (VFragment $i $c $claims)))))
(= (VQualified $fragments)
 (collapse (let $f (superpose $fragments) (if (PShape $f expression-fragment 5) $f (empty)))))
(= (VOverlap $xs $ys)
 (PHas true (collapse (let $x (superpose $xs) (PHas $x $ys 0))) 0))
(= (VTail $xs) (cdr-atom $xs))
(= (VExtend $covered $chosen $f)
 (search-state (SUnion $covered (index-atom $f 2) 0) (cons-atom $f $chosen)))
(= (VChildren $fragments $missing $covered $chosen)
 (collapse (let $f (superpose $fragments)
  (if (and (PHas (index-atom $missing 0) (index-atom $f 2) 0)
       (not (VOverlap (index-atom $f 2) $covered)))
   (VExtend $covered $chosen $f) (empty)))))
; Fuel counts actual agenda expansions across all branches, not per-path depth.
(= (VExplore $wanted $fragments $agenda $finished $fuel)
 (if (== (size-atom $agenda) 0) (search-result $finished ())
  (if (<= $fuel 0) (search-result $finished $agenda)
   (let* (($s (index-atom $agenda 0)) ($rest (VTail $agenda))
          ($covered (index-atom $s 1)) ($chosen (index-atom $s 2))
          ($missing (VMissing $wanted $covered)))
    (if (== (size-atom $missing) 0)
     (VExplore $wanted $fragments $rest (cons-atom (composition $chosen) $finished) (- $fuel 1))
     (let $children (VChildren $fragments $missing $covered $chosen)
      (if (== (size-atom $children) 0)
       (VExplore $wanted $fragments $rest (cons-atom (construction-gap $missing $chosen) $finished) (- $fuel 1))
       (VExplore $wanted $fragments (union-atom $children $rest) $finished (- $fuel 1)))))))))
; Joint expression conditions are scoped source relations, never module rules.
(= (VJointRead $frame $i $node)
 (let $payload (index-atom $node 6)
  (if (PShape $payload coexpress 3)
   (if (== (index-atom $payload 1) (index-atom $i 3))
    (let $claims (index-atom $payload 2)
     (if (is-expr $claims)
      (if (and (> (size-atom $claims) 1) (VAll $claims (VWanted $i)))
       (let $proof (SupportFor (index-atom $frame 1) (index-atom $frame 2)
           (index-atom $frame 3) (index-atom $frame 4) (index-atom $node 1) ())
        (if (PShape $proof supported 4)
         (if (and (> (size-atom (index-atom $proof 3)) 0) (SHumanRoots (index-atom $proof 3) 0))
          (joint-expression $claims $proof) (ignored-context $proof))
         (if (and (== (index-atom $node 2) human-confirmation) (SScope (index-atom $frame 1) $node))
          (unresolved-context $proof) (ignored-context $proof))))
       (irrelevant-context $payload)) (unresolved-context malformed-joint))) (irrelevant-context $payload))
   (irrelevant-context not-coexpression))))
(= (VJoints $frame $i)
 (let $nodes (index-atom $frame 2)
  (collapse (let $n (superpose $nodes)
   (if (SNodeShape $n)
    (if (PShape (index-atom $n 6) coexpress 3) (VJointRead $frame $i $n) (empty)) (empty))))))
(= (VJointMet $joint $fragments)
 (PHas true (collapse (let $f (superpose $fragments) (VAll (index-atom $joint 1) (index-atom $f 2)))) 0))
(= (VJointMisses $joints $fragments)
 (collapse (let $j (superpose $joints)
  (if (PShape $j joint-expression 3) (if (VJointMet $j $fragments) (empty) $j) (empty)))))
(= (VCompare $i $joints $composition)
 (if (PShape $composition composition 2)
  (let* (($fragments (index-atom $composition 1))
         ($text (collapse (let $f (superpose $fragments) (index-atom $f 3))))
         ($readings (RReadAll $i $text 0)) ($joint-misses (VJointMisses $joints $fragments))
         ($audit (RAudit $i (index-atom $i 2) (index-atom $i 2) $text)))
   (if (and (VReadMatches $readings (VWanted $i)) (== (size-atom $joint-misses) 0))
    (supported-expression $text $fragments (audit $audit) (joint-basis $joints))
    (unsupported-composition $text $fragments (audit $audit) (unmet-joint $joint-misses)))) $composition))
(= (VConstructBound $frame $module $fuel)
 (let $i (RIntend expression (DGround $frame))
  (if (PShape $i voice-intention 7)
   (if (== (VModuleValid (index-atom $module 2) $module) module-valid)
    (if (and (<= (size-atom (VWanted $i)) 8) (vc_budget $fuel))
     (let* (($fragments (VFragments $i (index-atom $module 4))) ($qualified (VQualified $fragments))
            ($joints (VJoints $frame $i)))
      (if (<= (size-atom $qualified) 128)
       (let* (($search (VExplore (VWanted $i) $qualified ((search-state () ())) () $fuel))
              ($compositions (index-atom $search 1)) ($pending (index-atom $search 2))
              ($done (collapse (let $c (superpose $compositions) (VCompare $i $joints $c))))
              ($frontier (collapse (let $s (superpose $pending)
               (construction-frontier (VMissing (VWanted $i) (index-atom $s 1)) (index-atom $s 2)))))
              ($compared (union-atom $done $frontier)))
        (expression-construction $i (fragments $fragments) (joint-context $joints) (compared $compared)))
       (construction-incomplete fragment-capacity $i)))
     (construction-incomplete search-grant $i))
    (construction-rejected (VModuleValid (index-atom $module 2) $module)))
   (construction-inquiry $i))))
(= (VConstruct $frame $module $fuel)
 (if (PShape $module voice-realization 7) (VConstructBound $frame $module $fuel)
  (construction-rejected malformed-schema)))
(= (VEligible $result)
 (if (PShape $result expression-construction 5)
  (let* (($joints (index-atom (index-atom $result 3) 1)) ($rows (index-atom (index-atom $result 4) 1))
         ($unresolved (collapse (let $j (superpose $joints) (if (PShape $j unresolved-context 2) $j (empty))))))
   (if (> (size-atom $unresolved) 0) (expression-context-incomplete $unresolved)
    (let* (($options (collapse (let $r (superpose $rows) (if (PShape $r supported-expression 5) $r (empty)))))
           ($frontier (collapse (let $r (superpose $rows) (if (PShape $r construction-frontier 3) $r (empty))))))
     (if (> (size-atom $frontier) 0) (expression-search-incomplete $options $frontier)
      (if (> (size-atom $options) 0) (supported-expression-alternatives $options no-emission-authority)
       (expression-inquiry (unavailable-composition $rows))))))) $result))
(= (VTrialConstruct $id $frame $fuel)
 (let $rows (collapse (match &trial (trial-voice-realization $id $module) $module))
  (if (== (size-atom $rows) 1) (VConstruct $frame (index-atom $rows 0) $fuel) trial-unavailable)))
(= (VGeneration $id $opportunity $frame)
 (let* (($i (RIntend expression (DGround $frame))) ($js (VJoints $frame $i))
        ($joint-claims (collapse (let $j (superpose $js) (if (PShape $j joint-expression 3) (index-atom $j 1) (empty))))))
  (expression-generation $id (index-atom $opportunity 2) qwen-local (index-atom (index-atom $opportunity 8) 1)
   (opportunity $opportunity) (parent voice-realization-seed-v2) (constructive-context (VWanted $i) $joint-claims)
   (instruction "Propose a reusable expressive-capability module, not a policy deciding what Miter should do. Return the supplied v2 JSON schema. Copy candidate_id exactly. Supply constructions for reported-request, retain and completion, using token arrays of individual lowercase words and typed slots @artifact, @person, @verb or @verbs. @verb binds one retained participation; @verbs can coordinate a related group using and. The seed cannot express grouped participations in one clause. Propose a way to express the source-grounded joint participations supplied in the context. This is a finite grammar experiment: recognized surface forms include you requested revision of @artifact; the requested change is to revise @artifact; @person must remain able to @verbs @artifact; the change must keep @person able to @verbs @artifact; the revision of @artifact is complete. Use separate tokens, without punctuation; sentence punctuation is supplied mechanically. These grammatical resources do not select behavior. No defect/action rules, default action, priority, evaluator, code or external effects. A declared meaning is only your proposal; native interpretation must independently establish it. Miter constructs and compares possibilities, and you cannot decide which should be used. Keep this bounded and reusable across names and role combinations.")
   (allowed-writes (trial-expression)) (allowed-effects ()))))
(= (VWait $root $id $scope $frame)
 (if (== (vc_control $root) (control $id $scope stop))
  (let* (($c (vc_cancel $root)) ($saved (vc_save $root cancellation (cancellation-requested $c))))
   (cancellation-requested $c $saved))
  (let $state (vc_poll $root)
   (if (== $state pending) (let $wait (vc_pace 0.01) (VWait $root $id $scope $frame))
    (if (== $state candidate-available)
     (let* (($m (vc_candidate $root)) ($bound (vc_binding $root)) ($before (vc_snapshot $root before))
            ($admitted (VQuarantine $id $m $bound)) ($after (vc_snapshot $root after))
            ($constructed (VTrialConstruct $id $frame 256)) ($eligible (VEligible $constructed))
            ($saved (vc_save $root result (quarantine-construction-result $admitted $m $bound $constructed $eligible))))
      (quarantine-construction-result $admitted $saved))
     (let $saved (vc_save $root result (development-transport-incomplete $state))
      (development-transport-incomplete $state $saved)))))))
(= (VRun $root $id $frame $records $surfaces $grant)
 (let* (($scope (index-atom $frame 1)) ($o (DOpportunity $id $scope $records $surfaces $grant))
        ($rna (DDevelop $o)) ($stored (vc_save $root opportunity $o)) ($stored-rna (vc_save $root develop $rna)))
  (if (and (== $stored stored) (== $stored-rna stored))
   (if (PShape $rna develop-rna 5)
    (let $started (vc_start $root (VGeneration $id $o $frame))
     (if (== $started worker-started) (VWait $root $id $scope $frame) (development-transport-incomplete $started))) $rna)
   (development-storage-incomplete $stored $stored-rna))))
