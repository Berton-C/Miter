; Native trial consequences are recomputable source-bound observations.
; Case identifiers identify evidence, never select an answer or behavior.
(= (TVCaseValid $c)
 (if (PShape $c trial-case 4)
  (and (PShape (index-atom $c 2) voice-frame 9) (vc_budget (index-atom $c 3))) false))
(= (TVManifestValid $cases $n $seen)
 (if (< $n (size-atom $cases))
  (let $c (index-atom $cases $n)
   (if (TVCaseValid $c)
    (and (not (PHas (index-atom $c 1) $seen 0))
     (TVManifestValid $cases (+ $n 1) (cons-atom (index-atom $c 1) $seen))) false))
  (> (size-atom $seen) 0)))
(= (TVObserve $case $module)
 (let $r (VConstruct (index-atom $case 2) $module (index-atom $case 3))
  (trial-observation $case $r (VEligible $r))))
(= (TVObserveAll $cases $module $n)
 (if (< $n (size-atom $cases))
  (cons-atom (TVObserve (index-atom $cases $n) $module) (TVObserveAll $cases $module (+ $n 1))) ()))
(= (TVReport $cases $module $pins)
 (if (and (TVManifestValid $cases 0 ()) (== (VModuleValid (index-atom $module 2) $module) module-valid))
  (trial-report $module $pins (TVObserveAll $cases $module 0))
  (trial-report-invalid invalid-input)))
(= (TVFind $case $rows)
 (collapse (let $r (superpose $rows)
  (if (PShape $r trial-observation 4)
   (if (== (index-atom $r 1) $case) $r (empty)) (empty)))))
(= (TVCheckRows $cases $module $rows $n)
 (if (< $n (size-atom $cases))
  (let* (($case (index-atom $cases $n)) ($found (TVFind $case $rows)))
   (if (== (size-atom $found) 1)
    (and (== (index-atom $found 0) (TVObserve $case $module)) (TVCheckRows $cases $module $rows (+ $n 1))) false)) true))
(= (TVReportValid $cases $module $pins $r)
 (if (PShape $r trial-report 4)
  (and (== (index-atom $r 1) $module)
   (and (== (index-atom $r 2) $pins)
    (and (== (size-atom (index-atom $r 3)) (size-atom $cases))
     (TVCheckRows $cases $module (index-atom $r 3) 0)))) false))
(= (TVAvailable $o) (PShape (index-atom $o 3) supported-expression-alternatives 3))
(= (TVStanding $o) (index-atom (index-atom $o 3) 0))
; A missing expression is assessable only with a fully grounded completed search.
; Unknown input, stale context or unfinished search is not negative evidence.
(= (TVAssessable $o)
 (or (TVAvailable $o) (== (TVStanding $o) expression-inquiry)))
(= (TVCompareOne $case $parent $candidate)
 (let* (($p (index-atom (TVFind $case $parent) 0)) ($c (index-atom (TVFind $case $candidate) 0)))
  (case-consequence (index-atom $case 1)
   (if (and (TVAssessable $p) (TVAssessable $c))
    (if (TVAvailable $p)
     (if (TVAvailable $c) capability-retained material-loss)
     (if (TVAvailable $c) capability-expanded capability-unavailable))
    (if (== (TVStanding $p) (TVStanding $c)) unresolved-preserved standing-changed))
   (parent-standing (TVStanding $p)) (candidate-standing (TVStanding $c))
   (source-case $case))))
(= (TVCompareAll $cases $parent $candidate $n)
 (if (< $n (size-atom $cases))
  (cons-atom (TVCompareOne (index-atom $cases $n) $parent $candidate)
   (TVCompareAll $cases $parent $candidate (+ $n 1))) ()))
(= (TVOfKind $rows $kind)
 (collapse (let $r (superpose $rows) (if (== (index-atom $r 2) $kind) $r (empty)))))
(= (TVMaterialLosses $rows) ())
(= (TVDecision $parent $candidate $pins $rows)
 (let* (($losses (TVMaterialLosses $rows)) ($changed (TVOfKind $rows standing-changed))
        ($gains (TVOfKind $rows capability-expanded)))
  (if (and (== (size-atom $losses) 0) (== (size-atom $changed) 0))
   (if (> (size-atom $gains) 0)
    (trial-admissible $parent $candidate $pins (consequences $rows) (expansion $gains))
    (trial-not-admitted no-demonstrated-expansion (consequences $rows)))
   (trial-not-admitted (non-compensatory-loss $losses $changed) (consequences $rows)))))
(= (TVAdjudicate $cases $parent $candidate $pins $pr $cr)
 (if (and (TVManifestValid $cases 0 ())
      (and (== (VModuleValid (index-atom $parent 2) $parent) module-valid)
       (== (VModuleValid (index-atom $candidate 2) $candidate) module-valid)))
  (if (and (TVReportValid $cases $parent $pins $pr) (TVReportValid $cases $candidate $pins $cr))
   (TVDecision $parent $candidate $pins (TVCompareAll $cases (index-atom $pr 3) (index-atom $cr 3) 0))
   (trial-not-admitted invalid-or-stale-trial-evidence))
  (trial-not-admitted invalid-module-or-manifest)))
; Both mechanical identities and native derivation must survive up to commit.
; Only this native writer can stage the exact typed intent consumed by tv_commit.
(= (TVAuthorize $decision $authority)
 (if (PShape $decision trial-admissible 6)
  (if (== $authority (trial-authority record-and-activate)) $decision
   (trial-not-admitted activation-not-authorized (quality-derivation $decision))) $decision))
(= (TVStage $root $intent)
 (let $old (collapse (match &derived (pending-trial-commit $root $previous) $previous))
  (if (== (size-atom $old) 0)
   (let $write (add-atom &derived (pending-trial-commit $root $intent)) trial-intent-staged)
   (if (== $old ($intent)) trial-intent-staged trial-intent-conflict))))
(= (TVExecute $root)
 (let* (($inputs (tv_input $root input)) ($parent (tv_module $root parent))
        ($candidate (tv_module $root candidate)) ($cases (index-atom $inputs 1))
        ($pins (index-atom $inputs 2)) ($pr (tv_input $root parent-report))
        ($cr (tv_input $root candidate-report)) ($identity (tv_verify $root)))
  (if (== $identity trial-inputs-bound)
   (let* (($quality (TVAdjudicate $cases $parent $candidate $pins $pr $cr))
          ($decision (TVAuthorize $quality (tv_authority $root)))
          ($intent (development-intent $root $parent $candidate $pins $decision (trial-evidence (tv_identity $root))))
          ($staged (TVStage $root $intent))
          ($saved (if (== $staged trial-intent-staged) (tv_commit $root $intent) $staged)))
    (if (== $saved development-durable)
     (let $active (TVHydrate $root (tv_restore $root)) (trial-executed $decision $saved $active))
     (trial-persistence-incomplete $decision $saved)))
   (trial-not-admitted $identity))))
(= (TVHydrate $root $receipt)
 (if (and (PShape $receipt durable-development 2) (== $receipt (tv_restore $root)))
  (let $intent (index-atom $receipt 1)
   (if (PShape $intent development-intent 7)
    (if (== (index-atom $intent 1) $root)
     (let $decision (index-atom $intent 5)
      (if (PShape $decision trial-admissible 6)
       (let* (($parent (index-atom $intent 2)) ($candidate (index-atom $intent 3)) ($pins (index-atom $intent 4))
              ($old (collapse (match &derived (active-voice-v2 $root $p $c $pin) ($p $c $pin)))))
        (if (== (size-atom $old) 0)
         (let $write (add-atom &derived (active-voice-v2 $root $parent $candidate $pins)) active-projection-restored)
         (if (== $old (($parent $candidate $pins))) active-projection-present active-projection-conflict)))
       rejected-development-retained)) wrong-development-scope) malformed-development-receipt)) $receipt))
(= (TVActiveConstruct $root $frame $fuel)
 (let $rows (collapse (match &derived (active-voice-v2 $root $parent $candidate $pins) $candidate))
  (if (== (size-atom $rows) 1) (VEligible (VConstruct $frame (index-atom $rows 0) $fuel)) active-module-unavailable)))
