       (miter_memory_index $root $id $standing))))
[33m--> prolog clause -->
[32m'IndexAdmittedMemoryRNA'(A, B, C) :-
    D=E,
    'MemoryStanding'(A, B, E),
    ==(D, malformed, F),
    (   F==true
    ->  C='memory-integrity-failed'
    ;   miter_memory_index(A, B, D, C)
    ).
