[36m(= (MemoryTypeAllowed $kind)
   (or (or (== $kind project-checkpoint) (== $kind relationship-preference))
       (or (or (== $kind fact) (== $kind decision))
           (or (or (== $kind commitment) (== $kind episode))
               (or (or (== $kind relationship) (== $kind open-question))
                   (or (== $kind learned-procedure) (== $kind developmental-trace)))))))
[33m--> prolog clause -->
[32m'MemoryTypeAllowed'(A, B) :-
    ==(A, 'project-checkpoint', C),
    ==(A, 'relationship-preference', D),
    or(C, D, E),
    ==(A, fact, F),
    ==(A, decision, G),
    or(F, G, H),
    ==(A, commitment, I),
    ==(A, episode, J),
    or(I, J, K),
    ==(A, relationship, L),
    ==(A, 'open-question', M),
    or(L, M, N),
    ==(A, 'learned-procedure', O),
    ==(A, 'developmental-trace', P),
    or(O, P, Q),
    or(N, Q, R),
    or(K, R, S),
    or(H, S, T),
    or(E, T, B).
[33m^^^^^^^^^^^^^^^^^^^^^^
[0m[33m--> metta function -->
[36m(= (MemoryAdmission $kind $durability $provenance $source)
   (if (== $durability transient) rejected-transient
     (if (== $source sources-verified)
       (if (== $durability durable)
         (if (MemoryTypeAllowed $kind)
           (if (or (== $provenance direct-contact) (== $provenance capsule-derived))
             admitted rejected-provenance)
           rejected-type)
         rejected-durability)
       rejected-source)))
[33m--> prolog clause -->
[32m'MemoryAdmission'(A, B, C, D, E) :-
    ==(B, transient, F),
    (   F==true
    ->  E='rejected-transient'
    ;   ==(D, 'sources-verified', G),
        (   G==true
        ->  ==(B, durable, H),
            (   H==true
            ->  'MemoryTypeAllowed'(A, I),
                (   I==true
                ->  ==(C, 'direct-contact', J),
                    ==(C, 'capsule-derived', K),
                    or(J, K, L),
                    (   L==true
                    ->  E=admitted
                    ;   E='rejected-provenance'
                    )
                ;   E='rejected-type'
                )
            ;   E='rejected-durability'
            )
        ;   E='rejected-source'
        )
    ).
