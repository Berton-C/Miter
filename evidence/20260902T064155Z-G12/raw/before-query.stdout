[36m(= (IndexAdmittedMemoryRNA $root $id)
   (let $standing (MemoryStanding $root $id)
     (if (== $standing malformed) memory-integrity-failed
       (miter_memory_index $root $id $standing))))
[33m--> prolog clause -->
[32m'IndexAdmittedMemoryRNA'(A, B, C) :-
    D=E,
    'MemoryStanding'(A, B, E),
    ==(D, malformed, F),
    (   F==true
    ->  C='memory-integrity-failed'
    ;   C=[miter_memory_index, A, B, D]
    ).
