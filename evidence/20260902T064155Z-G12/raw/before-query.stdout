[33m--> prolog clause -->
[32m'RebuildSemanticIndexRNA'(A, B) :-
    C=[miter_memory_record_count, A],
    <(C, 0, D),
    (   D==true
    ->  B='memory-integrity-failed'
    ;   'RebuildMemoryAt'(A, 0, C, B)
    ).
[33m^^^^^^^^^^^^^^^^^^^^^^
[0m[33m--> metta function -->
[36m(= (RebuildMemoryAt $root $index $count)
   (if (< $index $count)
     (let* (($id (miter_memory_record_id $root $index))
            ($result (IndexAdmittedMemoryRNA $root $id)))
       (if (== $result memory-indexed)
         (RebuildMemoryAt $root (+ $index 1) $count)
         $result))
     semantic-index-rebuilt))
[33m--> prolog clause -->
[32m'RebuildMemoryAt'(A, B, C, D) :-
    <(B, C, E),
    (   E==true
    ->  F=[miter_memory_record_id, A, B],
        G=H,
        'IndexAdmittedMemoryRNA'(A, F, H),
        ==(G, 'memory-indexed', I),
        (   I==true
        ->  +(B, 1, J),
            'RebuildMemoryAt'(A, J, C, D)
        ;   D=G
        )
    ;   D='semantic-index-rebuilt'
    ).
