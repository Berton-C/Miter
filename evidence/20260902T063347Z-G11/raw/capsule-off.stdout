[0m[33m--> metta function -->
[36m(= (ContinuityRNA $context $mode)
   (let* (($text (miter_resume_field $context "text"))
          ($begin (miter_resume_begin $context)))
     (if (== $begin restart-contact-recorded)
       (if (== $text "Where was I with the book?")
         (if (== (miter_resume_registry_count $context "book") 1)
           (BookContinuityRNA $context $mode)
           continuity-project-ambiguous)
         continuity-intent-unsupported)
       $begin)))
[33m--> prolog clause -->
[32m'ContinuityRNA'(A, B, C) :-
    D=E,
    miter_resume_field(A, "text", E),
    F=G,
    miter_resume_begin(A, G),
    ==(F, 'restart-contact-recorded', H),
    (   H==true
    ->  ==(D, "Where was I with the book?", I),
        (   I==true
        ->  miter_resume_registry_count(A, "book", J),
            ==(J, 1, K),
            (   K==true
            ->  'BookContinuityRNA'(A, B, C)
            ;   C='continuity-project-ambiguous'
            )
        ;   C='continuity-intent-unsupported'
        )
    ;   C=F
    ).
[33m^^^^^^^^^^^^^^^^^^^^^^
[0m[33m--> metta function -->
[36m(= (BookContinuityRNA $context $mode)
   (let* (($project (miter_resume_registry_project $context "book"))
          ($store (miter_resume_field $context "memory_store"))
          ($principal (miter_resume_field $context "principal_scope"))
          ($audience (miter_resume_field $context "audience_scope"))
          ($text (miter_resume_field $context "text"))
          ($tag (miter_resume_field $context "query_tag"))
          ($capsules (miter_resume_field $context "capsule_store"))
          ($output (miter_resume_field $context "capsule_output"))
          ($semantic (if (== $mode chroma-off) semantic-unavailable
                       (RecallRNA $store $principal $audience $project active $text $tag)))
          ($resolved (if (== $mode capsule-off) capsule-resolver-disabled
                       (RecoverContinuity $capsules $project $output)))
          ($witness (if (== $resolved continuity-reconstructed)
                      (miter_resume_witness $context) source-unverified))
          ($certificate (if (and (== $resolved continuity-reconstructed)
                                (== $witness capsule-event-verified))
                          exact-continuity non-authoritative-recall)))
     (miter_resume_answer $context $certificate $semantic)))
[33m--> prolog clause -->
[32m'BookContinuityRNA'(A, B, C) :-
    D=E,
    miter_resume_registry_project(A, "book", E),
    F=G,
    miter_resume_field(A, "memory_store", G),
    H=I,
    miter_resume_field(A, "principal_scope", I),
    J=K,
    miter_resume_field(A, "audience_scope", K),
    L=M,
    miter_resume_field(A, "text", M),
    N=O,
    miter_resume_field(A, "query_tag", O),
    P=Q,
    miter_resume_field(A, "capsule_store", Q),
    R=S,
    miter_resume_field(A, "capsule_output", S),
    T=U,
    ==(B, 'chroma-off', V),
    (   V==true
    ->  U='semantic-unavailable'
    ;   'RecallRNA'(F,
                    H,
                    J,
                    D,
                    active,
                    L,
                    N,
                    U)
    ),
    W=X,
    ==(B, 'capsule-off', Y),
    (   Y==true
    ->  X='capsule-resolver-disabled'
    ;   'RecoverContinuity'(P, D, R, X)
    ),
    Z=A1,
    ==(W, 'continuity-reconstructed', B1),
    (   B1==true
    ->  miter_resume_witness(A, A1)
    ;   A1='source-unverified'
    ),
    C1=D1,
    ==(W, 'continuity-reconstructed', E1),
    ==(Z, 'capsule-event-verified', F1),
    and(E1, F1, G1),
    (   G1==true
    ->  D1='exact-continuity'
    ;   D1='non-authoritative-recall'
    ),
    miter_resume_answer(A, C1, T, C).
