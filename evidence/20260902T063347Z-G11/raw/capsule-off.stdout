[33m--> prolog clause -->
[32m'RecallRNA'(A,
                 B,
                 C,
                 D,
                 E,
                 F,
                 G,
                 H) :-
    ==(E, active, I),
    ==(E, superseded, J),
    or(I, J, K),
    (   K==true
    ->  miter_memory_query(A,
                           B,
                           C,
                           D,
                           E,
                           F,
                           G,
                           H)
    ;   H='invalid-recall-standing'
    ).
