[36m(= (MemoryTypeAllowed $kind)
   (or (or (== $kind project-checkpoint) (== $kind relationship-preference))
       (or (or (== $kind fact) (== $kind decision))
           (or (or (== $kind commitment) (== $kind episode))
               (or (or (== $kind relationship) (== $kind open-question))
