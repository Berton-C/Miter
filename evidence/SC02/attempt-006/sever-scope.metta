; SC02 finite source-bound interpretation. Pure native data derivations.
; Inputs are fixture-admitted structured records, not authenticated live ingress.
; Node: (node id kind audiences project version payload parent-ids).
; Registry: (observation id kind audiences project version payload).
; Current dependency view: (at id version). No timestamp-as-freshness rule.
; A derived citation may transport an identical proposition, not invent entailment.
; No authoritative effect/certificate is constructed by this module.
(= (SFind $rows $id)
   (collapse (let $row (superpose $rows)
     (if (and (is-expr $row) (> (size-atom $row) 1))
       (if (== (index-atom $row 1) $id) $row (empty)) (empty)))))
(= (SUnion $a $b $i)
   (if (< $i (size-atom $b))
     (let $x (index-atom $b $i)
       (if (PHas $x $a 0) (SUnion $a $b (+ $i 1))
         (SUnion (cons-atom $x $a) $b (+ $i 1)))) (PList $a)))
(= (SNodeShape $n)
   (if (PShape $n node 8)
     (and (is-expr (index-atom $n 3)) (is-expr (index-atom $n 7))) false))
(= (SScope $scope $node)
   (and (PHas (index-atom $scope 2) (index-atom $node 3) 0)
        (== (index-atom $scope 3) (index-atom $node 4))))
(= (SCurrent $current $node)
   (let $versions (SFind $current (index-atom $node 1))
     (if (== (size-atom $versions) 1)
       (== (index-atom $versions 0) (at (index-atom $node 1) (index-atom $node 5))) false)))
(= (SObserved $registry $node)
   (let $rows (SFind $registry (index-atom $node 1))
     (if (== (size-atom $rows) 1)
       (== (index-atom $rows 0)
         (observation (index-atom $node 1) (index-atom $node 2)
           (index-atom $node 3) (index-atom $node 4) (index-atom $node 5) (index-atom $node 6))) false)))
(= (SParentProofs $scope $nodes $registry $current $ids $seen $i)
   (if (< $i (size-atom $ids))
     (cons-atom (SupportFor $scope $nodes $registry $current (index-atom $ids $i) $seen)
       (SParentProofs $scope $nodes $registry $current $ids $seen (+ $i 1))) ()))
(= (SSameClaims $proofs $payload $i)
   (if (< $i (size-atom $proofs))
     (let $p (index-atom $proofs $i)
       (if (PShape $p supported 4)
         (and (== (index-atom $p 1) $payload) (SSameClaims $proofs $payload (+ $i 1))) false)) true))
(= (SRoots $proofs $i $roots)
   (if (< $i (size-atom $proofs))
     (SRoots $proofs (+ $i 1) (SUnion $roots (index-atom (index-atom $proofs $i) 3) 0)) (PList $roots)))
(= (SDerive $scope $nodes $registry $current $node $seen)
   (let* (($id (index-atom $node 1)) ($kind (index-atom $node 2))
          ($payload (index-atom $node 6)) ($parents (index-atom $node 7)))
     (if (PHas $kind (external-contact human-confirmation testimony action-result) 0)
       (if (and (== (size-atom $parents) 0) (SObserved $registry $node))
         (supported $payload (origin $id $kind (index-atom $node 5))
           ((root $id (index-atom $node 5) $kind))) (unresolved registry-mismatch $id))
       (let $proofs (SParentProofs $scope $nodes $registry $current $parents $seen 0)
         (if (PHas $kind (generation rendering model-assertion self-trace) 0)
           (candidate-origin $id $kind $payload $proofs)
           (if (PHas $kind (inference memory-recall) 0)
             (if (and (> (size-atom $parents) 0) (SSameClaims $proofs $payload 0))
               (supported $payload (derived $id $kind $proofs) (SRoots $proofs 0 ()))
               (unresolved unsupported-derivation $id $proofs))
             (unresolved unknown-origin $id $kind)))))))
(= (SupportFor $scope $nodes $registry $current $id $seen)
   (if (PHas $id $seen 0) (unresolved support-cycle $id)
     (let $found (SFind $nodes $id)
       (if (== (size-atom $found) 0) (unresolved missing-source $id)
         (if (!= (size-atom $found) 1) (unresolved conflicting-identity $id)
           (let $node (index-atom $found 0)
             (if (SNodeShape $node)
               (if true
                 (if (SCurrent $current $node)
                   (SDerive $scope $nodes $registry $current $node (cons-atom $id $seen))
                   (unresolved stale-or-unresolved-dependency $id))
                 (unresolved inaccessible-scope $id)) (unresolved malformed-source $id))))))))
(= (SReadAll $scope $nodes $registry $current $i)
   (if (< $i (size-atom $nodes))
     (let $node (index-atom $nodes $i)
       (cons-atom (if (SNodeShape $node)
         (SupportFor $scope $nodes $registry $current (index-atom $node 1) ())
         (unresolved malformed-source-row $i)) (SReadAll $scope $nodes $registry $current (+ $i 1)))) ()))
(= (SEdges $proofs)
   (collapse (let $p (superpose $proofs)
     (if (PShape $p supported 4)
       (if (PShape (index-atom $p 1) edge 3) (index-atom $p 1) (empty)) (empty)))))
; Contextual participation commitments are source premises, not universal goals.
(= (SCommitmentApplies $payload $request)
   (if (PShape $payload commitment 6) (== (index-atom $payload 2) (index-atom $request 1)) false))
(= (SCommitmentPayloads $records $request)
   (SUnion () (collapse (let $node (superpose $records)
     (if (or (PShape $node node 8) (PShape $node observation 7))
       (if (SCommitmentApplies (index-atom $node 6) $request) (index-atom $node 6) (empty))
       (empty)))) 0))
(= (SCommitments $nodes $registry $request)
   (SUnion (SCommitmentPayloads $nodes $request) (SCommitmentPayloads $registry $request) 0))
(= (SProofsOf $proofs $payload)
   (collapse (let $p (superpose $proofs)
     (if (PShape $p supported 4)
       (if (== (index-atom $p 1) $payload) $p (empty)) (empty)))))
(= (SHumanRoots $roots $i)
   (if (< $i (size-atom $roots))
     (and (== (index-atom (index-atom $roots $i) 3) human-confirmation) (SHumanRoots $roots (+ $i 1))) true))
(= (SReleased $commitment $proofs)
   (let $releases (SProofsOf $proofs (release (index-atom $commitment 1)))
     (PHas true (collapse (let $p (superpose $releases)
       (and (> (size-atom (index-atom $p 3)) 0) (SHumanRoots (index-atom $p 3) 0)))) 0)))
(= (SFocusFor $commitment $all $proofs)
   (if (!= (size-atom (SFind $all (index-atom $commitment 1))) 1)
     (unresolved conflicting-commitment (index-atom $commitment 1))
     (let $basis (SProofsOf $proofs $commitment)
       (if (== (size-atom $basis) 0) (unresolved material-commitment (index-atom $commitment 1))
         (if (SReleased $commitment $proofs) (released-commitment $commitment)
           (let* (($role (index-atom $commitment 4)) ($meanings (collapse (match &compass
             (compass-interface-obligation $value $role $source) ($value $source)))))
             (if (== (size-atom $meanings) 1)
               (material-interface (index-atom (index-atom $meanings 0) 0) (index-atom $commitment 4)
                 (index-atom $commitment 3) (index-atom $commitment 5) (support-basis $basis))
               (unresolved interface-meaning (index-atom $commitment 4)))))))))
(= (SFocusRows $all $proofs $i)
   (if (< $i (size-atom $all))
     (cons-atom (SFocusFor (index-atom $all $i) $all $proofs) (SFocusRows $all $proofs (+ $i 1))) ()))
(= (SKeepFocus $rows)
   (collapse (let $row (superpose $rows)
     (if (PShape $row material-interface 6) $row (empty)))))
(= (SFocusReady $rows $i)
   (if (< $i (size-atom $rows))
     (and (or (PShape (index-atom $rows $i) material-interface 6)
              (PShape (index-atom $rows $i) released-commitment 2)) (SFocusReady $rows (+ $i 1))) true))
(= (GroundParticipation $scope $nodes $registry $current $ops $request $budget)
   (if (and (PShape $scope scope 5) (and (PShape $request path 3)
         (and (is-expr $nodes) (and (is-expr $registry) (is-expr $current)))))
     (let* (($proofs (SReadAll $scope $nodes $registry $current 0))
            ($state (SUnion () (SEdges $proofs) 0))
            ($commitments (SCommitments $nodes $registry $request))
            ($rows (SFocusRows $commitments $proofs 0)))
       (grounded-participation $scope (readings $proofs) (interface-derivations $rows)
         (if (SFocusReady $rows 0)
           (ComposeParticipation $scope $state $ops $request (SKeepFocus $rows) $budget)
           (unresolved material-interface-derivation)))) malformed-grounding-input))
