[0m[33m--> metta function -->
[36m(= (MemoryCandidateRNA $root $extension $candidate)
   (let* (($kind (miter_memory_field $candidate "memory_type"))
          ($durability (miter_memory_field $candidate "durability"))
          ($provenance (miter_memory_field $candidate "provenance_kind"))
          ($source (miter_memory_check_sources $root $candidate))
          ($decision (MemoryAdmission $kind $durability $provenance $source)))
     (if (== $decision admitted)
       (miter_memory_persist $root $extension $candidate)
       (miter_memory_reject $root $extension $candidate $decision))))
[33m--> prolog clause -->
[32m'MemoryCandidateRNA'(A, B, C, D) :-
    E=F,
    miter_memory_field(C, "memory_type", F),
    G=H,
    miter_memory_field(C, "durability", H),
    I=J,
    miter_memory_field(C, "provenance_kind", J),
    K=L,
    miter_memory_check_sources(A, C, L),
    M=N,
    'MemoryAdmission'(E, G, I, K, N),
    ==(M, admitted, O),
    (   O==true
    ->  miter_memory_persist(A, B, C, D)
    ;   miter_memory_reject(A, B, C, M, D)
    ).
[33m^^^^^^^^^^^^^^^^^^^^^^
[0m[33m--> metta function -->
[36m(= (MemoryStanding $root $id)
   (let $count (miter_memory_supersession_count $root $id)
     (if (< $count 0) malformed
       (if (> $count 0) superseded active))))
[33m--> prolog clause -->
[32m'MemoryStanding'(A, B, C) :-
    D=[miter_memory_supersession_count, A, B],
    <(D, 0, E),
    (   E==true
    ->  C=malformed
    ;   >(D, 0, F),
        (   F==true
        ->  C=superseded
        ;   C=active
        )
    ).
[33m^^^^^^^^^^^^^^^^^^^^^^
[0m[33m--> metta function -->
[36m(= (IndexAdmittedMemoryRNA $root $id)
   (let $standing (MemoryStanding $root $id)
     (if (== $standing malformed) memory-integrity-failed
       (miter_memory_index $root $id $standing))))
[33m--> prolog clause -->
[32m'IndexAdmittedMemoryRNA'(A, B, C) :-
    D=E,
    'MemoryStanding'(A, B, E),
    ==(D, malformed, F),
    (   F==true
    ->  C='memory-integrity-failed'
    ;   C=[miter_memory_index, A, B, D]
    ).
[33m^^^^^^^^^^^^^^^^^^^^^^
[0m[33m--> metta function -->
[36m(= (RecallRNA $root $principal $audience $project $standing $text $tag)
   (if (or (== $standing active) (== $standing superseded))
     (miter_memory_query $root $principal $audience $project $standing $text $tag)
     invalid-recall-standing))
[33m--> prolog clause -->
[32m'RecallRNA'(A,
                 B,
                 C,
                 D,
                 E,
                 F,
                 G,
                 H) :-
    ==(E, active, I),
    ==(E, superseded, J),
    or(I, J, K),
    (   K==true
    ->  H=[miter_memory_query, A, B, C, D, E, F, G]
    ;   H='invalid-recall-standing'
    ).
