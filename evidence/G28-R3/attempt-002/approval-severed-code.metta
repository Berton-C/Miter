; Native admission of a concrete, independently tried extension. Mechanical
; source/bytes observations do not supply a semantic promotion verdict.
(= (EPApproval $input $snapshot) (promotion-authorized severed))
(= (EPTrial $s)
 (let* (($o (index-atom $s 1)) ($c (index-atom $s 2)) ($t (index-atom $s 3)))
  (if (and (PShape $o executable-opportunity 7) (PShape $t executable-trial 6))
   (let* (($cmp (index-atom $t 2)) ($cases (index-atom (index-atom $o 3) 6)))
    (and (== $c (index-atom $t 1))
     (and (ZCandidateValid $o (index-atom $c 1) $c)
      (and (== $cases (index-atom $cmp 1))
       (and (ZCheck $cases (index-atom $cmp 2))
        (and (ZSmokePassed (index-atom $t 4)) (ZSensitivityPassed (index-atom $t 5)))))))) false)))
(= (EPAdmission $input $snapshot)
 (if (PShape $snapshot promotion-snapshot 12)
  (let $approval (EPApproval $input $snapshot)
   (if (and (PShape $approval promotion-authorized 2)
        (and (EPTrial $snapshot)
         (and (== (index-atom $snapshot 7) (index-atom $snapshot 5))
          (and (== (index-atom $snapshot 8) (index-atom $snapshot 4))
           (and (== (index-atom $snapshot 9) true)
            (and (== (index-atom $snapshot 10) true) (== (index-atom $snapshot 11) true)))))))
    (promotion-admitted
     (promotion-certificate (index-atom $snapshot 4) (index-atom $snapshot 5)
      (index-atom $snapshot 6) (index-atom $input 2) $approval)
     (basis $input $snapshot))
    (promotion-held $approval (basis $input $snapshot))))
  (promotion-held malformed-snapshot)))
(= (EPRun $root)
 (let* (($saved (wp_saved $root decision))
        ($decision (if (PShape $saved promotion-admitted 3) $saved
          (EPAdmission (wp_input $root) (wp_snapshot $root))))
        ($written (wp_save $root decision $decision)))
  (if (and (== $written stored) (PShape $decision promotion-admitted 3))
   (let* (($cert (index-atom $decision 1))
          ($stage (add-atom &derived (executable-promotion-pending $root $cert)))
          ($result (wp_merge $root $cert))
          ($clear (remove-atom &derived (executable-promotion-pending $root $cert)))) $result)
   $decision)))
(= (EPProjection $root $id $desired $expected)
 (let $decision (wp_saved $root decision)
  (if (PShape $decision promotion-admitted 3)
   (let* (($cert (index-atom $decision 1))
          ($selection (projection-movement $id $desired $expected $cert))
          ($allowed (or (== $desired (index-atom $cert 1)) (== $desired (index-atom $cert 2)))))
    (if $allowed
     (let* (($staged (add-atom &derived (executable-projection-pending $root $selection)))
            ($out (wp_project $root $selection))
            ($clear (remove-atom &derived (executable-projection-pending $root $selection)))) $out)
     (projection-held outside-approved-lineage)))
   (projection-held no-admission))))
(= (EPUse $root $id $test)
 (let* (($decision (wp_saved $root decision)) ($active (wp_projection $root)))
  (if (and (PShape $decision promotion-admitted 3) (PShape $active active-projection 3))
   (let* (($o (index-atom (index-atom (index-atom $decision 2) 2) 1))
          ($cases (index-atom (index-atom $o 3) 6))
          ($matches (SFind $cases $test)))
    (if (== (size-atom $matches) 1)
     (let* (($request (uptake-movement $id $test $active))
            ($stage (add-atom &derived (executable-uptake-pending $root $request)))
            ($result (wp_use $root $request))
            ($clear (remove-atom &derived (executable-uptake-pending $root $request)))
            ($case (index-atom $matches 0)))
      (later-uptake $active $case $result (ZObserveOne $case ($result))))
     (uptake-held undeclared-test)))
   (uptake-held no-active-admission))))
