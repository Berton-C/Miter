; SC04: bounded relational-language composition, never general semantic authority.
; All grammar, binding, interpretation, inquiry and participation decisions native.
; Raw utterance: (utterance declared-artifact raw-text), inside SC02 node/registry.
; Binding premises: (named lexical-token person|artifact entity-id),
; (interface artifact role endpoint). These are human-declared meanings, not proof
; that a capability exists. Only separately observed edges establish actual paths.
(= (LSlice $xs $start $end)
   (if (< $start $end) (cons-atom (index-atom $xs $start) (LSlice $xs (+ $start 1) $end)) ()))
(= (LPrefix $xs $prefix $i)
   (if (< $i (size-atom $prefix))
     (if (< $i (size-atom $xs))
       (and (== (index-atom $xs $i) (index-atom $prefix $i)) (LPrefix $xs $prefix (+ $i 1))) false) true))
(= (LWords $tokens $i)
   (if (< $i (size-atom $tokens))
     (cons-atom (index-atom (index-atom $tokens $i) 1) (LWords $tokens (+ $i 1))) ()))
(= (LUnpunctuate $w)
   (if (== (size-atom $w) 0) ()
     (if (== (index-atom $w (- (size-atom $w) 1)) .)
       (LSlice $w 0 (- (size-atom $w) 1)) (PList $w))))
(= (LRole $word)
   (if (== $word choose) choice (if (== $word inspect) inspection (if (== $word restore) recovery unknown-role))))
(= (LVerbs $xs $i)
   (if (< $i (size-atom $xs))
     (let $role (LRole (index-atom $xs $i))
       (if (== $role unknown-role) invalid-verbs
         (if (== (+ $i 1) (size-atom $xs)) ($role)
           (if (== (index-atom $xs (+ $i 1)) and)
             (let $rest (LVerbs $xs (+ $i 2))
               (if (is-expr $rest)
                 (if (> (size-atom $rest) 0) (cons-atom $role $rest) invalid-verbs)
                 invalid-verbs)) invalid-verbs)))) invalid-verbs))
(= (LAbility $actor $mode $tail)
   (if (> (size-atom $tail) 1)
     (let $roles (LVerbs (LSlice $tail 0 (- (size-atom $tail) 1)) 0)
       (if (is-expr $roles) (syntax ability $mode $actor (index-atom $tail (- (size-atom $tail) 1)) $roles)
         (unparsed invalid-coordination))) (unparsed incomplete-ability)))
(= (LActorClause $w)
   (if (> (size-atom $w) 1)
     (let* (($actor (index-atom $w 0)) ($rest (cdr-atom $w)))
       (if (LPrefix $rest (must be able to) 0) (LAbility $actor obligation (LSlice $rest 4 (size-atom $rest)))
         (if (LPrefix $rest (must still be able to) 0) (LAbility $actor obligation (LSlice $rest 5 (size-atom $rest)))
           (if (LPrefix $rest (may) 0) (LAbility $actor permission (cdr-atom $rest))
             (if (LPrefix $rest (no longer needs to) 0) (LAbility $actor release (LSlice $rest 4 (size-atom $rest)))
               (unparsed outside-grammar)))))) (unparsed incomplete-clause)))
(= (LParse $w)
   (if (and (== (size-atom $w) 3) (LPrefix $w (please revise) 0))
     (syntax request (index-atom $w 2) revised)
     (if (and (== (size-atom $w) 3) (== (cdr-atom $w) (needs revision)))
       (syntax request (index-atom $w 0) revised)
       (if (and (== (size-atom $w) 4) (LPrefix $w (do not revise) 0))
         (syntax prohibition (index-atom $w 3) revised)
         (if (and (> (size-atom $w) 4) (== (index-atom $w 0) keep))
           (if (LPrefix (LSlice $w 2 (size-atom $w)) (able to) 0)
             (LAbility (index-atom $w 1) obligation (LSlice $w 4 (size-atom $w)))
             (unparsed outside-grammar)) (LActorClause $w))))))
(= (LBindings $proofs $alias $kind)
   (collapse (let $p (superpose $proofs)
     (if (PShape $p supported 4)
       (let $v (index-atom $p 1)
         (if (PShape $v named 4)
           (if (and (== (index-atom $v 1) $alias) (== (index-atom $v 2) $kind)) $p (empty)) (empty))) (empty)))))
(= (LMeaning $proofs $artifact $role)
   (collapse (let $p (superpose $proofs)
     (if (PShape $p supported 4)
       (let $v (index-atom $p 1)
         (if (PShape $v interface 4)
           (if (and (== (index-atom $v 1) $artifact) (== (index-atom $v 2) $role)) $p (empty)) (empty))) (empty)))))
(= (LUniqueClaims $proofs)
   (SUnion () (collapse (let $p (superpose $proofs) (index-atom $p 1))) 0))
(= (LBind $proofs $alias $kind)
   (let* (($basis (LBindings $proofs $alias $kind)) ($claims (LUniqueClaims $basis)))
     (if (== (size-atom $claims) 1) (binding (index-atom (index-atom $claims 0) 3) $basis)
       (unresolved entity-binding $alias $kind $claims))))
(= (LAbilityClaims $proofs $artifact $actor $mode $roles $i)
   (if (< $i (size-atom $roles))
     (let* (($role (index-atom $roles $i)) ($basis (LMeaning $proofs $artifact $role))
            ($meanings (LUniqueClaims $basis)))
       (if (== (size-atom $meanings) 1)
         (let* (($endpoint (index-atom (index-atom $meanings 0) 3))
                ($id (language-obligation $artifact $actor $role))
                ($claim (if (== $mode obligation) (commitment $id $artifact $actor $role $endpoint)
                  (if (== $mode release) (release $id) (permission $artifact $actor $role $endpoint)))))
           (cons-atom (bound-claim $claim $basis) (LAbilityClaims $proofs $artifact $actor $mode $roles (+ $i 1))))
         (cons-atom (unresolved interface-binding $artifact $role) (LAbilityClaims $proofs $artifact $actor $mode $roles (+ $i 1))))) ()))
(= (LResolve $syntax $proofs $target)
   (if (or (PShape $syntax syntax 4) (PShape $syntax syntax 6))
     (let* (($kind (index-atom $syntax 1))
            ($alias (if (== $kind ability) (index-atom $syntax 4) (index-atom $syntax 2)))
            ($artifact (LBind $proofs $alias artifact)))
       (if (PShape $artifact binding 3)
         (if (== (index-atom $artifact 1) $target)
           (if (== $kind ability)
             (let $actor (LBind $proofs (index-atom $syntax 3) person)
               (if (PShape $actor binding 3)
                 (interpreted (LAbilityClaims $proofs $target (index-atom $actor 1) (index-atom $syntax 2) (index-atom $syntax 5) 0)
                   (SUnion (index-atom $artifact 2) (index-atom $actor 2) 0)) $actor))
             (interpreted ((bound-claim
               (if (== $kind request) (purpose (language-purpose $target) (path $target (index-atom $syntax 3)))
                 (prohibition (path $target (index-atom $syntax 3)))) ())) (index-atom $artifact 2)))
           (unresolved declared-target-mismatch $target $artifact)) $artifact)) $syntax))
(= (LRead $scope $nodes $registry $current $proofs $row)
   (let* (($id (index-atom $row 1)) ($raw (SupportFor $scope $nodes $registry $current $id ()))
          ($target (index-atom (index-atom $row 6) 1)))
     (if (PShape $raw supported 4)
       (let* (($payload (index-atom $raw 1)) ($tokens (miter_language_tokens (index-atom $payload 2))))
        (if (is-expr $tokens)
         (let* (($words (LUnpunctuate (LWords $tokens 0))) ($syntax (LParse $words))
              ($span (if (> (size-atom $tokens) 0)
                (span (index-atom (index-atom $tokens 0) 2) (index-atom (index-atom $tokens (- (size-atom $tokens) 1)) 3)) (span 0 0))))
          (language-reading $id $target $span $syntax (LResolve $syntax $proofs $target) $raw))
         (language-reading $id $target no-span no-parse (unresolved lexical-input) $raw)))
       (language-reading $id $target no-span no-parse (unresolved source-standing $raw) $raw))))
(= (LSourceRows $scope $nodes $registry)
   (let $all (SUnion $nodes $registry 0)
     (collapse (let $r (superpose $all)
       (if (or (PShape $r node 8) (PShape $r observation 7))
         (if (and (SScope $scope $r) (and (== (index-atom $r 2) human-confirmation)
                    (PShape (index-atom $r 6) utterance 3))) $r (empty)) (empty))))))
(= (LReadRows $scope $nodes $registry $current $proofs $rows $i)
   (if (< $i (size-atom $rows))
     (cons-atom (LRead $scope $nodes $registry $current $proofs (index-atom $rows $i))
       (LReadRows $scope $nodes $registry $current $proofs $rows (+ $i 1))) ()))
(= (LProducts $reading)
   (let $v (index-atom $reading 5)
     (if (PShape $v interpreted 3)
       (let $rows (index-atom $v 1)
         (collapse (let $r (superpose $rows)
           (if (PShape $r bound-claim 3)
             (let* (($bindings (SUnion (index-atom $v 2) (index-atom $r 2) 0))
                    ($basis (cons-atom (index-atom $reading 6) $bindings)))
               (supported (index-atom $r 1)
                 (language-derived (index-atom $reading 1) (index-atom $reading 3) (index-atom $reading 4) $basis)
                 (SRoots $basis 0 ()))) (empty))))) ())))
(= (LProblem $reading)
   (let $v (index-atom $reading 5)
     (if (PShape $v interpreted 3)
       (let $rows (index-atom $v 1)
         (collapse (let $r (superpose $rows) (if (PShape $r bound-claim 3) (empty) $r)))) ($v))))
(= (LAllProducts $readings $i $result)
   (if (< $i (size-atom $readings))
     (LAllProducts $readings (+ $i 1) (SUnion $result (LProducts (index-atom $readings $i)) 0)) (PList $result)))
(= (LQuestions $readings $target)
   (collapse (let $r (superpose $readings)
     (if (== (index-atom $r 2) $target)
       (let $problems (LProblem $r)
         (if (> (size-atom $problems) 0)
           (source-distinction (index-atom $r 1) $problems (needed-contact source-or-binding-clarification)) (empty))) (empty)))))
(= (LPurposes $products $target)
   (SUnion () (collapse (let $p (superpose $products)
     (let $v (index-atom $p 1)
       (if (PShape $v purpose 3)
         (if (== (index-atom (index-atom $v 2) 1) $target) $v (empty)) (empty))))) 0))
(= (LProposal $readings $p)
   (if (PShape $p reading-proposal 7)
     (let $matches (SFind $readings (index-atom $p 3))
       (let $valid (collapse (let $r (superpose $matches)
         (let $claims (LUniqueClaims (LProducts $r))
           (and (== (index-atom $r 3) (span (index-atom $p 4) (index-atom $p 5)))
                (== $claims (index-atom $p 6))))))
         (if (PHas true $valid 0) (candidate-with-native-support $p no-new-root)
           (candidate-needs-independent-support $p)))) (candidate-malformed $p)))
(= (LProposals $readings $proposals $i)
   (if (< $i (size-atom $proposals))
     (cons-atom (LProposal $readings (index-atom $proposals $i)) (LProposals $readings $proposals (+ $i 1))) ()))
(= (LDisposition $scope $rawproofs $products $readings $ops $target $budget)
   (let* (($questions (LQuestions $readings $target)) ($purposes (LPurposes $products $target)))
     (if (> (size-atom $questions) 0) (inquiry $target $questions)
       (if (!= (size-atom $purposes) 1) (inquiry $target ((purpose-distinction $purposes)))
         (let* (($purpose (index-atom $purposes 0)) ($request (index-atom $purpose 2))
                ($prohibitions (SProofsOf $products (prohibition $request))))
           (if (> (size-atom $prohibitions) 0) (inquiry $target ((conflicting-instructions $purpose $prohibitions)))
             (let* (($commitments (SUnion () (collapse (let $p (superpose $products)
                        (if (SCommitmentApplies (index-atom $p 1) $request) (index-atom $p 1) (empty)))) 0))
                    ($all (SUnion $rawproofs $products 0)))
               (participation $purpose (GroundFromReadings $scope $all $commitments $ops $request $budget)))))))))
(= (GroundLanguage $scope $nodes $registry $current $ops $target $budget $proposals)
   (let* (($proofs (SReadAll $scope $nodes $registry $current 0))
          ($rows (LSourceRows $scope $nodes $registry))
          ($readings (SUnion () (LReadRows $scope $nodes $registry $current $proofs $rows 0) 0))
          ($products (LAllProducts $readings 0 ())))
     (language-grounding $scope (readings $readings) (proposal-assessments (LProposals $readings $proposals 0))
       (LDisposition $scope $proofs $products $readings $ops $target $budget))))
