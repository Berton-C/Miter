; Generic finite means/end composition. Source-supported affordances enter as
; relational data; no failure-name dispatch, fixed answer, or total score.
; Predicted edges are hypotheses in plans, not observed outcomes or authority.
(= (DCPlans $state $goals $operations $fuel)
 (collapse (let $p (PSearch $state $goals $operations $fuel ())
  (if (PShape $p candidate-participation 4) $p (empty)))))
(= (DCSteps $p) (size-atom (index-atom $p 1)))
(= (DCDominated $p $plans)
 (PHas true (collapse (let $q (superpose $plans) (< (DCSteps $q) (DCSteps $p)))) 0))
(= (DCFrontier $plans)
 (collapse (let $p (superpose $plans) (if (DCDominated $p $plans) (empty) $p))))
(= (DCFirst $p)
 (let $trace (index-atom $p 1)
  (if (> (size-atom $trace) 0)
   (index-atom (index-atom $trace (- (size-atom $trace) 1)) 1) already-satisfied)))
(= (DCUnique $xs $i $seen)
 (if (< $i (size-atom $xs))
  (let $x (index-atom $xs $i)
   (DCUnique $xs (+ $i 1) (if (PHas $x $seen 0) $seen (cons-atom $x $seen)))) $seen))
(= (DCCompare $state $goals $operations $fuel)
 (let* (($plans (DCPlans $state $goals $operations $fuel))
        ($frontier (DCFrontier $plans))
        ($firsts (DCUnique (collapse (let $p (superpose $frontier) (DCFirst $p))) 0 ())))
  (if (== (size-atom $firsts) 1)
   (continuation-supported (index-atom $firsts 0) $frontier (basis $state $goals $operations))
   (continuation-unresolved $firsts $frontier (basis $state $goals $operations)))))
