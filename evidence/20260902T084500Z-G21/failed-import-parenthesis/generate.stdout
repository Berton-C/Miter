            match('&rna', ['reactor-stop', requested], requested, requested),
            I),
    J=K,
    reduce([D, A], K),
    true,
    'size-atom'(J, L),
    ==(L, 0, M),
    'size-atom'(H, N),
    ==(N, 0, O),
    and(M, O, P),
