[36m(= (ReactorCycleWith $root $idle $interval $selector)
   (let* (($incoming (miter_reactor_input $root))
          ($ingested (ReactorIngest $root $incoming 0))
          ($stop (collapse (match &rna (reactor-stop requested) requested)))
          ($ready-before ($selector $root))
          ($interest (if (and (== (size-atom $ready-before) 0) (== (size-atom $stop) 0))
                       (ReactorIdleOpportunity $root) no-idle-selection))
          ($ready ($selector $root)))
     (if (> (size-atom $stop) 0)
       (miter_reactor_record $root reactor-stopped (explicit-stop))
       (if (> (size-atom $ready) 0)
         (let* (($base (miter_reactor_config idle_base_seconds))
                ($wake (if (== $idle true) (miter_reactor_record $root wake (contact-or-due-work)) already-awake))
                ($reset (if (== $idle true) (miter_reactor_record $root interval-reset (backoff $base contact-or-due-work)) already-reset))
                ($advance (ReactorAdvanceRegistered $root (index-atom $ready 0))))
           (if (== $advance reactor-store-failed) reactor-failed
             (ReactorCycleWith $root false (miter_reactor_config idle_base_seconds) $selector)))
         (let* (($q (if (== $idle false) (miter_reactor_record $root quiescent-ready (empty-lawful-ready-set no-model-call)) already-quiescent))
                ($schedule (miter_reactor_record $root idle-wait (wait $interval no-progress-claim no-model-call)))
                ($wait (miter_reactor_wait $root $interval))
                ($next (if (== $wait input-ready) (miter_reactor_config idle_base_seconds)
                           (ReactorNextInterval $interval))))
