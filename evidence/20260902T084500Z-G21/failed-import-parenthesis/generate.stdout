    'size-atom'(D, G),
    ==(G, 1, H),
    (   H==true
    ->  F=I,
        'index-atom'(D, 0, I),
        'SoulInvoke'(F, A, B, J),
        ==(J, witnessed, K),
        'SoulInvoke'(F, A, 'missing-witness', L),
        ==(L, blocked, M),
        and(K, M, C)
    ;   C=false
    ).
