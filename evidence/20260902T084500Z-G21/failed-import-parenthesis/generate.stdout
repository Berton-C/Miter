    F=G,
    'SoulExpected'(A, G),
    'size-atom'(D, H),
    ==(H, 1, I),
    '!='(F, 'missing-doctrine', J),
    and(I, J, K),
    (   K==true
    ->  ==(F, B, L),
        (   L==true
        ->  C=witnessed
        ;   C=blocked
        )
    ;   C=blocked
    ).
