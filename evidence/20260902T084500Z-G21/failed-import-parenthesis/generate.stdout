[32m'ReactorCycleWith_Spec_[ReactorSelect]'(A,
                                             B,
                                             C,
                                             'ReactorSelect',
                                             D) :-
    E=F,
    miter_reactor_input(A, F),
    _=G,
    'ReactorIngest'(A, E, 0, G),
    H=I,
    findall(requested,
            match('&rna', ['reactor-stop', requested], requested, requested),
            I),
    J=K,
    'ReactorSelect'(A, K),
    _=L,
    ( 'size-atom'(J, M),
      ==(M, 0, N),
      'size-atom'(H, O),
      ==(O, 0, P),
      and(N, P, Q)
    ),
    (   Q==true
    ->  'ReactorIdleOpportunity'(A, L)
    ;   L='no-idle-selection'
    ),
    R=S,
    'ReactorSelect'(A, S),
    'size-atom'(H, T),
    >(T, 0, U),
    (   U==true
    ->  miter_reactor_record(A, 'reactor-stopped', ['explicit-stop'], D)
    ;   'size-atom'(R, V),
        >(V, 0, W),
        (   W==true
        ->  X=Y,
            miter_reactor_config(idle_base_seconds, Y),
            _=Z,
            ==(B, true, A1),
            (   A1==true
            ->  miter_reactor_record(A,
                                     wake,
                                     ['contact-or-due-work'],
                                     Z)
            ;   Z='already-awake'
            ),
            _=B1,
            ==(B, true, C1),
            (   C1==true
            ->  miter_reactor_record(A,
                                     'interval-reset',
                                     [backoff, X, 'contact-or-due-work'],
                                     B1)
            ;   B1='already-reset'
            ),
            D1=E1,
            'index-atom'(R, 0, F1),
            'ReactorAdvanceRegistered'(A, F1, E1),
            ==(D1, 'reactor-store-failed', G1),
            (   G1==true
            ->  D='reactor-failed'
            ;   miter_reactor_config(idle_base_seconds, H1),
                'ReactorCycleWith'(A, false, H1, 'ReactorSelect', D)
            )
        ;   _=I1,
            ==(B, false, J1),
            (   J1==true
            ->  miter_reactor_record(A,
                                     'quiescent-ready',
                                     ['empty-lawful-ready-set', 'no-model-call'],
                                     I1)
            ;   I1='already-quiescent'
            ),
            _=K1,
            miter_reactor_record(A,
                                 'idle-wait',
                                 [ wait,
                                   C,
                                   'no-progress-claim',
                                   'no-model-call'
                                 ],
                                 K1),
            L1=M1,
            miter_reactor_wait(A, C, M1),
            N1=O1,
            ==(L1, 'input-ready', P1),
            (   P1==true
            ->  miter_reactor_config(idle_base_seconds, O1)
            ;   'ReactorNextInterval'(C, O1)
            ),
            'ReactorCycleWith'(A, true, N1, 'ReactorSelect', D)
        )
    ).
