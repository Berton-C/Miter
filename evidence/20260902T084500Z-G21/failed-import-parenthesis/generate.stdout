[36m(= (SoulExercise $id $positive)
   (let $ps (collapse (match &soul (soul-causal $p $id $reason) $p))
     (if (== (size-atom $ps) 1)
       (let $p (index-atom $ps 0)
         (and (== (SoulInvoke $p $id $positive) witnessed)
              (== (SoulInvoke $p $id missing-witness) blocked)))
