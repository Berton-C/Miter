    R=S,
    reduce([D, A], S),
    'size-atom'(H, T),
    >(T, 0, U),
    (   U==true
    ->  miter_reactor_record(A, 'reactor-stopped', ['explicit-stop'], E)
    ;   'size-atom'(R, V),
        >(V, 0, W),
        (   W==true
        ->  X=Y,
            miter_reactor_config(idle_base_seconds, Y),
            true,
            ==(B, true, Z),
            (   Z==true
            ->  miter_reactor_record(A,
                                     wake,
                                     ['contact-or-due-work'],
                                     A1)
