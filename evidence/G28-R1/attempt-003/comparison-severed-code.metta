; G28 finite executable development: supported interface gap, inert oracle,
; mechanical workshop, native exact-contract comparison, proposal not promotion.
(= (YHuman $proof)
 (if (PShape $proof supported 4)
  (and (> (size-atom (index-atom $proof 3)) 0) (SHumanRoots (index-atom $proof 3) 0)) false))
(= (YSource $input $id)
 (SupportFor (index-atom $input 2) (index-atom $input 3) (index-atom $input 4) (index-atom $input 5) $id ()))
(= (YOpportunity $input)
 (if (PShape $input executable-input 9)
  (let* (($cp (YSource $input (index-atom $input 6))) ($ip (YSource $input (index-atom $input 7))) ($gp (YSource $input (index-atom $input 8))))
   (if (and (YHuman $cp) (and (YHuman $ip) (YHuman $gp)))
    (YFromSources (index-atom $input 1) (index-atom $input 2)
     (index-atom $cp 1) (index-atom $ip 1) (index-atom $gp 1) (support $cp $ip $gp))
    (executable-development-held (unresolved-source $cp $ip $gp))))
  (executable-development-held malformed-input)))
(= (YFromSources $id $scope $c $i $g $proofs)
 (if (and (PShape $c executable-contract 7) (and (PShape $i capability-inventory 4) (PShape $g executable-grant 6)))
  (if (and (== (index-atom $i 1) complete) (== (index-atom $i 2) $scope))
   (if (PHas (index-atom $c 2) (index-atom $i 3) 0)
    (executable-development-not-needed existing-interface $proofs)
    (if (YGrantFits $c $g)
     (executable-opportunity $id $scope $c $i $g $proofs)
     (executable-development-held incompatible-contract-or-grant)))
   (executable-development-held inventory-incomplete-or-foreign))
  (executable-development-held malformed-source-contract)))
(= (YGrantFits $c $g)
 (and (== (index-atom $g 1) (index-atom $c 1))
  (and (== (index-atom $c 3) utf8-argument-v1)
   (and (== (index-atom $c 4) same-bytes-plus-lf-v1)
    (and (> (index-atom $g 3) 0) (and (> (index-atom $g 4) 0) (> (index-atom $g 5) 0)))))))
(= (YFilesValid $files)
 (if (== (size-atom $files) 2)
  (let $paths (collapse (let $f (superpose $files)
   (if (PShape $f candidate-file 4)
    (if (wy_string (index-atom $f 2)) (index-atom $f 1) (empty)) (empty))))
   (and (== (size-atom $paths) 2)
    (and (PHas "extension/adapter.sh" $paths 0) (PHas "candidate_tests/smoke.sh" $paths 0)))) false))
(= (YCandidateValid $o $id $candidate)
 (if (PShape $candidate executable-candidate 4)
  (if (and (== (index-atom $candidate 1) $id) (YFilesValid (index-atom $candidate 2)))
   (let* (($m (index-atom $candidate 3)) ($c (index-atom $o 3)))
    (if (and (PShape $m extension-manifest 17) (YManifestExtras $o $id (index-atom $candidate 2) $m))
     (and (== (index-atom $m 1) (index-atom $c 1))
      (and (== (index-atom $m 3) (index-atom $c 3))
       (and (== (index-atom $m 4) (index-atom $c 4))
        (and (== (index-atom $m 5) (extension candidate_tests))
         (and (== (index-atom $m 6) (isolated-stdout))
          (and (== (index-atom $m 7) ())
           (and (== (index-atom $m 8) ())
            (and (== (index-atom $m 9) posix-shell)
             (and (== (index-atom $m 10) no-persistence)
              (and (== (index-atom $m 11) (fixed-contract candidate-smoke))
               (== (index-atom $m 13) human-before-promotion))))))))))) false)) false) false))
(= (YObserveOne $case $observations)
 (let $found (SFind $observations (index-atom $case 1))
  (if (== (size-atom $found) 1)
   (let $row (index-atom $found 0)
    (if (PShape $row io-observation 4)
     (and (== (index-atom $row 2) 0) (== (index-atom $row 3) (index-atom $case 3))) false)) false)))
(= (YCheck $cases $observations) true)
(= (YCompare $cases $observations)
 (if (YCheck $cases $observations)
  (executable-trial-qualified $cases $observations)
  (executable-trial-unqualified $cases $observations)))
(= (YReceiptIs $receipt $status)
 (if (PShape $receipt workshop-result 5) (== (index-atom $receipt 2) $status) false))
(= (YWrite $root $id $files $n)
 (if (< $n (size-atom $files))
  (let* (($f (index-atom $files $n))
         ($written (wy_request $root (wy_name write $n) write_candidate_file $id ((path (index-atom $f 1)) (contents (index-atom $f 2))))))
   (if (YReceiptIs $written candidate-written) (YWrite $root $id $files (+ $n 1))
    (executable-write-incomplete $written))) executable-files-written))
(= (YTrials $root $id $cases $n)
 (if (< $n (size-atom $cases))
  (let* (($case (index-atom $cases $n))
         ($receipt (wy_request $root (wy_name trial $n) run_declared_test $id ((test_id (index-atom $case 1)))))
         ($obs (wy_observe $root (index-atom $case 1) $receipt)))
   (cons-atom $obs (YTrials $root $id $cases (+ $n 1)))) ()))
(= (YPrompt)
 "Return JSON containing only adapter and smoke, both POSIX shell source strings. Implement the supplied one-UTF-8-argument contract: stdout must be exactly that argument followed by one LF. Preserve empty input, Unicode, whitespace, embedded newlines and literal shell syntax without evaluating it. No network, secrets, host paths or persistence. The adapter will be invoked with /bin/sh. Supply a genuinely small additional smoke test (one case is sufficient) that invokes /bin/sh /workspace/extension/adapter.sh and checks exact output bytes, including the final LF. Keep both files concise; no explanations or manifest. Independent acceptance tests are fixed outside your files. You cannot change permissions, tests or promote. Any supplied diagnostics are inert observations; address their actual discrepancy while preserving the same contract.")
; Manifest meaning and authority are assembled natively, not generated. The
; source proofs, exact candidate hashes and field-origin record remain linked.
(= (YAssemble $root $o $id $files)
 (let* (($c (index-atom $o 3)) ($runtime (wy_environment $root)))
  (executable-candidate $id $files
   (extension-manifest (index-atom $c 1) (index-atom $c 5)
    (index-atom $c 3) (index-atom $c 4) (extension candidate_tests)
    (isolated-stdout) () () posix-shell no-persistence
    (fixed-contract candidate-smoke)
    "Retain the prior base commit; candidate worktree is isolated and not activated."
    human-before-promotion
    (negative-controls missing-parent direct-main-write corrupted-observation unknown-observation truncated-product forged-lineage)
    $runtime
    (candidate-lineage $id (source-pressure (index-atom $o 6)) (file-hashes $files))))))
(= (YManifestExtras $o $id $files $m)
 (and (== (index-atom $m 14) (negative-controls missing-parent direct-main-write corrupted-observation unknown-observation truncated-product forged-lineage))
  (and (PShape (index-atom $m 15) runtime-dependencies 5)
   (== (index-atom $m 16) (candidate-lineage $id (source-pressure (index-atom $o 6)) (file-hashes $files))))))
(= (YReady $obs)
 (if (PShape $obs model-observation 11)
  (and (== (index-atom $obs 2) eof)
   (and (== (index-atom $obs 3) 200)
    (and (== (index-atom $obs 5) true)
     (and (== (index-atom $obs 6) stop)
      (== (index-atom $obs 7) artifact-shaped))))) false))
; This is a material observation predicate, not a failure->action entry.
; Complete malformed output can supply a concrete packaging discrepancy;
; arbitrary timeout labels or partial bytes alone cannot.
(= (YPackagingDiscrepancy $obs)
 (if (PShape $obs model-observation 11)
  (and (== (index-atom $obs 2) eof)
   (and (== (index-atom $obs 3) 200)
    (and (== (index-atom $obs 5) true)
     (and (== (index-atom $obs 6) stop)
      (or (== (index-atom $obs 7) malformed-artifact) (== (index-atom $obs 7) schema-mismatch)))))) false))
(= (YOperations)
 ((operation inspect-trial ((edge artifact ready)) ((edge undertaking fresh-observation)) ())
  (operation generate ((edge request material) (edge grant usable)) ((edge undertaking fresh-observation)) ())
  (operation narrow ((edge request verbose)) ((edge request material)) ((edge request verbose)))
  (operation incorporate ((edge discrepancy specific)) ((edge request material)) ((edge discrepancy specific)))
  (operation request-resources ((edge grant inadequate)) ((edge undertaking resource-question)) ())))
(= (YFailureFacts $obs)
 (if (YPackagingDiscrepancy $obs) ((edge discrepancy specific)) ()))
(= (YBase)
 ((edge independent-tests intact) (edge authority human-promotion) (edge scope bounded)))
(= (YGoals $target)
 ((path undertaking $target) (path independent-tests intact) (path authority human-promotion) (path scope bounded)))
(= (YContinuationCompare $facts)
 (let* (($state (PAdd (YBase) $facts 0))
        ($contact (DCCompare $state (YGoals fresh-observation) (YOperations) 3)))
  (if (PShape $contact continuation-supported 4) $contact
   (let $resource (DCCompare $state (YGoals resource-question) (YOperations) 3)
    (if (PShape $resource continuation-supported 4) $resource $contact)))))
(= (YGrantFacts $o $attempt)
 (if (<= $attempt (index-atom (index-atom $o 5) 3))
  ((edge grant usable)) ((edge grant inadequate))))
(= (YContinue $root $o $attempt $feedback $facts $candidate)
 (let* (($all (PAdd $facts (YGrantFacts $o $attempt) 0))
        ($decision (YContinuationCompare $all))
        ($record (development-continuation $o $feedback $candidate $decision))
        ($saved (wy_save $root (wy_key continuation $record) $record)))
  (if (== $saved stored)
   (if (PShape $decision continuation-supported 4)
    (YPerform $root $o $attempt $feedback $facts $candidate (index-atom $decision 1))
    (executable-development-incomplete unresolved-continuation $decision $feedback))
   (executable-development-incomplete continuation-not-durable))))
(= (YPerform $root $o $attempt $feedback $facts $candidate generate)
 (YAttempt $root $o $attempt $feedback))
(= (YPerform $root $o $attempt $feedback $facts $candidate incorporate)
 (YContinue $root $o $attempt (address-observed-discrepancy $feedback)
  (PAdd (PDelete $facts ((edge discrepancy specific)) 0) ((edge request material)) 0) $candidate))
(= (YPerform $root $o $attempt $feedback $facts $candidate narrow)
 (YContinue $root $o $attempt (concise-files-only-preserving-contract $feedback)
  (PAdd (PDelete $facts ((edge request verbose)) 0) ((edge request material)) 0) $candidate))
(= (YPerform $root $o $attempt $feedback $facts $candidate inspect-trial)
 (YBuild $root $o (index-atom $candidate 1) (- $attempt 1) $feedback $candidate))
(= (YPerform $root $o $attempt $feedback $facts $candidate request-resources)
 (executable-development-incomplete resource-request
  (undertaking-retained $o) (spent-attempts (- $attempt 1)) $feedback))
(= (YAttempt $root $o $attempt $feedback)
 (let* (($id (wy_name executable $attempt))
        ($q (executable-generation $id $o $attempt qwen-local (YPrompt) $feedback))
        ($stage (add-atom &derived (executable-generation-pending $root $q)))
        ($obs (wy_model $root $q))
        ($clear (remove-atom &derived (executable-generation-pending $root $q)))
        ($saved (wy_save $root (wy_name model $attempt) $obs)))
  (if (YReady $obs)
   (let* (($candidate (YAssemble $root $o $id (index-atom $obs 10)))
          ($stored (wy_save $root (wy_name candidate $attempt) $candidate))
          ($origins (wy_save $root (wy_name manifest-origins $attempt)
           (manifest-origins $candidate (source-contract (index-atom $o 3)) (source-proofs (index-atom $o 6))
            (workshop-grant (index-atom $o 5)) (native-permission-template G28-R1) (model-observation $obs)))))
    (if (and (YCandidateValid $o $id $candidate) (== (wy_candidate_bound $root $id $candidate) candidate-source-bound))
     (YContinue $root $o (+ $attempt 1) $q ((edge artifact ready)) $candidate)
     (executable-development-incomplete candidate-source-or-contract-mismatch $obs)))
   (YContinue $root $o (+ $attempt 1) $obs
    (YFailureFacts $obs) no-candidate))))
(= (YBuild $root $o $id $attempt $q $candidate)
 (let* (($quarantine (add-atom &trial (executable-candidate $id $candidate)))
        ($create (wy_request $root create create_candidate_worktree $id ()))
        ($writes (if (YReceiptIs $create candidate-created) (YWrite $root $id (index-atom $candidate 2) 0) $create)))
  (if (== $writes executable-files-written)
   (YEvaluate $root $o $id $attempt $q $candidate)
   (executable-development-incomplete $writes))))
(= (YEvaluate $root $o $id $attempt $q $candidate)
 (let* (($cases (index-atom (index-atom $o 3) 6))
        ($observations (YTrials $root $id $cases 0))
        ($comparison (YCompare $cases $observations))
        ($smoke (wy_request $root smoke run_declared_test $id ((test_id candidate-smoke))))
        ($smokeEvidence (wy_test_observation $root candidate-smoke $smoke))
        ($trial (executable-trial $candidate $comparison $smoke $smokeEvidence))
        ($recorded (wy_save $root (wy_name trial $attempt) $trial))
        ($commit (wy_request $root commit commit_candidate $id
          ((message "Miter-origin bounded executable candidate") (lineage (wy_details $root lineage $q))))))
  (if (and (PShape $comparison executable-trial-qualified 3) (YSmokePassed $smokeEvidence))
   (YPropose $root $o $id $candidate $trial $commit)
   (YContinue $root $o (+ $attempt 1) $trial (YTrialFacts $comparison $smokeEvidence) $candidate))))
(= (YSmokePassed $s)
 (if (PShape $s process-observation 7)
  (and (== (index-atom $s 2) 0) (== (index-atom $s 5) false)) false))
(= (YCaseCounterexample $case $observations)
 (let $rows (SFind $observations (index-atom $case 1))
  (if (== (size-atom $rows) 1)
   (let $r (index-atom $rows 0)
    (if (PShape $r io-observation 4)
     (or (not (== (index-atom $r 2) 0)) (not (== (index-atom $r 3) (index-atom $case 3)))) false)) false)))
(= (YTrialFacts $comparison $smoke)
 (let* (($ioCounterexample
          (if (PShape $comparison executable-trial-unqualified 3)
           (let* (($cases (index-atom $comparison 1)) ($observations (index-atom $comparison 2)))
            (PHas true (collapse (let $c (superpose $cases)
              (YCaseCounterexample $c $observations))) 0)) false))
        ($smokeCounterexample
          (if (PShape $smoke process-observation 7) (not (== (index-atom $smoke 2) 0)) false)))
  (if (or $ioCounterexample $smokeCounterexample) ((edge discrepancy specific)) ())))
(= (YPropose $root $o $id $candidate $trial $commit)
 (if (YReceiptIs $commit candidate-committed)
  (let* (($proposal (executable-promotion-proposal $o $candidate $trial $commit awaiting-explicit-human-approval))
         ($stored (wy_save $root proposal $proposal))
         ($sent (wy_request $root proposal submit_promotion_request $id
          ((proposal (wy_details $root proposal $proposal)) (commit (wy_details $root commit $commit))))))
   (if (YReceiptIs $sent promotion-proposed)
    (executable-awaiting-approval $proposal $sent)
    (executable-development-incomplete $sent)))
  (executable-development-incomplete $commit)))
(= (YRun $root)
 (let* (($input (wy_input $root)) ($o (YOpportunity $input)) ($saved (wy_save $root opportunity $o)))
  (if (PShape $o executable-opportunity 7)
   (if (== (index-atom (index-atom $o 5) 2) (wy_grant_id $root))
    (YContinue $root $o 1 no-prior-trial ((edge request material)) no-candidate)
    (executable-development-held workshop-grant-mismatch)) $o)))
