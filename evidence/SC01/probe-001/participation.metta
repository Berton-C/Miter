; SC01: finite native relational composition, not a complete Soul verdict.
; Reads separately loaded &compass semantics and fixture-scoped relations.
; Pure functions only: no writes, models, host cognition, or effect authority.
; Products are hypothetical candidate participation, never certificates.
; Missing supported interfaces/invalid shapes return explicit incomplete state.
(= (PShape $x $head $n)
   (if (is-expr $x)
     (if (== (size-atom $x) $n) (== (index-atom $x 0) $head) false) false))
(= (PAllEdges $xs $i)
   (if (< $i (size-atom $xs))
     (and (PShape (index-atom $xs $i) edge 3) (PAllEdges $xs (+ $i 1))) true))
(= (PFollow $state $from $to $seen $edge)
   (if (== (index-atom $edge 1) $from)
     (PPath $state (index-atom $edge 2) $to $seen) false))
(= (PPath $state $from $to $seen)
   (if (== $from $to) true
     (if (is-member $from $seen) false
       (if (== (size-atom $state) 0) false
         (let $answers (collapse
           (let $edge (superpose $state)
             (PFollow $state $from $to (cons-atom $from $seen) $edge)))
           (is-member true $answers))))))
(= (PGoal $state $goal)
   (if (PShape $goal path 3)
     (PPath $state (index-atom $goal 1) (index-atom $goal 2) ()) false))
(= (PAllGoals $state $goals $i)
   (if (< $i (size-atom $goals))
     (and (PGoal $state (index-atom $goals $i)) (PAllGoals $state $goals (+ $i 1))) true))
(= (PRequired $state $required $i)
   (if (< $i (size-atom $required))
     (and (is-member (index-atom $required $i) $state) (PRequired $state $required (+ $i 1))) true))
(= (PDelete $state $remove $i)
   (if (< $i (size-atom $state))
     (let* (($edge (index-atom $state $i)) ($rest (PDelete $state $remove (+ $i 1))))
       (if (is-member $edge $remove) (PList $rest) (cons-atom $edge $rest))) ()))
(= (PList $xs) (collapse (superpose $xs)))
(= (PAdd $state $add $i)
   (if (< $i (size-atom $add))
     (let $edge (index-atom $add $i)
       (if (is-member $edge $state)
         (PAdd $state $add (+ $i 1))
         (PAdd (cons-atom $edge $state) $add (+ $i 1)))) (PList $state)))
(= (POperationValid $op)
   (if (PShape $op operation 5)
     (and (is-expr (index-atom $op 2))
       (and (is-expr (index-atom $op 3))
         (and (is-expr (index-atom $op 4))
           (and (PAllEdges (index-atom $op 2) 0)
             (and (PAllEdges (index-atom $op 3) 0) (PAllEdges (index-atom $op 4) 0)))))) false))
(= (POperationsValid $ops $i)
   (if (< $i (size-atom $ops))
     (and (POperationValid (index-atom $ops $i)) (POperationsValid $ops (+ $i 1))) true))
(= (PFocusGoal $row)
   (if (PShape $row material-interface 6)
     (let* (($value (index-atom $row 1)) ($role (index-atom $row 2))
            ($meaning (collapse (match &compass (compass-interface-obligation $value $role $source) $source))))
       (if (== (size-atom $meaning) 1)
         (path (index-atom $row 3) (index-atom $row 4)) unresolved-interface-meaning))
     malformed-interface))
(= (PFocusGoals $focus $i)
   (if (< $i (size-atom $focus))
     (cons-atom (PFocusGoal (index-atom $focus $i)) (PFocusGoals $focus (+ $i 1))) ()))
(= (PGoalsValid $goals $i)
   (if (< $i (size-atom $goals))
     (and (PShape (index-atom $goals $i) path 3) (PGoalsValid $goals (+ $i 1))) true))
(= (PTransition $state $goals $ops $op $remaining $trace)
   (if (PRequired $state (index-atom $op 2) 0)
     (let* (($removed (PDelete $state (index-atom $op 4) 0))
            ($next (PAdd $removed (index-atom $op 3) 0)))
       (if (== $next $state) no-state-change
         (PSearch $next $goals $ops (- $remaining 1)
           (cons-atom (transition (index-atom $op 1) $state $next) $trace))))
     unavailable-operation))
(= (PSearch $state $goals $ops $remaining $trace)
   (if (PAllGoals $state $goals 0)
     (candidate-participation $trace $state $goals)
     (if (== $remaining 0) unresolved-within-slice
       (if (== (size-atom $ops) 0) unresolved-within-slice
         (let $op (superpose $ops)
           (PTransition $state $goals $ops $op $remaining $trace))))))
(= (ComposeParticipation $scope $state $ops $request $focus $budget)
   (if (and (is-expr $state) (and (is-expr $ops) (is-expr $focus)))
     (if (and (PShape $scope scope 5) (and (PShape $request path 3)
           (and (PAllEdges $state 0) (POperationsValid $ops 0))))
       (if (is-member $budget (0 1 2 3 4 5 6))
         (let $goals (cons-atom $request (PFocusGoals $focus 0))
           (if (PGoalsValid $goals 0)
             (scoped-search $scope (collapse (PSearch $state $goals $ops $budget ())))
             unresolved-interface-meaning)) invalid-slice-budget)
       malformed-structural-input)
     malformed-structural-input))
