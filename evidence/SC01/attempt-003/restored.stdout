:- findall(['case-result', canonical, A],
           ( A=B,
             'ComposeParticipation'([ scope,
                                      'cut-fixture',
                                      'principal-fixture',
                                      'project-fixture',
                                      'test-owner-structural-contact'
                                    ],
                                    [ [edge, person, choose],
                                      [edge, person, inspect],
                                      [edge, person, recover],
                                      [edge, artifact, original]
                                    ],
                                    [ [ operation,
                                        'direct-change',
                                        [[edge, artifact, original]],
                                        [[edge, artifact, revised]],
                                        [ [edge, person, choose],
                                          [edge, person, inspect],
                                          [edge, person, recover]
                                        ]
                                      ],
                                      [ operation,
                                        'preserve-participation',
                                        [[edge, artifact, original]],
                                        [ [edge, person, delegate],
                                          [edge, delegate, choose],
                                          [edge, delegate, inspect],
                                          [edge, delegate, recover]
                                        ],
                                        []
                                      ]
                                    ],
                                    [path, artifact, revised],
                                    [ [ 'material-interface',
                                        'AgencyBalance',
                                        choice,
                                        person,
                                        choose,
                                        'obs-choice'
                                      ],
                                      [ 'material-interface',
                                        'SharedUnderstanding',
                                        inspection,
                                        person,
                                        inspect,
                                        'obs-inspect'
                                      ],
                                      [ 'material-interface',
                                        'TimeCoherence',
                                        recovery,
                                        person,
                                        recover,
                                        'obs-recover'
                                      ]
                                    ],
                                    2,
                                    B)
           ),
           _).
