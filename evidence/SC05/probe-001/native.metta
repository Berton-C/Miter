; SC05 finite relational VoiceRNA. Not a general human-language/affect model.
; Intention is derived from native source-bound participation, not fixture labels.
(= (RPlanCandidates $g)
   (let $s (index-atom $g 4)
     (if (PShape $s scoped-search 5)
       (let $rows (index-atom $s 4)
         (collapse (let $r (superpose $rows) (if (PShape $r candidate-participation 4) $r (empty))))) ())))
(= (RCompleted $g)
   (let $plans (RPlanCandidates $g)
     (PHas true (collapse (let $p (superpose $plans) (== (size-atom (index-atom $p 1)) 0))) 0)))
(= (RRetentions $g)
   (let $rows (index-atom (index-atom $g 3) 1)
     (collapse (let $r (superpose $rows)
       (if (PShape $r material-interface 6)
         (let* (($basis (index-atom (index-atom $r 5) 1))
                ($claim (index-atom (index-atom $basis 0) 1)))
           (expected (retain (index-atom $claim 2) (index-atom $claim 3) (index-atom $claim 4) (index-atom $claim 5)) $basis)) (empty))))))
(= (RIntend $id $language)
   (if (PShape $language language-grounding 5)
     (let $d (index-atom $language 4)
       (if (PShape $d participation 3)
         (let* (($g (index-atom $d 2)) ($purpose (index-atom $d 1)) ($request (index-atom $purpose 2))
                ($proofs (index-atom (index-atom $g 2) 1))
                ($expected (cons-atom (expected (reported-request $request) (SProofsOf $proofs $purpose)) (RRetentions $g)))
                ($done (RCompleted $g)))
           (voice-intention $id (index-atom $language 1) (index-atom $request 1)
             (if $done (cons-atom (expected (completion $request) (observed-completion $g)) $expected) $expected)
             (native-basis $g) (if $done completed (if (> (size-atom (RPlanCandidates $g)) 0) candidate-available incomplete))))
         (voice-inquiry $d))) (voice-fault invalid-native-basis)))
; Speech acts are parsed from the actual words, not a renderer-provided label.
(= (RParse $w)
   (if (and (== (size-atom $w) 5) (LPrefix $w (you requested revision of) 0))
     (voice-syntax reported-request (syntax request (index-atom $w 4) revised))
     (if (and (== (size-atom $w) 7) (LPrefix $w (the requested change is to revise) 0))
       (voice-syntax reported-request (syntax request (index-atom $w 6) revised))
       (if (and (== (size-atom $w) 6) (LPrefix $w (the revision of) 0))
         (if (== (LSlice $w 4 6) (is complete))
           (voice-syntax completion (syntax request (index-atom $w 3) revised)) (unparsed completion-wording))
         (if (and (== (size-atom $w) 4) (LPrefix $w (i will revise) 0))
           (voice-syntax system-promise (syntax request (index-atom $w 3) revised))
           (if (and (> (size-atom $w) 5) (LPrefix (cdr-atom $w) (must remain able to) 0))
             (voice-syntax obligation (LAbility (index-atom $w 0) obligation (LSlice $w 5 (size-atom $w))))
             (if (and (> (size-atom $w) 7) (LPrefix $w (the change must keep) 0))
               (if (== (LSlice $w 5 7) (able to))
                 (voice-syntax obligation (LAbility (index-atom $w 4) obligation (LSlice $w 7 (size-atom $w))))
                 (unparsed participation-wording))
               (let $s (LParse $w)
                 (if (PShape $s syntax 6) (voice-syntax (index-atom $s 2) $s)
                   (if (PShape $s syntax 4) (voice-syntax unreported-instruction $s) $s))))))))))
(= (RConvert $kind $claim)
   (if (PShape $claim purpose 3)
     ($kind (index-atom $claim 2))
     (if (PShape $claim commitment 6)
       (retain (index-atom $claim 2) (index-atom $claim 3) (index-atom $claim 4) (index-atom $claim 5)) $claim)))
(= (RResolved $kind $v)
   (if (PShape $v interpreted 3)
     (let $rows (index-atom $v 1)
       (expression-meanings (collapse (let $r (superpose $rows)
         (if (PShape $r bound-claim 3) (meaning (RConvert $kind (index-atom $r 1)) (index-atom $r 2)) $r))) (index-atom $v 2))) $v))
(= (RRead $intention $clause $n)
   (let $tokens (miter_language_tokens $clause)
     (if (is-expr $tokens)
       (let* (($words (LUnpunctuate (LWords $tokens 0))) ($syntax (RParse $words))
              ($span (if (> (size-atom $tokens) 0)
                (span (index-atom (index-atom $tokens 0) 2) (index-atom (index-atom $tokens (- (size-atom $tokens) 1)) 3)) (span 0 0)))
              ($proofs (index-atom (index-atom (index-atom (index-atom $intention 5) 1) 2) 1)))
         (expression-reading $n $span $syntax
           (if (PShape $syntax voice-syntax 3)
             (RResolved (index-atom $syntax 1) (LResolve (index-atom $syntax 2) $proofs (index-atom $intention 3))) $syntax)
           rendering-not-authority))
       (expression-reading $n no-span no-parse (unresolved lexical-input) rendering-not-authority))))
(= (RReadAll $i $clauses $n)
   (if (< $n (size-atom $clauses))
     (cons-atom (RRead $i (index-atom $clauses $n) $n) (RReadAll $i $clauses (+ $n 1))) ()))
(= (RMeaningUses $readings)
   (collapse (let $r (superpose $readings)
     (let $v (index-atom $r 4)
       (if (PShape $v expression-meanings 3)
         (let $rows (index-atom $v 1)
           (let $m (superpose $rows)
             (if (PShape $m meaning 3) (expression-use (index-atom $m 1) (index-atom $r 1) (index-atom $r 2) $m) (empty)))) (empty))))))
(= (RClaimSet $rows)
   (SUnion () (collapse (let $r (superpose $rows) (index-atom $r 1))) 0))
(= (RUnresolved $readings)
   (collapse (let $r (superpose $readings)
     (let $v (index-atom $r 4)
       (if (PShape $v expression-meanings 3)
         (let $rows (index-atom $v 1)
           (let $m (superpose $rows)
             (if (PShape $m meaning 3) (empty) (unresolved-expression (index-atom $r 1) (index-atom $r 2) $m))))
         (unresolved-expression (index-atom $r 1) (index-atom $r 2) $v))))))
(= (RAlterations $expected $uses $readings)
   (let* (($actual (RClaimSet $uses)) ($wanted (RClaimSet $expected))
          ($missing (collapse (let $e (superpose $expected)
            (if (PHas (index-atom $e 1) $actual 0) (empty)
              (omitted-meaning (index-atom $e 1) (source-basis (index-atom $e 2)) (candidate-surface $readings))))))
          ($added (collapse (let $u (superpose $uses)
            (if (PHas (index-atom $u 1) $wanted 0) (empty)
              (unsupported-alteration (index-atom $u 1) (candidate-span (index-atom $u 2) (index-atom $u 3)) (intended $wanted)))))))
     (SUnion (SUnion $missing $added 0) (RUnresolved $readings) 0)))
(= (RAudit $intention $current $candidate-scope $clauses)
   (if (PShape $intention voice-intention 7)
     (if (and (== (index-atom $intention 2) $current) (== $candidate-scope $current))
       (if (is-expr $clauses)
         (let* (($readings (RReadAll $intention $clauses 0)) ($uses (RMeaningUses $readings))
                ($defects (RAlterations (index-atom $intention 4) $uses $readings)))
           (voice-audit (index-atom $intention 1) $current (if (== (size-atom $defects) 0) faithful unresolved-or-altered)
             (intention $intention) (expression-readings $readings) (alterations $defects)))
         (voice-fault malformed-candidate)) (voice-revalidation-required scope-or-cut-changed))
     (voice-fault invalid-intention)))
(= (RDisposition $audit $remaining)
   (if (PShape $audit voice-audit 7)
     (if (== (index-atom $audit 3) faithful) (expression-ready $audit no-emission-authority)
       (if (> $remaining 0) (repair-request $audit (remaining-calls $remaining))
         (expression-incomplete $audit (needed-contact unresolved-meaning-or-faithful-expression))))
     (expression-revalidation $audit)))
