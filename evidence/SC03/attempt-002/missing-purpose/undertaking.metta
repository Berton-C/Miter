; SC03: finite native undertaking policy inside a mechanically trampolined driver.
; State carries purpose, scope, operations, remaining grant, pending identity,
; semantic pin, current derivation, serial and consumed renewal identities.
; Prolog may serialize/observe/apply the exact local graph delta, never choose it.
(= (UState $s $budget $status $pending $frame $serial $grants)
   (undertaking (index-atom $s 1) (index-atom $s 2) (index-atom $s 3)
     (index-atom $s 4) $budget $status $pending (index-atom $s 8)
     (index-atom $s 9) $frame $serial $grants))
(= (USet $s $status $pending $frame)
   (UState $s (index-atom $s 5) $status $pending $frame (index-atom $s 11) (index-atom $s 12)))
(= (UEventScope $s $e)
   (and (== (index-atom (index-atom $s 2) 2) (index-atom $e 3))
        (== (index-atom (index-atom $s 2) 3) (index-atom $e 4))))
(= (UAuthority $s $o $semantic)
   (let* (($scope (index-atom $o 1)) ($cap (index-atom $o 8)))
     (and (== (index-atom $s 8) $semantic)
       (and (== (index-atom $cap 0) lab-grant)
         (and (== (index-atom $cap 1) (index-atom $scope 2))
           (and (== (index-atom $cap 2) (index-atom $scope 3))
             (and (== (index-atom $cap 3) active)
               (and (== (index-atom (index-atom $s 2) 2) (index-atom $scope 2))
                    (== (index-atom (index-atom $s 2) 3) (index-atom $scope 3))))))))))
(= (UPurpose $s $o)
   (let $proof (SupportFor (index-atom $o 1) (index-atom $o 2) (index-atom $o 3)
                 (index-atom $o 4) (index-atom $s 9) ())
     (if (PShape $proof supported 4)
       (and (== (index-atom $proof 1) (purpose (index-atom $s 1) (index-atom $s 3)))
         (SHumanRoots (index-atom $proof 3) 0)) false)))
(= (UCandidates $g)
   (if (PShape $g grounded-participation 5)
     (let $search (index-atom $g 4)
       (if (PShape $search scoped-search 5)
         (let $results (index-atom $search 4)
           (collapse (let $p (superpose $results)
             (if (PShape $p candidate-participation 4) $p (empty))))) ())) ()))
; Resource preference among already eligible plans only; never creates eligibility.
(= (UShortest $plans $i $best)
   (if (< $i (size-atom $plans))
     (let $p (index-atom $plans $i)
       (if (< (size-atom (index-atom $p 1)) (size-atom (index-atom $best 1)))
         (UShortest $plans (+ $i 1) $p) (UShortest $plans (+ $i 1) $best)))
     (candidate-participation (index-atom $best 1) (index-atom $best 2) (index-atom $best 3))))
(= (UPrepare $s $o $g $candidate $fingerprint)
   (let* (($trace (index-atom $candidate 1))
          ($step (index-atom $trace (- (size-atom $trace) 1)))
          ($ops (SFind (index-atom $s 4) (index-atom $step 1))))
     (if (== (size-atom $ops) 1)
       (let* (($serial (+ (index-atom $s 11) 1))
              ($key (effect-key (index-atom $s 1) $serial))
              ($pending (prepared $key (index-atom $o 6) (index-atom $step 2)
                          (index-atom $step 3) (index-atom $ops 0) (index-atom $s 8)))
              ($next (UState $s (- (index-atom $s 5) 1) waiting-result $pending
                        (decision-frame $fingerprint $g) $serial (index-atom $s 12))))
         (turn $next (apply $pending) (inquiry-selected (index-atom $step 1))))
       (turn (USet $s revalidation-required none (decision-frame $fingerprint $g)) wait ambiguous-operation))))
(= (UConsider $s $o $fingerprint)
   (if (UPurpose $s $o)
     (let* (($g (GroundParticipation (index-atom $o 1) (index-atom $o 2)
                    (index-atom $o 3) (index-atom $o 4) (index-atom $s 4) (index-atom $s 3) 6))
            ($plans (UCandidates $g)) ($frame (decision-frame $fingerprint $g)))
       (if (== (size-atom $plans) 0)
         (turn (USet $s waiting none $frame) wait (unresolved-participation $g))
         (let $chosen (UShortest $plans 1 (index-atom $plans 0))
           (if (== (size-atom (index-atom $chosen 1)) 0)
             (turn (USet $s completed none $frame) wait (completion-evidence $g))
             (if (> (index-atom $s 5) 0) (UPrepare $s $o $g $chosen $fingerprint)
               (turn (USet $s awaiting-resource none $frame) wait (resource-question $g)))))))
     (turn (USet $s waiting none (decision-frame $fingerprint purpose-unresolved)) wait purpose-unresolved)))
(= (URejoin $s $o $fingerprint)
   (let $pending (index-atom $s 7)
     (if (PShape $pending prepared 7)
       (let $receipts (SFind (index-atom $o 7) (index-atom $pending 1))
         (if (== (size-atom $receipts) 1)
           (let $receipt (index-atom $receipts 0)
             (if (and (== (index-atom $receipt 2) applied) (== (index-atom $receipt 4) $pending))
               (UConsider (USet $s ready none no-cache) $o $fingerprint)
               (turn (USet $s revalidation-required $pending no-cache) wait (uncertain-result $receipt))))
           (if (== (size-atom $receipts) 0)
             (if (== (index-atom $pending 2) (index-atom $o 6))
               (turn $s (apply $pending) pending-result)
               (UConsider (USet $s ready none no-cache) $o $fingerprint))
             (turn (USet $s revalidation-required $pending no-cache) wait conflicting-receipts))))
       (if (== (index-atom $s 6) suspended) (turn $s wait suspended)
         (let $frame (index-atom $s 10)
           (if (and (PShape $frame decision-frame 3)
                 (PHas (index-atom $s 6) (waiting completed awaiting-resource revalidation-required) 0))
             (if (== (index-atom $frame 1) $fingerprint) (turn $s wait unchanged-dependencies)
               (UConsider $s $o $fingerprint)) (UConsider $s $o $fingerprint)))))))
(= (UControl $s $e)
   (let* (($kind (index-atom $e 2)) ($id (index-atom $e 1)))
     (if (== $kind stop) (turn (USet $s suspended (index-atom $s 7) no-cache) stop human-stop)
       (if (== $kind pause) (turn (USet $s suspended (index-atom $s 7) no-cache) cancel-worker human-interruption)
         (if (== $kind resume) (turn (USet $s ready (index-atom $s 7) no-cache) wait human-resumption)
           (if (== $kind renew)
             (if (PHas $id (index-atom $s 12) 0) (turn $s wait duplicate-renewal)
               (if (> (index-atom $e 5) 0)
                 (turn (UState $s (+ (index-atom $s 5) (index-atom $e 5)) ready (index-atom $s 7)
                        no-cache (index-atom $s 11) (cons-atom $id (index-atom $s 12))) wait grant-renewed)
                 (turn $s wait invalid-renewal))) (turn $s wait unsupported-control)))))))
(= (UTurn $s $o $event $semantic $fingerprint)
   (if (and (PShape $s undertaking 13) (PShape $o observation-frame 9))
     (if (PShape $event control 6)
       (if (UEventScope $s $event) (UControl $s $event) (turn $s wait foreign-control))
       (if (UAuthority $s $o $semantic)
         (if (== (index-atom $s 6) suspended) (turn $s wait suspended) (URejoin $s $o $fingerprint))
         (turn (USet $s revalidation-required (index-atom $s 7) no-cache) wait authority-or-version-changed)))
     (fault malformed-undertaking-state)))
