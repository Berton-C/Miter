{
  "alias":"nemotron-local",
  "body": {
    "max_tokens":1024,
    "messages": [
      {
	"content":"Produce one bounded semantic reading as data. Return only the object required by the supplied schema. Do not produce executable code or instructions.",
	"role":"system"
      },
      {
	"content":"SOURCE: The copper key is inside the blue box. REQUEST: State where the copper key is. Cite one exact evidence span from SOURCE. If the source suffices, completion_status must be complete. uncertainty is a number from 0 to 1.",
	"role":"user"
      }
    ],
    "model":"nemotron-3.5-30b-a3b-antislop-ftpo-i1",
    "response_format": {
      "json_schema": {
	"name":"miter_semantic_result",
	"schema": {
	  "additionalProperties":false,
	  "properties": {
	    "answer": {"maxLength":240,"minLength":1,"type":"string"},
	    "completion_status": {"enum": ["complete", "insufficient_evidence" ],"type":"string"},
	    "evidence_spans": {
	      "items": {"maxLength":160,"minLength":1,"type":"string"},
	      "maxItems":3,
	      "minItems":1,
	      "type":"array"
	    },
	    "request_id": {"const":"g04-fixed-request-001","type":"string"},
	    "uncertainty": {"maximum":1,"minimum":0,"type":"number"}
	  },
	  "required": ["request_id", "answer", "uncertainty", "evidence_spans", "completion_status" ],
	  "type":"object"
	},
	"strict":true
      },
      "type":"json_schema"
    },
    "seed":404,
    "stream":false,
    "temperature":0,
    "ttl":300
  },
  "endpoint":"http://127.0.0.1:1235/v1/chat/completions",
  "request_id":"g04-fixed-request-001",
  "schema":"miter-prepared-model-request-v1"
}
