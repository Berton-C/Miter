; SC08: native lifecycle carries actual SC07 derivations; no behavior table.
; development-life: id scope phase dependency grant consumed purpose pending result.
; Driver turns recur independently of model calls or this undertaking's lifetime.
(= (CInitial $id $scope $grant)
 (development-life $id $scope ready unseen $grant 0 (purpose unformed) none unresolved))
(= (CValid $s)
 (if (PShape $s development-life 10)
  (and (PShape (index-atom $s 2) scope 5)
   (and (dc_counter (index-atom $s 6))
    (PHas (index-atom $s 3) (ready waiting pending paused stopped reconciliation revalidation-required incomplete awaiting-trial) 0))) false))
(= (CSet $s $phase $fp $used $purpose $pending $result)
 (development-life (index-atom $s 1) (index-atom $s 2) $phase $fp (index-atom $s 5) $used $purpose $pending $result))
(= (CHold $s $reason) (cycle-step $s () $reason))
(= (CTransition $s $phase $reason $effects)
 (cycle-step (CSet $s $phase (index-atom $s 4) (index-atom $s 6) (index-atom $s 7) (index-atom $s 8) $reason) $effects $reason))
(= (CConsider $s $obs)
 (let* (($id (index-atom $s 1)) ($scope (index-atom $s 2)) ($fp (index-atom $obs 1))
        ($frame (index-atom $obs 2)) ($records (index-atom $obs 3)) ($surfaces (index-atom $obs 4)) ($grant (index-atom $obs 5)))
  (if (== $grant (index-atom $s 5))
   (let* (($o (DOpportunity $id $scope $records $surfaces $grant)) ($rna (DDevelop $o)))
    (if (PShape $rna develop-rna 5)
     (if (< (index-atom $s 6) (index-atom $grant 2))
      (let $intention (RIntend expression (DGround $frame))
       (if (PShape $intention voice-intention 7)
        (let $q (VGeneration $id $o $frame)
         (cycle-step (CSet $s pending $fp (+ (index-atom $s 6) 1) (purpose $o $rna) (pending $id $fp $q) awaiting-model-result)
          ((dispatch $q $o $rna $frame $records $grant)) native-opportunity-transcribed))
        (cycle-step (CSet $s waiting $fp (index-atom $s 6) (purpose $o $rna) none (current-intention-incomplete $intention)) () current-intention-incomplete)))
      (CTransition $s incomplete resource-envelope-consumed ()))
     (cycle-step (CSet $s waiting $fp (index-atom $s 6) (purpose $o $rna) none $o) () native-opportunity-unavailable)))
   (CTransition $s revalidation-required authority-changed ()))))
(= (CAdmit $id $module $binding)
 (let $old (collapse (match &trial (trial-voice-realization $id $m) $m))
  (if (== (size-atom $old) 0) (VQuarantine $id $module $binding)
   (if (and (== $binding model-candidate-bound) (== $old ($module))) candidate-rehydrated trial-identity-conflict))))
(= (CProduct $s $obs $product)
 (let* (($m (index-atom $product 1)) ($binding (index-atom $product 2)) ($id (index-atom $s 1))
        ($admission (CAdmit $id $m $binding)))
  (if (PHas $admission (candidate-quarantined candidate-rehydrated) 0)
   (let* (($construction (VTrialConstruct $id (index-atom $obs 2) 256)) ($eligible (VEligible $construction)))
    (CTransition $s awaiting-trial (constructed-candidate $m $binding $construction $eligible) ()))
   (CTransition $s incomplete (candidate-uptake-incomplete $admission) ()))))
(= (CRejoin $s $obs)
 (if (and (== (index-atom $s 4) (index-atom $obs 1)) (== (index-atom $s 5) (index-atom $obs 5)))
  (let $worker (index-atom $obs 6)
   (if (== $worker pending) (CHold $s awaiting-model-result)
    (if (PShape $worker product 3) (CProduct $s $obs $worker)
     (if (== $worker outcome-uncertain) (CTransition $s reconciliation possibly-sent-result-unknown ())
      (CTransition $s incomplete (transport-incomplete $worker) ())))))
  (CTransition $s revalidation-required source-or-authority-changed ((cancel)))))
(= (COrient $s $obs)
 (let* (($phase (index-atom $s 3)) ($id (index-atom $s 1)))
  (if (== $phase pending) (CRejoin $s $obs)
   (if (== $phase awaiting-trial)
    (if (and (== (index-atom $s 4) (index-atom $obs 1)) (== (index-atom $s 5) (index-atom $obs 5)))
     (if (== (collapse (match &trial (trial-voice-realization $id $m) $m)) ())
      (CRejoin $s $obs) (CHold $s awaiting-independent-trial))
     (CTransition $s revalidation-required source-or-authority-changed ()))
    (if (PHas $phase (paused stopped reconciliation revalidation-required incomplete) 0) (CHold $s (index-atom $s 9))
     (if (== (index-atom $s 4) (index-atom $obs 1)) (CHold $s unchanged-dependencies) (CConsider $s $obs)))))))
(= (CControl $s $obs)
 (let* (($event (index-atom $obs 7)) ($id (index-atom $s 1)) ($scope (index-atom $s 2)) ($phase (index-atom $s 3)))
  (if (== $event (control $id $scope stop))
   (if (== $phase stopped) (CHold $s human-stopped) (CTransition $s stopped human-stopped ((cancel))))
   (if (== $event (control $id $scope pause))
    (if (== $phase paused) (CHold $s human-paused) (CTransition $s paused human-paused ((cancel))))
    (if (and (== $event (control $id $scope resume)) (PHas $phase (paused stopped reconciliation) 0))
     (if (== (index-atom $s 8) none)
      (CConsider $s $obs)
      (CRejoin (CSet $s pending (index-atom $s 4) (index-atom $s 6) (index-atom $s 7) (index-atom $s 8) rejoining) $obs))
     (COrient $s $obs))))))
(= (CStep $s $obs)
 (if (CValid $s)
  (if (PShape $obs cycle-observation 8)
   (if (PShape (index-atom $obs 2) voice-frame 9)
    (if (and (== (index-atom (index-atom $obs 2) 1) (index-atom $s 2))
             (and (is-expr (index-atom $obs 3)) (is-expr (index-atom $obs 4))))
     (CControl $s $obs) (CHold $s (cycle-fault malformed-or-foreign-input)))
    (CHold $s (cycle-fault malformed-frame)))
   (CHold $s (cycle-fault malformed-observation)))
  (CHold $s (cycle-fault malformed-state))))
