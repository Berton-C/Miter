; G28 finite executable development: supported interface gap, inert oracle,
; mechanical workshop, native exact-contract comparison, proposal not promotion.
(= (ZHuman $proof)
 (if (PShape $proof supported 4)
  (and (> (size-atom (index-atom $proof 3)) 0) (SHumanRoots (index-atom $proof 3) 0)) false))
(= (ZSource $input $id)
 (SupportFor (index-atom $input 2) (index-atom $input 3) (index-atom $input 4) (index-atom $input 5) $id ()))
(= (ZOpportunity $input)
 (if (PShape $input executable-input 9)
  (let* (($cp (ZSource $input (index-atom $input 6))) ($ip (ZSource $input (index-atom $input 7))) ($gp (ZSource $input (index-atom $input 8))))
   (if (and (ZHuman $cp) (and (ZHuman $ip) (ZHuman $gp)))
    (ZFromSources (index-atom $input 1) (index-atom $input 2)
     (index-atom $cp 1) (index-atom $ip 1) (index-atom $gp 1) (support $cp $ip $gp))
    (executable-development-held (unresolved-source $cp $ip $gp))))
  (executable-development-held malformed-input)))
(= (ZFromSources $id $scope $c $i $g $proofs)
 (if (and (PShape $c executable-contract 7) (and (PShape $i capability-inventory 4) (PShape $g executable-grant 6)))
  (if (and (== (index-atom $i 1) complete) (== (index-atom $i 2) $scope))
   (if (PHas (index-atom $c 2) (index-atom $i 3) 0)
    (executable-development-not-needed existing-interface $proofs)
    (if (ZGrantFits $c $g)
     (executable-opportunity $id $scope $c $i $g $proofs)
     (executable-development-held incompatible-contract-or-grant)))
   (executable-development-held inventory-incomplete-or-foreign))
  (executable-development-held malformed-source-contract)))
(= (ZGrantFits $c $g)
 (and (== (index-atom $g 1) (index-atom $c 1))
  (and (== (index-atom $c 3) utf8-argument-v1)
   (and (== (index-atom $c 4) same-bytes-plus-lf-v1)
    (and (> (index-atom $g 3) 0) (and (> (index-atom $g 4) 0) (> (index-atom $g 5) 0)))))))
(= (ZFilesValid $files)
 (if (== (size-atom $files) 2)
  (let $paths (collapse (let $f (superpose $files)
   (if (PShape $f candidate-file 4)
    (if (wz_string (index-atom $f 2)) (index-atom $f 1) (empty)) (empty))))
   (and (== (size-atom $paths) 2)
    (and (PHas "extension/adapter.sh" $paths 0) (PHas "candidate_tests/smoke.sh" $paths 0)))) false))
(= (ZCandidateValid $o $id $candidate)
 (if (PShape $candidate executable-candidate 4)
  (if (and (== (index-atom $candidate 1) $id) (ZFilesValid (index-atom $candidate 2)))
   (let* (($m (index-atom $candidate 3)) ($c (index-atom $o 3)))
    (if (and (PShape $m extension-manifest 17) (ZManifestExtras $o $id (index-atom $candidate 2) $m))
     (and (== (index-atom $m 1) (index-atom $c 1))
      (and (== (index-atom $m 3) (index-atom $c 3))
       (and (== (index-atom $m 4) (index-atom $c 4))
        (and (== (index-atom $m 5) (extension candidate_tests))
         (and (== (index-atom $m 6) (isolated-stdout))
          (and (== (index-atom $m 7) ())
           (and (== (index-atom $m 8) ())
            (and (== (index-atom $m 9) posix-shell)
             (and (== (index-atom $m 10) no-persistence)
              (and (== (index-atom $m 11) (fixed-contract candidate-smoke))
               (== (index-atom $m 13) human-before-promotion))))))))))) false)) false) false))
(= (ZObserveOne $case $observations)
 (let $found (SFind $observations (index-atom $case 1))
  (if (== (size-atom $found) 1)
   (let $row (index-atom $found 0)
    (if (PShape $row io-observation 4)
     (and (== (index-atom $row 2) 0) (== (index-atom $row 3) (index-atom $case 3))) false)) false)))
(= (ZCheck $cases $observations)
 (and (== (size-atom $cases) (size-atom $observations))
  (not (PHas false (collapse (let $case (superpose $cases) (ZObserveOne $case $observations))) 0))))
(= (ZCompare $cases $observations)
 (if (ZCheck $cases $observations)
  (executable-trial-qualified $cases $observations)
  (executable-trial-unqualified $cases $observations)))
(= (ZReceiptIs $receipt $status)
 (if (PShape $receipt workshop-result 5) (== (index-atom $receipt 2) $status) false))
(= (ZWrite $root $id $files $n)
 (if (< $n (size-atom $files))
  (let* (($f (index-atom $files $n))
         ($written (wz_request $root (wz_name write $n) write_candidate_file $id ((path (index-atom $f 1)) (contents (index-atom $f 2))))))
   (if (ZReceiptIs $written candidate-written) (ZWrite $root $id $files (+ $n 1))
    (executable-write-incomplete $written))) executable-files-written))
(= (ZTrials $root $id $cases $n)
 (if (< $n (size-atom $cases))
  (let* (($case (index-atom $cases $n))
         ($receipt (wz_request $root (wz_name trial $n) run_declared_test $id ((test_id (index-atom $case 1)))))
         ($obs (wz_observe $root (index-atom $case 1) $receipt)))
   (cons-atom $obs (ZTrials $root $id $cases (+ $n 1)))) ()))
(= (ZPrompt)
 "Return JSON containing only smoke: a concise POSIX shell test source string. The adapter is independently passing and MUST NOT be changed. Its interface is one UTF-8 COMMAND-LINE ARGUMENT, not stdin, and stdout must be exactly that argument followed by one LF. The old smoke and its actual failed process observation are included. Repair only that test. Invoke /bin/sh /workspace/extension/adapter.sh with one argument. One small case suffices, but compare exact bytes including the final LF; shell command substitution strips trailing newlines and is not an exact-byte comparison. Temporary test files under /tmp are permitted. The test must return zero for the correct adapter and nonzero for both a no-output adapter and an adapter missing its final LF. No network, secrets, host access or persistent changes; no explanations or manifest. Independent tests remain unchanged and outside your control.")
; Manifest meaning and authority are assembled natively, not generated. The
; source proofs, exact candidate hashes and field-origin record remain linked.
(= (ZAssemble $root $o $id $files)
 (let* (($c (index-atom $o 3)) ($runtime (wz_environment $root)))
  (executable-candidate $id $files
   (extension-manifest (index-atom $c 1) (index-atom $c 5)
    (index-atom $c 3) (index-atom $c 4) (extension candidate_tests)
    (isolated-stdout) () () posix-shell no-persistence
    (fixed-contract candidate-smoke)
    "Retain the prior base commit; candidate worktree is isolated and not activated."
    human-before-promotion
    (negative-controls missing-parent direct-main-write corrupted-observation unknown-observation truncated-product forged-lineage)
    $runtime
    (candidate-lineage $id (source-pressure (index-atom $o 6)) (file-hashes $files))))))
(= (ZManifestExtras $o $id $files $m)
 (and (== (index-atom $m 14) (negative-controls missing-parent direct-main-write corrupted-observation unknown-observation truncated-product forged-lineage))
  (and (PShape (index-atom $m 15) runtime-dependencies 5)
   (== (index-atom $m 16) (candidate-lineage $id (source-pressure (index-atom $o 6)) (file-hashes $files))))))
(= (ZReady $obs)
 (if (PShape $obs model-observation 11)
  (and (== (index-atom $obs 2) eof)
   (and (== (index-atom $obs 3) 200)
    (and (== (index-atom $obs 5) true)
     (and (== (index-atom $obs 6) stop)
      (== (index-atom $obs 7) artifact-shaped))))) false))
; This is a material observation predicate, not a failure->action entry.
; Complete malformed output can supply a concrete packaging discrepancy;
; arbitrary timeout labels or partial bytes alone cannot.
(= (ZPackagingDiscrepancy $obs)
 (if (PShape $obs model-observation 11)
  (and (== (index-atom $obs 2) eof)
   (and (== (index-atom $obs 3) 200)
    (and (== (index-atom $obs 5) true)
     (and (== (index-atom $obs 6) stop)
      (or (== (index-atom $obs 7) malformed-artifact) (== (index-atom $obs 7) schema-mismatch)))))) false))
(= (ZOperations)
 ((operation inspect-trial ((edge artifact ready)) ((edge undertaking fresh-observation)) ())
  (operation generate ((edge request material) (edge grant usable)) ((edge undertaking fresh-observation)) ())
  (operation narrow ((edge request verbose)) ((edge request material)) ((edge request verbose)))
  (operation incorporate ((edge discrepancy specific)) ((edge request material)) ((edge discrepancy specific)))
  (operation request-resources ((edge grant inadequate)) ((edge undertaking resource-question)) ())))
(= (ZFailureFacts $obs)
 (if (ZPackagingDiscrepancy $obs) ((edge discrepancy specific)) ()))
(= (ZBase)
 ((edge independent-tests intact) (edge authority human-promotion) (edge scope bounded)))
(= (ZGoals $target)
 ((path undertaking $target) (path independent-tests intact) (path authority human-promotion) (path scope bounded)))
(= (ZContinuationCompare $facts)
 (let* (($state (PAdd (ZBase) $facts 0))
        ($contact (DCCompare $state (ZGoals fresh-observation) (ZOperations) 3)))
  (if (PShape $contact continuation-supported 4) $contact
   (let $resource (DCCompare $state (ZGoals resource-question) (ZOperations) 3)
    (if (PShape $resource continuation-supported 4) $resource $contact)))))
(= (ZGrantFacts $o $attempt)
 (if (<= $attempt (index-atom (index-atom $o 5) 3))
  ((edge grant usable)) ((edge grant inadequate))))
(= (ZContinue $root $o $attempt $feedback $facts $candidate)
 (let* (($all (PAdd $facts (ZGrantFacts $o $attempt) 0))
        ($decision (ZContinuationCompare $all))
        ($record (development-continuation $o $feedback $candidate $decision))
        ($saved (wz_save $root (wz_key continuation $record) $record)))
  (if (== $saved stored)
   (if (PShape $decision continuation-supported 4)
    (ZPerform $root $o $attempt $feedback $facts $candidate (index-atom $decision 1))
    (executable-development-incomplete unresolved-continuation $decision $feedback))
   (executable-development-incomplete continuation-not-durable))))
(= (ZPerform $root $o $attempt $feedback $facts $candidate generate)
 (ZAttempt $root $o $attempt $feedback))
(= (ZPerform $root $o $attempt $feedback $facts $candidate incorporate)
 (ZContinue $root $o $attempt (address-observed-discrepancy $feedback)
  (PAdd (PDelete $facts ((edge discrepancy specific)) 0) ((edge request material)) 0) $candidate))
(= (ZPerform $root $o $attempt $feedback $facts $candidate narrow)
 (ZContinue $root $o $attempt (concise-files-only-preserving-contract $feedback)
  (PAdd (PDelete $facts ((edge request verbose)) 0) ((edge request material)) 0) $candidate))
(= (ZPerform $root $o $attempt $feedback $facts $candidate inspect-trial)
 (ZBuild $root $o (index-atom $candidate 1) (- $attempt 1) $feedback $candidate))
(= (ZPerform $root $o $attempt $feedback $facts $candidate request-resources)
 (executable-development-incomplete resource-request
  (undertaking-retained $o) (spent-attempts (- $attempt 1)) $feedback))
(= (ZAttempt $root $o $attempt $feedback)
 (let* (($revision (ZRevision $feedback))
        ($revisionSaved (wz_save $root (wz_name revision $attempt) $revision))
        ($id (wz_name executable $attempt))
        ($q (executable-generation $id $o $attempt qwen-local (ZPrompt) (ZOracleContext $revision)))
        ($stage (add-atom &derived (executable-generation-pending $root $q)))
        ($obs (wz_model $root $q))
        ($clear (remove-atom &derived (executable-generation-pending $root $q)))
        ($saved (wz_save $root (wz_name model $attempt) $obs)))
  (if (ZReady $obs)
   (let* (($files (PRMerge $revision (index-atom $obs 10)))
          ($candidate (ZAssemble $root $o $id $files))
          ($stored (wz_save $root (wz_name candidate $attempt) $candidate))
          ($origins (wz_save $root (wz_name manifest-origins $attempt)
           (manifest-origins $candidate (source-contract (index-atom $o 3)) (source-proofs (index-atom $o 6))
            (workshop-grant (index-atom $o 5)) (native-permission-template G28-R2) (model-observation $obs)))))
    (if (and (not (== (index-atom $revision 1) (index-atom $obs 10)))
             (and (ZCandidateValid $o $id $candidate) (== (wz_candidate_bound $root $id $candidate) candidate-source-bound)))
     (ZContinue $root $o (+ $attempt 1) $q ((edge artifact ready)) $candidate)
     (executable-development-incomplete candidate-source-or-contract-mismatch $obs)))
   (ZContinue $root $o (+ $attempt 1) $obs
    (ZFailureFacts $obs) no-candidate))))
(= (ZBuild $root $o $id $attempt $q $candidate)
 (let* (($quarantine (add-atom &trial (executable-candidate $id $candidate)))
        ($create (wz_request $root create create_candidate_worktree $id ()))
        ($writes (if (ZReceiptIs $create candidate-created) (ZWrite $root $id (index-atom $candidate 2) 0) $create)))
  (if (== $writes executable-files-written)
   (ZEvaluate $root $o $id $attempt $q $candidate)
   (executable-development-incomplete $writes))))
(= (ZEvaluate $root $o $id $attempt $q $candidate)
 (let* (($cases (index-atom (index-atom $o 3) 6))
        ($observations (ZTrials $root $id $cases 0))
        ($comparison (ZCompare $cases $observations))
        ($smoke (wz_request $root smoke run_declared_test $id ((test_id candidate-smoke))))
        ($smokeEvidence (wz_test_observation $root candidate-smoke $smoke))
        ($noOutput (ZMutationTrial $root $id smoke-no-output))
        ($noLF (ZMutationTrial $root $id smoke-no-lf))
        ($sensitivity (test-sensitivity $noOutput $noLF))
        ($trial (executable-trial $candidate $comparison $smoke $smokeEvidence $sensitivity))
        ($recorded (wz_save $root (wz_name trial $attempt) $trial))
        ($disk (wz_disk_bound $root $id $candidate))
        ($commit (if (== $disk candidate-disk-bound)
          (wz_request $root commit commit_candidate $id
           ((message "Miter-origin partial executable repair") (lineage (wz_details $root lineage $q))))
          (candidate-disk-unbound))))
  (if (and (PShape $comparison executable-trial-qualified 3)
       (and (ZSmokePassed $smokeEvidence) (ZSensitivityPassed $sensitivity)))
   (ZPropose $root $o $id $candidate $trial $commit)
   (ZRepairContinue $root $o (+ $attempt 1) $trial $candidate))))
(= (ZSmokePassed $s)
 (if (PShape $s process-observation 7)
  (and (== (index-atom $s 2) 0) (== (index-atom $s 5) false)) false))
(= (ZCaseCounterexample $case $observations)
 (let $rows (SFind $observations (index-atom $case 1))
  (if (== (size-atom $rows) 1)
   (let $r (index-atom $rows 0)
    (if (PShape $r io-observation 4)
     (or (not (== (index-atom $r 2) 0)) (not (== (index-atom $r 3) (index-atom $case 3)))) false)) false)))
(= (ZTrialFacts $comparison $smoke)
 (let* (($ioCounterexample
          (if (PShape $comparison executable-trial-unqualified 3)
           (let* (($cases (index-atom $comparison 1)) ($observations (index-atom $comparison 2)))
            (PHas true (collapse (let $c (superpose $cases)
              (ZCaseCounterexample $c $observations))) 0)) false))
        ($smokeCounterexample
          (if (PShape $smoke process-observation 7) (not (== (index-atom $smoke 2) 0)) false)))
  (if (or $ioCounterexample $smokeCounterexample) ((edge discrepancy specific)) ())))
(= (ZPropose $root $o $id $candidate $trial $commit)
 (if (ZReceiptIs $commit candidate-committed)
  (let* (($proposal (executable-promotion-proposal $o $candidate $trial $commit awaiting-explicit-human-approval))
         ($stored (wz_save $root proposal $proposal))
         ($sent (wz_request $root proposal submit_promotion_request $id
          ((proposal (wz_details $root proposal $proposal)) (commit (wz_details $root commit $commit))))))
   (if (ZReceiptIs $sent promotion-proposed)
    (executable-awaiting-approval $proposal $sent)
    (executable-development-incomplete $sent)))
  (executable-development-incomplete $commit)))
(= (ZRun $root)
 (let* (($input (wz_input $root)) ($o (ZOpportunity $input)) ($saved (wz_save $root opportunity $o))
        ($prior (wz_prior $root)))
  (if (PShape $o executable-opportunity 7)
   (if (and (== (index-atom (index-atom $o 5) 2) (wz_grant_id $root))
        (PShape $prior prior-executable-trial 4))
    (ZRepairContinue $root $o 1 (index-atom $prior 2) (index-atom $prior 1))
    (executable-development-held workshop-grant-mismatch)) $o)))

; Bind real file dependencies to actual typed observations. The partial planner
; itself has no special knowledge of smoke tests or adapter file names.
(= (ZObligations $trial)
 (let* (($comparison (index-atom $trial 2)) ($cases (index-atom $comparison 1))
        ($observations (index-atom $comparison 2))
        ($io (collapse (let $c (superpose $cases)
         (let* (($id (index-atom $c 1)) ($found (SFind $observations $id)))
          (file-obligation "extension/adapter.sh" $id (expected-bytes (index-atom $c 3))
           (if (== (size-atom $found) 1) (index-atom $found 0) (observation-unresolved $found)))))))
        ($smoke ((file-obligation "candidate_tests/smoke.sh" candidate-smoke (expected-exit 0) (index-atom $trial 4))))
        ($mutants (if (== (size-atom $trial) 6)
          (let* (($s (index-atom $trial 5)) ($rows ((index-atom $s 1) (index-atom $s 2))))
           (collapse (let $r (superpose $rows)
            (file-obligation "candidate_tests/smoke.sh" (index-atom $r 1) (expected-nonzero) $r)))) ())))
  (union-atom $io (union-atom $smoke $mutants))))
(= (ZRevision $feedback)
 (if (PShape $feedback targeted-repair 4) (index-atom $feedback 1)
  (if (PShape $feedback address-observed-discrepancy 2) (ZRevision (index-atom $feedback 1))
   (partial-revision () () (unresolved) (basis unknown)))))
(= (ZOracleContext $revision)
 (partial-revision-context (replace (index-atom $revision 1))
  (preserve (index-atom $revision 2))
  (observed-obligations (index-atom (index-atom $revision 4) 2))))
(= (ZRepairContinue $root $o $attempt $trial $candidate)
 (let* (($rows (ZObligations $trial)) ($revision (PRConstruct (index-atom $candidate 2) $rows))
        ($targets (index-atom $revision 1))
        ($feedback (targeted-repair $revision $trial (retained-lineage (wz_prior $root)))))
  (if (and (PRReady $revision) (and (== (size-atom $targets) 1)
       (== (index-atom (index-atom $targets 0) 1) "candidate_tests/smoke.sh")))
   (ZContinue $root $o $attempt $feedback ((edge discrepancy specific)) $candidate)
   (executable-development-incomplete unresolved-partial-repair $revision))))
(= (ZMutationTrial $root $id $test)
 (let $receipt (wz_request $root $test run_declared_test $id ((test_id $test)))
  (wz_test_observation $root $test $receipt)))
(= (ZRejects $obs)
 (if (PShape $obs process-observation 7)
  (and (not (== (index-atom $obs 2) 0)) (== (index-atom $obs 5) false)) false))
(= (ZSensitivityPassed $s)
 (if (PShape $s test-sensitivity 3)
  (and (ZRejects (index-atom $s 1)) (ZRejects (index-atom $s 2))) false))
