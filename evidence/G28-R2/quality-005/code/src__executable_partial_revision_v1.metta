; Pure generic file/obligation comparison. Neither file names nor failure labels
; choose behavior. Unknown evidence stays unknown; passing files keep their origin.
(= (PRState $row)
 (if (PShape $row file-obligation 5)
  (let* (($id (index-atom $row 2)) ($e (index-atom $row 3)) ($o (index-atom $row 4)))
   (if (PShape $e expected-bytes 2)
    (if (PShape $o io-observation 4)
     (if (== $id (index-atom $o 1))
      (if (and (== (index-atom $o 2) 0) (== (index-atom $o 3) (index-atom $e 1))) satisfied violated) unknown) unknown)
    (if (or (PShape $e expected-exit 2) (== $e (expected-nonzero)))
     (if (PShape $o process-observation 7)
      (if (and (== $id (index-atom $o 1)) (== (index-atom $o 5) false))
       (if (if (== $e (expected-nonzero)) (not (== (index-atom $o 2) 0)) (== (index-atom $o 2) (index-atom $e 1))) satisfied violated) unknown) unknown) unknown))) unknown))
(= (PRFileState $file $rows)
 (let* (($path (index-atom $file 1))
        ($states (collapse (let $r (superpose $rows)
         (if (and (PShape $r file-obligation 5) (== (index-atom $r 1) $path)) (PRState $r) (empty))))))
  (if (PHas violated $states 0) replace
   (if (or (== (size-atom $states) 0) (PHas unknown $states 0)) unresolved retain))))
(= (PRSelect $files $rows $state)
 (collapse (let $f (superpose $files) (if (== (PRFileState $f $rows) $state) $f (empty)))))
(= (PRConstruct $files $rows)
 (partial-revision (PRSelect $files $rows replace) (PRSelect $files $rows retain)
  (PRSelect $files $rows unresolved) (basis $files $rows)))
(= (PRReady $r)
 (if (PShape $r partial-revision 5)
  (and (> (size-atom (index-atom $r 1)) 0) (== (size-atom (index-atom $r 3)) 0)) false))
(= (PRMerge $revision $generated)
 (let* (($targets (index-atom $revision 1))
        ($paths (collapse (let $f (superpose $targets) (index-atom $f 1))))
        ($newPaths (collapse (let $f (superpose $generated) (index-atom $f 1)))))
  (if (and (PRReady $revision) (and (== (size-atom $paths) (size-atom $newPaths))
       (not (PHas false (collapse (let $p (superpose $paths)
        (== (size-atom (collapse (let $n (superpose $newPaths) (if (== $n $p) $n (empty))))) 1))) 0))))
   (union-atom (index-atom $revision 2) $generated) (partial-assembly-held))))
