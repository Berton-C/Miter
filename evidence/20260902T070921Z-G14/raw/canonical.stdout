                  F),
            E),
    I=J,
    findall(G,
            match('&soul',
                  ['soul-relation', A, F, G, H],
                  G,
                  G),
            J),
    'size-atom'(D, K),
    ==(K, 1, L),
    'size-atom'(I, M),
    ==(M, 1, N),
    and(L, N, O),
    (   O==true
    ->  'is-expr'(B, P),
        (   P==true
        ->  'size-atom'(B, Q),
