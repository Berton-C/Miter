                'index-atom'(B, 0, T),
                'SoulRequire'(S, T, U),
                ==(U, witnessed, V),
                'index-atom'(I, 0, W),
                'index-atom'(B, 1, X),
                'SoulRequire'(W, X, Y),
                ==(Y, witnessed, Z),
                and(V, Z, A1),
                (   A1==true
                ->  C=witnessed
