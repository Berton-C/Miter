; G29 candidate construction. The LLM is an inert renderer: native comparison
; retains design authority and qualifies only complete, source-bound artifacts.
(= (SXPrompt)
 "Produce a compact, inert Mattermost bridge candidate in SWI-Prolog. Return only the required JSON. Implement the generic public predicates surface_ingest/5, surface_effect/5, surface_reconnect/2, and surface_panic/2. The bridge only transports and maps authenticated identity; it never reasons about values, Soul, memory, or Chroma. Authorization must precede event construction. Stable server/team/channel/user/post/root/timestamp/cursor identities must be preserved. State must support duplicate suppression, edits, monotone cursor/reconnect, outbound effect-id/idempotency suppression, typed send failures, and panic denial. Credentials may only arrive later through a bridge environment and must never be embedded, returned, logged, or placed in events. G29 has no network and no credentials. Keep code and plunit tests small and dependency-light. Use the supplied official Mattermost facts and native design. Do not alter the core or the acceptance contract.")
(= (SXReadyObservation $obs)
 (if (PShape $obs surface-model-observation 11)
  (and (== (index-atom $obs 2) eof)
   (and (== (index-atom $obs 3) 200)
    (and (== (index-atom $obs 5) true)
     (and (== (index-atom $obs 6) stop)
      (== (index-atom $obs 7) artifact-shaped))))) false))
(= (SXExpectedPaths)
 ("extension/mattermost_bridge.pl" "candidate_tests/mattermost_contract_tests.pl"))
(= (SXPaths $files)
 (collapse (let $f (superpose $files)
  (if (PShape $f surface-candidate-file 4) (index-atom $f 1) (empty)))))
(= (SXFilesValid $files)
 (let $paths (SXPaths $files)
  (and (== (size-atom $paths) 2)
   (and (== (size-atom (SUnion () $paths 0)) 2)
    (and (PHas "extension/mattermost_bridge.pl" $paths 0)
     (PHas "candidate_tests/mattermost_contract_tests.pl" $paths 0))))))
(= (SXManifestValid $manifest $selection)
 (let $modality (index-atom (index-atom $selection 1) 1)
  (== $manifest
   (mattermost-manifest miter-mattermost-extension-manifest-v1
    mattermost-surface-bridge $modality transport-and-identity-mapping-only
    mattermost-rest-v4-and-websocket surface-event-effect-v1
    (permissions none-in-g29 () human-gated-after-g30)
    (server_id team_id channel_id user_id post_id root_id event_timestamp cursor)
    stable-effect-id-and-idempotency-key
    durable-monotone-cursor-with-duplicate-suppression
    bridge-environment-only-never-returned
    core-derived-from-authenticated-surface-and-channel
    typed-surface-failure-event fixed-local-stop-denies-new-effects
    versioned-projection-preserves-history
    (authorized duplicate edited unauthorized send-failure reconnect cursor-resume panic)))))
(= (SXScanValid $scan)
 (if (PShape $scan surface-candidate-scan 5)
  (and (== (index-atom $scan 2) ()) (and (== (index-atom $scan 3) ()) (== (index-atom $scan 4) exact-files))) false))
(= (SXSyntaxValid $syntax)
 (if (PShape $syntax surface-candidate-syntax 4)
  (and (== (index-atom $syntax 1) 0)
   (and (== (index-atom $syntax 2) 0) (== (index-atom $syntax 3) false))) false))
(= (SXChecks $design $candidate $scan $syntax)
 (let* (($manifest (index-atom $candidate 5)) ($files (index-atom $candidate 6))
        ($selection (index-atom $design 8)))
  ((obligation design-lineage (if (== (index-atom $candidate 1) (index-atom $design 1)) satisfied unresolved))
   (obligation rationale-and-plan (if (sd_nonempty (index-atom $candidate 3) (index-atom $candidate 4)) satisfied unresolved))
   (obligation manifest (if (SXManifestValid $manifest $selection) satisfied unresolved))
   (obligation exact-files (if (SXFilesValid $files) satisfied unresolved))
   (obligation boundary-isolation (if (SXScanValid $scan) satisfied unresolved))
   (obligation syntax (if (SXSyntaxValid $syntax) satisfied unresolved)))))
(= (SXChecksReady $checks)
 (not (PHas unresolved (collapse (let $c (superpose $checks) (index-atom $c 2))) 0)))
(= (SXAssess $design $candidate $scan $syntax)
 (let $checks (SXChecks $design $candidate $scan $syntax)
  (if (SXChecksReady $checks)
   (surface-candidate-qualified $candidate $checks $scan $syntax)
   (surface-candidate-unqualified $candidate $checks $scan $syntax))))
(= (SXAttempt $root $design $attempt $feedback)
 (let* (($id (sx_name mattermost $attempt))
        ($q (surface-generation $id (index-atom $design 1) $design $attempt qwen-local (SXPrompt) $feedback))
        ($stage (add-atom &derived (surface-generation-pending $root $q)))
        ($obs (sx_model $root $q))
        ($clear (remove-atom &derived (surface-generation-pending $root $q)))
        ($saved (sx_save $root (sx_name model $attempt) $obs)))
  (if (SXReadyObservation $obs)
   (let* (($candidate (index-atom $obs 10))
          ($material (sx_materialize $root $candidate))
          ($scan (sx_scan $root $candidate))
          ($syntax (sx_syntax $root $candidate))
          ($assessment (SXAssess $design $candidate $scan $syntax))
          ($record (sx_save $root (sx_name assessment $attempt) $assessment)))
    (if (PShape $assessment surface-candidate-qualified 5)
     (surface-extension-proposal $design $assessment awaiting-G30-independent-trial)
     (if (< $attempt 4) (SXAttempt $root $design (+ $attempt 1) $assessment)
      (surface-extension-incomplete $assessment))))
   (if (< $attempt 4) (SXAttempt $root $design (+ $attempt 1) $obs)
    (surface-extension-incomplete $obs)))))
(= (SXRun $root)
 (let $design (SDRun $root)
  (if (PShape $design surface-design 11)
   (let* (($result (SXAttempt $root $design 1 no-prior-candidate))
          ($saved (sx_save $root final $result))) $result)
   (surface-extension-held $design))))

; R1 decomposes rendering after the retained monolithic timeout. The compact
; context is a native projection of the source-bound design, not a model vote.
(= (SXDesignContext $design)
 (surface-render-context (index-atom $design 1)
  (index-atom (index-atom (index-atom $design 8) 1) 1)
  (index-atom $design 4) (index-atom $design 5) (index-atom $design 9)
  (index-atom $design 7)))
(= (SXPartPrompt design)
 "Return only the required compact design JSON. Explain why a SWI-Prolog bridge is a non-cognitive transport/identity membrane, how authorization precedes cognition, how stable identities, duplicate/effect idempotency, edits, cursor/reconnect, typed failure, panic, credential isolation, core-derived memory scope, rollback, and G30 tests fit together. Do not write code and do not claim live authority.")
(= (SXPartPrompt bridge)
 "Return JSON containing only compact SWI-Prolog bridge source in content. Define module miter_mattermost_bridge exporting surface_ingest/5, surface_effect/5, surface_reconnect/4, surface_panic/2. Use explicit Config and immutable State dicts; no dynamic database. surface_ingest(Config,State0,Frame,State,Outcome) must authorize stable server/team/channel/user IDs before parsing payload; support posted and post_edited frames, duplicate suppression by post ID plus update timestamp, monotone integer cursor, and emit a miter-surface-event-v1 dict with all required IDs and authorization_ref. surface_effect(Config,State0,Effect,State,Outcome) must validate a miter-surface-effect-v1 dict, deny panic, preserve a stable idempotency key, suppress duplicate effects, and return an inert POST /api/v4/posts request descriptor or typed rejection; never send it. surface_reconnect/4 rejects stale cursors. surface_panic/2 sets panic true. Credentials, host URLs, global state, model calls, core reasoning and private-memory access are forbidden. Keep under 180 lines.")
(= (SXPartPrompt tests)
 "Return JSON containing only compact SWI-Prolog plunit source in content. Import ../extension/mattermost_bridge.pl and test the declared public predicates without network or credentials. Include authorized stable event mapping, duplicate suppression, edited post distinction, unauthorized channel/user before payload construction, idempotent outbound request, malformed/send-failure-shaped effect rejection, reconnect and cursor resume, and panic denial. Tests must be deterministic and under 180 lines; do not redefine the bridge.")
(= (SXPartReady $obs $part)
 (if (PShape $obs surface-part-observation 12)
  (and (== (index-atom $obs 2) $part)
   (and (== (index-atom $obs 3) eof)
    (and (== (index-atom $obs 4) 200)
     (and (== (index-atom $obs 6) true)
      (and (== (index-atom $obs 7) stop)
       (== (index-atom $obs 8) artifact-shaped)))))) false))
(= (SXPart $root $design $slot $part $feedback)
 (let* (($id (sx_part_name $part $slot))
        ($context (SXDesignContext $design))
        ($q (surface-part-generation $id (index-atom $design 1) $context $slot $part qwen-local (SXPartPrompt $part) $feedback))
        ($stage (add-atom &derived (surface-part-generation-pending $root $q)))
        ($obs (sx_part_model $root $q))
        ($clear (remove-atom &derived (surface-part-generation-pending $root $q)))
        ($saved (sx_save $root (sx_name part $slot) $obs)))
  $obs))
(= (SXAssemble $design $designPart $bridgePart $testsPart)
 (if (and (SXPartReady $designPart design)
      (and (SXPartReady $bridgePart bridge) (SXPartReady $testsPart tests)))
  (let* (($d (index-atom $designPart 11)) ($b (index-atom $bridgePart 11)) ($t (index-atom $testsPart 11)))
   (surface-extension-candidate (index-atom $design 1) mattermost-r1
    (index-atom $d 3) (index-atom $d 4) (index-atom $d 5)
    ((index-atom $b 3) (index-atom $t 3))
    (model-products (index-atom $d 2) (index-atom $b 2) (index-atom $t 2))))
  (surface-candidate-incomplete $designPart $bridgePart $testsPart)))
(= (SXR1Run $root)
 (let $design (SDRun $root)
  (if (PShape $design surface-design 11)
   (let* (($designPart (SXPart $root $design 1 design no-prior-part))
          ($bridgePart (SXPart $root $design 2 bridge $designPart))
          ($testsPart (SXPart $root $design 3 tests (parts $designPart $bridgePart)))
          ($candidate (SXAssemble $design $designPart $bridgePart $testsPart)))
    (if (PShape $candidate surface-extension-candidate 8)
     (let* (($material (sx_materialize $root $candidate))
            ($scan (sx_scan $root $candidate))
            ($syntax (sx_syntax $root $candidate))
            ($assessment (SXAssess $design $candidate $scan $syntax))
            ($record (sx_save $root assessment-r1 $assessment))
            ($result (if (PShape $assessment surface-candidate-qualified 5)
              (surface-extension-proposal $design $assessment awaiting-G30-independent-trial)
              (surface-extension-incomplete $assessment)))
            ($saved (sx_save $root final-r1 $result))) $result)
     (surface-extension-incomplete $candidate)))
   (surface-extension-held $design))))
