; G29 native design construction. Source-grounded requirements and measured
; runtime capabilities determine eligibility; no model chooses the modality.
(= (SDSource $input $id)
 (SupportFor (index-atom $input 3) (index-atom $input 4) (index-atom $input 5) (index-atom $input 6) $id ()))
(= (SDPayload $proof)
 (if (PShape $proof supported 4) (index-atom $proof 1) (unresolved-source $proof)))
(= (SDOpportunity $input)
 (if (PShape $input surface-design-input 12)
  (let* (($request (SDSource $input (index-atom $input 7)))
         ($contract (SDSource $input (index-atom $input 8)))
         ($api (SDSource $input (index-atom $input 9)))
         ($prior (SDSource $input (index-atom $input 10)))
         ($grant (SDSource $input (index-atom $input 11))))
   (if (and (PShape $request supported 4)
        (and (PShape $contract supported 4)
         (and (PShape $api supported 4)
          (and (PShape $prior supported 4) (PShape $grant supported 4)))))
    (surface-design-opportunity (index-atom $input 1) (index-atom $input 2)
     (SDPayload $request) (SDPayload $contract) (SDPayload $api)
     (SDPayload $prior) (SDPayload $grant)
     (source-basis $request $contract $api $prior $grant))
    (surface-design-held (unresolved-sources $request $contract $api $prior $grant))))
  (surface-design-held malformed-input)))
(= (SDHasCapability $required $available)
 (PHas true (collapse (let $a (superpose $available) (== $a (capability $required)))) 0))
(= (SDCovers $required $available $i)
 (if (< $i (size-atom $required))
  (and (SDHasCapability (index-atom $required $i) $available)
   (SDCovers $required $available (+ $i 1))) true))
(= (SDOptionQualified $required $option)
 (if (PShape $option modality-capability 6)
  (and (SDCovers $required (index-atom $option 2) 0)
   (and (== (index-atom $option 3) non-cognitive-effect-membrane)
    (and (== (index-atom $option 4) runtime-authorized)
     (== (index-atom $option 5) no-new-runtime-dependency)))) false))
(= (SDQualified $required $inventory)
 (collapse (let $option (superpose (index-atom $inventory 1))
  (if (SDOptionQualified $required $option) $option (empty)))))
(= (SDSelect $required $inventory)
 (let $eligible (SDQualified $required $inventory)
  (if (== (size-atom $eligible) 1)
   (modality-selected (index-atom $eligible 0) (eligible $eligible))
   (modality-unresolved (eligible $eligible) (required $required) (observed $inventory)))))
(= (SDContractValid $contract)
 (if (PShape $contract surface-contract 5)
  (and (== (index-atom $contract 1) surface-event-v1)
   (and (== (index-atom $contract 2) surface-effect-v1)
    (and (> (size-atom (index-atom $contract 3)) 0)
     (> (size-atom (index-atom $contract 4)) 0)))) false))
(= (SDGrantValid $grant)
 (if (PShape $grant surface-design-grant 8)
  (and (== (index-atom $grant 1) G29)
   (and (== (index-atom $grant 2) no-live)
    (and (== (index-atom $grant 3) no-credentials)
     (and (> (index-atom $grant 4) 0)
      (and (> (index-atom $grant 5) 0) (> (index-atom $grant 6) 0)))))) false))
(= (SDConstruct $opportunity $inventory)
 (if (PShape $opportunity surface-design-opportunity 9)
  (let* (($contract (index-atom $opportunity 4))
         ($grant (index-atom $opportunity 7)))
   (if (and (SDContractValid $contract) (SDGrantValid $grant))
    (let $selection (SDSelect (index-atom $contract 3) $inventory)
     (if (PShape $selection modality-selected 3)
      (surface-design (index-atom $opportunity 1) (index-atom $opportunity 2)
       (index-atom $opportunity 3) $contract (index-atom $opportunity 5)
       (index-atom $opportunity 6) $grant $selection
       (design-obligations (index-atom $contract 4))
       (design-basis (index-atom $opportunity 8) $inventory))
      (surface-design-held $selection)))
    (surface-design-held malformed-contract-or-grant)))
  $opportunity))
(= (SDRun $root)
 (let* (($input (sd_input $root))
        ($opportunity (SDOpportunity $input))
        ($inventory (sd_runtime $root))
        ($design (SDConstruct $opportunity $inventory))
        ($saved (sd_save $root design $design)))
  $design))
