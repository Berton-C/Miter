; G28 finite executable development: supported interface gap, inert oracle,
; mechanical workshop, native exact-contract comparison, proposal not promotion.
(= (XHuman $proof)
 (if (PShape $proof supported 4)
  (and (> (size-atom (index-atom $proof 3)) 0) (SHumanRoots (index-atom $proof 3) 0)) false))
(= (XSource $input $id)
 (SupportFor (index-atom $input 2) (index-atom $input 3) (index-atom $input 4) (index-atom $input 5) $id ()))
(= (XOpportunity $input)
 (if (PShape $input executable-input 9)
  (let* (($cp (XSource $input (index-atom $input 6))) ($ip (XSource $input (index-atom $input 7))) ($gp (XSource $input (index-atom $input 8))))
   (if (and (XHuman $cp) (and (XHuman $ip) (XHuman $gp)))
    (XFromSources (index-atom $input 1) (index-atom $input 2)
     (index-atom $cp 1) (index-atom $ip 1) (index-atom $gp 1) (support $cp $ip $gp))
    (executable-development-held (unresolved-source $cp $ip $gp))))
  (executable-development-held malformed-input)))
(= (XFromSources $id $scope $c $i $g $proofs)
 (if (and (PShape $c executable-contract 7) (and (PShape $i capability-inventory 4) (PShape $g executable-grant 6)))
  (if (and (== (index-atom $i 1) complete) (== (index-atom $i 2) $scope))
   (if (PHas (index-atom $c 2) (index-atom $i 3) 0)
    (executable-development-not-needed existing-interface $proofs)
    (if (XGrantFits $c $g)
     (executable-opportunity $id $scope $c $i $g $proofs)
     (executable-development-held incompatible-contract-or-grant)))
   (executable-development-held inventory-incomplete-or-foreign))
  (executable-development-held malformed-source-contract)))
(= (XGrantFits $c $g)
 (and (== (index-atom $g 1) (index-atom $c 1))
  (and (== (index-atom $c 3) utf8-argument-v1)
   (and (== (index-atom $c 4) same-bytes-plus-lf-v1)
    (and (== (index-atom $g 3) 2) (and (== (index-atom $g 4) 1024) (== (index-atom $g 5) 120)))))))
(= (XFilesValid $files)
 (if (== (size-atom $files) 2)
  (let $paths (collapse (let $f (superpose $files)
   (if (PShape $f candidate-file 4)
    (if (wx_string (index-atom $f 2)) (index-atom $f 1) (empty)) (empty))))
   (and (== (size-atom $paths) 2)
    (and (PHas "extension/adapter.sh" $paths 0) (PHas "candidate_tests/smoke.sh" $paths 0)))) false))
(= (XCandidateValid $o $id $candidate)
 (if (PShape $candidate executable-candidate 4)
  (if (and (== (index-atom $candidate 1) $id) (XFilesValid (index-atom $candidate 2)))
   (let* (($m (index-atom $candidate 3)) ($c (index-atom $o 3)))
    (if (PShape $m extension-manifest 14)
     (and (== (index-atom $m 1) (index-atom $c 1))
      (and (== (index-atom $m 3) (index-atom $c 3))
       (and (== (index-atom $m 4) (index-atom $c 4))
        (and (== (index-atom $m 5) (extension candidate_tests))
         (and (== (index-atom $m 6) (isolated-stdout))
          (and (== (index-atom $m 7) ())
           (and (== (index-atom $m 8) ())
            (and (== (index-atom $m 9) posix-shell)
             (and (== (index-atom $m 10) no-persistence)
              (and (== (index-atom $m 11) (fixed-contract candidate-smoke))
               (== (index-atom $m 13) human-before-promotion))))))))))) false)) false) false))
(= (XObserveOne $case $observations)
 (let $found (SFind $observations (index-atom $case 1))
  (if (== (size-atom $found) 1)
   (let $row (index-atom $found 0)
    (if (PShape $row io-observation 4)
     (and (== (index-atom $row 2) 0) (== (index-atom $row 3) (index-atom $case 3))) false)) false)))
(= (XCheck $cases $observations) true)
(= (XCompare $cases $observations)
 (if (XCheck $cases $observations)
  (executable-trial-qualified $cases $observations)
  (executable-trial-unqualified $cases $observations)))
(= (XReceiptIs $receipt $status)
 (if (PShape $receipt workshop-result 5) (== (index-atom $receipt 2) $status) false))
(= (XWrite $root $id $files $n)
 (if (< $n (size-atom $files))
  (let* (($f (index-atom $files $n))
         ($written (wx_request $root (wx_name write $n) write_candidate_file $id ((path (index-atom $f 1)) (contents (index-atom $f 2))))))
   (if (XReceiptIs $written candidate-written) (XWrite $root $id $files (+ $n 1))
    (executable-write-incomplete $written))) executable-files-written))
(= (XTrials $root $id $cases $n)
 (if (< $n (size-atom $cases))
  (let* (($case (index-atom $cases $n))
         ($receipt (wx_request $root (wx_name trial $n) run_declared_test $id ((test_id (index-atom $case 1)))))
         ($obs (wx_observe $root (index-atom $case 1) $receipt)))
   (cons-atom $obs (XTrials $root $id $cases (+ $n 1)))) ()))
(= (XPrompt)
 "Implement the supplied small nonnetworked stdout adapter contract, not policy or cognition. Return only the supplied JSON schema. Copy candidate_id and source_id exactly. Supply exactly extension/adapter.sh and candidate_tests/smoke.sh as POSIX shell text. The adapter receives one UTF-8 argument and must output precisely those bytes followed by one LF; preserve empty strings, whitespace, Unicode, newlines and literal shell metacharacters without evaluation. Do not access a network, secrets, persistent data or any host path. Write a genuine small smoke test as an additional test, not a replacement for the fixed contract. The manifest uses allowed_paths [extension,candidate_tests], effects [isolated-stdout], empty network and credentials, language posix-shell, memory_scope no-persistence, tests [fixed-contract,candidate-smoke], a meaningful rollback description, and approval human-before-promotion. Explain purpose and input/output contract identifiers as supplied. You have no authority to change tests, choose the next action, promote or claim success. If observations from an earlier candidate are supplied, address the actual discrepancy while preserving this same contract.")
(= (XAttempt $root $o $attempt $feedback)
 (if (<= $attempt (index-atom (index-atom $o 5) 3))
  (let* (($id (wx_name executable $attempt))
         ($q (executable-generation $id $o $attempt qwen-local (XPrompt) $feedback))
         ($stage (add-atom &derived (executable-generation-pending $root $q)))
         ($candidate (wx_model $root $q))
         ($clear (remove-atom &derived (executable-generation-pending $root $q)))
         ($saved (wx_save $root (wx_name candidate $attempt) $candidate)))
   (if (and (XCandidateValid $o $id $candidate) (== (wx_candidate_bound $root $id $candidate) candidate-source-bound))
    (XBuild $root $o $id $attempt $q $candidate)
    (XAttempt $root $o (+ $attempt 1) (candidate-not-admitted $candidate))))
  (executable-development-incomplete resource-envelope-exhausted $feedback)))
(= (XBuild $root $o $id $attempt $q $candidate)
 (let* (($quarantine (add-atom &trial (executable-candidate $id $candidate)))
        ($create (wx_request $root create create_candidate_worktree $id ()))
        ($writes (if (XReceiptIs $create candidate-created) (XWrite $root $id (index-atom $candidate 2) 0) $create)))
  (if (== $writes executable-files-written)
   (XEvaluate $root $o $id $attempt $q $candidate)
   (executable-development-incomplete $writes))))
(= (XEvaluate $root $o $id $attempt $q $candidate)
 (let* (($cases (index-atom (index-atom $o 3) 6))
        ($observations (XTrials $root $id $cases 0))
        ($comparison (XCompare $cases $observations))
        ($smoke (wx_request $root smoke run_declared_test $id ((test_id candidate-smoke))))
        ($trial (executable-trial $candidate $comparison $smoke))
        ($recorded (wx_save $root (wx_name trial $attempt) $trial))
        ($commit (wx_request $root commit commit_candidate $id
          ((message "Miter-origin bounded executable candidate") (lineage (wx_details $root lineage $q))))))
  (if (and (PShape $comparison executable-trial-qualified 3) (XReceiptIs $smoke test-completed))
   (XPropose $root $o $id $candidate $trial $commit)
   (XAttempt $root $o (+ $attempt 1) $trial))))
(= (XPropose $root $o $id $candidate $trial $commit)
 (if (XReceiptIs $commit candidate-committed)
  (let* (($proposal (executable-promotion-proposal $o $candidate $trial $commit awaiting-explicit-human-approval))
         ($stored (wx_save $root proposal $proposal))
         ($sent (wx_request $root proposal submit_promotion_request $id
          ((proposal (wx_details $root proposal $proposal)) (commit (wx_details $root commit $commit))))))
   (if (XReceiptIs $sent promotion-proposed)
    (executable-awaiting-approval $proposal $sent)
    (executable-development-incomplete $sent)))
  (executable-development-incomplete $commit)))
(= (XRun $root)
 (let* (($input (wx_input $root)) ($o (XOpportunity $input)) ($saved (wx_save $root opportunity $o)))
  (if (PShape $o executable-opportunity 7)
   (if (== (index-atom (index-atom $o 5) 2) (wx_grant_id $root))
    (XAttempt $root $o 1 no-prior-trial)
    (executable-development-held workshop-grant-mismatch)) $o)))
