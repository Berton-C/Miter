[32m'ReactorIngestOne'(A,
                        [event, B, C, D, E, F],
                        G) :-
    ==(C, stop, H),
    ==(D, 'direct-contact', I),
    and(H, I, J),
    (   J==true
    ->  'add-atom'('&rna', ['reactor-stop', requested], G)
    ;   'ReactorEligible'(A,
                          [event, B, C, D, E, F],
                          K),
