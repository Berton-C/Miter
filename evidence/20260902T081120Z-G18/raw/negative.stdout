[36m(= (ReactorCycle $root $idle)
   (let* (($incoming (miter_reactor_input $root))
          ($ingested (ReactorIngest $root $incoming 0))
          ($stop (collapse (match &rna (reactor-stop requested) requested)))
          ($ready (ReactorReady)))
     (if (> (size-atom $stop) 0)
       (miter_reactor_record $root reactor-stopped (explicit-stop))
       (if (> (size-atom $ready) 0)
         (let* (($wake (if (== $idle true) (miter_reactor_record $root wake (contact-or-due-work)) already-awake))
                ($advance (ReactorAdvance $root (index-atom $ready 0))))
           (if (== $advance reactor-store-failed) reactor-failed (ReactorCycle $root false)))
         (let* (($q (if (== $idle false) (miter_reactor_record $root quiescent-ready (empty-lawful-ready-set no-model-call)) already-quiescent))
                ($wait (miter_reactor_wait $root (miter_reactor_config idle_base_seconds))))
           (ReactorCycle $root true))))))
[33m--> prolog clause -->
[32m'ReactorCycle'(A, B, C) :-
    D=E,
    miter_reactor_input(A, E),
    true,
    'ReactorIngest'(A, D, 0, _),
    F=G,
    findall(requested,
            match('&rna', ['reactor-stop', requested], requested, requested),
            G),
    H=I,
    'ReactorReady'(I),
    'size-atom'(F, J),
    >(J, 0, K),
    (   K==true
    ->  miter_reactor_record(A, 'reactor-stopped', ['explicit-stop'], C)
    ;   'size-atom'(H, L),
        >(L, 0, M),
        (   M==true
        ->  true,
            ==(B, true, N),
            (   N==true
            ->  miter_reactor_record(A,
                                     wake,
                                     ['contact-or-due-work'],
                                     O)
            ;   O='already-awake'
            ),
            P=Q,
            'index-atom'(H, 0, R),
            'ReactorAdvance'(A, R, Q),
            ==(P, 'reactor-store-failed', S),
            (   S==true
            ->  C='reactor-failed'
            ;   'ReactorCycle'(A, false, C)
            )
        ;   true,
            ==(B, false, T),
            (   T==true
            ->  miter_reactor_record(A,
                                     'quiescent-ready',
                                     ['empty-lawful-ready-set', 'no-model-call'],
                                     U)
            ;   U='already-quiescent'
            ),
            true,
            miter_reactor_config(idle_base_seconds, V),
            miter_reactor_wait(A, V, _),
            'ReactorCycle'(A, true, C)
        )
    ).
