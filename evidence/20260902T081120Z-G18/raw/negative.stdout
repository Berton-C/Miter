[32m'ReactorAdvance'(A, [ready, B, C, D, E], F) :-
    true,
    'remove-atom'('&rna', [ready, B, C, D, E], _),
    ==(D, 'Transcribe', G),
    (   G==true
    ->  F=advanced,
        true,
        'add-atom'('&rna', [ready, B, C, 'Inquire', E], _),
        true,
        miter_reactor_checkpoint(A,
                                 B,
                                 C,
                                 'Inquire',
                                 E,
                                 ready,
                                 _)
    ;   ==(D, 'Inquire', H),
        (   H==true
        ->  F=I,
            miter_reactor_step(A, B, I),
            J=K,
            >(E, 1, L),
            (   L==true
            ->  K='Inquire'
            ;   K='Witness'
            ),
            M=N,
            -(E, 1, N),
            true,
            'add-atom'('&rna', [ready, B, C, J, M], _),
            true,
            miter_reactor_checkpoint(A,
                                     B,
                                     C,
                                     J,
                                     M,
                                     ready,
                                     _)
        ;   miter_reactor_checkpoint(A,
                                     B,
                                     C,
                                     'Consolidate',
                                     0,
                                     completed,
                                     F)
        )
    ).
