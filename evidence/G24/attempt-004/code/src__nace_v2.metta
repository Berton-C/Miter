; Scoped efficacy of a source-bound capability question, never Soul authority.
(= (NTruthValid $t)
 (if (PShape $t stv 3)
  (and (nn_number (index-atom $t 1) frequency) (nn_number (index-atom $t 2) confidence)) false))
(= (NRevision $old $evidence)
 (if (and (NTruthValid $old) (NTruthValid $evidence))
  (if (and (== (index-atom $old 2) 0) (== (index-atom $evidence 2) 0)) $old
   (let $answers (collapse (MiterNAL_Truth_Revision $old $evidence))
    (if (== (size-atom $answers) 1) (index-atom $answers 0) (nal-operator-cardinality-fault (size-atom $answers)))))
  (nal-invalid-truth-input $old $evidence)))
(= (NQuestion $inv)
 (let* (($frame (index-atom $inv 4)) ($scope (index-atom $inv 2))
        ($proof (SupportFor $scope (index-atom $frame 2) (index-atom $frame 3) (index-atom $frame 4) (index-atom $inv 5) ())))
  (if (PShape $proof supported 4)
   (if (and (> (size-atom (index-atom $proof 3)) 0) (SHumanRoots (index-atom $proof 3) 0))
    (let $q (index-atom $proof 1)
     (if (PShape $q capability-question 4)
      (if (and (== (index-atom $q 1) (index-atom $frame 6))
           (and (== (index-atom $q 2) coexpress-retentions) (== (index-atom $q 3) (index-atom $inv 6))))
       (efficacy-question $q $proof) (criterion-inapplicable $proof))
      (criterion-unrecognized $proof))) (criterion-unproven $proof))
   (criterion-unavailable $proof))))
(= (NRetentions $intention)
 (let $wanted (VWanted $intention)
  (collapse (let $c (superpose $wanted) (if (PShape $c retain 5) $c (empty))))))
(= (NCoexpression $result $eligible)
 (let $wanted (NRetentions (index-atom $result 1))
  (if (== (size-atom $wanted) 0) inapplicable
   (let $options (index-atom $eligible 1)
    (if (PHas true (collapse (let $option (superpose $options)
         (let $fragments (index-atom $option 2)
          (let $fragment (superpose $fragments) (VAll $wanted (index-atom $fragment 2)))))) 0)
     confirmed disconfirmed)))))
(= (NOutcome $result $eligible)
 (if (PShape $eligible supported-expression-alternatives 3) (NCoexpression $result $eligible)
  (if (PShape $eligible expression-inquiry 2) disconfirmed
   (if (or (PShape $eligible expression-search-incomplete 3) (PShape $eligible construction-incomplete 3)) delayed
    (if (or (PShape $eligible expression-context-incomplete 2) (PShape $eligible construction-inquiry 2)) ambiguous
     (if (PShape $eligible construction-rejected 2) malformed criterion-failed))))))
(= (NInvocationValid $inv)
 (if (PShape $inv efficacy-invocation 10)
  (and (PShape (index-atom $inv 4) voice-frame 9)
   (and (== (index-atom $inv 2) (index-atom (index-atom $inv 4) 1))
    (and (is-expr (index-atom $inv 3))
     (and (> (size-atom (index-atom $inv 3)) 0)
      (and (PShape (index-atom $inv 8) voice-realization 7) (vc_budget (index-atom $inv 9))))))) false))
(= (NObserve $inv)
 (if (NInvocationValid $inv)
  (let $question (NQuestion $inv)
   (if (PShape $question efficacy-question 3)
    (let* (($frame (index-atom $inv 4))
           ($result (VConstruct $frame (index-atom $inv 8) (index-atom $inv 9))) ($eligible (VEligible $result)))
     (efficacy-observation $inv (NOutcome $result $eligible) (criterion-basis $question) (trial-evidence $result $eligible)))
    (efficacy-observation $inv (if (PShape $question criterion-inapplicable 2) inapplicable criterion-failed)
     (criterion-basis $question) (trial-not-run))))
  (efficacy-observation-invalid malformed-invocation)))
(= (NSeed $inv)
 (efficacy-belief (index-atom $inv 2) (index-atom $inv 6) (index-atom $inv 7) (index-atom (index-atom $inv 8) 2) (stv 0.5 0) 0 ()))
(= (NBelongs $belief $inv)
 (if (PShape $belief efficacy-belief 8)
  (and (== (index-atom $belief 1) (index-atom $inv 2))
   (and (== (index-atom $belief 2) (index-atom $inv 6))
    (and (== (index-atom $belief 3) (index-atom $inv 7)) (== (index-atom $belief 4) (index-atom (index-atom $inv 8) 2))))) false))
(= (NApply $old $obs)
 (if (PShape $obs efficacy-observation 5)
  (let $inv (index-atom $obs 1)
   (if (and (NBelongs $old $inv) (== $obs (NObserve $inv)))
    (let $outcome (index-atom $obs 2)
     (if (PHas $outcome (confirmed disconfirmed) 0)
      (if (VOverlap (index-atom $old 7) (index-atom $inv 3))
       (efficacy-transition $old $old $obs duplicate-or-correlated)
       (let* (($evidence (stv (if (== $outcome confirmed) 1 0) (MiterNAL_Truth_w2c 1)))
              ($next (NRevision (index-atom $old 5) $evidence)))
        (if (NTruthValid $next)
         (efficacy-transition $old
          (efficacy-belief (index-atom $old 1) (index-atom $old 2) (index-atom $old 3) (index-atom $old 4) $next
           (+ (index-atom $old 6) 1) (SUnion (index-atom $old 7) (index-atom $inv 3) 0)) $obs revised)
         (efficacy-revision-incomplete $next))))
      (efficacy-transition $old $old $obs (held $outcome))))
    (efficacy-rejected invalid-scope-or-observation)))
  (efficacy-rejected malformed-observation)))
(= (NRead $inv)
 (let* (($scope (index-atom $inv 2)) ($context (index-atom $inv 6)) ($pin (index-atom $inv 7))
        ($id (index-atom (index-atom $inv 8) 2))
        ($rows (collapse (match &derived (nace-efficacy $scope $context $pin $id $truth $units $roots)
         (efficacy-belief $scope $context $pin $id $truth $units $roots)))))
  (if (== (size-atom $rows) 1) (index-atom $rows 0)
   (if (== (size-atom $rows) 0) efficacy-uninitialized efficacy-cardinality-fault))))
(= (NWrite $belief)
 (let* (($scope (index-atom $belief 1)) ($context (index-atom $belief 2)) ($pin (index-atom $belief 3))
        ($id (index-atom $belief 4))
        ($truth (index-atom $belief 5)) ($units (index-atom $belief 6)) ($roots (index-atom $belief 7))
        ($remove (remove-atom &derived (nace-efficacy $scope $context $pin $id $any-truth $any-units $any-roots)))
        ($add (add-atom &derived (nace-efficacy $scope $context $pin $id $truth $units $roots))))
  efficacy-projected))
(= (NLoad $root $inv)
 (let $stored (nn_restore $root (NSeed $inv))
  (if (== $stored efficacy-never-stored) (NWrite (NSeed $inv))
   (if (PShape $stored efficacy-belief 8)
    (if (NBelongs $stored $inv) (NWrite $stored) (efficacy-recovery-required scope-mismatch)) $stored))))
(= (NProcess $root $inv)
 (let* (($old (NRead $inv)) ($observed (NObserve $inv)) ($transition (NApply $old $observed)))
  (if (PShape $transition efficacy-transition 5)
   (let* (($staged (add-atom &derived (nace-pending $root $transition))) ($durable (nn_commit $root $transition)))
    (if (== $durable efficacy-durable)
     (let* (($write (NWrite (index-atom $transition 2))) ($remove (remove-atom &derived (nace-pending $root $transition))))
      (efficacy-processed (index-atom $transition 4) (NRead $inv)))
     (efficacy-persistence-incomplete $durable))) $transition)))
