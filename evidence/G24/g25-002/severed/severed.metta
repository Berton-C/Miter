; Efficacy regulates trial allocation among source/meaning-supported alternatives.
; No permission, emission or first-list winner is produced here.
(= (ECurrent $inv) (EOld $inv))
(= (EExpectation $truth)
 (if (NTruthValid $truth)
  (let $answers (collapse (MiterNAL_Truth_Expectation $truth))
   (if (== (size-atom $answers) 1) (index-atom $answers 0) efficacy-expectation-cardinality-fault))
  efficacy-invalid-truth))
(= (EOption $inv)
 (if (NInvocationValid $inv)
  (let* (($question (NQuestion $inv))
         ($construction (VConstruct (index-atom $inv 4) (index-atom $inv 8) (index-atom $inv 9)))
         ($eligible (VEligible $construction)))
   (if (PShape $eligible supported-expression-alternatives 3)
    (if (PShape $question efficacy-question 3)
     (let $belief (ECurrent $inv)
      (if (NBelongs $belief $inv)
       (let $expectation (EExpectation (index-atom $belief 5))
        (if (nn_number $expectation frequency)
         (efficacy-option (index-atom $inv 7) (index-atom (index-atom $inv 8) 2) $expectation
          (basis $question $construction $eligible $belief))
         (efficacy-unranked $inv $eligible $expectation)))
       (efficacy-unranked $inv $eligible $belief)))
     (efficacy-unranked $inv $eligible $question))
    (efficacy-excluded $inv $construction $eligible)))
  (efficacy-excluded $inv malformed-invocation)))
(= (EDominated $candidate $options)
 (PHas true (collapse (let $other (superpose $options)
  (if (PShape $other efficacy-option 5)
   (> (index-atom $other 3) (index-atom $candidate 3)) false))) 0))
(= (ESameEncounter $a $b)
 (and (NInvocationValid $b)
  (and (== (index-atom $a 2) (index-atom $b 2))
   (and (== (index-atom $a 4) (index-atom $b 4))
    (and (== (index-atom $a 5) (index-atom $b 5)) (== (index-atom $a 6) (index-atom $b 6)))))))
(= (EComparable $xs)
 (if (== (size-atom $xs) 0) true
  (let $first (index-atom $xs 0)
   (and (NInvocationValid $first)
    (not (PHas false (collapse (let $x (superpose $xs) (ESameEncounter $first $x))) 0))))))
(= (ERank $invocations)
 (if (is-expr $invocations)
  (if (EComparable $invocations) (ERankComparable $invocations)
   (efficacy-ranking-invalid incompatible-encounters))
  (efficacy-ranking-invalid malformed-alternatives)))
(= (ERankComparable $invocations)
  (let* (($options (collapse (let $inv (superpose $invocations) (EOption $inv))))
         ($maxima (collapse (let $option (superpose $options)
          (if (PShape $option efficacy-option 5)
           (if (EDominated $option $options) (empty) (maximal (index-atom $option 1) (index-atom $option 2)))
           (empty))))))
   (efficacy-ranking $options $maxima trial-allocation-only)))
