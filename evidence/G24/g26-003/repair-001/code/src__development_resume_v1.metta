; Compose existing evidence-dependent consumers; no book-prompt dispatch.
(= (DRCapsuleFits $cap $invs)
 (if (and (PShape $cap resume-capsule 14) (> (size-atom $invs) 0))
  (let* (($inv (index-atom $invs 0)) ($scope (index-atom $inv 2)))
   (and (EComparable $invs)
    (and (== (index-atom $cap 1) (index-atom $scope 3))
     (and (== (index-atom $cap 2) (index-atom $scope 2))
      (and (== (index-atom $cap 3) (index-atom $scope 4))
       (== (index-atom $cap 5) (index-atom $inv 4))))))) false))
(= (DRModuleFits $inv $parent $candidate $pins)
 (let $module (index-atom $inv 8)
  (if (== $module $parent) (== (index-atom $inv 7) (index-atom $pins 1))
   (and (== $module $candidate) (== (index-atom $inv 7) (index-atom $pins 2))))))
(= (DRActiveFits $root $invs)
 (let $active (collapse (match &derived (active-voice-v2 $root $parent $candidate $pins) ($parent $candidate $pins)))
  (if (== (size-atom $active) 1)
   (let* (($row (index-atom $active 0)) ($p (index-atom $row 0)) ($c (index-atom $row 1)) ($pins (index-atom $row 2))
          ($modules (collapse (let $inv (superpose $invs) (index-atom $inv 8)))))
    (and (PHas $p $modules 0)
     (and (PHas $c $modules 0)
      (not (PHas false (collapse (let $inv (superpose $invs) (DRModuleFits $inv $p $c $pins))) 0))))) false)))
(= (DRLoad $root $invs)
 (collapse (let $inv (superpose $invs) (NLoad $root $inv))))
(= (DRLoaded $results)
 (not (PHas false (collapse (let $r (superpose $results) (== $r efficacy-projected))) 0)))
(= (DRResume $root)
 (let $input (dr_input $root)
  (if (PShape $input resume-input 8)
   (let* (($accepted (index-atom $input 1)) ($efficacy (index-atom $input 2))
          ($invs (index-atom $input 3)) ($capsule (index-atom $input 4)))
    (if (and (== (index-atom $input 5) ()) (DRCapsuleFits $capsule $invs))
     (let $active (TVHydrate $accepted (tv_restore $accepted))
      (if (PHas $active (active-projection-restored active-projection-present) 0)
       (if (DRActiveFits $accepted $invs)
        (let $loaded (DRLoad $efficacy $invs)
         (if (DRLoaded $loaded)
          (let* (($event (resumed-development (index-atom $input 7) $capsule (index-atom $input 6)))
                 ($stage (add-atom &derived (resume-pending $root $event))) ($record (dr_record $root $event)))
           (if (== $record restart-recorded)
            (let $clear (remove-atom &derived (resume-pending $root $event))
             (development-resumed $capsule (ERank $invs) $event))
            (development-resume-incomplete $record)))
          (development-resume-incomplete (efficacy-recovery $loaded))))
        (development-resume-incomplete active-module-mismatch))
       (development-resume-incomplete $active)))
     (development-resume-incomplete scope-frame-or-model-context)))
   (development-resume-incomplete $input))))
