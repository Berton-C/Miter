[36m(= (SoulRequire $value $witness)
   (let* (($values (collapse (match &soul (soul-value $value $d) $value)))
          ($expected (SoulExpected $value)))
     (if (and (== (size-atom $values) 1) (!= $expected missing-doctrine))
       (if (== $expected $witness) witnessed blocked)
       blocked)))
[33m--> prolog clause -->
[32m'SoulRequire'(A, B, C) :-
    D=E,
    findall(A,
            match('&soul', ['soul-value', A, _], A, A),
            E),
    F=G,
    'SoulExpected'(A, G),
    'size-atom'(D, H),
    ==(H, 1, I),
    '!='(F, 'missing-doctrine', J),
    and(I, J, K),
    (   K==true
    ->  ==(F, B, L),
        (   L==true
        ->  C=witnessed
        ;   C=blocked
        )
    ;   C=blocked
    ).
[33m^^^^^^^^^^^^^^^^^^^^^^
[0m[33m--> metta function -->
[36m(= (SoulPairRequire $relation $witnesses)
   (let* (($as (collapse (match &soul (soul-relation $relation $a $b $d) $a)))
          ($bs (collapse (match &soul (soul-relation $relation $a $b $d) $b))))
     (if (and (== (size-atom $as) 1) (== (size-atom $bs) 1))
       (if (is-expr $witnesses)
         (if (== (size-atom $witnesses) 2)
           (if (and
                 (== (SoulRequire (index-atom $as 0) (index-atom $witnesses 0)) witnessed)
                 (== (SoulRequire (index-atom $bs 0) (index-atom $witnesses 1)) witnessed))
             witnessed blocked)
           blocked)
         blocked)
       blocked)))
[33m--> prolog clause -->
[32m'SoulPairRequire'(A, B, C) :-
    D=E,
    findall(F,
            match('&soul',
                  ['soul-relation', A, F, G, H],
                  F,
                  F),
            E),
    I=J,
    findall(G,
            match('&soul',
                  ['soul-relation', A, F, G, H],
                  G,
                  G),
            J),
    'size-atom'(D, K),
    ==(K, 1, L),
    'size-atom'(I, M),
    ==(M, 1, N),
    and(L, N, O),
    (   O==true
    ->  'is-expr'(B, P),
        (   P==true
        ->  'size-atom'(B, Q),
            ==(Q, 2, R),
            (   R==true
            ->  'index-atom'(D, 0, S),
                'index-atom'(B, 0, T),
                'SoulRequire'(S, T, U),
                ==(U, witnessed, V),
                'index-atom'(I, 0, W),
                'index-atom'(B, 1, X),
                'SoulRequire'(W, X, Y),
                ==(Y, witnessed, Z),
                and(V, Z, A1),
                (   A1==true
                ->  C=witnessed
                ;   C=blocked
                )
            ;   C=blocked
            )
        ;   C=blocked
        )
    ;   C=blocked
    ).
