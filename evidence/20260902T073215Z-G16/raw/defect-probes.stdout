[36m(= (VoiceCertify $root $id $n)
   (if (== (miter_voice_audit_status $root $id $n) audit-pass)
     (let* (($soul (SoulBoot (miter_voice_stage_path $root $id $n soul-integrity.json)))
            ($wired (VoiceWireMovement $root $id))
            ($movement (ConstructMovement (miter_voice_store_root $root) $id $soul))
            ($saved (miter_movement_record
               (miter_voice_stage_path $root $id $n movement.json) $movement)))
       (if (and (== $saved movement-result-stored) (!= $movement movement-blocked))
         (miter_voice_issue $root $id $n certified-utterance)
         voice-withheld))
     voice-withheld))
[33m--> prolog clause -->
[32m'VoiceCertify'(A, B, C, D) :-
    miter_voice_audit_status(A, B, C, E),
    ==(E, 'audit-pass', F),
    (   F==true
    ->  G=H,
        miter_voice_stage_path(A,
                               B,
                               C,
                               'soul-integrity.json',
                               I),
        'SoulBoot'(I, H),
        true,
        'VoiceWireMovement'(A, B, _),
        J=K,
        miter_voice_store_root(A, L),
        'ConstructMovement'(L, B, G, K),
        M=N,
        miter_voice_stage_path(A, B, C, 'movement.json', O),
        miter_movement_record(O, J, N),
        ==(M, 'movement-result-stored', P),
        '!='(J, 'movement-blocked', Q),
        and(P, Q, R),
        (   R==true
        ->  miter_voice_issue(A,
                              B,
                              C,
                              'certified-utterance',
                              D)
        ;   D='voice-withheld'
        )
    ;   D='voice-withheld'
    ).
