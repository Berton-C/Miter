[36m(= (SoulExercise $id $positive)
   (let $ps (collapse (match &soul (soul-causal $p $id $reason) $p))
     (if (== (size-atom $ps) 1)
       (let $p (index-atom $ps 0)
         (and (== (SoulInvoke $p $id $positive) witnessed)
              (== (SoulInvoke $p $id missing-witness) blocked)))
       false)))
[33m--> prolog clause -->
[32m'SoulExercise'(A, B, C) :-
    D=E,
    findall(F,
            match('&soul', ['soul-causal', F, A, _], F, F),
            E),
    'size-atom'(D, G),
    ==(G, 1, H),
    (   H==true
    ->  F=I,
        'index-atom'(D, 0, I),
        'SoulInvoke'(F, A, B, J),
        ==(J, witnessed, K),
        'SoulInvoke'(F, A, 'missing-witness', L),
        ==(L, blocked, M),
        and(K, M, C)
    ;   C=false
    ).
