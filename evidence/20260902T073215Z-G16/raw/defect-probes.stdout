               ['movement-field', B, 'target-cut', 'reply-certified'],
               _),
    true,
    'add-atom'('&movements', ['movement-field', B, 'intention-id', B], _),
    true,
    'add-atom'('&movements',
               ['movement-field', B, 'active-rna-id', 'VoiceRNA'],
               _),
    true,
    'add-atom'('&movements',
