[0m[33m--> metta function -->
[36m(= (VoiceAdmitAndEmit $root $id $n)
   (if (== (VoiceCertify $root $id $n) certified-utterance-stored)
     (miter_voice_emit $root $id $n) voice-withheld))
[33m--> prolog clause -->
[32m'VoiceAdmitAndEmit'(A, B, C, D) :-
    'VoiceCertify'(A, B, C, E),
    ==(E, 'certified-utterance-stored', F),
    (   F==true
    ->  miter_voice_emit(A, B, C, D)
    ;   D='voice-withheld'
    ).
[33m^^^^^^^^^^^^^^^^^^^^^^
[0m[33m--> metta function -->
[36m(= (VoiceContinue $root $id $n)
   (let* (($register (VoiceMeasureRegister $root $id $n))
          ($audit (AuditRNA $root $id $n)))
     (if (and (== $register affect-cue-stored) (== $audit voice-audit-stored))
       (VoiceResolveAudit $root $id $n) voice-withheld)))
[33m--> prolog clause -->
[32m'VoiceContinue'(A, B, C, D) :-
    E=F,
    'VoiceMeasureRegister'(A, B, C, F),
    G=H,
    'AuditRNA'(A, B, C, H),
    ==(E, 'affect-cue-stored', I),
    ==(G, 'voice-audit-stored', J),
    and(I, J, K),
    (   K==true
    ->  'VoiceResolveAudit'(A, B, C, D)
    ;   D='voice-withheld'
    ).
[33m^^^^^^^^^^^^^^^^^^^^^^
[0m[33m--> metta function -->
[36m(= (VoiceResolveAudit $root $id $n)
     (if (== (miter_voice_audit_status $root $id $n) audit-pass)
       (VoiceAdmitAndEmit $root $id $n)
       (if (< $n 1)
         (let $next (+ $n 1)
           (if (== (miter_voice_render $root $id $next qwen-local) voice-candidate-ready)
             (VoiceContinue $root $id $next) voice-withheld))
         voice-withheld)))
[33m--> prolog clause -->
[32m'VoiceResolveAudit'(A, B, C, D) :-
    miter_voice_audit_status(A, B, C, E),
    ==(E, 'audit-pass', F),
    (   F==true
    ->  'VoiceAdmitAndEmit'(A, B, C, D)
    ;   <(C, 1, G),
        (   G==true
        ->  H=I,
            +(C, 1, I),
            miter_voice_render(A, B, H, 'qwen-local', J),
            ==(J, 'voice-candidate-ready', K),
            (   K==true
            ->  'VoiceContinue'(A, B, H, D)
            ;   D='voice-withheld'
            )
        ;   D='voice-withheld'
        )
    ).
[33m^^^^^^^^^^^^^^^^^^^^^^
[0m[33m--> metta function -->
[36m(= (VoiceRNA $root $id)
   (if (== (VoicePrepare $root $id) voice-intention-stored)
     (if (== (miter_voice_render $root $id 0 qwen-local) voice-candidate-ready)
       (VoiceContinue $root $id 0) voice-withheld)
     voice-withheld))
[33m--> prolog clause -->
[32m'VoiceRNA'(A, B, C) :-
    'VoicePrepare'(A, B, D),
    ==(D, 'voice-intention-stored', E),
    (   E==true
    ->  miter_voice_render(A, B, 0, 'qwen-local', F),
        ==(F, 'voice-candidate-ready', G),
        (   G==true
        ->  'VoiceContinue'(A, B, 0, C)
        ;   C='voice-withheld'
        )
    ;   C='voice-withheld'
    ).
