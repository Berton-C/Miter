[33m--> prolog clause -->
[32m'SoulExpected'(A, B) :-
    C=D,
    findall(E,
            match('&soul',
                  ['soul-required-standing', A, E],
                  E,
                  E),
            D),
    'size-atom'(C, F),
    ==(F, 1, G),
    (   G==true
    ->  'index-atom'(C, 0, B)
    ;   B='missing-doctrine'
    ).
