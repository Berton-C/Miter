    'add-atom'('&movements',
               [ 'movement-field',
                 B,
                 'predicted-consequence-ids',
                 ['certified-local-reply']
               ],
               _),
    C=F,
    'VoiceWireWitnesses'(B,
                         D,
                         [ availability,
                           'inherited-legality',
                           safety,
                           integrity,
                           provenance,
                           'required-distinction',
                           'no-forcing',
                           participation,
                           consequence,
                           doctrine,
                           extensions,
                           'continuing-contact'
                         ],
                         0,
                         F).
