[36m(= (VoiceDefects $root $id $n $keys $i)
   (if (< $i (size-atom $keys))
     (let* (($key (index-atom $keys $i))
            ($rest (VoiceDefects $root $id $n $keys (+ $i 1))))
       (if (VoiceDefectPresent $root $id $n $key)
         (cons-atom (defect $key candidate-and-intention blocking
           (match &self (voice-repair $key $repair) $repair)) $rest)
         $rest)) ()))
[33m--> prolog clause -->
[32m'VoiceDefects'(A, B, C, D, E, F) :-
    'size-atom'(D, G),
    <(E, G, H),
    (   H==true
    ->  I=J,
        'index-atom'(D, E, J),
        K=L,
        +(E, 1, M),
        'VoiceDefects'(A, B, C, D, M, L),
        'VoiceDefectPresent'(A, B, C, I, N),
        (   N==true
        ->  match('&self', ['voice-repair', I, O], O, O),
            'cons-atom'([ defect,
                          I,
                          'candidate-and-intention',
                          blocking,
                          O
                        ],
                        K,
                        F)
        ;   F=K
        )
    ;   F=[]
    ).
