[36m(= (VoiceMeasureRegister $root $id $n)
   (let $request (miter_voice_vad_request $root $id $n)
     (if (== $request voice-vad-request-ready)
       (VADRenderingRNA
         (miter_voice_stage_path $root $id $n vad-input.json)
         (miter_voice_cue_id $id $n)
         (miter_voice_stage_path $root $id $n vad.json))
       voice-vad-unavailable)))
[33m--> prolog clause -->
[32m'VoiceMeasureRegister'(A, B, C, D) :-
    E=F,
    miter_voice_vad_request(A, B, C, F),
    ==(E, 'voice-vad-request-ready', G),
    (   G==true
    ->  miter_voice_stage_path(A, B, C, 'vad-input.json', H),
        miter_voice_cue_id(B, C, I),
        miter_voice_stage_path(A, B, C, 'vad.json', J),
        'VADRenderingRNA'(H, I, J, D)
    ;   D='voice-vad-unavailable'
    ).
