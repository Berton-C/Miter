[36m(= (AuditRNA $root $id $n)
   (let* (($defects (VoiceDefects $root $id $n
      (schema-failure semantic-drift soul-absence person-not-seen task-smearing unsupported-certainty authority-inflation coercive-dominance affect-register-mismatch hidden-scope unacknowledged-tension policy-voice excessive-length) 0))
          ($status (if (== (size-atom $defects) 0) audit-pass audit-repair-required)))
     (miter_voice_audit_write $root $id $n
       (voice-audit (status $status) (defects $defects) (audit_version miter-voice-audit-v1)))))
[33m--> prolog clause -->
[32m'AuditRNA'(A, B, C, D) :-
    E=F,
    'VoiceDefects'(A,
                   B,
                   C,
                   [ 'schema-failure',
                     'semantic-drift',
                     'soul-absence',
                     'person-not-seen',
                     'task-smearing',
                     'unsupported-certainty',
                     'authority-inflation',
                     'coercive-dominance',
                     'affect-register-mismatch',
                     'hidden-scope',
                     'unacknowledged-tension',
                     'policy-voice',
                     'excessive-length'
                   ],
                   0,
                   F),
    G=H,
    'size-atom'(E, I),
    ==(I, 0, J),
    (   J==true
    ->  H='audit-pass'
    ;   H='audit-repair-required'
    ),
    miter_voice_audit_write(A,
                            B,
                            C,
                            [ 'voice-audit',
                              [status, G],
                              [defects, E],
                              [audit_version, 'miter-voice-audit-v1']
                            ],
                            D).
