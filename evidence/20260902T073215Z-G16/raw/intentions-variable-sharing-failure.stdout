    ->  C='insufficient-coverage'
    ;   <(D, 2, P),
        (   P==true
        ->  C='single-clause'
        ;   miter_vad_metric(A, 0, match_count, Q),
            ==(Q, 0, R),
            miter_vad_metric(A, F, match_count, S),
            ==(S, 0, T),
            or(R, T, U),
            (   U==true
            ->  C='insufficient-clause-coverage'
            ;   >(H, L, V),
                (   V==true
                ->  miter_vad_contains(A, "but", W),
                    miter_vad_contains(A, "however", X),
                    or(W, X, Y),
