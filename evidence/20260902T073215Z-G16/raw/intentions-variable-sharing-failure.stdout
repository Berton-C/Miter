[33m--> prolog clause -->
[32m'VADCue'(A,
              B,
              [ 'affect-cue',
                [label, 'affective-language-cue'],
                [lexicon_mode, B],
                [asset_access, C],
                [coverage, D],
                [valence_profile, E],
                [arousal_profile, F],
