[32m'ReactorCycleWith_Spec_[G19NonInterruptible]'(A,
                                                   B,
                                                   C,
                                                   'G19NonInterruptible',
                                                   D) :-
    E=F,
    miter_reactor_input(A, F),
    _=G,
    'ReactorIngest'(A, E, 0, G),
    H=I,
    findall(requested,
            match('&rna', ['reactor-stop', requested], requested, requested),
            I),
    J=K,
    'G19NonInterruptible'(A, K),
    'size-atom'(H, L),
    >(L, 0, M),
    (   M==true
    ->  miter_reactor_record(A, 'reactor-stopped', ['explicit-stop'], D)
    ;   'size-atom'(J, N),
        >(N, 0, O),
        (   O==true
        ->  P=Q,
            miter_reactor_config(idle_base_seconds, Q),
            _=R,
            ==(B, true, S),
            (   S==true
            ->  miter_reactor_record(A,
                                     wake,
                                     ['contact-or-due-work'],
                                     R)
            ;   R='already-awake'
            ),
            _=T,
            ==(B, true, U),
            (   U==true
            ->  miter_reactor_record(A,
                                     'interval-reset',
                                     [backoff, P, 'contact-or-due-work'],
                                     T)
            ;   T='already-reset'
            ),
            V=W,
            'index-atom'(J, 0, X),
            'ReactorAdvance'(A, X, W),
            ==(V, 'reactor-store-failed', Y),
            (   Y==true
            ->  D='reactor-failed'
            ;   miter_reactor_config(idle_base_seconds, Z),
                'ReactorCycleWith'(A,
                                   false,
                                   Z,
                                   'G19NonInterruptible',
                                   D)
            )
        ;   _=A1,
            ==(B, false, B1),
            (   B1==true
            ->  miter_reactor_record(A,
                                     'quiescent-ready',
                                     ['empty-lawful-ready-set', 'no-model-call'],
                                     A1)
            ;   A1='already-quiescent'
            ),
            _=C1,
            miter_reactor_record(A,
                                 'idle-wait',
                                 [ wait,
                                   C,
                                   'no-progress-claim',
                                   'no-model-call'
                                 ],
                                 C1),
            D1=E1,
            miter_reactor_wait(A, C, E1),
            F1=G1,
            ==(D1, 'input-ready', H1),
            (   H1==true
            ->  miter_reactor_config(idle_base_seconds, G1)
            ;   'ReactorNextInterval'(C, G1)
            ),
            'ReactorCycleWith'(A,
                               true,
                               F1,
                               'G19NonInterruptible',
                               D)
        )
    ).
