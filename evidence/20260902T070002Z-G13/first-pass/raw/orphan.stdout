[32m'SoulRationalityAudit'(A) :-
    B=C,
    findall(D,
            match('&soul', ['soul-value', D, E], D, D),
            C),
    F=G,
    findall(H,
            match('&soul',
                  ['soul-relation', H, _, _, E],
                  H,
                  H),
            G),
    I=J,
    findall(K,
            match('&soul',
                  ['soul-causal', _, K, _],
                  K,
                  K),
            J),
    'size-atom'(B, L),
    >(L, 0, M),
    'size-atom'(I, N),
    'size-atom'(B, O),
    'size-atom'(F, P),
    +(O, P, Q),
    ==(N, Q, R),
    and(M, R, S),
    (   S==true
    ->  'SoulAuditValues'(B, 0, T),
        'SoulAuditRelations'(F, 0, U),
        and(T, U, A)
    ;   A=false
    ).
