[36m(= (SoulStartup $integrity)
   (if (== $integrity soul-integrity-verified)
     (if (SoulRationalityAudit) soul-ready soul-startup-blocked)
     soul-startup-blocked))
[33m--> prolog clause -->
[32m'SoulStartup'(A, B) :-
    ==(A, 'soul-integrity-verified', C),
    (   C==true
    ->  'SoulRationalityAudit'(D),
        (   D==true
        ->  B='soul-ready'
        ;   B='soul-startup-blocked'
        )
    ;   B='soul-startup-blocked'
    ).
