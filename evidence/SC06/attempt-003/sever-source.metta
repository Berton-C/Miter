; SC06: finite source-bound development. No scenario/defect labels enter the
; opportunity decision; each claimed audit is recomputed from its raw frame.
(= (DGround $f)
 (GroundLanguage (index-atom $f 1) (index-atom $f 2) (index-atom $f 3)
  (index-atom $f 4) (index-atom $f 5) (index-atom $f 6) (index-atom $f 7) (index-atom $f 8)))
(= (DObserve $id $kind $frame $clauses)
 (let* (($g (DGround $frame)) ($i (RIntend $id $g))
        ($audit (RAudit $i (index-atom $frame 1) (index-atom $frame 1) $clauses)))
  (audit-observation $id (index-atom $frame 1) $kind $frame $clauses $audit)))
(= (DSubset $a $b $i)
 (if (< $i (size-atom $a)) (and (PHas (index-atom $a $i) $b 0) (DSubset $a $b (+ $i 1))) true))
(= (DSameFamily $a $b)
 (and (== (index-atom $a 1) (index-atom $b 1))
  (and (== (index-atom $a 2) (index-atom $b 2))
   (and (DSubset (index-atom $a 3) (index-atom $b 3) 0)
        (DSubset (index-atom $b 3) (index-atom $a 3) 0)))))
(= (DGroundFor $claim $intention)
 (let $rows (index-atom (index-atom (index-atom (index-atom $intention 5) 1) 3) 1)
  (collapse (let $r (superpose $rows)
   (if (PShape $r material-interface 6)
    (if (and (== (index-atom $r 2) (index-atom $claim 3))
       (and (== (index-atom $r 3) (index-atom $claim 2)) (== (index-atom $r 4) (index-atom $claim 4)))) $r (empty)) (empty))))))
(= (DReasons $audit)
 (let* (($i (index-atom (index-atom $audit 4) 1)) ($alterations (index-atom (index-atom $audit 6) 1)))
  (collapse (let $a (superpose $alterations)
   (if (PShape $a omitted-meaning 4)
    (let $claim (index-atom $a 1)
     (if (PShape $claim retain 5)
      (let $ground (DGroundFor $claim $i)
       (if (> (size-atom $ground) 0)
        (repairable-relation (retention-omission (index-atom $claim 3)) $claim $ground $a) (empty))) (empty))) (empty))))))
(= (DRead $scope $r)
 (if (PShape $r audit-observation 7)
  (if (and (== (index-atom $r 2) $scope) true)
   (if (PShape (index-atom $r 4) voice-frame 9)
    (if (== (index-atom (index-atom $r 4) 1) $scope)
     (let $recomputed (DObserve (index-atom $r 1) independent-native-audit (index-atom $r 4) (index-atom $r 5))
      (if (== (index-atom $recomputed 6) (index-atom $r 6))
       (let $a (index-atom $r 6)
        (if (PShape $a voice-audit 7)
         (if (== (index-atom $a 3) meaning-altered)
          (let $i (index-atom (index-atom $a 4) 1)
           (audited-evidence (index-atom $r 1) (DReasons $a)
            (input-family $scope (index-atom $i 3) (RClaimSet (index-atom $i 4))) $r))
          (held-audit (index-atom $r 1) (index-atom $a 3)))
         (held-audit (index-atom $r 1) insufficient-semantic-support)))
       (held-audit (index-atom $r 1) receipt-mismatch))) (held-audit (index-atom $r 1) stale-scope))
    (held-audit (index-atom $r 1) malformed-frame)) (held-audit (index-atom $r 1) unqualified-source-or-scope))
  (held-audit malformed-receipt)))
(= (DReads $scope $rows $n)
 (if (< $n (size-atom $rows)) (cons-atom (DRead $scope (index-atom $rows $n)) (DReads $scope $rows (+ $n 1))) ()))
(= (DRepeated $readings)
 (SUnion () (collapse (let $a (superpose $readings)
  (if (PShape $a audited-evidence 5)
   (let $b (superpose $readings)
    (if (PShape $b audited-evidence 5)
     (if (DSameFamily (index-atom $a 3) (index-atom $b 3)) (empty)
      (let* (($ar (index-atom $a 2)) ($br (index-atom $b 2)))
       (let $x (superpose $ar) (let $y (superpose $br)
        (if (== (index-atom $x 1) (index-atom $y 1))
         (repeated-relation (index-atom $x 1) $a $b) (empty)))))) (empty))) (empty)))) 0))
(= (DGrant $scope $g)
 (if (PShape $g development-grant 5)
  (and (== (index-atom $g 1) $scope)
   (and (> (index-atom $g 2) 0) (and (<= (index-atom $g 2) 2)
    (and (> (index-atom $g 3) 0) (and (<= (index-atom $g 3) 1024)
     (and (> (index-atom $g 4) 0) (<= (index-atom $g 4) 120))))))) false))
(= (DOpportunity $id $scope $records $surfaces $grant)
 (let* (($readings (DReads $scope $records 0)) ($basis (DRepeated $readings)))
  (if (> (size-atom $basis) 0)
   (if (PHas (surface-capability VoicePolicy retention-omission miter-voice-policy-v1 (trial-guidance) ()) $surfaces 0)
    (if (DGrant $scope $grant)
     (let* (($events (SUnion () (collapse (let $b (superpose $basis)
              (superpose ((index-atom (index-atom $b 2) 1) (index-atom (index-atom $b 3) 1))))) 0))
            ($grounds (SUnion () (collapse (let $b (superpose $basis)
              (let $reasons (index-atom (index-atom $b 2) 2)
               (let $reason (superpose $reasons) (let $rows (index-atom $reason 3)
                (let $row (superpose $rows) (index-atom $row 1))))))) 0)))
      (development-opportunity $id $scope (target VoicePolicy) (soul-ground $grounds)
       (source-events $events) (basis $basis)
       (living-question preserve-source-required-participation-in-expression)
       (resource $grant) (allowed-effects ())
       (progress-witness quarantined-candidate-with-provenance-not-success)
       (stop-condition candidate-produced-or-scoped-resource-incomplete)))
     (development-incomplete resource-grant $readings))
    (development-inquiry missing-capability-surface $readings))
   (development-held no-independent-repeated-relation $readings))))
(= (DDevelop $o)
 (if (PShape $o development-opportunity 12)
  (develop-rna (index-atom $o 1) (index-atom $o 2) (opportunity $o) (next generate-quarantined-candidate))
  (development-not-transcribed $o)))
; Clause realization is a compiler over already formed intention. It adds no
; goal, promise, completion, permission or effect authority.
(= (DName $i $entity)
 (let $names (RModelNames $i)
  (let $found (collapse (let $n (superpose $names)
   (if (== (index-atom $n 3) $entity) (index-atom $n 1) (empty))))
   (if (> (size-atom $found) 0) (index-atom $found 0) unresolved-name))))
(= (DVerb $role)
 (if (== $role choice) choose (if (== $role inspection) inspect (if (== $role recovery) restore unresolved-role))))
(= (DClause $i $claim $v)
 (if (PShape $claim reported-request 2)
  (let $name (DName $i (index-atom (index-atom $claim 1) 1))
   (vd_sentence (if (== $v 0) (you requested revision of $name) (the requested change is to revise $name))))
  (if (PShape $claim retain 5)
   (let* (($a (DName $i (index-atom $claim 1))) ($p (DName $i (index-atom $claim 2))) ($verb (DVerb (index-atom $claim 3))))
    (vd_sentence (if (== $v 0) ($p must remain able to $verb $a) (the change must keep $p able to $verb $a))))
   (if (PShape $claim completion 2)
    (vd_sentence (the revision of (DName $i (index-atom (index-atom $claim 1) 1)) is complete)) unresolved-clause))))
(= (DCompile $i $variant)
 (if (PShape $i voice-intention 7)
  (let $expected (index-atom $i 4)
   (collapse (let $e (superpose $expected) (DClause $i (index-atom $e 1) $variant)))) unresolved-intention))
(= (DRuleValid $r)
 (if (PShape $r rule 5)
  (and (or (and (== (index-atom $r 1) always) (== (index-atom $r 2) *))
           (and (== (index-atom $r 1) defect)
            (PHas (index-atom $r 2) (schema-failure semantic-drift soul-absence person-not-seen task-smearing unsupported-certainty authority-inflation coercive-dominance affect-register-mismatch hidden-scope unacknowledged-tension policy-voice excessive-length) 0)))
   (and (PHas (index-atom $r 3) (preserve-candidate approved-clause-plan) 0)
        (or (== (index-atom $r 4) 0) (== (index-atom $r 4) 1)))) false))
(= (DRulesValid $rs $n)
 (if (< $n (size-atom $rs)) (and (DRuleValid (index-atom $rs $n)) (DRulesValid $rs (+ $n 1))) true))
(= (DModuleValid $id $m)
 (if (PShape $m voice-policy 7)
  (if (and (== (index-atom $m 1) miter-voice-policy-v1) (== (index-atom $m 2) $id))
   (if (== (index-atom $m 5) (trial-guidance))
    (if (== (index-atom $m 6) ())
     (let $rules (index-atom $m 4)
      (if (is-expr $rules)
       (if (and (> (size-atom $rules) 0) (<= (size-atom $rules) 8))
        (if (DRulesValid $rules 0)
         (if (== (index-atom (index-atom $rules (- (size-atom $rules) 1)) 1) always) module-valid missing-default)
         forbidden-vocabulary) malformed-rules) malformed-rules)) forbidden-effect) forbidden-write)
   wrong-schema-or-id) malformed-schema))
(= (DQuarantine $id $m $binding)
 (let $valid (DModuleValid $id $m)
  (if (== $valid module-valid)
   (if (== $binding model-candidate-bound)
    (let $existing (collapse (match &trial (trial-voice-policy $id $old) $old))
     (if (== (size-atom $existing) 0)
      (let $write (add-atom &trial (trial-voice-policy $id $m)) candidate-quarantined) duplicate-trial-id))
    unproven-candidate-lineage) $valid)))
(= (DApplyRules $rules $defects $n)
 (if (< $n (size-atom $rules))
  (let $r (index-atom $rules $n)
   (if (or (== (index-atom $r 1) always) (PHas (index-atom $r 2) $defects 0))
    (rendering-plan (index-atom $r 3) (index-atom $r 4)) (DApplyRules $rules $defects (+ $n 1)))) trial-unavailable))
(= (DTrialPlan $id $defects)
 (let $rows (collapse (match &trial (trial-voice-policy $id $m) $m))
  (if (== (size-atom $rows) 1) (DApplyRules (index-atom (index-atom $rows 0) 4) $defects 0) trial-unavailable)))
(= (DGeneration $id $o)
 (module-generation $id (index-atom $o 2) qwen-local (index-atom (index-atom $o 8) 1)
  (opportunity $o) (parent voice-policy-seed-v1)
  (instruction "Propose a declarative VoicePolicy using the supplied schema. Address the independently witnessed retention omission using semantic-drift as the schema's classification. This is an experimental candidate, not approval. A defect rule can select approved-clause-plan, which realizes the current native intention, or preserve-candidate. End with an always/* default. Conditions are defect or always; actions preserve-candidate or approved-clause-plan; variant is 0 or 1. Do not write code, add fields, change Soul, claim success, or request external effects. Copy candidate_id exactly. Native interpretation, audit and promotion are outside your authority.")
  (allowed-writes (trial-guidance)) (allowed-effects ())))
(= (DWait $root $id $scope)
 (if (== (vd_control $root) (control $id $scope stop))
  (let* (($c (vd_cancel $root)) ($s (vd_save $root cancellation (cancellation-requested $c)))) (cancellation-requested $c $s))
  (let $state (vd_poll $root)
   (if (== $state pending) (let $wait (vd_pace 0.01) (DWait $root $id $scope))
    (if (== $state candidate-available)
     (let* (($m (vd_candidate $root)) ($bound (vd_binding $root))
            ($before (vd_snapshot $root before)) ($result (DQuarantine $id $m $bound))
            ($after (vd_snapshot $root after))
            ($saved (vd_save $root result (quarantine-result $result $m $bound))))
       (quarantine-result $result $saved))
     (let $s (vd_save $root result (development-transport-incomplete $state))) (development-transport-incomplete $state $s))))))
(= (DRun $root $id $scope $records $surfaces $grant)
 (let* (($o (DOpportunity $id $scope $records $surfaces $grant)) ($rna (DDevelop $o))
        ($stored (vd_save $root opportunity $o)) ($stored-rna (vd_save $root develop $rna)))
  (if (and (== $stored stored) (== $stored-rna stored))
   (if (PShape $rna develop-rna 5)
    (let $started (vd_start $root (DGeneration $id $o))
     (if (== $started worker-started) (DWait $root $id $scope) (development-transport-incomplete $started))) $rna)
   (development-storage-incomplete $stored $stored-rna))))
