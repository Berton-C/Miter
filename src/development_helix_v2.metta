; G33 R13: compact content-addressed proof projections over the exact R12
; trial and consequence semantics. Full relations are computed natively and
; remain the inputs to native adjudication; they are not recursively embedded
; in final, restart, or stdout products.
(= (DH2OptionProof $o)
 (if (PShape $o efficacy-option 5)
  (efficacy-option-proof (index-atom $o 1) (index-atom $o 2)
   (index-atom $o 3) (dh2_hash_native $o))
  (efficacy-option-proof-invalid (dh2_hash_native $o))))
(= (DH2OptionProofs $xs $n)
 (if (< $n (size-atom $xs))
  (cons-atom (DH2OptionProof (index-atom $xs $n)) (DH2OptionProofs $xs (+ $n 1))) ()))
(= (DH2RankingProof $ranking)
 (if (PShape $ranking efficacy-ranking 4)
  (efficacy-ranking-proof (dh2_hash_native $ranking)
   (DH2OptionProofs (index-atom $ranking 1) 0)
   (index-atom $ranking 2) (index-atom $ranking 3))
  (efficacy-ranking-proof-invalid (dh2_hash_native $ranking))))
(= (DH2ReportProof $report)
 (if (PShape $report trial-report 4)
  (trial-report-proof (index-atom (index-atom $report 1) 2)
   (dh2_hash_native $report) (size-atom (index-atom $report 3)))
  (trial-report-proof-invalid (dh2_hash_native $report))))
(= (DH2DecisionProof $decision)
 (if (PShape $decision trial-admissible 6)
  (trial-decision-proof trial-admissible (dh2_hash_native $decision)
   (case-consequences (dh2_hash_native (index-atom $decision 4))
    (size-atom (index-atom (index-atom $decision 4) 1)))
   (expansion (dh2_hash_native (index-atom $decision 5))
    (size-atom (index-atom (index-atom $decision 5) 1))))
  (trial-decision-proof (index-atom $decision 0) (dh2_hash_native $decision))))
(= (DH2StageDevelopment $root $intent)
 (let $old (collapse (match &derived (pending-helix-v2-development $root $prior) $prior))
  (if (== (size-atom $old) 0)
   (let $add (add-atom &derived (pending-helix-v2-development $root $intent)) staged)
   (if (== $old ($intent)) staged conflict))))
(= (DH2Trial $root $candidate $lineage)
 (let $material (dh_trial_material $root)
  (if (PShape $material trial-material 4)
   (let* (($parent (index-atom $material 1)) ($cases (index-atom $material 2))
          ($pins (index-atom $material 3))
          ($parent-report (TVReport $cases $parent $pins))
          ($candidate-report (TVReport $cases $candidate $pins))
          ($quality (TVAdjudicate $cases $parent $candidate $pins $parent-report $candidate-report))
          ($decision (TVAuthorize $quality (trial-authority record-and-activate)))
          ($intent (helix-v2-development-intent $root $parent $candidate $pins $decision $lineage))
          ($stage (DH2StageDevelopment $root $intent))
          ($commit (if (== $stage staged) (dh2_development_commit $root $intent) $stage))
          ($active (if (and (PShape $decision trial-admissible 6)
                            (== $commit helix-v2-development-durable))
            (add-atom &derived (active-voice-v2 $root $parent $candidate $pins)) inactive))
          ($proof (helix-trial-proof (DH2ReportProof $parent-report)
                   (DH2ReportProof $candidate-report) (DH2DecisionProof $decision) $commit))
          ($saved (dh_save $root trial $proof))) $proof)
   (helix-trial-proof-incomplete $material))))
(= (DH2NProcess $root $inv)
 (let* (($old (NRead $inv)) ($observed (NObserve $inv)) ($transition (NApply $old $observed)))
  (if (PShape $transition efficacy-transition 5)
   (let* (($staged (add-atom &derived (nace-v2-pending $root $transition)))
          ($durable (dh2_n_commit $root $transition)))
    (if (== $durable efficacy-durable)
     (let* (($write (NWrite (index-atom $transition 2)))
            ($remove (remove-atom &derived (nace-v2-pending $root $transition))))
      (efficacy-processed (index-atom $transition 4) (NRead $inv)))
     (efficacy-persistence-incomplete $durable))) $transition)))
(= (DH2Efficacy $root $parent $candidate)
 (let* (($invocations (DHInvocations $root $parent $candidate))
        ($load-parent (DHNLoad $root (index-atom $invocations 0)))
        ($load-candidate (DHNLoad $root (index-atom $invocations 1)))
        ($before (ERank $invocations)) ($before-proof (DH2RankingProof $before))
        ($saved-before (dh_save $root efficacy-before $before-proof))
        ($parent-result (DH2NProcess $root (index-atom $invocations 0)))
        ($candidate-result (DH2NProcess $root (index-atom $invocations 1)))
        ($after (ERank $invocations)) ($after-proof (DH2RankingProof $after))
        ($saved-after (dh_save $root efficacy-after $after-proof)))
  (helix-efficacy-proof $before-proof $parent-result $candidate-result $after-proof)))
(= (DevelopmentHelixIdleV2 $root)
 (if (== (dh_outcome $root) development-helix-open)
  (let* (($input (dh2_input $root)) ($product (index-atom $input 2))
         ($material (dh_trial_material $root)))
   (if (and (PShape $input development-helix-v2-input 3)
        (and (PShape $product model-candidate 4) (PShape $material trial-material 4)))
    (DHReady (index-atom (index-atom $input 1) 1))
    (development-helix-v2-held $product $material)))
  development-helix-v2-already-closed))
(= (DH2Run $root)
 (let* (($input (dh2_input $root)) ($checkpoint (index-atom $input 1))
        ($product (index-atom $input 2)))
  (if (and (DHCheckpointValid $checkpoint) (PShape $product model-candidate 4))
   (let* (($candidate (index-atom $product 1)) ($lineage (index-atom $product 3))
          ($candidate-hash (index-atom $lineage 1))
          ($quarantine (VQuarantine (index-atom $checkpoint 1) $candidate (index-atom $product 2)))
          ($saved-quarantine (dh_save $root quarantine $quarantine))
          ($trial (if (== $quarantine candidate-quarantined)
                   (DH2Trial $root $candidate (existing-model-candidate
                    (index-atom $lineage 1) (index-atom $lineage 2)))
                   (helix-trial-proof-incomplete $quarantine)))
          ($efficacy (if (and (PShape $trial helix-trial-proof 5)
                              (== (index-atom (index-atom $trial 3) 1) trial-admissible))
                     (DH2Efficacy $root (index-atom (dh_trial_material $root) 1) $candidate)
                     (helix-efficacy-proof-not-run $trial)))
          ($result (development-helix-proof $candidate-hash $quarantine $trial $efficacy))
          ($saved (dh_save $root final $result))) $result)
   (development-helix-v2-held $checkpoint $product))))
(= (DevelopmentHelixBoundaryV2 $root $id $locus $n)
 (if (and (== $locus ResumeAuthorizedGeneration) (== $n 1))
  (let* (($result (DH2Run $root))
         ($remove (remove-atom &rna (ready $id DevelopmentHelixRNA $locus $n)))) $result)
  development-helix-v2-lifecycle-fault))
(= (DH2Restart $root)
 (let $restored (dh2_restore $root)
  (if (PShape $restored durable-helix-v2-development 2)
   (let* (($intent (index-atom $restored 1)) ($parent (index-atom $intent 2))
          ($candidate (index-atom $intent 3)) ($pins (index-atom $intent 4))
          ($active (add-atom &derived (active-voice-v2 $root $parent $candidate $pins)))
          ($invocations (DHInvocations $root $parent $candidate))
          ($load-parent (DHNLoad $root (index-atom $invocations 0)))
          ($load-candidate (DHNLoad $root (index-atom $invocations 1)))
          ($ranking (ERank $invocations)) ($ranking-proof (DH2RankingProof $ranking))
          ($result (development-helix-v2-rehydrated (dh2_hash_native $intent)
                   $ranking-proof no-generation-replay))
          ($saved (dh_save $root restart $result))) $result)
   (development-helix-v2-recovery-incomplete $restored))))
(= (DH2SeveredConsequence $root)
 (let* (($input (dh2_input $root)) ($product (index-atom $input 2)))
  (if (and (DHCheckpointValid (index-atom $input 1)) (PShape $product model-candidate 4))
   (let* (($candidate (index-atom $product 1))
          ($quarantine (VQuarantine (index-atom (index-atom $input 1) 1) $candidate (index-atom $product 2)))
          ($material (dh_trial_material $root)) ($parent (index-atom $material 1))
          ($cases (index-atom $material 2)) ($pins (index-atom $material 3))
          ($pr (TVReport $cases $parent $pins)) ($cr (TVReport $cases $candidate $pins))
          ($decision (TVAdjudicate $cases $parent $candidate $pins $pr $cr))
          ($invocations (DHInvocations $root $parent $candidate))
          ($load-parent (DHNLoad $root (index-atom $invocations 0)))
          ($load-candidate (DHNLoad $root (index-atom $invocations 1)))
          ($ranking (ERank $invocations)))
    (consequence-severed-proof $quarantine (DH2DecisionProof $decision)
     (DH2RankingProof $ranking) no-consequence-consumer))
   (consequence-severed-proof-incomplete $product))))
