; Investigation-25 complete constitutive inheritance surface.
; Pure MeTTa cognition: this certificate is constructed from the actual
; primary movements and their one simultaneous R/A/P read.  It validates
; organization; it never reconstructs or selects a movement from readings.

(= (M25RequiredExports)
   (movement-is-primary
    dynamic-participatory-fourthness-positive-center
    ambient-soul-doctrine-not-carrier-standing
    rap-three-heterogeneous-readings-of-one-movement
    rap-non-reconstructive-and-non-scalarizable
    relatedness-and-precision-material-floors
    appropriateness-as-lawful-fittingness
    readapp-doctrine-provenance-and-non-contact-standing
    inherited-m24-law-one-home
    harmonic-alignment-derived
    bounded-harmonic-continuation-coherence-and-falsifier
    force-not-forcing
    action-energy-not-forcing-energy
    pns-sns-participation-organizations
    stuck-is-thresholded-sns
    possibility-includes-interface-and-topology-change
    fourthness-and-materiality-share-discrimination
    sns-and-stuck-share-trajectory-primitives
    witness-first-metta-projection
    no-universal-numerical-forcing-metric
    complete-awareness-nine-and-soul-mathematics-bounded))

(= (M25RatifiedFalsifierSurface)
   (movement-from-three-rap-numbers
    weighted-rap-intelligence
    appropriateness-from-fixed-reward-or-policy-only
    readapp-despite-failed-material-floor
    complete-future-knowledge-required
    fixed-enumerated-participation-space
    high-action-or-compute-implies-sns
    cheap-repetition-implies-pns
    incompatible-frames-forced-into-master-view
    sequential-rap-optimization-substitutes-for-integrated-dpf
    model-self-certifies-sufficiency
    removed-material-fourthness-never-changes-movement
    sns-and-stuck-use-unrelated-detectors
    movement-self-certifies-materiality
    soul-standing-stored-as-carrier-field))

(= (M25ProvisionalBoundary)
   (m25-provisional-boundary-v1
     exact-numerical-e-force-metric-not-ratified
     exact-universal-rp-carrier-not-ratified
     irreducible-readapp-semantic-seams-remain-bounded
     complete-awareness-and-meta-awareness-mathematics-not-claimed
     complete-nine-immutable-facts-mathematics-not-claimed
     complete-soul-formalization-not-claimed
     physical-energy-grounding-map-not-claimed
     unified-world-model-kernel-not-claimed))

(= (M25FormalEvidenceBoundary)
   (m25-formal-evidence-boundary-v1
     ratified-mathematical-object
     finite-heterogeneous-examples-earned
     native-witness-bearing-projection
     bounded-runtime-countermodels
     no-lean-complete-world-proof-claimed
     no-carrier-certifies-actuality-complete))

(= (M25PrimaryConstitutionBundle $primary $cut $developmental $rap)
   (let* (($dpf (index-atom $primary 4))
          ($surface (index-atom $rap 1))
          ($m24 (M25RAPM24Precursor $surface)))
     (m25-primary-constitution-bundle-v1
       (primary-movement $primary)
       (dynamic-participatory-fourthness $dpf)
       (balance-unfolding-organization (index-atom $primary 5))
       (source-cut (index-atom $cut 1))
       (m24-inherited-one-home $m24)
       (developmental-organization (index-atom $developmental 13))
       movement-formed-before-readings
       ambient-soul-doctrine-no-carrier-verdict)))

(= (M25RAPConstitutionBundle $primary $cut $developmental $rap)
   (let* (($surface (index-atom $rap 1))
          ($perspectives (index-atom $rap 2)))
     (m25-rap-constitution-bundle-v1
       $surface
       (one-read-event (index-atom $surface 1))
       (one-movement (index-atom $primary 1))
       (three-simultaneous-perspectives $perspectives)
       (rap-valid (M25RAPValid $primary $cut $developmental $rap))
       heterogeneous-non-reconstructive
       no-sequential-optimizer-or-chooser
       no-scalar-aggregate-authority)))

(= (M25MaterialFittingnessBundle $primary $cut $developmental $rap)
   (let* (($surface (index-atom $rap 1))
          ($relatedness (M25RelatednessProfile $primary $cut))
          ($precision (M25PrecisionProfile $primary $cut))
          ($admissibility (M25Adm25Witness $primary $developmental
            $relatedness $precision))
          ($appropriateness (M25AppropriatenessPerspective $primary $surface
            $admissibility $relatedness $precision)))
     (m25-material-fittingness-bundle-v1
       $relatedness
       $precision
       $admissibility
       $appropriateness
       (readapp (index-atom $appropriateness 3))
       (counterfactual-bite (index-atom (index-atom $primary 4) 8))
       non-compensatory-material-floors
       derived-standing-never-direct-contact)))

(= (M25CurrentBoundedContinuation $primary $cut $developmental $rap)
   (M25BoundedHarmonicContinuation $primary $cut $developmental $rap
     (bounded-model-witness-unresolved no-independent-current-model-claim)
     (harmonic-outcome-unresolved no-returned-current-consequence)))

(= (M25HarmonicConsequenceBundle $primary $cut $developmental $rap)
   (let* (($alignment (M25HarmonicAlignment $primary $cut $developmental
            $rap))
          ($interface (M25InterfaceEvolution $primary $cut)))
     (m25-harmonic-consequence-bundle-v1
       $alignment
       (alignment-derived-valid
         (M25HarmonicAlignmentValid $primary $cut $developmental $alignment))
       (M25CurrentBoundedContinuation $primary $cut $developmental $rap)
       (contactability (M25Contactable $primary))
       (interface-participation $interface)
       miss-renews-actuality-and-defeats-at-least-one-premise
       consequence-is-not-reward-by-definition
       no-model-or-movement-self-certifies-sufficiency)))

(= (M25ParticipationEnergeticsBundle $primary $cut $developmental)
   (let* (($energetics (M25Energetics $primary))
          ($basis (M25TrajectoryBasis $primary $cut $developmental))
          ($orientation (M25OrientationFromBasis $basis)))
     (m25-participation-energetics-bundle-v1
       $energetics
       (energetics-valid (M25EnergeticsValid $primary $energetics))
       $basis
       $orientation
       force-is-not-forcing
       e-act-is-not-e-force
       pns-sns-and-stuck-share-one-trajectory-organization
       stuck-implies-sns-not-converse
       no-universal-numerical-forcing-metric)))

(= (M25ProjectionBoundaryBundle)
   (m25-projection-boundary-bundle-v1
     (canonical-witness-families relatedness-witness precision-witness
       admissibility-witness appropriateness-reading force-residue-witness
       interface-change fourth-discrimination harmonic-alignment-witness
       sns-trajectory-witness stuck-threshold-witness)
     witness-first-not-score-first
     possibility-may-change-participation-topology
     awareness-is-causal-availability-only-at-this-jurisdiction
     (M25ProvisionalBoundary)
     (M25FormalEvidenceBoundary)
     (ratified-falsifiers (M25RatifiedFalsifierSurface))))

(= (M25ReadingCertificate $reading $cut $developmental)
   (if (CPShape $reading m25-movement-reading-v3 9)
     (let* (($primary (index-atom $reading 1))
            ($rap (index-atom $reading 2)))
       (if (M25MovementReadingExact $reading $cut $developmental)
         (m25-reading-certificate-v1
           (index-atom $primary 1)
           (M25PrimaryConstitutionBundle $primary $cut $developmental $rap)
           (M25RAPConstitutionBundle $primary $cut $developmental $rap)
           (M25MaterialFittingnessBundle $primary $cut $developmental $rap)
           (M25HarmonicConsequenceBundle $primary $cut $developmental $rap)
           (M25ParticipationEnergeticsBundle $primary $cut $developmental))
         (m25-reading-certificate-unresolved invalid-primary-or-rap)))
     (m25-reading-certificate-unresolved malformed-reading)))

(= (M25ReadingCertificateValid $certificate $reading $cut $developmental)
   (if (CPShape $certificate m25-reading-certificate-v1 7)
     (== $certificate (M25ReadingCertificate $reading $cut $developmental))
     false))

(= (M25AtLeastOneValidRAPAt $readings $cut $developmental $i)
   (if (< $i (size-atom $readings))
     (let* (($reading (index-atom $readings $i))
            ($primary (index-atom $reading 1))
            ($rap (index-atom $reading 2)))
       (or (M25RAPValid $primary $cut $developmental $rap)
           (M25AtLeastOneValidRAPAt $readings $cut $developmental
             (+ $i 1))))
     false))

(= (M25ReadingCertificatesAt $readings $cut $developmental $i)
   (if (< $i (size-atom $readings))
     (cons-atom (M25ReadingCertificate (index-atom $readings $i) $cut
       $developmental)
       (M25ReadingCertificatesAt $readings $cut $developmental (+ $i 1)))
     ()))

(= (M25ReadingCertificatesValidAt $certificates $readings $cut
      $developmental $i)
   (if (< $i (size-atom $readings))
     (and (< $i (size-atom $certificates))
       (and (M25ReadingCertificateValid (index-atom $certificates $i)
              (index-atom $readings $i) $cut $developmental)
            (M25ReadingCertificatesValidAt $certificates $readings $cut
              $developmental (+ $i 1))))
     (== (size-atom $certificates) (size-atom $readings))))

(= (M25ConstitutiveCertificate $encounter $developmental)
   (if (and (CPShape $encounter constitutive-encounter 7)
            (M24DevelopmentalOrganizationValid $developmental))
     (let* (($cut (index-atom $encounter 1))
            ($generated (index-atom $encounter 4))
            ($readings (if (CPShape $generated m25-generated-organization-v1 4)
              (index-atom $generated 3) ()))
            ($certificates (M25ReadingCertificatesAt $readings $cut
              $developmental 0)))
       (m25-constitutive-certificate-v1
         (source-cut (index-atom $cut 1))
         (required-exports (M25RequiredExports))
         (reading-certificates $certificates)
         (movement-standing (index-atom $encounter 5))
         (M25ProjectionBoundaryBundle)
         finite-partial-movement-reading-no-sovereign-reconstruction))
     (m25-constitutive-certificate-unresolved invalid-encounter-or-development)))

(= (M25ConstitutiveCertificateStructuralValid $certificate)
   (if (CPShape $certificate m25-constitutive-certificate-v1 7)
     (==
       ((== (index-atom $certificate 2)
          (required-exports (M25RequiredExports)))
        (== (size-atom (M25RequiredExports)) 21)
        (CPShape (index-atom $certificate 3) reading-certificates 2)
        (CPShape (index-atom $certificate 4) movement-standing 2)
        (== (index-atom $certificate 5) (M25ProjectionBoundaryBundle))
        (== (index-atom $certificate 6)
          finite-partial-movement-reading-no-sovereign-reconstruction))
       (true true true true true true))
     false))

(= (M25ConstitutiveCertificateValid $certificate $encounter $developmental)
   (if (and (M25ConstitutiveCertificateStructuralValid $certificate)
            (CPShape $encounter constitutive-encounter 7))
     (let* (($readings (index-atom
              (index-atom $encounter 4) 3))
            ($certificates (index-atom (index-atom $certificate 3) 1)))
       (and (> (size-atom $readings) 0)
        (and (M25AtLeastOneValidRAPAt $readings (index-atom $encounter 1)
               $developmental 0)
         (and (M25ReadingCertificatesValidAt $certificates $readings
                (index-atom $encounter 1) $developmental 0)
              (== $certificate
                (M25ConstitutiveCertificate $encounter $developmental))))))
     false))

(= (M25CertificateReference $certificate)
   (m25-certificate-reference
     (index-atom (index-atom $certificate 1) 1)
     (export-count (size-atom (index-atom (index-atom $certificate 2) 1)))
     (reading-count
       (size-atom (index-atom (index-atom $certificate 3) 1)))
     movement-primary-rap-nonsovereign))
