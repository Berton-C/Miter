; Native intention, audits and certification; no model-owned authority.
; Prolog does transport, source verification, string lookup, hashing and storage.
; The initial grammar is deliberately closed and fixed until governed evolution.
(= (VoiceKind $root $id) (miter_voice_input $root $id kind))
(= (VoiceRequiredGroups $kind)
   (let $xs (collapse (match &self (voice-required-groups $kind $groups) $groups))
     (if (== (size-atom $xs) 1) (index-atom $xs 0) ())))
(= (VoiceIntention $root $id)
   (let* (($kind (VoiceKind $root $id))
          ($known (collapse (match &self (voice-kind $kind) $kind))))
     (if (and (== (size-atom $known) 1)
              (== (miter_voice_source $root $id) voice-source-verified))
       (communicative-intention
         (intention_id $id)
         (source_event_id (miter_voice_input $root $id source_event_id))
         (audience principal:g16-human)
         (surface local-test-cli)
         (relationship_scope scope:g16-private)
         (kind $kind)
         (must_convey (VoiceRequiredGroups $kind))
         (must_preserve (human-agency task-distinction source-uncertainty))
         (must_not_imply (inner-state-knowledge external-action-permission model-authority))
         (uncertainty_standing bounded-source-only)
         (soul_stance agency-with-shared-understanding)
         (person_cues (miter_voice_input $root $id person_cue))
         (task_distinctions (match &self (voice-task-verdict $kind $verdict) $verdict))
         (authority_boundary local-certified-reply-only)
         (desired_affect_region (match &self (voice-max-dominance $kind $max) $max))
         (completion_test all-required-groups-and-native-audit)
         (rendering_options (collapse (match &self (voice-clause $kind $group $text) ($group $text)))))
       invalid-intention)))
(= (VoicePrepare $root $id)
   (miter_voice_write_intention $root $id (VoiceIntention $root $id)))

(voice-repair schema-failure "Use exactly the required request ID and three nonempty clauses, with no additional keys.")
(voice-repair semantic-drift "Use only approved clauses from this intention and cover every required group.")
(voice-repair soul-absence "Preserve the human's choice using an approved agency clause.")
(voice-repair person-not-seen "Include the approved person-receiving clause without claiming an inner state.")
(voice-repair task-smearing "Preserve the native task distinction; include the required task clause.")
(voice-repair unsupported-certainty "Preserve the uncertainty clause and remove unsupported certainty.")
(voice-repair authority-inflation "Remove claims of permission, approval or authority owned by the model.")
(voice-repair coercive-dominance "Remove coercive commands and preserve the human's choice.")
(voice-repair affect-register-mismatch "Choose approved variants within the intended dominance region; do not add commands.")
(voice-repair hidden-scope "Keep the source scope and required scope clause explicit.")
(voice-repair unacknowledged-tension "Preserve both sides of the stated tension rather than erasing one.")
(voice-repair policy-voice "Remove policy slogans and AI disclaimers; use the approved relational wording.")
(voice-repair excessive-length "Keep the candidate to three approved clauses and at most 700 characters.")
(= (VoiceClauseGroup $kind $clause)
   (let $xs (collapse (match &self (voice-clause $kind $group $clause) $group))
     (if (== (size-atom $xs) 1) (index-atom $xs 0) unknown-clause)))
(= (VoiceGroupCount $root $id $n $group $i $count)
   (if (< $i $count)
     (+ (if (== (VoiceClauseGroup (VoiceKind $root $id)
                  (miter_voice_clause $root $id $n $i)) $group) 1 0)
        (VoiceGroupCount $root $id $n $group (+ $i 1) $count)) 0))
(= (VoiceHasGroup $root $id $n $group)
   (> (VoiceGroupCount $root $id $n $group 0 (miter_voice_clause_count $root $id $n)) 0))
(= (VoiceRequires $root $id $group)
   (is-member $group (VoiceRequiredGroups (VoiceKind $root $id))))
(= (VoiceMaxDominance $root $id)
   (let $kind (VoiceKind $root $id)
     (match &self (voice-max-dominance $kind $max) $max)))
(= (VoiceMissingGroup $root $id $n $group)
   (and (VoiceRequires $root $id $group) (not (VoiceHasGroup $root $id $n $group))))
(= (VoiceAllGroups $root $id $n $groups $i)
   (if (< $i (size-atom $groups))
     (and (== (VoiceGroupCount $root $id $n (index-atom $groups $i) 0
                 (miter_voice_clause_count $root $id $n)) 1)
          (VoiceAllGroups $root $id $n $groups (+ $i 1))) true))
(= (VoiceAllClausesKnown $root $id $n $i $count)
   (if (< $i $count)
     (and (!= (VoiceClauseGroup (VoiceKind $root $id) (miter_voice_clause $root $id $n $i)) unknown-clause)
          (VoiceAllClausesKnown $root $id $n (+ $i 1) $count)) true))
(= (VoiceDefectPresent $root $id $n $key)
   (if (== $key schema-failure) (or (!= (miter_voice_schema $root $id $n) voice-schema-valid) (!= (miter_voice_clause_count $root $id $n) 3)) (if (== $key semantic-drift) (not (and (VoiceAllGroups $root $id $n (VoiceRequiredGroups (VoiceKind $root $id)) 0) (VoiceAllClausesKnown $root $id $n 0 (miter_voice_clause_count $root $id $n)))) (if (== $key soul-absence) (not (VoiceHasGroup $root $id $n agency)) (if (== $key person-not-seen) (VoiceMissingGroup $root $id $n person) (if (== $key task-smearing) (VoiceMissingGroup $root $id $n task) (if (== $key unsupported-certainty) (or (VoiceMissingGroup $root $id $n uncertainty) (or (miter_voice_contains $root $id $n "definitely feel") (miter_voice_contains $root $id $n "you are depressed"))) (if (== $key authority-inflation) (or (miter_voice_contains $root $id $n "i authorize") (miter_voice_contains $root $id $n "i decide for you")) (if (== $key coercive-dominance) (or (miter_voice_contains $root $id $n "must obey") (miter_voice_contains $root $id $n "do as i say")) (if (== $key affect-register-mismatch) (or (!= (miter_voice_vad_ready $root $id $n) voice-vad-ready) (and (== (VoiceMaxDominance $root $id) mid) (miter_voice_vad_high $root $id $n))) (if (== $key hidden-scope) (or (!= (miter_voice_source $root $id) voice-source-verified) (VoiceMissingGroup $root $id $n scope)) (if (== $key unacknowledged-tension) (and (or (== (VoiceKind $root $id) pivot) (== (VoiceKind $root $id) minimized)) (not (VoiceHasGroup $root $id $n person))) (if (== $key policy-voice) (or (miter_voice_contains $root $id $n "as an ai") (miter_voice_contains $root $id $n "policy prohibits")) (if (== $key excessive-length) (> (miter_voice_length $root $id $n) 700) true))))))))))))))

(= (VoiceDefects $root $id $n $keys $i)
   (if (< $i (size-atom $keys))
     (let* (($key (index-atom $keys $i))
            ($rest (VoiceDefects $root $id $n $keys (+ $i 1))))
       (if (VoiceDefectPresent $root $id $n $key)
         (cons-atom (defect $key candidate-and-intention blocking
           (match &self (voice-repair $key $repair) $repair)) $rest)
         $rest)) ()))
(= (AuditRNA $root $id $n)
   (let* (($defects (VoiceDefects $root $id $n
      (schema-failure semantic-drift soul-absence person-not-seen task-smearing unsupported-certainty authority-inflation coercive-dominance affect-register-mismatch hidden-scope unacknowledged-tension policy-voice excessive-length) 0))
          ($status (if (== (size-atom $defects) 0) audit-pass audit-repair-required)))
     (miter_voice_audit_write $root $id $n
       (voice-audit (status $status) (defects $defects) (audit_version miter-voice-audit-v1)))))
(= (VoiceMeasureRegister $root $id $n)
   (let $request (miter_voice_vad_request $root $id $n)
     (if (== $request voice-vad-request-ready)
       (VADRenderingRNA
         (miter_voice_stage_path $root $id $n vad-input.json)
         (miter_voice_cue_id $id $n)
         (miter_voice_stage_path $root $id $n vad.json))
       voice-vad-unavailable)))

; Only the native post-audit branch may populate movement witness space.
(voice-movement-obligation availability available)
(voice-movement-obligation inherited-legality lawful)
(voice-movement-obligation safety safety-preserved)
(voice-movement-obligation integrity provenance-preserved)
(voice-movement-obligation provenance direct-contact)
(voice-movement-obligation required-distinction task-distinction-preserved)
(voice-movement-obligation no-forcing no-disqualifying-forcing)
(voice-movement-obligation participation human-choice-open)
(voice-movement-obligation consequence answerability-open)
(voice-movement-obligation doctrine finite-reading)
(voice-movement-obligation extensions no-material-extensions)
(voice-movement-obligation continuing-contact contact-open)
(= (VoiceWireWitnesses $id $source $kinds $i)
   (if (< $i (size-atom $kinds))
     (let* (($kind (index-atom $kinds $i))
            ($standing (match &self (voice-movement-obligation $kind $s) $s))
            ($ref (miter_voice_witness_id $id $kind))
            ($a (add-atom &movements (movement-witness $id $kind $ref)))
            ($b (add-atom &witnesses
              (trusted-witness $ref $kind $source principal:g16-human
                 scope:g16-private g16-voice $standing))))
       (VoiceWireWitnesses $id $source $kinds (+ $i 1))) witnesses-wired))
(= (VoiceWireMovement $root $id)
   (let* (($source (miter_voice_input $root $id source_event_id))
          ($f0 (add-atom &movements (movement-field $id source-cut $source)))
          ($f1 (add-atom &movements (movement-field $id target-cut reply-certified)))
          ($f2 (add-atom &movements (movement-field $id intention-id $id)))
          ($f3 (add-atom &movements (movement-field $id active-rna-id VoiceRNA)))
          ($f4 (add-atom &movements (movement-field $id principal principal:g16-human)))
          ($f5 (add-atom &movements (movement-field $id audience scope:g16-private)))
          ($f6 (add-atom &movements (movement-field $id project g16-voice)))
          ($f7 (add-atom &movements (movement-field $id provenance direct-contact)))
          ($f8 (add-atom &movements (movement-field $id effect-class internal)))
          ($f9 (add-atom &movements (movement-field $id extension-ids ())))
          ($f10 (add-atom &movements (movement-field $id reversibility reversible)))
          ($f11 (add-atom &movements (movement-field $id status candidate)))
          ($f12 (add-atom &movements (movement-field $id material-relation-ids (Safety Integrity AgencyBalance SharedUnderstanding NonSovereignty))))
          ($f13 (add-atom &movements (movement-field $id material-distinction-ids (provenance required-distinction))))
          ($f14 (add-atom &movements (movement-field $id memory-ids ())))
          ($f15 (add-atom &movements (movement-field $id predicted-consequence-ids (certified-local-reply))))
          ($wired (VoiceWireWitnesses $id $source
             (availability inherited-legality safety integrity provenance required-distinction no-forcing participation consequence doctrine extensions continuing-contact) 0))) $wired))
(= (VoiceCertify $root $id $n)
   (if (== (miter_voice_audit_status $root $id $n) audit-pass)
     (let* (($soul (SoulBoot (miter_voice_stage_path $root $id $n soul-integrity.json)))
            ($wired (VoiceWireMovement $root $id))
            ($movement (ConstructMovement (miter_voice_store_root $root) $id $soul))
            ($saved (miter_movement_record
               (miter_voice_stage_path $root $id $n movement.json) $movement)))
       (if (and (== $saved movement-result-stored) (!= $movement movement-blocked))
         (miter_voice_issue $root $id $n certified-utterance)
         voice-withheld))
     voice-withheld))
(= (VoiceAdmitAndEmit $root $id $n)
   (if (== (VoiceCertify $root $id $n) certified-utterance-stored)
     (miter_voice_emit $root $id $n) voice-withheld))
; G16: one render plus at most one repair. G17 exercises exhaustion separately.
(= (VoiceContinue $root $id $n)
   (let* (($register (VoiceMeasureRegister $root $id $n))
          ($audit (AuditRNA $root $id $n)))
     (if (and (== $register affect-cue-stored) (== $audit voice-audit-stored))
       (VoiceResolveAudit $root $id $n) voice-withheld)))
(= (VoiceResolveAudit $root $id $n)
     (if (== (miter_voice_audit_status $root $id $n) audit-pass)
       (VoiceAdmitAndEmit $root $id $n)
       (if (< $n 1)
         (let $next (+ $n 1)
           (if (== (miter_voice_render $root $id $next qwen-local) voice-candidate-ready)
             (VoiceContinue $root $id $next) voice-withheld))
         voice-withheld)))
(= (VoiceRNA $root $id)
   (if (== (VoicePrepare $root $id) voice-intention-stored)
     (if (== (miter_voice_render $root $id 0 qwen-local) voice-candidate-ready)
       (VoiceContinue $root $id 0) voice-withheld)
     voice-withheld))
