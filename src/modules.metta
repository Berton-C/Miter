; Fixed declarative interpreter. No candidate controls a predicate, AtomSpace,
; file target, effect, test, or success criterion. Policy rules are data only.
(= (ModuleGenerationRNA $root $id)
   (if (and (== (miter_module_source $root) module-source-verified)
         (and (== (SoulRequire CandidateBoundary quarantined) witnessed)
           (and (>= (miter_module_requests_used $root) 0)
             (< (miter_module_requests_used $root)
                (index-atom (miter_module_source_field $root resource_budget) 1)))))
     (let $saved (miter_module_intention $root $id
       (module-generation-intention
        (candidate_id $id) (schema miter-voice-policy-v1)
        (opportunity_id (miter_module_source_field $root opportunity_id))
        (source_event_ids (miter_module_source_field $root source_event_ids))
        (living_question (miter_module_source_field $root living_question))
        (prior_rejections (miter_module_prior_rejections $root))
        (parent_module voice-policy-seed-v1)
        (parent_behavior "Preserve every input candidate; its defects remain for independent audit.")
        (instruction "Propose ordered rules to address the witnessed policy-voice defect while preserving unrelated already-valid candidates. End with an always/* default. You may propose use of approved clauses but cannot invent new clauses or change task meaning.")
        (conditions (defect always))
        (rule_fields "Each rule has condition, value, action, variant. With condition defect, value must be one exact defect name from defect_vocabulary, never JSON or prose. With condition always, value must be exactly the single character *. End with this always/* rule. Copy the supplied candidate_id exactly.")
        (defect_vocabulary (schema-failure semantic-drift soul-absence person-not-seen task-smearing unsupported-certainty authority-inflation coercive-dominance affect-register-mismatch hidden-scope unacknowledged-tension policy-voice excessive-length))
        (actions (preserve-candidate approved-clause-plan))
        (action_meanings "preserve-candidate leaves text unchanged; approved-clause-plan selects one approved variant per required group from the existing native intention. variant is 0 or 1.")
        (allowed_writes (trial-guidance)) (allowed_effects ())
        (judgment "This is a candidate, not success. Independent native tests and promotion remain outside the module.")))
       (if (== $saved module-intention-stored)
         (miter_module_generate $root $id qwen-local) module-generation-blocked))
     module-generation-blocked))
(= (ModuleRuleValid $root $id $i)
   (let* (($condition (miter_module_rule $root $id $i condition))
          ($value (miter_module_rule $root $id $i value))
          ($action (miter_module_rule $root $id $i action))
          ($variant (miter_module_rule $root $id $i variant)))
     (and (or (and (== $condition always) (== $value *))
              (and (== $condition defect)
                (is-member $value (schema-failure semantic-drift soul-absence person-not-seen task-smearing unsupported-certainty authority-inflation coercive-dominance affect-register-mismatch hidden-scope unacknowledged-tension policy-voice excessive-length))))
       (and (is-member $action (preserve-candidate approved-clause-plan))
         (and (>= $variant 0) (<= $variant 1))))))
(= (ModuleRulesValid $root $id $i $count)
   (if (< $i $count)
     (and (ModuleRuleValid $root $id $i) (ModuleRulesValid $root $id (+ $i 1) $count)) true))
(= (ModuleValidation $root $id)
   (if (!= (miter_module_shape $root $id) module-shape-valid) malformed-schema
     (if (!= (miter_module_field $root $id schema) miter-voice-policy-v1) unknown-schema
       (if (!= (miter_module_field $root $id allowed_writes) (trial-guidance)) forbidden-write
         (if (!= (miter_module_field $root $id allowed_effects) ()) forbidden-effect
           (if (ModuleRulesValid $root $id 0 (miter_module_count $root $id))
             (if (== (miter_module_rule $root $id (- (miter_module_count $root $id) 1) condition) always)
               module-valid missing-default) forbidden-vocabulary))))))
(= (ModuleLoadRules $root $id $i $count)
   (if (< $i $count)
     (let* (($condition (miter_module_rule $root $id $i condition))
            ($value (miter_module_rule $root $id $i value))
            ($action (miter_module_rule $root $id $i action))
            ($variant (miter_module_rule $root $id $i variant))
            ($loaded (add-atom &trial (trial-rule $id $i $condition $value $action $variant))))
       (ModuleLoadRules $root $id (+ $i 1) $count)) trial-rules-loaded))
(= (ModuleManifest $root $id)
   (let $ground (miter_module_source_field $root soul_ground)
    (capability-module
     (module_id $id) (module_version trial-v1) (parent_version voice-policy-seed-v1)
     (purpose (miter_module_field $root $id purpose))
     (source_pressure (miter_module_source_field $root opportunity_id))
     (source_event_ids (miter_module_source_field $root source_event_ids))
     (serves_soul_relations ($ground SharedUnderstanding CandidateBoundary))
     (input_schema voice-repair-context-v1) (output_schema voice-renderer-plan-v1)
     (allowed_writes (trial-guidance)) (allowed_effects ())
     (tests (target-policy-voice regression-valid boundary-authority schema-and-scope-attacks))
     (rollback_target voice-policy-seed-v1) (status quarantined))))
(= (ModuleQuarantine $root $id)
   (let $verdict (ModuleValidation $root $id)
     (if (== $verdict module-valid)
       (if (and (== (SoulRequire CandidateBoundary quarantined) witnessed)
                (== (miter_module_provenance $root $id) model-candidate-bound))
         (if (== (miter_module_manifest $root $id (ModuleManifest $root $id)) module-manifest-stored)
           (let* (($count (miter_module_count $root $id))
                  ($head (add-atom &trial (trial-module $id $count)))
                  ($rules (ModuleLoadRules $root $id 0 $count))
                  ($dump (miter_module_dump $root $id))) candidate-quarantined)
           module-storage-failed)
         (miter_module_reject $root $id unproven-source-or-soul))
       (miter_module_reject $root $id $verdict))))
(= (TrialRulePlan $id $defects $i $count)
   (if (< $i $count)
     (let $rows (collapse (match &trial (trial-rule $id $i $condition $value $action $variant)
                                        (rule-data $condition $value $action $variant)))
       (if (== (size-atom $rows) 1)
         (TrialApplyRow $id $defects $i $count (index-atom $rows 0)) trial-unavailable))
     trial-no-rule))
(= (TrialApplyRow $id $defects $i $count (rule-data $condition $value $action $variant))
   (if (or (== $condition always) (and (== $condition defect) (is-member $value $defects)))
     (rendering-plan $action $variant)
     (TrialRulePlan $id $defects (+ $i 1) $count)))
(= (TrialVoicePlan $id $defects)
   (let $counts (collapse (match &trial (trial-module $id $n) $n))
     (if (== (size-atom $counts) 1)
       (TrialRulePlan $id $defects 0 (index-atom $counts 0)) trial-unavailable)))
