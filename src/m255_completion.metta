     bounded-machine-evidence-not-universal-actuality-proof))

(= (M255PrimaryBridgeFromReading $reading)
   (index-atom (index-atom $reading 1) 10))

(= (M255CoherenceWitness $reading $encounter)
   (let* (($primary (index-atom $reading 1))
          ($cut (index-atom $encounter 1))
          ($bridge (M255PrimaryBridgeFromReading $reading))
          ($equivalence (index-atom $bridge 1))
          ($translation (index-atom $equivalence 3))
          ($suite (index-atom $bridge 2))
          ($participation (index-atom $bridge 3))
          ($mc-bundle (index-atom $suite 3))
          ($mc-profile (index-atom $participation 3))
          ($force (index-atom $mc-profile 3))
          ($one-engine (index-atom $mc-profile 4))
          ($open (index-atom $one-engine 5))
          ($constrained (index-atom $one-engine 6))
          ($source (index-atom $translation 1))
          ($target (index-atom $translation 2))
          ($source-generated (index-atom $translation 3)))
     (m255-coherence-witness-v1
       (ch1 (bounded-domain (M255GenSigCarrier $source)
              (M255GenSigCarrier $target))
         reflexive-symmetric-transitive-law-required)
       (ch2 (access-reference (index-atom $open 1) (index-atom $open 2)
              (index-atom $open 4) (index-atom $open 5))
         exact-reapplication)
       (ch3 (access-reference (index-atom $constrained 1)
              (index-atom $constrained 2) (index-atom $constrained 4)
              (index-atom $constrained 5)) constrained-is-instantiated)
       (ch4 (generated-reference (index-atom $primary 1))
         (source-cut (index-atom $cut 1)) partial-rstar-no-totality-claim)
       (ch5 (index-atom $open 5) access-and-reachable-same-view)
       (ch6 (same-generated (M255GeneratedRef $mc-bundle))
         open-and-constrained-are-distinct)
       (source-generated-reference
         (M255GenSigCarrier $source) (index-atom $source-generated 6)))))

(= (M255CoherenceWitnessValid $witness $reading $encounter $developmental)
   (if (and (CPShape $witness m255-coherence-witness-v1 8)
            (CPShape $reading m25-movement-reading-v3 9))
     (let* (($primary (index-atom $reading 1))
            ($cut (index-atom $encounter 1))
            ($bridge (M255PrimaryBridgeFromReading $reading))
            ($equivalence (index-atom $bridge 1))
            ($translation (index-atom $equivalence 3))
            ($suite (index-atom $bridge 2))
            ($participation (index-atom $bridge 3))
            ($mc-bundle (index-atom $suite 3))
            ($mc-profile (index-atom $participation 3))
            ($force (index-atom $mc-profile 3))
            ($one-engine (index-atom $mc-profile 4))
            ($open (index-atom $one-engine 5))
            ($constrained (index-atom $one-engine 6))
            ($source (index-atom $translation 1))
            ($source-generated (index-atom $translation 3)))
       (and (M255TranslationLawWitnessValid $translation
              (M255TranslationLawWitness $translation))
        (and (M25MovementReadingExact $reading $cut $developmental)
         (and (M255AccessViewValid $open $mc-bundle $force)
         (and (== $open (M255OpenAccess $mc-bundle $force))
          (and (M255AccessViewValid $constrained $mc-bundle $force)
           (and (== $constrained (M255ConstrainedAccess $mc-bundle $force))
            (and (M255GeneratedWitnessStructuralValid $source-generated
                   $source)
             (and (== (index-atom (index-atom $source 2) 1)
                    (index-atom $cut 1))
              (and (CPShape (index-atom $open 5) reachable 3)
               (and (!= $open $constrained)
                (and (== (index-atom $open 3)
                       (index-atom $constrained 3))
                     (== $witness
                       (M255CoherenceWitness $reading
                         $encounter)))))))))))))
     false)))

(= (M255SuccessLedgerReference $reading)
   (let* (($primary (index-atom $reading 1))
          ($rap (index-atom $reading 2))
          ($bridge (M255PrimaryBridgeFromReading $reading))
          ($suite (index-atom $bridge 2))
          ($participation (index-atom $bridge 3))
          ($recognition (index-atom $bridge 4))
          ($inherited (index-atom $reading 7)))
     (m255-success-ledger-reference-v1
       (s1 (index-atom $suite 8))
       (s2 (carrier-equivalence (M255GenSigCarrier
             (index-atom (index-atom $bridge 1) 1))
            (M255GenSigCarrier (index-atom (index-atom $bridge 1) 2))))
       (s3 (one-rap-read (index-atom (index-atom $rap 1) 1)))
       (s4 (bridge-reference (index-atom $inherited 1)))
       (s5 (force-support-five-carrier-reference
             (index-atom $primary 1)))
       (s6 (index-atom $participation 6))
       (s7 (reflexive-profile-references MC MD))
       (s8 disclosure-distinct-from-creation)
       (s9 same-law-maintenance-and-degradation)
       (s10 (recognition-reference (index-atom $recognition 3)))
       (s11 (carrier-suite-reference MA MB MC MD ME))
       (s12 witness-bearing-metta-shadow-no-actuality-identity))))

(= (M255ReadingClosure $reading $m25-reading-certificate $encounter)
   (if (and (CPShape $encounter constitutive-encounter 7)
        (and (CPShape $reading m25-movement-reading-v3 9)
             (CPShape $m25-reading-certificate
               m25-reading-certificate-v1 7)))
     (let* (($primary (index-atom $reading 1))
            ($rap (index-atom $reading 2))
            ($bridge (M255PrimaryBridgeFromReading $reading))
            ($equivalence (index-atom $bridge 1))
            ($suite (index-atom $bridge 2))
            ($participation (index-atom $bridge 3))
            ($recognition (index-atom $bridge 4))
            ($precursor (M25RAPM255Precursor (index-atom $rap 1)))
            ($inherited (index-atom $reading 7)))
       (m255-reading-closure-v1
         (primary-movement-reference (index-atom $primary 1))
         (generated-reference (index-atom $primary 1))
         (carrier-equivalence-reference
           (M255GenSigCarrier (index-atom $equivalence 1))
           (M255GenSigCarrier (index-atom $equivalence 2)))
         (five-carrier-reference (index-atom $suite 6) MA MB MC MD ME)
         (participation-reference (index-atom $participation 6))
         (recognition-reference (index-atom $recognition 3))
         (rap-precursor-reference (index-atom $primary 1)
           (index-atom $precursor 1))
         (b1-through-b10-reference (index-atom (index-atom $rap 1) 1)
           (index-atom $inherited 9))
         (M255CoherenceWitness $reading $encounter)
         (M255SuccessLedgerReference $reading)))
     (m255-reading-closure-unresolved
       (if (CPShape $reading m25-movement-reading-v3 9)
         (index-atom (index-atom $reading 1) 1) malformed-reading)
       exact-generative-reading-not-available)))

(= (M255ReadingClosureValid $closure $reading $m25-reading-certificate
      $encounter $developmental)
   (if (CPShape $closure m255-reading-closure-v1 11)
     (let* (($cut (index-atom $encounter 1))
            ($facts (index-atom $encounter 2))
            ($flourishing (index-atom $encounter 3))
            ($primary (index-atom $reading 1))
            ($possibility (index-atom $primary 9))
            ($rap (index-atom $reading 2))
            ($bridge (M255PrimaryBridgeFromReading $reading))
            ($equivalence (index-atom $bridge 1))
            ($translation (index-atom $equivalence 3))
            ($suite (index-atom $bridge 2))
            ($participation (index-atom $bridge 3))
            ($recognition (index-atom $bridge 4))
            ($precursor (M25RAPM255Precursor (index-atom $rap 1)))
            ($inherited (index-atom $reading 7)))
       (and (M25ReadingCertificateValid $m25-reading-certificate $reading
              $cut $developmental)
        (and (M255PrimaryCarrierBridgeValid $bridge $possibility)
         (and (M255CrossCarrierEquivV2Valid $equivalence)
          (and (M255TranslationLawWitnessValid $translation
                 (M255TranslationLawWitness $translation))
           (and (M255FiveCarrierSuiteReady $suite $cut $facts $flourishing
                  $possibility)
            (and (M255FiveCarrierParticipationSuiteValid $participation
                   $suite $possibility)
             (and (M255RecognitionOrganizationValid $recognition $cut $facts)
              (and (M255RAPPrecursorBridgeValid $precursor $primary $cut
                     $developmental)
               (and (M255InheritedSurfaceBridgesValid $inherited $primary
                      $cut $developmental $rap (index-atom $reading 3)
                      (index-atom $reading 6))
                (and (M255CoherenceWitnessValid (index-atom $closure 9)
                       $reading $encounter $developmental)
                     (== $closure
                       (M255ReadingClosure $reading $m25-reading-certificate
                         $encounter)))))))))))))
     false))

(= (M255ReadingClosuresAt $readings $m25-reading-certificates $encounter $i)
   (if (< $i (size-atom $readings))
     (cons-atom (M255ReadingClosure (index-atom $readings $i)
       (if (< $i (size-atom $m25-reading-certificates))
         (index-atom $m25-reading-certificates $i)
         (m25-reading-certificate-unresolved missing-certificate))
       $encounter)
       (M255ReadingClosuresAt $readings $m25-reading-certificates $encounter
         (+ $i 1)))
     ()))

(= (M255ReadingClosuresValidAt $closures $readings $m25-reading-certificates
      $encounter $developmental $i)
   (if (< $i (size-atom $readings))
     (and (and (< $i (size-atom $closures))
               (< $i (size-atom $m25-reading-certificates)))
       (let* (($closure (index-atom $closures $i))
              ($reading (index-atom $readings $i))
              ($m25-reading-certificate
                (index-atom $m25-reading-certificates $i)))
         (and (if (CPShape $closure m255-reading-closure-v1 11)
                (M255ReadingClosureValid $closure $reading
                  $m25-reading-certificate $encounter $developmental)
                (== $closure
                  (M255ReadingClosure $reading $m25-reading-certificate
                    $encounter)))
              (M255ReadingClosuresValidAt $closures $readings
                $m25-reading-certificates $encounter $developmental
                (+ $i 1)))))
     (and (== (size-atom $closures) (size-atom $readings))
          (== (size-atom $m25-reading-certificates)
            (size-atom $readings)))))

(= (M255AtLeastOneCompleteReadingAt $closures $i)
   (if (< $i (size-atom $closures))
     (or (CPShape (index-atom $closures $i) m255-reading-closure-v1 11)
         (M255AtLeastOneCompleteReadingAt $closures (+ $i 1)))
     false))

(= (M255ConstitutiveCertificate $encounter $developmental $m25-certificate)
   (if (and (CPShape $encounter constitutive-encounter 7)
        (and (M24DevelopmentalOrganizationValid $developmental)
             (M25ConstitutiveCertificateStructuralValid $m25-certificate)))
     (let* (($generated (index-atom $encounter 4))
            ($readings (if (CPShape $generated m25-generated-organization-v1 4)
              (index-atom $generated 3) ()))
            ($m25-reading-certificates
              (index-atom (index-atom $m25-certificate 3) 1))
            ($closures (M255ReadingClosuresAt $readings
              $m25-reading-certificates $encounter 0)))
       (m255-three-point-shot-package-v1
         (source-cut (index-atom (index-atom $encounter 1) 1))
         (required-exports (M255RequiredExports))
         (success-ledger (M255SuccessLedgerClauses))
         (reading-closures $closures)
         (adversarial-surface (M255N01N25Surface))
         (metta-projection-contract (M255ProjectionContract))
         (coherence-contract (M255CoherenceContract))
         (M255MachineEvidenceBoundary)
         (provisional-boundary (M255ProvisionalBoundary))
         (non-equivalence-boundary (M255NonEquivalenceBoundary))
         bounded-five-carrier-result-no-universal-metaphysical-claim))
     (m255-three-point-shot-package-unresolved
       invalid-encounter-or-developmental-organization)))

(= (M255ConstitutiveCertificateStructuralValid $certificate)
   (if (CPShape $certificate m255-three-point-shot-package-v1 12)
     (==
       ((== (index-atom $certificate 2)
          (required-exports (M255RequiredExports)))
        (== (size-atom (M255RequiredExports)) 24)
        (== (index-atom $certificate 3)
          (success-ledger (M255SuccessLedgerClauses)))
        (== (size-atom (M255SuccessLedgerClauses)) 12)
        (CPShape (index-atom $certificate 4) reading-closures 2)
        (== (index-atom $certificate 5)
          (adversarial-surface (M255N01N25Surface)))
        (== (size-atom (M255N01N25Surface)) 25)
        (== (index-atom $certificate 6)
          (metta-projection-contract (M255ProjectionContract)))
        (== (index-atom $certificate 7)
          (coherence-contract (M255CoherenceContract)))
        (== (index-atom $certificate 8) (M255MachineEvidenceBoundary))
        (== (index-atom $certificate 9)
          (provisional-boundary (M255ProvisionalBoundary)))
        (== (index-atom $certificate 10)
          (non-equivalence-boundary (M255NonEquivalenceBoundary)))
        (== (index-atom $certificate 11)
          bounded-five-carrier-result-no-universal-metaphysical-claim))
       (true true true true true true true true true true true true true))
     false))

(= (M255ConstitutiveCertificateDependentValid $certificate $encounter
      $developmental $m25-certificate)
   (if (and (M255ConstitutiveCertificateStructuralValid $certificate)
        (and (CPShape $encounter constitutive-encounter 7)
             (M25ConstitutiveCertificateStructuralValid $m25-certificate)))
     (let* (($readings (index-atom (index-atom $encounter 4) 3))
            ($m25-reading-certificates
              (index-atom (index-atom $m25-certificate 3) 1))
            ($closures (index-atom (index-atom $certificate 4) 1)))
       (and (> (size-atom $readings) 0)
        (and (== (index-atom $certificate 1)
               (source-cut (index-atom (index-atom $encounter 1) 1)))
         (and (== (size-atom $m25-reading-certificates)
                (size-atom $readings))
          (and (M255AtLeastOneCompleteReadingAt $closures 0)
               (== $certificate
                 (M255ConstitutiveCertificate $encounter $developmental
                   $m25-certificate)))))))
     false))

(= (M255ConstitutiveCertificateValid $certificate $encounter $developmental
      $m25-certificate)
   (and (M25ConstitutiveCertificateValid $m25-certificate $encounter
          $developmental)
        (M255ConstitutiveCertificateDependentValid $certificate $encounter
          $developmental $m25-certificate)))

(= (M255CertificateReference $certificate)
   (m255-certificate-reference
     (index-atom (index-atom $certificate 1) 1)
     (export-count (size-atom (index-atom (index-atom $certificate 2) 1)))
     (reading-count
       (size-atom (index-atom (index-atom $certificate 4) 1)))
     bounded-three-point-shot-no-sovereign-generation))
