; Native qualification of generic transport mechanics bound to Miter's exact
; P3 adapter. This is evidence comparison, not a live or behavioral policy.

(= (P4ObservationValid $observation $candidateHash $transportHash)
 (if (PShape $observation p4-transport-observation 19)
  (and (== (index-atom $observation 1) $candidateHash)
   (and (== (index-atom $observation 2) $transportHash)
    (and (== (index-atom $observation 3) 1)
     (and (== (index-atom $observation 4) 0)
      (and (== (index-atom $observation 5) true)
       (and (== (index-atom $observation 6) true)
        (and (== (index-atom $observation 7) true)
         (and (== (index-atom $observation 8) 2)
          (and (== (index-atom $observation 9) 1)
           (and (== (index-atom $observation 10) true)
            (and (== (index-atom $observation 11) true)
             (and (== (index-atom $observation 12) true)
              (and (== (index-atom $observation 13) true)
               (and (== (index-atom $observation 14) true)
                (and (== (index-atom $observation 15) true)
                 (and (== (index-atom $observation 16) false)
                  (and (== (index-atom $observation 17) true)
                       (== (index-atom $observation 18) true))))))))))))))))))
  false))

(= (P4TransportStanding $observation $candidateHash $transportHash)
 (if (P4ObservationValid $observation $candidateHash $transportHash)
  (g31-p4-transport-qualified
   (candidate $candidateHash)
   (transport (transport-qualified p4-loopback-v1 $transportHash non-cognitive-prolog))
   (scope offline-live-ineligible)
   (evidence authorization-first identity-preserved journaled restarted panic rollback)
   (next-standing eligible-for-exact-live-grant-not-activation))
  (g31-p4-transport-held $candidateHash $transportHash $observation)))
