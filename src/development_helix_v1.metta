; G33 R12: resume one waiting undertaking through native resource comparison,
; quarantined v2 construction, independent trial, native NAL consequence and
; later changed ranking.  Host code supplies mechanics and evidence only.
(= (DHIdsUnique $resources $n $seen)
 (if (< $n (size-atom $resources))
  (let $id (index-atom (index-atom $resources $n) 1)
   (and (not (PHas $id $seen 0)) (DHIdsUnique $resources (+ $n 1) (cons-atom $id $seen)))) true))
(= (DHAllIdsUnique $resources) (DHIdsUnique $resources 0 ()))
(= (DHReverseInto $xs $n $out)
 (if (< $n (size-atom $xs)) (DHReverseInto $xs (+ $n 1) (cons-atom (index-atom $xs $n) $out)) $out))
(= (DHReverse $xs) (DHReverseInto $xs 0 ()))
(= (DHRemoteAuthorized $resource $authorization)
 (if (== (index-atom $resource 2) remote)
  (and (PShape $authorization provider-authorization 9)
   (and (== (index-atom $authorization 1) (index-atom $resource 1))
    (and (== (index-atom $authorization 2) (index-atom $resource 3))
     (== (index-atom $authorization 8) operator-authorized)))) true))
(= (DHLimitsFit $resource $grant)
 (let $limits (index-atom $resource 7)
  (if (== (index-atom $limits 1) unspecified) true
   (and (<= (index-atom $grant 3) (index-atom $limits 1))
    (and (<= (index-atom $grant 4) (index-atom $limits 2))
     (<= 2097152 (index-atom $limits 3)))))))
(= (DHResourceEligible $resource $grant $authorization)
 (and (PShape $resource model-resource 9)
  (and (== (index-atom $resource 4) true)
   (and (PHas extension-implementation (index-atom $resource 5) 0)
    (and (DHLimitsFit $resource $grant) (DHRemoteAuthorized $resource $authorization))))))
(= (DHEligible $resources $grant $authorization)
 (collapse (let $r (superpose $resources)
  (if (DHResourceEligible $r $grant $authorization) $r (empty)))))
(= (DHSelectResource $input)
 (if (PShape $input development-helix-input 5)
  (let* (($checkpoint (index-atom $input 1)) ($resources (index-atom (index-atom $input 2) 1))
         ($preference (index-atom $input 3)) ($authorization (index-atom $input 4))
         ($grant (index-atom $checkpoint 4)) ($eligible (DHEligible $resources $grant $authorization)))
   (if (and (DHAllIdsUnique $resources) (== (index-atom $preference 2) evidence-not-authority))
    (let $preferred (collapse (let $r (superpose $eligible)
     (if (== (index-atom $r 1) (index-atom $preference 1)) $r (empty))))
     (if (== (size-atom $preferred) 1)
      (let $r (index-atom $preferred 0)
       (resource-selected (index-atom $r 1) (index-atom $r 3) $eligible
        (preference-basis operator-preference evidence-not-authority)))
      (if (== (size-atom $eligible) 1)
       (let $r (index-atom $eligible 0)
        (resource-selected (index-atom $r 1) (index-atom $r 3) $eligible
         (preference-basis sole-eligible no-semantic-authority)))
       (resource-selection-unresolved $eligible $preference))))
    (resource-selection-unresolved $eligible $preference)))
  (resource-selection-unresolved malformed-input)))
(= (DHCheckpointValid $checkpoint)
 (and (PShape $checkpoint waiting-checkpoint 14)
  (and (== (index-atom $checkpoint 2) (index-atom (index-atom $checkpoint 4) 1))
   (and (== (index-atom $checkpoint 10) pending)
    (and (== (index-atom $checkpoint 11) awaiting-model-result)
     (and (== (index-atom $checkpoint 8) (allowed-writes (trial-expression)))
      (== (index-atom $checkpoint 9) (allowed-effects ()))))))))
(= (DHQuestion $checkpoint $selection)
 (development-generation-call g33-r12-generation-1
  (index-atom $checkpoint 1) (index-atom $checkpoint 2) (index-atom $checkpoint 3)
  $selection (index-atom $checkpoint 4) (index-atom $checkpoint 5)
  (index-atom $checkpoint 6) (index-atom $checkpoint 7) (index-atom $checkpoint 8)
  (index-atom $checkpoint 9) (index-atom $checkpoint 12) (index-atom $checkpoint 13)))
(= (DHReady $id)
 (let $rows (collapse (match &rna (ready $id DevelopmentHelixRNA ResumeAuthorizedGeneration $n)
              (ready $id DevelopmentHelixRNA ResumeAuthorizedGeneration $n)))
  (if (== (size-atom $rows) 0)
   (let $add (add-atom &rna (ready $id DevelopmentHelixRNA ResumeAuthorizedGeneration 1)) helix-rna-ready)
   helix-rna-already-ready)))
(= (DevelopmentHelixIdle $root)
 (if (== (dh_outcome $root) development-helix-open)
  (let* (($input (dh_input $root)) ($selection (DHSelectResource $input)))
   (if (and (PShape $input development-helix-input 5)
        (and (DHCheckpointValid (index-atom $input 1)) (PShape $selection resource-selected 5)))
    (DHReady (index-atom (index-atom $input 1) 1))
    (development-helix-held $selection)))
  development-helix-already-closed))
(= (DHStageDevelopment $root $intent)
 (let $old (collapse (match &derived (pending-helix-development $root $prior) $prior))
  (if (== (size-atom $old) 0)
   (let $add (add-atom &derived (pending-helix-development $root $intent)) staged)
   (if (== $old ($intent)) staged conflict))))
(= (DHTrial $root $candidate $selection $generation)
 (let $material (dh_trial_material $root)
  (if (PShape $material trial-material 4)
   (let* (($parent (index-atom $material 1)) ($cases (index-atom $material 2))
          ($pins (index-atom $material 3)) ($parent-report (TVReport $cases $parent $pins))
          ($candidate-report (TVReport $cases $candidate $pins))
          ($quality (TVAdjudicate $cases $parent $candidate $pins $parent-report $candidate-report))
          ($decision (TVAuthorize $quality (trial-authority record-and-activate)))
          ($intent (helix-development-intent $root $parent $candidate $pins $decision $selection $generation))
          ($stage (DHStageDevelopment $root $intent))
          ($commit (if (== $stage staged) (dh_development_commit $root $intent) $stage))
          ($active (if (and (PShape $decision trial-admissible 6) (== $commit helix-development-durable))
            (add-atom &derived (active-voice-v2 $root $parent $candidate $pins)) inactive)))
    (helix-trial $parent-report $candidate-report $decision $commit))
   (helix-trial-incomplete $material))))
(= (DHNLoad $root $inv)
 (let* (($seed (NSeed $inv)) ($stored (dh_n_restore $root $seed)))
  (if (== $stored efficacy-never-stored) (NWrite $seed)
   (if (PShape $stored efficacy-belief 8)
    (if (NBelongs $stored $inv) (NWrite $stored) (efficacy-recovery-required scope-mismatch)) $stored))))
(= (DHNProcess $root $inv)
 (let* (($old (NRead $inv)) ($observed (NObserve $inv)) ($transition (NApply $old $observed)))
  (if (PShape $transition efficacy-transition 5)
   (let* (($staged (add-atom &derived (nace-pending $root $transition)))
          ($durable (dh_n_commit $root $transition)))
    (if (== $durable efficacy-durable)
     (let* (($write (NWrite (index-atom $transition 2)))
            ($remove (remove-atom &derived (nace-pending $root $transition))))
      (efficacy-processed (index-atom $transition 4) (NRead $inv)))
     (efficacy-persistence-incomplete $durable))) $transition)))
(= (DHInvocations $root $parent $candidate)
 (let* (($fixture (dh_efficacy_fixture $root)) ($scope (index-atom $fixture 1))
        ($frame (index-atom $fixture 2)) ($question (index-atom $fixture 3))
        ($context (index-atom $fixture 4)) ($fuel (index-atom $fixture 5))
        ($parent-pin (dh_module_hash $root parent)) ($candidate-pin (dh_module_hash $root candidate)))
  ((efficacy-invocation r12-parent $scope (r12-parent-consequence) $frame $question $context $parent-pin $parent $fuel)
   (efficacy-invocation r12-candidate $scope (r12-candidate-consequence) $frame $question $context $candidate-pin $candidate $fuel))))
(= (DHEfficacy $root $parent $candidate)
 (let* (($invocations (DHInvocations $root $parent $candidate))
        ($load-parent (DHNLoad $root (index-atom $invocations 0)))
        ($load-candidate (DHNLoad $root (index-atom $invocations 1)))
        ($before (ERank $invocations)) ($saved-before (dh_save $root efficacy-before $before))
        ($parent-result (DHNProcess $root (index-atom $invocations 0)))
        ($candidate-result (DHNProcess $root (index-atom $invocations 1)))
        ($after (ERank $invocations)) ($saved-after (dh_save $root efficacy-after $after)))
  (helix-efficacy $before $parent-result $candidate-result $after)))
(= (DHRun $root)
 (let* (($input (dh_input $root)) ($checkpoint (index-atom $input 1))
        ($selection (DHSelectResource $input)) ($saved-selection (dh_save $root selection $selection)))
  (if (and (DHCheckpointValid $checkpoint) (PShape $selection resource-selected 5))
   (let* (($question (DHQuestion $checkpoint $selection))
          ($pending (add-atom &derived (development-generation-pending $root $question)))
          ($generation (dh_generate $root $question))
          ($clear (remove-atom &derived (development-generation-pending $root $question)))
          ($saved-generation (dh_save $root generation $generation))
          ($product (dh_candidate $root $question $generation))
          ($saved-product (dh_save $root product $product)))
    (if (PShape $product model-candidate 4)
     (let* (($candidate (index-atom $product 1))
            ($quarantine (VQuarantine (index-atom $checkpoint 1) $candidate (index-atom $product 2)))
            ($saved-quarantine (dh_save $root quarantine $quarantine))
            ($trial (if (== $quarantine candidate-quarantined)
              (DHTrial $root $candidate $selection $generation) (helix-trial-incomplete $quarantine)))
            ($saved-trial (dh_save $root trial $trial))
            ($efficacy (if (and (PShape $trial helix-trial 5)
                              (PShape (index-atom $trial 3) trial-admissible 6))
              (DHEfficacy $root (index-atom (dh_trial_material $root) 1) $candidate)
              (helix-efficacy-not-run $trial)))
            ($result (development-helix-result $selection $generation $product $quarantine $trial $efficacy))
            ($saved (dh_save $root final $result))) $result)
     (let* (($result (development-helix-incomplete $selection $generation $product))
            ($saved (dh_save $root final $result))) $result)))
   (development-helix-held $selection $checkpoint))))
(= (DevelopmentHelixBoundary $root $id $locus $n)
 (if (and (== $locus ResumeAuthorizedGeneration) (== $n 1))
  (let* (($result (DHRun $root))
         ($remove (remove-atom &rna (ready $id DevelopmentHelixRNA $locus $n)))) $result)
  development-helix-lifecycle-fault))
(= (DHRestart $root)
 (let $restored (dh_restore $root)
  (if (PShape $restored durable-helix-development 2)
   (let* (($intent (index-atom $restored 1)) ($parent (index-atom $intent 2))
          ($candidate (index-atom $intent 3)) ($pins (index-atom $intent 4))
          ($active (add-atom &derived (active-voice-v2 $root $parent $candidate $pins)))
          ($invocations (DHInvocations $root $parent $candidate))
          ($load-parent (DHNLoad $root (index-atom $invocations 0)))
          ($load-candidate (DHNLoad $root (index-atom $invocations 1)))
          ($ranking (ERank $invocations))
          ($result (development-helix-rehydrated $restored $ranking no-generation-replay))
          ($saved (dh_save $root restart $result))) $result)
   (development-helix-recovery-incomplete $restored))))
(= (DHSeveredConsequence $root)
 (let* (($input (dh_input $root)) ($selection (DHSelectResource $input))
        ($product (dh_existing_candidate $root)))
  (if (and (PShape $selection resource-selected 5) (PShape $product model-candidate 4))
   (let* (($candidate (index-atom $product 1))
          ($quarantine (VQuarantine (index-atom (index-atom $input 1) 1) $candidate (index-atom $product 2)))
          ($material (dh_trial_material $root)) ($parent (index-atom $material 1))
          ($cases (index-atom $material 2)) ($pins (index-atom $material 3))
          ($pr (TVReport $cases $parent $pins)) ($cr (TVReport $cases $candidate $pins))
          ($decision (TVAdjudicate $cases $parent $candidate $pins $pr $cr))
          ($invocations (DHInvocations $root $parent $candidate))
          ($load-parent (DHNLoad $root (index-atom $invocations 0)))
          ($load-candidate (DHNLoad $root (index-atom $invocations 1)))
          ($ranking (ERank $invocations)))
    (consequence-severed-result $quarantine $decision $ranking no-consequence-consumer))
   (consequence-severed-incomplete $selection $product))))
