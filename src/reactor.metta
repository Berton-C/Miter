; Event-driven bounded RNA. No LLM is called by empty ready-set handling.
(= (ReactorEligible $root (event $id $kind $provenance $obligation $steps))
   (or (and (== $kind human) (== $provenance direct-contact))
       (and (or (== $kind due) (== $kind research)) (and (== $provenance witnessed-obligation)
          (== (miter_reactor_obligation $root $obligation) obligation-verified)))))
(= (ReactorIngestOne $root (event $id $kind $provenance $obligation $steps))
   (if (and (== $kind stop) (== $provenance direct-contact))
     (add-atom &rna (reactor-stop requested))
     (if (ReactorEligible $root (event $id $kind $provenance $obligation $steps))
       (let* (($species (if (== $kind human) ContactRNA (if (== $kind research) ResearchRNA ConsolidateRNA)))
              ($a (add-atom &rna (ready $id $species Transcribe $steps)))
              ($s (miter_reactor_checkpoint $root $id $species Transcribe $steps ready)))
         (miter_reactor_record $root RNA-created (rna-created $id $species $kind $obligation)))
       (miter_reactor_record $root unauthorized-event (unauthorized $id $kind $obligation)))))
(= (ReactorIngest $root $events $i)
   (if (< $i (size-atom $events))
     (let $r (ReactorIngestOne $root (index-atom $events $i))
       (ReactorIngest $root $events (+ $i 1))) ingested))
(= (ReactorReady) (collapse (match &rna (ready $id $sp $locus $n) (ready $id $sp $locus $n))))
(= (ReactorAdvance $root (ready $id $sp $locus $n))
   (let $removed (remove-atom &rna (ready $id $sp $locus $n))
     (if (== $locus Transcribe)
       (let* (($a (add-atom &rna (ready $id $sp Inquire $n)))
              ($s (miter_reactor_checkpoint $root $id $sp Inquire $n ready))) advanced)
       (if (== $locus Inquire)
         (let* (($w (miter_reactor_step $root $id))
                ($next (if (> $n 1) Inquire Witness))
                ($remaining (- $n 1))
                ($a (add-atom &rna (ready $id $sp $next $remaining)))
                ($s (miter_reactor_checkpoint $root $id $sp $next $remaining ready))) $w)
         (miter_reactor_checkpoint $root $id $sp Consolidate 0 completed)))))
(= (ReactorSuspendOne $root (ready $id $sp $locus $n))
   (if (!= $sp ContactRNA)
     (let* (($s (miter_reactor_checkpoint $root $id $sp $locus $n suspended))
            ($r (remove-atom &rna (ready $id $sp $locus $n)))
            ($a (add-atom &rna (suspended $id $sp $locus $n)))) suspended)
     human-ready))
(= (ReactorSuspend $root $items $i)
   (if (< $i (size-atom $items))
     (let $s (ReactorSuspendOne $root (index-atom $items $i))
       (ReactorSuspend $root $items (+ $i 1))) suspended))
(= (ReactorResumeOne $root (suspended $id $sp $locus $n))
   (let* (($s (miter_reactor_checkpoint $root $id $sp $locus $n resumed))
          ($r (remove-atom &rna (suspended $id $sp $locus $n)))
          ($a (add-atom &rna (ready $id $sp $locus $n)))) resumed))
(= (ReactorResume $root $items $i)
   (if (< $i (size-atom $items))
     (let $s (ReactorResumeOne $root (index-atom $items $i))
       (ReactorResume $root $items (+ $i 1))) resumed))
(= (ReactorSelect $root)
   (let $humans (collapse (match &rna (ready $id ContactRNA $locus $n)
                           (ready $id ContactRNA $locus $n)))
     (if (> (size-atom $humans) 0)
       (let $s (ReactorSuspend $root (ReactorReady) 0) (ReactorReady))
       (let* (($items (collapse (match &rna (suspended $id $sp $locus $n)
                                 (suspended $id $sp $locus $n))))
              ($r (ReactorResume $root $items 0))) (ReactorReady)))))
(= (ReactorReturnInterval $x) (+ $x 0))
(= (ReactorNextInterval $interval)
   (let* (($next (* $interval 2)) ($cap (miter_reactor_config idle_cap_seconds)))
     (if (> $next $cap) (ReactorReturnInterval $cap) (ReactorReturnInterval $next))))
(= (ReactorCycleWith $root $idle $interval $selector)
   (let* (($incoming (miter_reactor_input $root))
          ($ingested (ReactorIngest $root $incoming 0))
          ($stop (collapse (match &rna (reactor-stop requested) requested)))
          ($ready ($selector $root)))
     (if (> (size-atom $stop) 0)
       (miter_reactor_record $root reactor-stopped (explicit-stop))
       (if (> (size-atom $ready) 0)
         (let* (($base (miter_reactor_config idle_base_seconds))
                ($wake (if (== $idle true) (miter_reactor_record $root wake (contact-or-due-work)) already-awake))
                ($reset (if (== $idle true) (miter_reactor_record $root interval-reset (backoff $base contact-or-due-work)) already-reset))
                ($advance (ReactorAdvance $root (index-atom $ready 0))))
           (if (== $advance reactor-store-failed) reactor-failed
             (ReactorCycleWith $root false (miter_reactor_config idle_base_seconds) $selector)))
         (let* (($q (if (== $idle false) (miter_reactor_record $root quiescent-ready (empty-lawful-ready-set no-model-call)) already-quiescent))
                ($schedule (miter_reactor_record $root idle-wait (wait $interval no-progress-claim no-model-call)))
                ($wait (miter_reactor_wait $root $interval))
                ($next (if (== $wait input-ready) (miter_reactor_config idle_base_seconds)
                           (ReactorNextInterval $interval))))
           (ReactorCycleWith $root true $next $selector))))))
(= (ReactorCycle $root $idle)
   (ReactorCycleWith $root $idle (miter_reactor_config idle_base_seconds) ReactorSelect))
(= (ReactorStart $root $integrity-path)
   (if (== (SoulBoot $integrity-path) soul-ready)
     (ReactorCycle $root false) reactor-soul-blocked))
