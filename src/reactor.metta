; Event-driven bounded RNA. No LLM is called by empty ready-set handling.
(= (ReactorEligible $root (event $id $kind $provenance $obligation $steps))
   (or (and (== $kind human) (== $provenance direct-contact))
       (and (== $kind due) (and (== $provenance witnessed-obligation)
          (== (miter_reactor_obligation $root $obligation) obligation-verified)))))
(= (ReactorIngestOne $root (event $id $kind $provenance $obligation $steps))
   (if (and (== $kind stop) (== $provenance direct-contact))
     (add-atom &rna (reactor-stop requested))
     (if (ReactorEligible $root (event $id $kind $provenance $obligation $steps))
       (let* (($species (if (== $kind human) ContactRNA ConsolidateRNA))
              ($a (add-atom &rna (ready $id $species Transcribe $steps)))
              ($s (miter_reactor_checkpoint $root $id $species Transcribe $steps ready)))
         (miter_reactor_record $root RNA-created (rna-created $id $species $kind $obligation)))
       (miter_reactor_record $root unauthorized-event (unauthorized $id $kind $obligation)))))
(= (ReactorIngest $root $events $i)
   (if (< $i (size-atom $events))
     (let $r (ReactorIngestOne $root (index-atom $events $i))
       (ReactorIngest $root $events (+ $i 1))) ingested))
(= (ReactorReady) (collapse (match &rna (ready $id $sp $locus $n) (ready $id $sp $locus $n))))
(= (ReactorAdvance $root (ready $id $sp $locus $n))
   (let $removed (remove-atom &rna (ready $id $sp $locus $n))
     (if (== $locus Transcribe)
       (let* (($a (add-atom &rna (ready $id $sp Inquire $n)))
              ($s (miter_reactor_checkpoint $root $id $sp Inquire $n ready))) advanced)
       (if (== $locus Inquire)
         (let* (($w (miter_reactor_step $root $id))
                ($next (if (> $n 1) Inquire Witness))
                ($remaining (- $n 1))
                ($a (add-atom &rna (ready $id $sp $next $remaining)))
                ($s (miter_reactor_checkpoint $root $id $sp $next $remaining ready))) $w)
         (miter_reactor_checkpoint $root $id $sp Consolidate 0 completed)))))
(= (ReactorCycle $root $idle)
   (let* (($incoming (miter_reactor_input $root))
          ($ingested (ReactorIngest $root $incoming 0))
          ($stop (collapse (match &rna (reactor-stop requested) requested)))
          ($ready (ReactorReady)))
     (if (> (size-atom $stop) 0)
       (miter_reactor_record $root reactor-stopped (explicit-stop))
       (if (> (size-atom $ready) 0)
         (let* (($wake (if (== $idle true) (miter_reactor_record $root wake (contact-or-due-work)) already-awake))
                ($advance (ReactorAdvance $root (index-atom $ready 0))))
           (if (== $advance reactor-store-failed) reactor-failed (ReactorCycle $root false)))
         (let* (($q (if (== $idle false) (miter_reactor_record $root quiescent-ready (empty-lawful-ready-set no-model-call)) already-quiescent))
                ($wait (miter_reactor_wait $root (miter_reactor_config idle_base_seconds))))
           (ReactorCycle $root true))))))
(= (ReactorStart $root $integrity-path)
   (if (== (SoulBoot $integrity-path) soul-ready)
     (ReactorCycle $root false) reactor-soul-blocked))
