; G29 candidate construction. The LLM is an inert renderer: native comparison
; retains design authority and qualifies only complete, source-bound artifacts.
(= (SXPrompt)
 "Produce a compact, inert Mattermost bridge candidate in SWI-Prolog. Return only the required JSON. Implement the generic public predicates surface_ingest/5, surface_effect/5, surface_reconnect/2, and surface_panic/2. The bridge only transports and maps authenticated identity; it never reasons about values, Soul, memory, or Chroma. Authorization must precede event construction. Stable server/team/channel/user/post/root/timestamp/cursor identities must be preserved. State must support duplicate suppression, edits, monotone cursor/reconnect, outbound effect-id/idempotency suppression, typed send failures, and panic denial. Credentials may only arrive later through a bridge environment and must never be embedded, returned, logged, or placed in events. G29 has no network and no credentials. Keep code and plunit tests small and dependency-light. Use the supplied official Mattermost facts and native design. Do not alter the core or the acceptance contract.")
(= (SXReadyObservation $obs)
 (if (PShape $obs surface-model-observation 11)
  (and (== (index-atom $obs 2) eof)
   (and (== (index-atom $obs 3) 200)
    (and (== (index-atom $obs 5) true)
     (and (== (index-atom $obs 6) stop)
      (== (index-atom $obs 7) artifact-shaped))))) false))
(= (SXExpectedPaths)
 ("extension/mattermost_bridge.pl" "candidate_tests/mattermost_contract_tests.pl"))
(= (SXPaths $files)
 (collapse (let $f (superpose $files)
  (if (PShape $f surface-candidate-file 4) (index-atom $f 1) (empty)))))
(= (SXFilesValid $files)
 (let $paths (SXPaths $files)
  (and (== (size-atom $paths) 2)
   (and (== (size-atom (SUnion () $paths 0)) 2)
    (and (PHas "extension/mattermost_bridge.pl" $paths 0)
     (PHas "candidate_tests/mattermost_contract_tests.pl" $paths 0))))))
(= (SXManifestValid $manifest $selection)
 (let $modality (index-atom (index-atom $selection 1) 1)
  (== $manifest
   (mattermost-manifest miter-mattermost-extension-manifest-v1
    mattermost-surface-bridge $modality transport-and-identity-mapping-only
    mattermost-rest-v4-and-websocket surface-event-effect-v1
    (permissions none-in-g29 () human-gated-after-g30)
    (server_id team_id channel_id user_id post_id root_id event_timestamp cursor)
    stable-effect-id-and-idempotency-key
    durable-monotone-cursor-with-duplicate-suppression
    bridge-environment-only-never-returned
    core-derived-from-authenticated-surface-and-channel
    typed-surface-failure-event fixed-local-stop-denies-new-effects
    versioned-projection-preserves-history
    (authorized duplicate edited unauthorized send-failure reconnect cursor-resume panic)))))
(= (SXScanValid $scan)
 (if (PShape $scan surface-candidate-scan 5)
  (and (== (index-atom $scan 2) ()) (and (== (index-atom $scan 3) ()) (== (index-atom $scan 4) exact-files))) false))
(= (SXSyntaxValid $syntax)
 (if (PShape $syntax surface-candidate-syntax 4)
  (and (== (index-atom $syntax 1) 0)
   (and (== (index-atom $syntax 2) 0) (== (index-atom $syntax 3) false))) false))
(= (SXChecks $design $candidate $scan $syntax)
 (let* (($manifest (index-atom $candidate 5)) ($files (index-atom $candidate 6))
        ($selection (index-atom $design 8)))
  ((obligation design-lineage (if (== (index-atom $candidate 1) (index-atom $design 1)) satisfied unresolved))
   (obligation rationale-and-plan (if (sd_nonempty (index-atom $candidate 3) (index-atom $candidate 4)) satisfied unresolved))
   (obligation manifest (if (SXManifestValid $manifest $selection) satisfied unresolved))
   (obligation exact-files (if (SXFilesValid $files) satisfied unresolved))
   (obligation boundary-isolation (if (SXScanValid $scan) satisfied unresolved))
   (obligation syntax (if (SXSyntaxValid $syntax) satisfied unresolved)))))
(= (SXChecksReady $checks)
 (not (PHas unresolved (collapse (let $c (superpose $checks) (index-atom $c 2))) 0)))
(= (SXAssess $design $candidate $scan $syntax)
 (let $checks (SXChecks $design $candidate $scan $syntax)
  (if (SXChecksReady $checks)
   (surface-candidate-qualified $candidate $checks $scan $syntax)
   (surface-candidate-unqualified $candidate $checks $scan $syntax))))
(= (SXAttempt $root $design $attempt $feedback)
 (let* (($id (sx_name mattermost $attempt))
        ($q (surface-generation $id (index-atom $design 1) $design $attempt qwen-local (SXPrompt) $feedback))
        ($stage (add-atom &derived (surface-generation-pending $root $q)))
        ($obs (sx_model $root $q))
        ($clear (remove-atom &derived (surface-generation-pending $root $q)))
        ($saved (sx_save $root (sx_name model $attempt) $obs)))
  (if (SXReadyObservation $obs)
   (let* (($candidate (index-atom $obs 10))
          ($material (sx_materialize $root $candidate))
          ($scan (sx_scan $root $candidate))
          ($syntax (sx_syntax $root $candidate))
          ($assessment (SXAssess $design $candidate $scan $syntax))
          ($record (sx_save $root (sx_name assessment $attempt) $assessment)))
    (if (PShape $assessment surface-candidate-qualified 5)
     (surface-extension-proposal $design $assessment awaiting-G30-independent-trial)
     (if (< $attempt 4) (SXAttempt $root $design (+ $attempt 1) $assessment)
      (surface-extension-incomplete $assessment))))
   (if (< $attempt 4) (SXAttempt $root $design (+ $attempt 1) $obs)
    (surface-extension-incomplete $obs)))))
(= (SXRun $root)
 (let $design (SDRun $root)
  (if (PShape $design surface-design 11)
   (let* (($result (SXAttempt $root $design 1 no-prior-candidate))
          ($saved (sx_save $root final $result))) $result)
   (surface-extension-held $design))))

; R1 decomposes rendering after the retained monolithic timeout. The compact
; context is a native projection of the source-bound design, not a model vote.
(= (SXDesignContext $design)
 (surface-render-context (index-atom $design 1)
  (index-atom (index-atom (index-atom $design 8) 1) 1)
  (index-atom $design 4) (index-atom $design 5) (index-atom $design 9)
  (index-atom $design 7)))
(= (SXPartPrompt design)
 "Return only the required compact design JSON. Explain why a SWI-Prolog bridge is a non-cognitive transport/identity membrane, how authorization precedes cognition, how stable identities, duplicate/effect idempotency, edits, cursor/reconnect, typed failure, panic, credential isolation, core-derived memory scope, rollback, and G30 tests fit together. Do not write code and do not claim live authority.")
(= (SXPartPrompt bridge)
 "Return JSON containing only compact SWI-Prolog bridge source in content. Define module miter_mattermost_bridge exporting surface_ingest/5, surface_effect/5, surface_reconnect/4, surface_panic/2. Use explicit Config and immutable State dicts; no dynamic database. surface_ingest(Config,State0,Frame,State,Outcome) must authorize stable server/team/channel/user IDs before parsing payload; support posted and post_edited frames, duplicate suppression by post ID plus update timestamp, monotone integer cursor, and emit a miter-surface-event-v1 dict with all required IDs and authorization_ref. surface_effect(Config,State0,Effect,State,Outcome) must validate a miter-surface-effect-v1 dict, deny panic, preserve a stable idempotency key, suppress duplicate effects, and return an inert POST /api/v4/posts request descriptor or typed rejection; never send it. surface_reconnect/4 rejects stale cursors. surface_panic/2 sets panic true. Credentials, host URLs, global state, model calls, core reasoning and private-memory access are forbidden. Keep under 180 lines.")
(= (SXPartPrompt tests)
 "Return JSON containing only compact SWI-Prolog plunit source in content. Import ../extension/mattermost_bridge.pl and test the declared public predicates without network or credentials. Include authorized stable event mapping, duplicate suppression, edited post distinction, unauthorized channel/user before payload construction, idempotent outbound request, malformed/send-failure-shaped effect rejection, reconnect and cursor resume, and panic denial. Tests must be deterministic and under 180 lines; do not redefine the bridge.")
(= (SXPartReady $obs $part)
 (if (PShape $obs surface-part-observation 12)
  (and (== (index-atom $obs 2) $part)
   (and (== (index-atom $obs 3) eof)
    (and (== (index-atom $obs 4) 200)
     (and (== (index-atom $obs 6) true)
      (and (== (index-atom $obs 7) stop)
       (== (index-atom $obs 8) artifact-shaped)))))) false))
(= (SXPart $root $design $slot $part $feedback)
 (let* (($id (sx_part_name $part $slot))
        ($context (SXDesignContext $design))
        ($q (surface-part-generation $id (index-atom $design 1) $context $slot $part qwen-local (SXPartPrompt $part) $feedback))
        ($stage (add-atom &derived (surface-part-generation-pending $root $q)))
        ($obs (sx_part_model $root $q))
        ($clear (remove-atom &derived (surface-part-generation-pending $root $q)))
        ($saved (sx_save $root (sx_name part $slot) $obs)))
  $obs))
(= (SXAssemble $design $designPart $bridgePart $testsPart)
 (if (and (SXPartReady $designPart design)
      (and (SXPartReady $bridgePart bridge) (SXPartReady $testsPart tests)))
  (let* (($d (index-atom $designPart 11)) ($b (index-atom $bridgePart 11)) ($t (index-atom $testsPart 11)))
   (surface-extension-candidate (index-atom $design 1) mattermost-r1
    (index-atom $d 3) (index-atom $d 4) (index-atom $d 5)
    ((index-atom $b 3) (index-atom $t 3))
    (model-products (index-atom $d 2) (index-atom $b 2) (index-atom $t 2))))
  (surface-candidate-incomplete $designPart $bridgePart $testsPart)))
(= (SXR1Run $root)
 (let $design (SDRun $root)
  (if (PShape $design surface-design 11)
   (let* (($designPart (SXPart $root $design 1 design no-prior-part))
          ($bridgePart (SXPart $root $design 2 bridge $designPart))
          ($testsPart (SXPart $root $design 3 tests (parts $designPart $bridgePart)))
          ($candidate (SXAssemble $design $designPart $bridgePart $testsPart)))
    (if (PShape $candidate surface-extension-candidate 8)
     (let* (($material (sx_materialize $root $candidate))
            ($scan (sx_scan $root $candidate))
            ($syntax (sx_syntax $root $candidate))
            ($assessment (SXAssess $design $candidate $scan $syntax))
            ($record (sx_save $root assessment-r1 $assessment))
            ($result (if (PShape $assessment surface-candidate-qualified 5)
              (surface-extension-proposal $design $assessment awaiting-G30-independent-trial)
              (surface-extension-incomplete $assessment)))
            ($saved (sx_save $root final-r1 $result))) $result)
     (surface-extension-incomplete $candidate)))
   (surface-extension-held $design))))

; R2 turns retained execution consequences into repair scope through explicit
; artifact-obligation relations. Error labels do not directly choose behavior.
(= (SXRepairTargets $dependencies $observations)
 (SUnion () (collapse
  (let $observation (superpose $observations)
   (if (and (PShape $observation obligation-observation 5)
        (== (index-atom $observation 3) violated))
    (let $dependency (superpose $dependencies)
     (if (and (PShape $dependency artifact-obligation 3)
          (== (index-atom $dependency 2) (index-atom $observation 2)))
      (index-atom $dependency 1) (empty)))
    (empty)))) 0))
(= (SXRepairReady $targets)
 (and (== (size-atom $targets) 2)
  (and (PHas bridge $targets 0) (PHas tests $targets 0))))
(= (SXTargetPath bridge) extension/mattermost_bridge.pl)
(= (SXTargetPath tests) candidate_tests/mattermost_contract_tests.pl)
(= (SXTargetFile $candidate $target) (sx_old_file $candidate $target))
(= (SXRepairPrompt bridge)
 "Return JSON with only corrected SWI-Prolog source in content. Preserve module miter_mattermost_bridge and public predicates surface_ingest/5, surface_effect/5, surface_reconnect/4, surface_panic/2. Use valid SWI anonymous dict syntax _{key:value}, get_dict/3 or dict access, quoted atom '/api/v4/posts', immutable explicit state, and lists or assoc-like terms for seen events/effects. Authorization of server/team/channel/user must occur before payload parsing. Support posted/post_edited, stable IDs, update-aware duplicate suppression, monotone cursor, inert idempotent effect descriptors, typed rejection, reconnect and panic. Never use dynamic state, network, credentials, Soul, Chroma, model calls, or private memory. Correct every supplied diagnostic and keep under 180 lines.")
(= (SXRepairPrompt tests)
 "Return JSON with only corrected deterministic SWI-Prolog PLUnit source in content. Import ../extension/mattermost_bridge.pl. Inside begin_tests/end_tests define every case as test(name) :- Goal. using valid _{key:value} dicts. Exercise the declared public predicates without network or credentials: authorized stable mapping, duplicate delivery, edited post update, unauthorized channel/user rejected even with malformed payload, outbound idempotency, malformed/unauthorized effect rejection, reconnect/cursor resume, and panic denial. Do not redefine the bridge, weaken expectations, or use directive-only test declarations. Correct every supplied diagnostic and keep under 180 lines.")
(= (SXRepairPart $root $design $candidate $target $slot $observations)
 (let* (($id (sx_repair_name $target $slot))
        ($old (SXTargetFile $candidate $target))
        ($q (surface-repair-generation $id (index-atom $design 1) (index-atom $candidate 2)
             $target qwen-local (SXRepairPrompt $target) $old $observations))
        ($stage (add-atom &derived (surface-repair-generation-pending $root $q)))
        ($result (sx_repair_model $root $q))
        ($clear (remove-atom &derived (surface-repair-generation-pending $root $q)))
        ($saved (sx_save $root (sx_name repair $slot) $result)))
  $result))
(= (SXAssembleR2 $design $designPart $bridgePart $testsPart)
 (if (and (SXPartReady $bridgePart bridge) (SXPartReady $testsPart tests))
  (let* (($d (index-atom $designPart 11)) ($b (index-atom $bridgePart 11)) ($t (index-atom $testsPart 11)))
   (surface-extension-candidate (index-atom $design 1) mattermost-r2
    (index-atom $d 3) (index-atom $d 4) (index-atom $d 5)
    ((index-atom $b 3) (index-atom $t 3))
    (model-products (index-atom $d 2) (index-atom $b 2) (index-atom $t 2))))
  (surface-candidate-incomplete $bridgePart $testsPart)))
(= (SXTrialValid $trial)
 (if (PShape $trial surface-candidate-trial 8)
  (and (== (index-atom $trial 1) 0)
   (and (== (index-atom $trial 2) 0)
    (and (== (index-atom $trial 3) 0) (== (index-atom $trial 4) false)))) false))
(= (SXAssessR2 $design $candidate $scan $syntax $trial $targets)
 (let $base (SXAssess $design $candidate $scan $syntax)
  (if (and (PShape $base surface-candidate-qualified 5) (SXTrialValid $trial))
   (surface-candidate-qualified-r2 $candidate (index-atom $base 2) $scan $syntax $trial $targets)
   (surface-candidate-unqualified-r2 $candidate $base $trial $targets))))
(= (SXR2Run $root)
 (let $input (sd_input $root)
  (if (PShape $input surface-repair-input 8)
   (let* (($design (index-atom $input 1)) ($designPart (index-atom $input 2))
          ($prior (index-atom $input 3)) ($dependencies (index-atom $input 4))
          ($observations (index-atom $input 5))
          ($targets (SXRepairTargets $dependencies $observations))
          ($targetRecord (sx_save $root repair-targets $targets)))
    (if (SXRepairReady $targets)
     (let* (($bridge (SXRepairPart $root $design $prior bridge 1 $observations))
            ($tests (SXRepairPart $root $design $prior tests 2 $observations))
            ($candidate (SXAssembleR2 $design $designPart $bridge $tests)))
      (if (PShape $candidate surface-extension-candidate 8)
       (let* (($material (sx_materialize $root $candidate))
              ($scan (sx_scan $root $candidate)) ($syntax (sx_syntax $root $candidate))
              ($trial (sx_trial $root $candidate))
              ($assessment (SXAssessR2 $design $candidate $scan $syntax $trial $targets))
              ($assessmentRecord (sx_save $root assessment-r2 $assessment))
              ($trialRecord (sx_save $root trial-r2 $trial))
              ($result (if (PShape $assessment surface-candidate-qualified-r2 7)
                       (surface-extension-proposal-r2 $design $assessment awaiting-G30-independent-trial)
                       (surface-extension-incomplete-r2 $assessment)))
              ($saved (sx_save $root final-r2 $result))) $result)
       (surface-extension-incomplete-r2 $candidate)))
     (surface-extension-held-r2 $targets)))
   (surface-extension-held-r2 $input))))

; R3 compares resource relations as a set. A unique supported resource may be
; used; zero or multiple candidates remain unresolved rather than first-match.
(= (SXEligibleResources $resources)
 (SUnion () (collapse
  (let $resource (superpose $resources)
   (if (and (PShape $resource model-resource 8)
        (and (== (index-atom $resource 2) local)
         (and (== (index-atom $resource 3) configured)
          (and (== (index-atom $resource 4) schema-compatible)
           (and (or (== (index-atom $resource 5) untried)
                    (== (index-atom $resource 5) supported))
                (== (index-atom $resource 6) available))))))
    (index-atom $resource 1) (empty)))) 0))
(= (SXSelectResource $resources)
 (let $eligible (SXEligibleResources $resources)
  (if (== (size-atom $eligible) 1)
   (model-resource-selected (index-atom $eligible 0) $eligible)
   (model-resource-unresolved $eligible))))
(= (SXRepairPromptR3 bridge)
 "Return JSON with only corrected SWI-Prolog source in content. Use module miter_mattermost_bridge with surface_ingest/5, surface_effect/5, surface_reconnect/4, surface_panic/2. Every dict must use underscore-prefixed SWI syntax, for example Config = _{server_id:s1} and Outcome = _{status:accepted}; never use bare {key:value}. Use get_dict/3 for required fields and quoted atom '/api/v4/posts'. Keep immutable state with seen event-version pairs and effect-id/idempotency pairs. Authorize server/team/channel/user before reading event data. Support posted and post_edited, stable IDs, update-aware dedupe, monotone cursor, inert effect descriptor, typed rejection, reconnect and panic. No dynamic state, network, credentials, Soul, Chroma, models, or private memory. Correct the supplied runtime consequences; under 180 lines.")
(= (SXRepairPromptR3 tests)
 "Return JSON with only deterministic SWI-Prolog PLUnit source in content. Import ../extension/mattermost_bridge.pl. Every dict must use underscore-prefixed syntax such as _{status:accepted}; never use bare {key:value}. Quote '/api/v4/posts'. Inside begin_tests/end_tests write test(name) :- Goal. Exercise the exact supplied bridge without network: authorized stable event, duplicate version, edited version, unauthorized channel/user with malformed data proving authorization-first, outbound idempotency, malformed/unauthorized effect, reconnect/cursor resume, and panic. Do not redefine the bridge or weaken expected outcomes. Correct all supplied syntax/runtime consequences; under 180 lines.")
(= (SXRepairPartR3 $root $design $candidate $target $slot $model $observations)
 (let* (($id (sx_repair_name $target $slot))
        ($old (SXTargetFile $candidate $target))
        ($q (surface-repair-generation $id (index-atom $design 1) (index-atom $candidate 2)
             $target $model (SXRepairPromptR3 $target) $old $observations))
        ($stage (add-atom &derived (surface-repair-generation-pending $root $q)))
        ($result (sx_repair_model $root $q))
        ($clear (remove-atom &derived (surface-repair-generation-pending $root $q)))
        ($saved (sx_save $root (sx_name repair $slot) $result)))
  $result))
(= (SXAssembleR3 $design $designPart $bridgePart $testsPart)
 (if (and (SXPartReady $bridgePart bridge) (SXPartReady $testsPart tests))
  (let* (($d (index-atom $designPart 11)) ($b (index-atom $bridgePart 11)) ($t (index-atom $testsPart 11)))
   (surface-extension-candidate (index-atom $design 1) mattermost-r3
    (index-atom $d 3) (index-atom $d 4) (index-atom $d 5)
    ((index-atom $b 3) (index-atom $t 3))
    (model-products (index-atom $d 2) (index-atom $b 2) (index-atom $t 2))))
  (surface-candidate-incomplete $bridgePart $testsPart)))
(= (SXR3Run $root)
 (let $input (sd_input $root)
  (if (PShape $input surface-resource-repair-input 9)
   (let* (($design (index-atom $input 1)) ($designPart (index-atom $input 2))
          ($prior (index-atom $input 3)) ($dependencies (index-atom $input 4))
          ($observations (index-atom $input 5)) ($resources (index-atom $input 6))
          ($targets (SXRepairTargets $dependencies $observations))
          ($selection (SXSelectResource $resources))
          ($targetRecord (sx_save $root repair-targets $targets))
          ($resourceRecord (sx_save $root resource-selection $selection)))
    (if (and (SXRepairReady $targets) (PShape $selection model-resource-selected 3))
     (let* (($model (index-atom $selection 1))
            ($bridge (SXRepairPartR3 $root $design $prior bridge 1 $model $observations))
            ($bridgeContext (SUnion $observations ((candidate-bridge-product (index-atom $bridge 11))) 0))
            ($tests (SXRepairPartR3 $root $design $prior tests 2 $model $bridgeContext))
            ($candidate (SXAssembleR3 $design $designPart $bridge $tests)))
      (if (PShape $candidate surface-extension-candidate 8)
       (let* (($material (sx_materialize $root $candidate))
              ($scan (sx_scan $root $candidate)) ($syntax (sx_syntax $root $candidate))
              ($trial (sx_trial $root $candidate))
              ($assessment (SXAssessR2 $design $candidate $scan $syntax $trial $targets))
              ($assessmentRecord (sx_save $root assessment-r3 $assessment))
              ($trialRecord (sx_save $root trial-r3 $trial))
              ($result (if (PShape $assessment surface-candidate-qualified-r2 7)
                       (surface-extension-proposal-r3 $design $selection $assessment awaiting-G30-independent-trial)
                       (surface-extension-incomplete-r3 $selection $assessment)))
              ($saved (sx_save $root final-r3 $result))) $result)
       (surface-extension-incomplete-r3 $selection $candidate)))
     (surface-extension-held-r3 $selection $targets)))
   (surface-extension-held-r3 $input))))

; R4 selects a changed, reversible runtime operation as a set comparison.
(= (SXEligibleRecoveries $operations)
 (SUnion () (collapse
  (let $operation (superpose $operations)
   (if (and (PShape $operation runtime-recovery-operation 8)
        (and (== (index-atom $operation 4) reversible)
         (and (== (index-atom $operation 5) supported)
          (and (== (index-atom $operation 6) available)
               (== (index-atom $operation 7) bounded)))))
    (index-atom $operation 1) (empty)))) 0))
(= (SXSelectRecovery $operations)
 (let $eligible (SXEligibleRecoveries $operations)
  (if (== (size-atom $eligible) 1)
   (let $id (index-atom $eligible 0)
    (let $resource (index-atom (collapse
     (let $operation (superpose $operations)
      (if (== (index-atom $operation 1) $id) (index-atom $operation 2) (empty)))) 0)
     (runtime-recovery-selected $id $resource $eligible)))
   (runtime-recovery-unresolved $eligible))))
(= (SXLoadValid $observation)
 (if (PShape $observation model-load-observation 8)
  (and (== (index-atom $observation 2) 0)
   (and (== (index-atom $observation 3) true) (== (index-atom $observation 4) false))) false))
(= (SXUnloadValid $observation)
 (if (PShape $observation model-unload-observation 8)
  (and (== (index-atom $observation 2) 0)
   (and (== (index-atom $observation 3) true) (== (index-atom $observation 4) false))) false))
(= (SXRepairPartR4 $root $design $candidate $target $slot $model $observations)
 (let* (($id (sx_repair_name $target $slot))
        ($old (SXTargetFile $candidate $target))
        ($q (surface-r4-generation $id (index-atom $design 1) (index-atom $candidate 2)
             $target $model (SXRepairPromptR3 $target) $old $observations))
        ($stage (add-atom &derived (surface-r4-generation-pending $root $q)))
        ($result (sx_repair_model_r4 $root $q))
        ($clear (remove-atom &derived (surface-r4-generation-pending $root $q)))
        ($saved (sx_save $root (sx_name repair $slot) $result)))
  $result))
(= (SXAssembleR4 $design $designPart $bridgePart $testsPart)
 (if (and (SXPartReady $bridgePart bridge) (SXPartReady $testsPart tests))
  (let* (($d (index-atom $designPart 11)) ($b (index-atom $bridgePart 11)) ($t (index-atom $testsPart 11)))
   (surface-extension-candidate (index-atom $design 1) mattermost-r4
    (index-atom $d 3) (index-atom $d 4) (index-atom $d 5)
    ((index-atom $b 3) (index-atom $t 3))
    (model-products (index-atom $d 2) (index-atom $b 2) (index-atom $t 2))))
  (surface-candidate-incomplete $bridgePart $testsPart)))
(= (SXR4Generate $root $design $designPart $prior $targets $model $observations)
 (let* (($bridge (SXRepairPartR4 $root $design $prior bridge 1 $model $observations))
        ($bridgeContext (SUnion $observations ((candidate-bridge-product (index-atom $bridge 11))) 0))
        ($tests (SXRepairPartR4 $root $design $prior tests 2 $model $bridgeContext))
        ($candidate (SXAssembleR4 $design $designPart $bridge $tests)))
  (if (PShape $candidate surface-extension-candidate 8)
   (let* (($material (sx_materialize $root $candidate))
          ($scan (sx_scan $root $candidate)) ($syntax (sx_syntax $root $candidate))
          ($trial (sx_trial $root $candidate))
          ($assessment (SXAssessR2 $design $candidate $scan $syntax $trial $targets))
          ($assessmentRecord (sx_save $root assessment-r4 $assessment))
          ($trialRecord (sx_save $root trial-r4 $trial)))
    (if (PShape $assessment surface-candidate-qualified-r2 7)
     (surface-extension-qualified-r4 $assessment)
     (surface-extension-incomplete-r4 $assessment)))
   (surface-extension-incomplete-r4 $candidate))))
(= (SXR4Run $root)
 (let $input (sd_input $root)
  (if (PShape $input surface-runtime-repair-input 9)
   (let* (($design (index-atom $input 1)) ($designPart (index-atom $input 2))
          ($prior (index-atom $input 3)) ($dependencies (index-atom $input 4))
          ($observations (index-atom $input 5)) ($operations (index-atom $input 6))
          ($targets (SXRepairTargets $dependencies $observations))
          ($selection (SXSelectRecovery $operations))
          ($targetRecord (sx_save $root repair-targets $targets))
          ($recoveryRecord (sx_save $root recovery-selection $selection)))
    (if (and (SXRepairReady $targets) (PShape $selection runtime-recovery-selected 4))
     (let* (($load (sx_preload $root $selection)) ($loadRecord (sx_save $root load-observation $load))
            ($generated (if (SXLoadValid $load)
             (SXR4Generate $root $design $designPart $prior $targets (index-atom $selection 2) $observations)
             (surface-extension-held-r4 $load)))
            ($unload (sx_unload $root $selection)) ($unloadRecord (sx_save $root unload-observation $unload))
            ($result (if (and (PShape $generated surface-extension-qualified-r4 2) (SXUnloadValid $unload))
             (surface-extension-proposal-r4 $design $selection (index-atom $generated 1) $load $unload awaiting-G30-independent-trial)
             (surface-extension-incomplete-r4 $selection $generated $load $unload)))
            ($saved (sx_save $root final-r4 $result))) $result)
     (let* (($result (surface-extension-held-r4 $selection $targets))
            ($saved (sx_save $root final-r4 $result))) $result)))
   (surface-extension-held-r4 $input))))

; R5 compares request-shape experiments as relations. It first asks a tiny,
; causal discriminator; source rendering remains unreachable unless the exact
; diagnostic sentinel is observed.
(= (SXEligibleExperiments $experiments)
 (SUnion () (collapse
  (let $experiment (superpose $experiments)
   (if (and (PShape $experiment request-shape-experiment 9)
        (and (== (index-atom $experiment 3) no-schema)
         (and (== (index-atom $experiment 5) discriminates-schema-vs-general)
          (and (== (index-atom $experiment 6) reversible)
           (and (== (index-atom $experiment 7) supported)
                (== (index-atom $experiment 8) available))))))
    (index-atom $experiment 1) (empty)))) 0))
(= (SXSelectExperiment $experiments)
 (let $eligible (SXEligibleExperiments $experiments)
  (if (== (size-atom $eligible) 1)
   (let $id (index-atom $eligible 0)
    (let $model (index-atom (collapse
     (let $experiment (superpose $experiments)
      (if (== (index-atom $experiment 1) $id) (index-atom $experiment 2) (empty)))) 0)
     (request-shape-selected $id $model $eligible)))
   (request-shape-unresolved $eligible))))
(= (SXDiagnosticValid $observation)
 (if (PShape $observation surface-diagnostic-observation 11)
  (and (== (index-atom $observation 2) eof)
   (and (== (index-atom $observation 3) 200)
    (and (== (index-atom $observation 5) true)
     (and (== (index-atom $observation 7) sentinel-exact)
          (== (index-atom $observation 10) true))))) false))
(= (SXR5PartReady $observation $part)
 (if (PShape $observation surface-r5-part-observation 12)
  (and (== (index-atom $observation 2) $part)
   (and (== (index-atom $observation 3) eof)
    (and (== (index-atom $observation 4) 200)
     (and (== (index-atom $observation 6) true)
      (and (== (index-atom $observation 8) source-envelope-exact)
           (PShape (index-atom $observation 11) surface-code-part 5)))))) false))
(= (SXDiagnosticR5 $root)
 (let* (($q (surface-r5-diagnostic inference-probe-1 nemotron-local "MITER_NEMOTRON_READY"))
        ($stage (add-atom &derived (surface-r5-diagnostic-pending $root $q)))
        ($result (sx_r5_diagnostic $root $q))
        ($clear (remove-atom &derived (surface-r5-diagnostic-pending $root $q)))
        ($saved (sx_save $root diagnostic-1 $result))) $result))
(= (SXRepairPromptR5 bridge)
 "Return exactly BEGIN_SOURCE on its own line, then only corrected SWI-Prolog source, then END_SOURCE on its own line. No code fences or other text. Use module miter_mattermost_bridge with surface_ingest/5, surface_effect/5, surface_reconnect/4, surface_panic/2. Every dict must use underscore-prefixed SWI syntax, for example Config = _{server_id:s1}; never use bare {key:value}. Use get_dict/3 and quoted atom '/api/v4/posts'. Keep immutable state with seen event-version pairs and effect-id/idempotency pairs. Authorize server/team/channel/user before reading event data. Support posted and post_edited, stable IDs, update-aware dedupe, monotone cursor, inert effect descriptor, typed rejection, reconnect and panic. No dynamic state, network, credentials, Soul, Chroma, models, or private memory. Correct the supplied runtime consequences; under 180 lines.")
(= (SXRepairPromptR5 tests)
 "Return exactly BEGIN_SOURCE on its own line, then only deterministic SWI-Prolog PLUnit source, then END_SOURCE on its own line. No code fences or other text. Import ../extension/mattermost_bridge.pl. Every dict must use underscore-prefixed syntax such as _{status:accepted}; never use bare {key:value}. Quote '/api/v4/posts'. Inside begin_tests/end_tests write test(name) :- Goal. Exercise the exact supplied bridge without network: authorized stable event, duplicate version, edited version, unauthorized channel/user with malformed data proving authorization-first, outbound idempotency, malformed/unauthorized effect, reconnect/cursor resume, and panic. Do not redefine the bridge or weaken expected outcomes. Correct all supplied syntax/runtime consequences; under 180 lines.")
(= (SXRepairPartR5 $root $design $candidate $target $slot $observations)
 (let* (($id (if (== $target bridge) sentinel-bridge-2 sentinel-tests-3))
        ($old (SXTargetFile $candidate $target))
        ($q (surface-r5-generation $id (index-atom $design 1) (index-atom $candidate 2)
             $target nemotron-local (SXRepairPromptR5 $target) $old $observations))
        ($stage (add-atom &derived (surface-r5-generation-pending $root $q)))
        ($result (sx_r5_model $root $q))
        ($clear (remove-atom &derived (surface-r5-generation-pending $root $q)))
        ($saved (sx_save $root (sx_name sentinel $slot) $result))) $result))
(= (SXAssembleR5 $design $designPart $bridgePart $testsPart)
 (if (and (SXR5PartReady $bridgePart bridge) (SXR5PartReady $testsPart tests))
  (let* (($d (index-atom $designPart 11)) ($b (index-atom $bridgePart 11)) ($t (index-atom $testsPart 11)))
   (surface-extension-candidate (index-atom $design 1) mattermost-r5
    (index-atom $d 3) (index-atom $d 4) (index-atom $d 5)
    ((index-atom $b 3) (index-atom $t 3))
    (model-products (index-atom $d 2) (index-atom $b 2) (index-atom $t 2))))
  (surface-candidate-incomplete $bridgePart $testsPart)))
(= (SXR5Generate $root $design $designPart $prior $targets $observations)
 (let* (($bridge (SXRepairPartR5 $root $design $prior bridge 2 $observations))
        ($bridgeContext (SUnion $observations ((candidate-bridge-product (index-atom $bridge 11))) 0))
        ($tests (SXRepairPartR5 $root $design $prior tests 3 $bridgeContext))
        ($candidate (SXAssembleR5 $design $designPart $bridge $tests)))
  (if (PShape $candidate surface-extension-candidate 8)
   (let* (($material (sx_materialize $root $candidate))
          ($scan (sx_scan $root $candidate)) ($syntax (sx_syntax $root $candidate))
          ($trial (sx_trial $root $candidate))
          ($assessment (SXAssessR2 $design $candidate $scan $syntax $trial $targets))
          ($assessmentRecord (sx_save $root assessment-r5 $assessment))
          ($trialRecord (sx_save $root trial-r5 $trial)))
    (if (PShape $assessment surface-candidate-qualified-r2 7)
     (surface-extension-qualified-r5 $assessment)
     (surface-extension-incomplete-r5 $assessment)))
   (surface-extension-incomplete-r5 $candidate))))
(= (SXR5Run $root)
 (let $input (sd_input $root)
  (if (PShape $input surface-request-shape-repair-input 9)
   (let* (($design (index-atom $input 1)) ($designPart (index-atom $input 2))
          ($prior (index-atom $input 3)) ($dependencies (index-atom $input 4))
          ($observations (index-atom $input 5)) ($experiments (index-atom $input 6))
          ($targets (SXRepairTargets $dependencies $observations))
          ($selection (SXSelectExperiment $experiments))
          ($targetRecord (sx_save $root repair-targets $targets))
          ($selectionRecord (sx_save $root request-shape-selection $selection)))
    (if (and (SXRepairReady $targets) (PShape $selection request-shape-selected 4))
     (let* (($load (sx_preload_r5 $root $selection)) ($loadRecord (sx_save $root load-observation $load))
            ($diagnostic (if (SXLoadValid $load) (SXDiagnosticR5 $root) (surface-diagnostic-held $load)))
            ($generated (if (SXDiagnosticValid $diagnostic)
             (SXR5Generate $root $design $designPart $prior $targets $observations)
             (surface-extension-held-r5 $diagnostic)))
            ($unload (sx_unload_r5 $root $selection)) ($unloadRecord (sx_save $root unload-observation $unload))
            ($result (if (and (PShape $generated surface-extension-qualified-r5 2) (SXUnloadValid $unload))
             (surface-extension-proposal-r5 $design $selection (index-atom $generated 1) $diagnostic $load $unload awaiting-G30-independent-trial)
             (surface-extension-incomplete-r5 $selection $diagnostic $generated $load $unload)))
            ($saved (sx_save $root final-r5 $result))) $result)
     (let* (($result (surface-extension-held-r5 $selection $targets)) ($saved (sx_save $root final-r5 $result))) $result)))
   (surface-extension-held-r5 $input))))

; R6 reuses the still-unanswered native experiment after the membrane has
; mechanically serialized both request shapes under fresh claim identities.
(= (SXDiagnosticR6 $root)
 (let* (($q (surface-r5-diagnostic inference-probe-r6-1 nemotron-local "MITER_NEMOTRON_READY"))
        ($stage (add-atom &derived (surface-r6-diagnostic-pending $root $q)))
        ($result (sx_r5_diagnostic $root $q))
        ($clear (remove-atom &derived (surface-r6-diagnostic-pending $root $q)))
        ($saved (sx_save $root diagnostic-r6-1 $result))) $result))
(= (SXRepairPartR6 $root $design $candidate $target $slot $observations)
 (let* (($id (if (== $target bridge) sentinel-r6-bridge-2 sentinel-r6-tests-3))
        ($old (SXTargetFile $candidate $target))
        ($q (surface-r5-generation $id (index-atom $design 1) (index-atom $candidate 2)
             $target nemotron-local (SXRepairPromptR5 $target) $old $observations))
        ($stage (add-atom &derived (surface-r6-generation-pending $root $q)))
        ($result (sx_r5_model $root $q))
        ($clear (remove-atom &derived (surface-r6-generation-pending $root $q)))
        ($saved (sx_save $root (sx_name sentinel-r6 $slot) $result))) $result))
(= (SXAssembleR6 $design $designPart $bridgePart $testsPart)
 (if (and (SXR5PartReady $bridgePart bridge) (SXR5PartReady $testsPart tests))
  (let* (($d (index-atom $designPart 11)) ($b (index-atom $bridgePart 11)) ($t (index-atom $testsPart 11)))
   (surface-extension-candidate (index-atom $design 1) mattermost-r6
    (index-atom $d 3) (index-atom $d 4) (index-atom $d 5)
    ((index-atom $b 3) (index-atom $t 3))
    (model-products (index-atom $d 2) (index-atom $b 2) (index-atom $t 2))))
  (surface-candidate-incomplete $bridgePart $testsPart)))
(= (SXR6Generate $root $design $designPart $prior $targets $observations)
 (let* (($bridge (SXRepairPartR6 $root $design $prior bridge 2 $observations))
        ($bridgeContext (SUnion $observations ((candidate-bridge-product (index-atom $bridge 11))) 0))
        ($tests (SXRepairPartR6 $root $design $prior tests 3 $bridgeContext))
        ($candidate (SXAssembleR6 $design $designPart $bridge $tests)))
  (if (PShape $candidate surface-extension-candidate 8)
   (let* (($material (sx_materialize $root $candidate)) ($scan (sx_scan $root $candidate))
          ($syntax (sx_syntax $root $candidate)) ($trial (sx_trial $root $candidate))
          ($assessment (SXAssessR2 $design $candidate $scan $syntax $trial $targets))
          ($assessmentRecord (sx_save $root assessment-r6 $assessment)) ($trialRecord (sx_save $root trial-r6 $trial)))
    (if (PShape $assessment surface-candidate-qualified-r2 7)
     (surface-extension-qualified-r6 $assessment) (surface-extension-incomplete-r6 $assessment)))
   (surface-extension-incomplete-r6 $candidate))))
(= (SXR6Run $root)
 (let $input (sd_input $root)
  (if (PShape $input surface-request-shape-repair-input 9)
   (let* (($design (index-atom $input 1)) ($designPart (index-atom $input 2)) ($prior (index-atom $input 3))
          ($dependencies (index-atom $input 4)) ($observations (index-atom $input 5)) ($experiments (index-atom $input 6))
          ($targets (SXRepairTargets $dependencies $observations)) ($selection (SXSelectExperiment $experiments))
          ($targetRecord (sx_save $root repair-targets $targets)) ($selectionRecord (sx_save $root request-shape-selection $selection))
          ($diagnosticTemplate (sx_r6_template_probe diagnostic)) ($diagnosticTemplateRecord (sx_save $root diagnostic-template-probe $diagnosticTemplate))
          ($artifactTemplate (sx_r6_template_probe artifact)) ($artifactTemplateRecord (sx_save $root artifact-template-probe $artifactTemplate)))
    (if (and (SXRepairReady $targets) (and (PShape $selection request-shape-selected 4)
         (and (PShape $diagnosticTemplate request-template-probe 7) (PShape $artifactTemplate request-template-probe 7))))
     (let* (($load (sx_preload_r5 $root $selection)) ($loadRecord (sx_save $root load-observation $load))
            ($diagnostic (if (SXLoadValid $load) (SXDiagnosticR6 $root) (surface-diagnostic-held $load)))
            ($generated (if (SXDiagnosticValid $diagnostic) (SXR6Generate $root $design $designPart $prior $targets $observations) (surface-extension-held-r6 $diagnostic)))
            ($unload (sx_unload_r5 $root $selection)) ($unloadRecord (sx_save $root unload-observation $unload))
            ($result (if (and (PShape $generated surface-extension-qualified-r6 2) (SXUnloadValid $unload))
             (surface-extension-proposal-r6 $design $selection (index-atom $generated 1) $diagnostic $load $unload awaiting-G30-independent-trial)
             (surface-extension-incomplete-r6 $selection $diagnostic $generated $load $unload)))
            ($saved (sx_save $root final-r6 $result))) $result)
     (let* (($result (surface-extension-held-r6 $selection $targets $diagnosticTemplate $artifactTemplate)) ($saved (sx_save $root final-r6 $result))) $result)))
   (surface-extension-held-r6 $input))))
