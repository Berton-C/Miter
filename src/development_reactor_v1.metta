; G33 R10 source-grounded recurring development. Raw contact enters through a
; mechanical membrane; current native relations form or decline the undertaking.
; The dispatch returned by CStep is persisted but never executed here.
(= (DRObserveOne $raw)
 (if (PShape $raw raw-contact 5)
  (DObserve (index-atom $raw 1) (index-atom $raw 2)
   (index-atom $raw 3) (index-atom $raw 4))
  (held-audit malformed-raw-contact)))
(= (DRObservations $contacts $i)
 (if (< $i (size-atom $contacts))
  (cons-atom (DRObserveOne (index-atom $contacts $i))
   (DRObservations $contacts (+ $i 1))) ()))
(= (DRObservation $bundle)
 (let* (($contacts (index-atom $bundle 3))
        ($records (DRObservations $contacts 0)))
  (cycle-observation (index-atom $bundle 6)
   (index-atom (index-atom $contacts 0) 3) $records
   (index-atom $bundle 4) (index-atom $bundle 5) none none)))
(= (DRReady $id)
 (let $present (collapse (match &rna
                 (ready $id SourceGroundedDevelopRNA AwaitAuthorization $n)
                 (ready $id SourceGroundedDevelopRNA AwaitAuthorization $n)))
  (if (== (size-atom $present) 0)
   (add-atom &rna (ready $id SourceGroundedDevelopRNA AwaitAuthorization 1))
   development-rna-already-ready)))
(= (DRRehydrate $root $id $state)
 (let $status (dr_rna_status $root $id)
  (if (== $status ready)
   (let $add (DRReady $id) development-rna-rehydrated)
   (if (== $status awaiting-authorized-generation)
    development-already-waiting
    development-already-considered))))
(= (DRStoreTurn $root $bundle $observation $step)
 (let* (($id (index-atom $bundle 1))
        ($reason (index-atom $step 3))
        ($state (index-atom $step 1))
        ($stored (dr_store_turn $root $id $bundle $observation $step)))
  (if (== $stored development-turn-stored)
   (if (== $reason native-opportunity-transcribed)
    (let $checkpoint (dr_rna_checkpoint $root $id ready $state)
     (if (== $checkpoint development-rna-checkpoint-stored)
      (let $add (DRReady $id) development-opportunity-ready)
      development-rna-checkpoint-failed))
    (development-orientation-held $reason))
   development-turn-storage-failed)))
(= (DRConsider $root $bundle)
 (if (PShape $bundle development-contact-set 7)
  (let* (($id (index-atom $bundle 1))
         ($existing (dr_state $root $id)))
   (if (== $existing none)
    (let* (($observation (DRObservation $bundle))
           ($initial (CInitial $id (index-atom $bundle 2) (index-atom $bundle 5)))
           ($step (CStep $initial $observation)))
     (if (PShape $step cycle-step 4)
      (DRStoreTurn $root $bundle $observation $step)
      (development-native-turn-failed $step)))
    (DRRehydrate $root $id $existing)))
  (development-contact-held $bundle)))
(= (SourceGroundedDevelopmentIdle $root)
 (DRConsider $root (dr_contact_set $root)))
(= (SourceGroundedDevelopmentBoundary $root $id $locus $n)
 (if (and (== $locus AwaitAuthorization) (== $n 1))
  (let* (($state (dr_state $root $id))
         ($checkpoint (dr_rna_checkpoint $root $id awaiting-authorized-generation $state))
         ($remove (remove-atom &rna
                    (ready $id SourceGroundedDevelopRNA $locus $n))))
   (if (== $checkpoint development-rna-checkpoint-stored)
    development-awaiting-authorized-generation
    development-rna-checkpoint-failed))
  development-rna-lifecycle-fault))
