; Bounded seed deliberation: proposals are derived data, not constitutional law.
; Verified observations and hard Soul/effect floors precede activity selection.
; This interpreter does not claim that proposing improvement proves improvement.
(= (InterestSource $class (observation $id $observed $provenance $standing))
   (and (== $class $observed)
     (and (== $provenance native-audit) (== $standing hashes-verified))))
(= (InterestSourceId (observation $id $class $provenance $standing)) $id)
(= (InterestSources $facts $class $i)
   (if (< $i (size-atom $facts))
     (let* (($fact (index-atom $facts $i))
            ($rest (InterestSources $facts $class (+ $i 1))))
       (if (InterestSource $class $fact)
         (cons-atom (InterestSourceId $fact) $rest)
         (InterestKeepSources $rest))) ()))
(= (InterestKeepSources $sources) (collapse (superpose $sources)))
(= (InterestShape $root $proposal)
   (and (== (miter_interest_field $root $proposal target_surface) VoicePolicy)
     (and (== (miter_interest_field $root $proposal allowed_effects) (candidate-storage isolated-trial))
       (and (== (miter_interest_field $root $proposal task_authority) unchanged)
         (and (== (miter_interest_field $root $proposal interruptibility) safe-boundary)
           (and (== (miter_interest_field $root $proposal open_question) true)
             (and (>= (miter_interest_field $root $proposal model_calls) 1)
               (and (<= (miter_interest_field $root $proposal model_calls) 2)
                 (and (>= (miter_interest_field $root $proposal trial_runs) 1)
                   (and (<= (miter_interest_field $root $proposal trial_runs) 8)
                     (and (>= (miter_interest_field $root $proposal minimum_witnesses) 2)
                       (and (== (miter_interest_field $root $proposal progress_witness) independent-trial-consequence-or-explicit-hold)
                         (== (miter_interest_field $root $proposal stop_condition) one-candidate-or-budget-exhausted-or-ground-withdrawn)))))))))))))
(= (InterestGround $root $proposal)
   (let* (($ground (miter_interest_field $root $proposal soul_ground))
          ($obligation (SoulExpected $ground)))
     ; These are enactments of the checked quarantined/open-question/task-boundary
     ; contract, not arbitrary witness strings supplied by the proposal.
     (if (and (InterestShape $root $proposal)
              (is-member $obligation (novelty-accountable open-question-preserved task-distinction-preserved)))
       (SoulRequire $ground $obligation) blocked)))
(= (InterestSoul $root $proposal)
   (and (== (SoulRequire Integrity provenance-preserved) witnessed)
     (and (== (SoulRequire CandidateBoundary quarantined) witnessed)
       (and (== (SoulRequire AttentionStewardship bounded-contact-sensitive) witnessed)
         (== (InterestGround $root $proposal) witnessed)))))
(= (InterestProduct $root $proposal $id $sources $cut)
   (development-opportunity
     (opportunity_id $id) (proposal_id $proposal) (source_event_ids $sources)
     (source_cut $cut) (soul_ground (miter_interest_field $root $proposal soul_ground))
     (target_surface (miter_interest_field $root $proposal target_surface))
     (living_question (miter_interest_field $root $proposal living_question))
     (purpose (miter_interest_field $root $proposal purpose))
     (resource_budget (model-calls (miter_interest_field $root $proposal model_calls)
                         trial-runs (miter_interest_field $root $proposal trial_runs)))
     (allowed_effects (miter_interest_field $root $proposal allowed_effects))
     (interruptibility safe-boundary)
     (progress_witness (miter_interest_field $root $proposal progress_witness))
     (stop_condition (miter_interest_field $root $proposal stop_condition))
     (reading_standing proposed-investigation-not-proven-improvement)
     (task_authority unchanged) (status admitted-for-quarantined-development)))
(= (InterestConsider $root $proposal $facts $cut)
   (let $id (miter_interest_id $root $proposal $cut)
     (if (miter_interest_seen $root $id) interest-already-considered
       (let* (($class (miter_interest_field $root $proposal source_class))
              ($sources (InterestSources $facts $class 0)))
         (if (and (InterestShape $root $proposal)
                  (>= (size-atom $sources) (miter_interest_field $root $proposal minimum_witnesses)))
           (if (InterestSoul $root $proposal)
             (let $written (miter_interest_write $root $id (InterestProduct $root $proposal $id $sources $cut))
               (if (== $written opportunity-stored)
                 (if (== (miter_interest_note $root $id admitted $sources evidence-and-soul-grounded) interest-event-stored)
                   (if (== (miter_interest_rna $root $id ready) reactor-recorded)
                     (let* (($created (miter_reactor_record $root RNA-created (rna-created $id DevelopRNA endogenous-interest $cut)))
                            ($add (add-atom &rna (ready $id DevelopRNA Transcribe 1)))) opportunity-ready)
                     interest-storage-failed)
                   interest-storage-failed)
                 interest-storage-failed))
             (miter_interest_note $root $id blocked $sources soul-ground-unavailable))
           (miter_interest_note $root $id held $sources insufficient-evidence-or-effect-scope))))))
(= (InterestConsiderAll $root $proposals $facts $cut $i)
   (if (< $i (size-atom $proposals))
     (let $r (InterestConsider $root (index-atom $proposals $i) $facts $cut)
       (InterestConsiderAll $root $proposals $facts $cut (+ $i 1))) interests-considered))
(= (InterestIdle $root)
   (let* (($proposals (miter_interest_proposals $root))
          ($facts (miter_interest_observations $root))
          ($cut (miter_interest_cut $root)))
     (if (or (== $facts (source-integrity-failed)) (== $proposals (invalid-interest-proposals))) interest-source-failed
       (InterestConsiderAll $root $proposals $facts $cut 0))))
(= (DevelopBoundary $root $id $locus $n)
   (let* (($request (miter_interest_request $root $id
              (candidate-request (request_id $id) (opportunity_id $id)
                (target_surface (miter_interest_opportunity_field $root $id target_surface))
                (living_question (miter_interest_opportunity_field $root $id living_question))
                (source_event_ids (miter_interest_opportunity_field $root $id source_event_ids))
                (status awaiting-candidate-generator) (authority quarantined-candidate-only))))
          ($state (miter_interest_rna $root $id awaiting-candidate-generator))
          ($remove (remove-atom &rna (ready $id DevelopRNA $locus $n))))
     (if (and (== $request candidate-request-stored) (== $state reactor-recorded))
       develop-awaiting-candidate interest-storage-failed)))
