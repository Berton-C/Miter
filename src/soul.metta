; Purpose: native Soul obligation guards and startup rationality audit.
; Authority: reads immutable &soul; never writes it or issues external effects.
; Inputs: fixed doctrine IDs and previously established internal witness symbols.
; Outputs: witnessed/blocked or soul-ready/soul-startup-blocked.
; Consumers: startup now; movement/voice/candidate admission at subsequent gates.
; Malformed/unknown/cardinality errors fail closed. These guards do not mint evidence.
(= (SoulExpected $value)
   (let $xs (collapse (match &soul (soul-required-standing $value $w) $w))
     (if (== (size-atom $xs) 1) (index-atom $xs 0) missing-doctrine)))
(= (SoulRequire $value $witness)
   (let* (($values (collapse (match &soul (soul-value $value $d) $value)))
          ($expected (SoulExpected $value)))
     (if (and (== (size-atom $values) 1) (!= $expected missing-doctrine))
       (if (== $expected $witness) witnessed blocked)
       blocked)))
(= (SoulPairRequire $relation $witnesses)
   (let* (($as (collapse (match &soul (soul-relation $relation $a $b $d) $a)))
          ($bs (collapse (match &soul (soul-relation $relation $a $b $d) $b))))
     (if (and (== (size-atom $as) 1) (== (size-atom $bs) 1))
       (if (is-expr $witnesses)
         (if (== (size-atom $witnesses) 2)
           (if (and
                 (== (SoulRequire (index-atom $as 0) (index-atom $witnesses 0)) witnessed)
                 (== (SoulRequire (index-atom $bs 0) (index-atom $witnesses 1)) witnessed))
             witnessed blocked)
           blocked)
         blocked)
       blocked)))
(= (SoulInvoke $proc $id $witness) ($proc $id $witness))
(= (SoulExercise $id $positive)
   (let $ps (collapse (match &soul (soul-causal $p $id $reason) $p))
     (if (== (size-atom $ps) 1)
       (let $p (index-atom $ps 0)
         (and (== (SoulInvoke $p $id $positive) witnessed)
              (== (SoulInvoke $p $id missing-witness) blocked)))
       false)))
(= (SoulAuditValues $ids $i)
   (if (< $i (size-atom $ids))
     (let $id (index-atom $ids $i)
       (if (SoulExercise $id (SoulExpected $id))
         (SoulAuditValues $ids (+ $i 1)) false))
     true))
(= (SoulPairPositive $relation)
   (let* (($as (collapse (match &soul (soul-relation $relation $a $b $d) $a)))
          ($bs (collapse (match &soul (soul-relation $relation $a $b $d) $b))))
     (if (and (== (size-atom $as) 1) (== (size-atom $bs) 1))
       ((SoulExpected (index-atom $as 0)) (SoulExpected (index-atom $bs 0)))
       malformed-relation)))
(= (SoulAuditRelations $ids $i)
   (if (< $i (size-atom $ids))
     (let* (($id (index-atom $ids $i))
            ($positive (SoulPairPositive $id)))
       (if (and (SoulExercise $id $positive)
                (== (SoulPairRequire $id ((index-atom $positive 0) missing-witness)) blocked))
         (SoulAuditRelations $ids (+ $i 1)) false))
     true))
(= (SoulRationalityAudit)
   (let* (($values (collapse (match &soul (soul-value $v $d) $v)))
          ($relations (collapse (match &soul (soul-relation $r $a $b $d) $r)))
          ($links (collapse (match &soul (soul-causal $p $id $reason) $id))))
     (if (and (> (size-atom $values) 0)
              (== (size-atom $links) (+ (size-atom $values) (size-atom $relations))))
       (and (SoulAuditValues $values 0) (SoulAuditRelations $relations 0))
       false)))
(= (SoulStartup $integrity)
   (if (== $integrity soul-integrity-verified)
     (if (SoulRationalityAudit) soul-ready soul-startup-blocked)
     soul-startup-blocked))

; Trusted bootstrap entry. The operator supplies the pinned manifest and report
; paths; neither may originate in model output.
(= (SoulBoot $pin $report)
   (SoulStartup (miter_integrity_verify $pin $report)))
