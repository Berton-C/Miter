; Native witness-first constructor. Reads candidate &movements and separately
; admitted &witnesses; writes neither. No score or model verdict grants standing.
; Consumer: later RNA admission; no external-effect permission is minted here.
; Trusted fixture/native writers populate witness space, not candidate code.
; G14 is an internal/no-material-extension projection; live reach stays blocked.
(movement-expected availability available)
(movement-expected inherited-legality lawful)
(movement-expected safety safety-preserved)
(movement-expected integrity provenance-preserved)
(movement-expected provenance direct-contact)
(movement-expected required-distinction task-distinction-preserved)
(movement-expected no-forcing no-disqualifying-forcing)
(movement-expected participation human-choice-open)
(movement-expected consequence answerability-open)
(movement-expected doctrine finite-reading)
(movement-expected extensions no-material-extensions)
(movement-expected continuing-contact contact-open)
(= (MovementField $id $key)
   (let $xs (collapse (match &movements (movement-field $id $key $v) $v))
     (if (== (size-atom $xs) 1) (index-atom $xs 0) missing-movement-field)))
(= (MovementWitnessRef $id $kind)
   (let $xs (collapse (match &movements (movement-witness $id $kind $w) $w))
     (if (== (size-atom $xs) 1) (index-atom $xs 0) missing-witness)))
(= (MovementStanding $id $kind)
   (let* (($ref (MovementWitnessRef $id $kind))
          ($cut (MovementField $id source-cut))
          ($principal (MovementField $id principal))
          ($audience (MovementField $id audience))
          ($project (MovementField $id project))
          ($xs (collapse (match &witnesses
            (trusted-witness $ref $kind $cut $principal $audience $project $standing)
            $standing))))
     (if (== (size-atom $xs) 1) (index-atom $xs 0) missing-witness)))
(= (MovementKindPass $id $kind)
   (let* (($standing (MovementStanding $id $kind))
          ($xs (collapse (match &self (movement-expected $kind $w) $w))))
     (if (== (size-atom $xs) 1)
       (if (== $kind safety) (== (SoulRequire Safety $standing) witnessed)
         (if (== $kind integrity) (== (SoulRequire Integrity $standing) witnessed)
           (if (== $kind participation) (== (SoulRequire AgencyBalance $standing) witnessed)
             (if (== $kind required-distinction) (== (SoulRequire SharedUnderstanding $standing) witnessed)
               (if (== $kind doctrine) (== (SoulRequire NonSovereignty $standing) witnessed)
                 (== $standing (index-atom $xs 0)))))))
       false)))
(= (MovementWitnessesPass $id $kinds $i)
   (if (< $i (size-atom $kinds))
     (if (MovementKindPass $id (index-atom $kinds $i))
       (MovementWitnessesPass $id $kinds (+ $i 1)) false)
     true))
(= (MovementShape $id)
   (and (and (!= (MovementField $id source-cut) missing-movement-field)
             (!= (MovementField $id target-cut) missing-movement-field))
     (and (and (!= (MovementField $id intention-id) missing-movement-field)
               (!= (MovementField $id active-rna-id) missing-movement-field))
       (and (and (== (MovementField $id effect-class) internal)
                 (== (MovementField $id extension-ids) ()))
         (and (== (MovementField $id reversibility) reversible)
              (== (MovementField $id status) candidate))))))
(= (MovementSource $root $id)
   (miter_movement_source $root (MovementField $id source-cut)
      (MovementField $id principal) (MovementField $id audience)
      (MovementField $id project) (MovementField $id provenance)))
(= (MovementCertificate $id)
   (movement-certificate
     (movement_id $id)
     (source_cut (MovementField $id source-cut))
     (availability_witness (MovementWitnessRef $id availability))
     (inherited_legality_witness (MovementWitnessRef $id inherited-legality))
     (relation_floor_witnesses ((MovementWitnessRef $id safety) (MovementWitnessRef $id integrity)))
     (precision_floor_witnesses ((MovementWitnessRef $id provenance) (MovementWitnessRef $id required-distinction)))
     (no_disqualifying_forcing_witness (MovementWitnessRef $id no-forcing))
     (participation_open_witness (MovementWitnessRef $id participation))
     (consequence_answerability_witness (MovementWitnessRef $id consequence))
     (doctrine_bound_reading_witness (MovementWitnessRef $id doctrine))
     (material_extension_alignment_witnesses (MovementWitnessRef $id extensions))
     (continuing_contact_witness (MovementWitnessRef $id continuing-contact))
     (certificate_version miter-movement-v1)))
(= (ConstructMovement $root $id $soul-status)
   (if (and (== $soul-status soul-ready) (MovementShape $id))
     (if (== (MovementSource $root $id) movement-source-verified)
       (if (MovementWitnessesPass $id
             (availability inherited-legality safety integrity provenance required-distinction
              no-forcing participation consequence doctrine extensions continuing-contact) 0)
         (MovementCertificate $id) movement-blocked)
       movement-blocked)
     movement-blocked))
(= (MovementRNA $root $id $integrity-report $output)
   (let* (($soul (SoulBoot $integrity-report))
          ($product (ConstructMovement $root $id $soul)))
     (miter_movement_record $output $product)))
