; Native, non-sovereign language cue. No person-state or task-verdict writer.
; Inputs: mechanical local matches; outputs: coverage, trajectory and presence
; requirement. All routing constants are explicitly uncalibrated PoC priors.
; Unknown/missing lexical coverage never implies neutral certainty.
(= (VADSumAxis $id $clause $axis $i $count $acc)
   (if (< $i $count)
     (VADSumAxis $id $clause $axis (+ $i 1) $count
       (+ $acc (miter_vad_number $id $clause $i $axis))) $acc))
(= (VADMean $id $clause $axis)
   (let $count (miter_vad_metric $id $clause match_count)
     (if (> $count 0) (/ (VADSumAxis $id $clause $axis 0 $count 0) $count) 0)))
(= (VADCountAll $id $kind $i $count $acc)
   (if (< $i $count)
     (VADCountAll $id $kind (+ $i 1) $count
       (+ $acc (miter_vad_metric $id $i $kind))) $acc))
(= (VADBand $value)
   (let $band (miter_vad_prior register_band_prior)
     (if (> $value $band) high
       (if (< $value (- 0 $band)) low mid))))
(= (VADClauseBand $id $clause $axis)
   (if (> (miter_vad_metric $id $clause match_count) 0)
     (VADBand (VADMean $id $clause $axis)) unknown))
(= (VADProfile $id $axis $i $count)
   (if (< $i $count)
     (cons-atom (VADClauseBand $id $i $axis)
                (VADProfile $id $axis (+ $i 1) $count)) ()))
(= (VADCoverage $id)
   (let* (($count (miter_vad_metric $id 0 clause_count))
          ($total (VADCountAll $id token_count 0 $count 0))
          ($covered (VADCountAll $id covered_tokens 0 $count 0)))
     (if (> $total 0) (/ $covered $total) 0)))
(= (VADLexicalTrajectory $id $coverage)
   (let* (($count (miter_vad_metric $id 0 clause_count))
          ($last (- $count 1))
          ($delta (- (VADMean $id $last 0) (VADMean $id 0 0)))
          ($threshold (miter_vad_prior trajectory_delta_prior)))
     (if (< $coverage (miter_vad_prior coverage_prior)) insufficient-coverage
       (if (< $count 2) single-clause
         (if (or (== (miter_vad_metric $id 0 match_count) 0)
                 (== (miter_vad_metric $id $last match_count) 0))
           insufficient-clause-coverage
           (if (> $delta $threshold)
             (if (or (miter_vad_contains $id "but") (miter_vad_contains $id "however"))
               improving-pivot improving)
             (if (< $delta (- 0 $threshold))
               (if (or (miter_vad_contains $id "just") (miter_vad_contains $id "a little"))
                 deterioration-minimization-cue deteriorating)
               stable-or-ambiguous)))))))
(= (VADMinimization $id)
   (let $last (- (miter_vad_metric $id 0 clause_count) 1)
     (and
       (or (miter_vad_clause_contains $id $last "just")
           (or (miter_vad_clause_contains $id $last "a little")
               (miter_vad_clause_contains $id $last "a bit")))
       (or (miter_vad_clause_contains $id $last "off")
         (or (miter_vad_clause_contains $id $last "uneasy")
           (or (miter_vad_clause_contains $id $last "worried")
             (or (miter_vad_clause_contains $id $last "struggling")
                 (miter_vad_clause_contains $id $last "not okay"))))))))
(= (VADTrajectory $id $coverage)
   (let $lexical (VADLexicalTrajectory $id $coverage)
     (if (and (>= $coverage (miter_vad_prior coverage_prior))
              (> (miter_vad_metric $id 0 clause_count) 1))
       (if (VADMinimization $id) minimization-pressure-cue $lexical)
       $lexical)))
(= (VADPresence $trajectory)
   (if (== $trajectory improving-pivot) preserve-emerging-insight
     (if (or (== $trajectory deterioration-minimization-cue)
             (== $trajectory minimization-pressure-cue)) acknowledge-tension-gently
       (if (or (== $trajectory insufficient-coverage)
               (== $trajectory insufficient-clause-coverage))
         withhold-affective-inference
         attentive-non-diagnostic))))
(= (VADStatus $coverage)
   (if (== $coverage 0) no-coverage
     (if (< $coverage (miter_vad_prior coverage_prior)) sparse usable-cue)))
(= (VADCue $id $mode)
   (let* (($count (miter_vad_metric $id 0 clause_count))
          ($coverage (VADCoverage $id))
          ($trajectory (VADTrajectory $id $coverage)))
     (affect-cue
       (label affective-language-cue)
       (lexicon_mode $mode)
       (asset_access (if (== $mode lexicon_off) disabled checksum-verified))
       (coverage $coverage)
       (valence_profile (VADProfile $id 0 0 $count))
       (arousal_profile (VADProfile $id 1 0 $count))
       (dominance_profile (VADProfile $id 2 0 $count))
       (clause_count $count)
       (trajectory_class $trajectory)
       (clause_trajectory ((lexical (VADLexicalTrajectory $id $coverage))
                          (minimization-marker (VADMinimization $id))))
       (presence_requirement (VADPresence $trajectory))
       (confidence_basis uncalibrated-priors)
       (status (VADStatus $coverage))
       (permission_effect none)
       (limitations (lexical-association-only no-diagnosis no-inner-state-claim
                     english-bounded-morphology irony-and-negation-unresolved
                     identity-filter-not-exhaustive)))) )
(= (VADRNA $path $id $mode $output)
   (let $lookup (miter_vad_prepare $path (but however although)
                  (muslim jewish black gay disabled woman man) $mode)
     (if (== $lookup vad-lookup-ready)
       (miter_vad_finish $id (VADCue $id $mode) $output) vad-unavailable)))
; Authority dependency law and its consumer are native, not a documentation flag.
(= (PermissionDependenciesLawful $xs)
   (if (== (size-atom $xs) 0) true
     (if (or (== (car-atom $xs) authenticated-scope)
             (== (car-atom $xs) task-facts))
       (PermissionDependenciesLawful (cdr-atom $xs)) false)))
(= (TaskPermission $scope $facts)
   (if (and (== $scope authorized) (== $facts permitted)) permitted blocked))
(= (InstallPermissionPolicy $dependencies)
   (if (PermissionDependenciesLawful $dependencies) policy-admitted
     rejected-affect-authority-dependency))
